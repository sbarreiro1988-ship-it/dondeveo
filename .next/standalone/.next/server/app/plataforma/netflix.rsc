2:["$","$Lb",null,{"platform":{"id":"netflix","name":"Netflix","shortName":"N","color":"#E50914","bgColor":"#E50914","textColor":"#ffffff","url":"https://netflix.com","type":"flatrate"},"movies":[{"id":1007757,"title":"Intercambiados","originalTitle":"Intercambiados","overview":"Una pequeña criatura del bosque intercambia el cuerpo con un majestuoso pájaro del valle, lo que los obliga a colaborar para sobrevivir a la aventura más salvaje de sus vidas.","posterPath":"https://image.tmdb.org/t/p/w500/i89vUDwNhAEWUZSFYITSiv1RIbK.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/zMwhWailP1WY7sb6AoE6b8ugoy.jpg","voteAverage":9,"voteCount":1132,"releaseDate":"2026-05-01","genres":["Animación","Familia","Aventura","Fantasía"],"type":"movie","platforms":["$c"],"tmdbId":1007757,"runtime":"$undefined","seasons":"$undefined"},{"id":1318447,"title":"Depredador dominante","originalTitle":"Depredador dominante","overview":"Una mujer en duelo se adentra en la naturaleza de Australia para ponerse a prueba y queda atrapada en un juego mortal con un astuto asesino que la considera su presa.","posterPath":"https://image.tmdb.org/t/p/w500/mV7uFS1U8iP0p4CcXZp4znBVpch.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/p8777bPIlyFYcjqP2hU8htoz1RG.jpg","voteAverage":6.6,"voteCount":1065,"releaseDate":"2026-04-24","genres":["Acción","Suspense"],"type":"movie","platforms":["$c"],"tmdbId":1318447,"runtime":"$undefined","seasons":"$undefined"},{"id":1630423,"title":"Sangre asesina","originalTitle":"Sangre asesina","overview":"A una mujer le espera una bala con su nombre por culpa de su extraño grupo sanguíneo, pero encuentra cobijo en los brazos del asesino al que ama, y juntos luchan por sobrevivir.","posterPath":"https://image.tmdb.org/t/p/w500/16TvbhCP8CfiGEbxcbtQLYWO6WG.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/xA6AM5MvEkieZKlv1Tn3sN23I7i.jpg","voteAverage":8.6,"voteCount":168,"releaseDate":"2026-05-06","genres":["Acción","Drama","Romance"],"type":"movie","platforms":["$c"],"tmdbId":1630423,"runtime":"$undefined","seasons":"$undefined"},{"id":1330021,"title":"Criaturas luminosas","originalTitle":"Criaturas luminosas","overview":"En este drama, basado en el bestseller homónimo, una viuda forja un vínculo con un pulpo muy listo y un joven a la deriva mientras trabaja de noche en un pequeño acuario.","posterPath":"https://image.tmdb.org/t/p/w500/aNixJoh0U4kN85YM6vPyVZL6ALF.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/bVGHSe47W6oCQL1Q88pvRAet51A.jpg","voteAverage":8.5,"voteCount":293,"releaseDate":"2026-05-07","genres":["Drama","Misterio"],"type":"movie","platforms":["$c"],"tmdbId":1330021,"runtime":"$undefined","seasons":"$undefined"},{"id":318256,"title":"Hot Girls Wanted","originalTitle":"Hot Girls Wanted","overview":"Gracias a Internet, miles de jóvenes estadounidenses están entrando en el “amateur” mundo del porno, en cumplimiento de una demanda creciente de aspirantes a estrellas estilo “chica de al lado”. ‘Hot Girls Wanted’ sigue a una de esas chicas, deseosa de dejar la vida de pueblo pequeño en busca de la libertad y la fama.","posterPath":"https://image.tmdb.org/t/p/w500/75ot83QOkc02vujyzmIbumQCU6Y.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/bV7eAcBrYb57PwjpQ2ODT6VyFPd.jpg","voteAverage":6.1,"voteCount":721,"releaseDate":"2015-01-24","genres":["Documental"],"type":"movie","platforms":["$c"],"tmdbId":318256,"runtime":"$undefined","seasons":"$undefined"},{"id":7451,"title":"xXx","originalTitle":"xXx","overview":"Xander Cage es XXX, un antiguo ganador de X-Games y atleta profesional de deportes de extremo, que sobrevive vendiendo videos de sus increíbles hazañas, las cuales hacen emitir adrenalina por todo el cuerpo. Pero después de incontables encuentros con la ley, su mundo está a punto de tomar un rumbo aún más extremo... Porque Xander no sabe que ha sido \"espiado\" por Augustus Gibbons, un agente veterano de la Agencia Nacional de Seguridad que se encuentra en una desesperada situación en la distante ciudad de Praga, en donde su operativo secreto ha sido asesinado por una pandilla de mafiosos con un estilo muy propio, que se llaman así mismos Anarchy 99, encabezados por el brutal ex-Comandante del Ejército Ruso Yorgi.","posterPath":"https://image.tmdb.org/t/p/w500/gd4hRY3pFXRY7YVbMdVBpnKV7wC.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/2OHa6ukEq3Hce7Pc2kvu8wkmMFY.jpg","voteAverage":6,"voteCount":4894,"releaseDate":"2002-08-09","genres":["Acción","Aventura","Suspense","Crimen","Drama"],"type":"movie","platforms":["$c"],"tmdbId":7451,"runtime":"$undefined","seasons":"$undefined"},{"id":1265609,"title":"Máquina de guerra","originalTitle":"Máquina de guerra","overview":"En una última misión agotadora durante el entrenamiento para ser ranger, un ingeniero de combate debe liderar a su unidad contra una gigantesca máquina asesina de otro mundo.","posterPath":"https://image.tmdb.org/t/p/w500/5C18uOTbDZRvVIZcVRO747k2fUi.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/6yeVcxFR0j08vlv2OlL6zbewm4D.jpg","voteAverage":7.3,"voteCount":1709,"releaseDate":"2026-02-12","genres":["Acción","Ciencia ficción","Suspense"],"type":"movie","platforms":["$c"],"tmdbId":1265609,"runtime":"$undefined","seasons":"$undefined"},{"id":1582770,"title":"Dhurandhar The Revenge","originalTitle":"Dhurandhar The Revenge","overview":"Hamza Ali Mazari, cuya verdadera identidad es Jaskirat Singh Rangi, continúa su operación encubierta en el mundo criminal de Pakistán mientras rastrea a Majo.","posterPath":"https://image.tmdb.org/t/p/w500/jvAEt2mqWdY0sUNybtVFelRzMnZ.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/gRoZG3Z0zJxgElmTsVHOl2dNYXe.jpg","voteAverage":7.3,"voteCount":73,"releaseDate":"2026-03-18","genres":["Acción","Crimen","Suspense"],"type":"movie","platforms":["$c"],"tmdbId":1582770,"runtime":"$undefined","seasons":"$undefined"},{"id":502356,"title":"Super Mario Bros: La película","originalTitle":"Super Mario Bros: La película","overview":"Mientras trabajan en una avería subterránea, los fontaneros de Brooklyn, Mario y su hermano Luigi, viajan por una misteriosa tubería hasta un nuevo mundo mágico. Pero, cuando los hermanos se separan, Mario deberá emprender una épica misión para encontrar a Luigi. Con la ayuda del champiñón local Toad y unas cuantas nociones de combate de la guerrera líder del Reino Champiñón, la princesa Peach, Mario descubre todo el poder que alberga en su interior.","posterPath":"https://image.tmdb.org/t/p/w500/5AIZhT8vwdut7ILImXk0bfRPbaX.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/9n2tJBplPbgR2ca05hS5CKXwP2c.jpg","voteAverage":7.6,"voteCount":10668,"releaseDate":"2023-04-05","genres":["Familia","Comedia","Aventura","Fantasía","Animación"],"type":"movie","platforms":["$c"],"tmdbId":502356,"runtime":"$undefined","seasons":"$undefined"},{"id":603,"title":"Matrix","originalTitle":"Matrix","overview":"Thomas Anderson lleva una doble vida: por el día es programador en una importante empresa de software, y por la noche un hacker informático llamado Neo. Su vida no volverá a ser igual cuando unos misteriosos personajes le inviten a descubrir la respuesta a la pregunta que no le deja dormir: ¿qué es Matrix?","posterPath":"https://image.tmdb.org/t/p/w500/8rT9kG2EYkZpJmYCuTJNnPDEube.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/tlm8UkiQsitc8rSuIAscQDCnP8d.jpg","voteAverage":8.2,"voteCount":27842,"releaseDate":"1999-03-31","genres":["Acción","Ciencia ficción"],"type":"movie","platforms":["$c"],"tmdbId":603,"runtime":"$undefined","seasons":"$undefined"},{"id":803796,"title":"Las guerreras k-pop","originalTitle":"Las guerreras k-pop","overview":"Cuando no están llenando estadios, las superestrellas del K-pop Rumi, Mira y Zoey usan sus poderes secretos para proteger a sus fans de una amenaza sobrenatural.","posterPath":"https://image.tmdb.org/t/p/w500/6EQMqEmdG5HoGe2zT1WwWUMvVhv.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/w3Bi0wygeFQctn6AqFTwhGNXRwL.jpg","voteAverage":8,"voteCount":2761,"releaseDate":"2025-06-20","genres":["Fantasía","Música","Comedia","Animación"],"type":"movie","platforms":["$c"],"tmdbId":803796,"runtime":"$undefined","seasons":"$undefined"},{"id":155,"title":"El caballero oscuro","originalTitle":"El caballero oscuro","overview":"Batman/Bruce Wayne regresa para continuar su guerra contra el crimen. Con la ayuda del teniente Jim Gordon y del Fiscal del Distrito Harvey Dent, Batman se propone destruir el crimen organizado en la ciudad de Gotham. El triunvirato demuestra su eficacia, pero, de repente, aparece Joker, un nuevo criminal que desencadena el caos y tiene aterrados a los ciudadanos.","posterPath":"https://image.tmdb.org/t/p/w500/8QDQExnfNFOtabLDKqfDQuHDsIg.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/cfT29Im5VDvjE0RpyKOSdCKZal7.jpg","voteAverage":8.5,"voteCount":35723,"releaseDate":"2008-07-16","genres":["Acción","Crimen","Suspense"],"type":"movie","platforms":["$c"],"tmdbId":155,"runtime":"$undefined","seasons":"$undefined"},{"id":680,"title":"Pulp Fiction","originalTitle":"Pulp Fiction","overview":"Jules y Vincent, dos asesinos a sueldo con muy pocas luces, trabajan para Marsellus Wallace. Vincent le confiesa a Jules que Marsellus le ha pedido que cuide de Mia, su mujer. Jules le recomienda prudencia porque es muy peligroso sobrepasarse con la novia del jefe. Cuando llega la hora de trabajar, ambos deben ponerse manos a la obra. Su misión: recuperar un misterioso maletín.","posterPath":"https://image.tmdb.org/t/p/w500/hNcQAuquJxTxl2fJFs1R42DrWcf.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/suaEOtk1N1sgg2MTM7oZd2cfVp3.jpg","voteAverage":8.5,"voteCount":30154,"releaseDate":"1994-09-10","genres":["Suspense","Crimen","Comedia"],"type":"movie","platforms":["$c"],"tmdbId":680,"runtime":"$undefined","seasons":"$undefined"},{"id":496243,"title":"Parásitos","originalTitle":"Parásitos","overview":"Tanto Gi Taek (Song Kang-ho) como su familia están sin trabajo. Cuando su hijo mayor, Gi Woo (Choi Woo-sik), empieza a dar clases particulares en casa de Park (Lee Seon-gyun), las dos familias, que tienen mucho en común pese a pertenecer a dos mundos totalmente distintos, comienzan una interrelación de resultados imprevisibles.","posterPath":"https://image.tmdb.org/t/p/w500/4N55tgxDW0RRATyrZHbx0q9HUKv.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/TU9NIjwzjoKPwQHoHshkFcQUCG.jpg","voteAverage":8.5,"voteCount":20593,"releaseDate":"2019-05-30","genres":["Comedia","Suspense","Drama"],"type":"movie","platforms":["$c"],"tmdbId":496243,"runtime":"$undefined","seasons":"$undefined"},{"id":1306368,"title":"El botín","originalTitle":"El botín","overview":"El descubrimiento de varios millones de dólares en efectivo en un zulo abandonado de Miami quiebra la confianza de un grupo de policías. Ahora, todo y todos están bajo sospecha.","posterPath":"https://image.tmdb.org/t/p/w500/55C5loKFkw7Cj0nMLWux4FJCRHI.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/3F2EXWF1thX0BdrVaKvnm6mAhqh.jpg","voteAverage":7.1,"voteCount":1587,"releaseDate":"2026-01-13","genres":["Acción","Suspense","Crimen"],"type":"movie","platforms":["$c"],"tmdbId":1306368,"runtime":"$undefined","seasons":"$undefined"},{"id":514847,"title":"La caza","originalTitle":"La caza","overview":"Doce extraños se despiertan en el claro de un bosque con muchas preguntas sin respuesta. ¿Dónde están? ¿Cómo llegaron allí? ¿Y por qué o con qué propósito están ahí? La respuesta a todas esas preguntas es: La caza, un juego macabro ideado por miembros de las élites globales, que se reúnen en un punto remoto o una casa para cazar humanos por diversión. Ellos son las presas; el resto, los cazadores. Pero todo está a punto de cambiar cuando Crystal, una de las jóvenes que se encuentra entre los \"cazados\", le da la vuelta al juego y empieza a inclinar la balanza a su favor. Uno a uno, comienza a deshacerse de los miembros de la élite que pretende darles caza, con la intención de llegar hasta la misteriosa mujer (Hilary Swank) que mueve los hilos de todo aquello.","posterPath":"https://image.tmdb.org/t/p/w500/5WCuPRfa0h8jMT4Iu2jIIQXqllM.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/evo3crueRIK9Eutb3lnDLVbD2xD.jpg","voteAverage":6.6,"voteCount":3630,"releaseDate":"2020-03-11","genres":["Acción","Suspense","Terror"],"type":"movie","platforms":["$c"],"tmdbId":514847,"runtime":"$undefined","seasons":"$undefined"},{"id":129,"title":"El viaje de Chihiro","originalTitle":"El viaje de Chihiro","overview":"Durante el traslado de su familia a los suburbios, una niña de 10 años de edad deambula por un mundo gobernado por dioses, brujas y espíritus, y donde los humanos se convierten en bestias.","posterPath":"https://image.tmdb.org/t/p/w500/2RcxjDykOssx4SfqshewyI9vfSl.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/dyJvKsNs2KP8qQnAXbRwDjblViy.jpg","voteAverage":8.5,"voteCount":18287,"releaseDate":"2001-07-20","genres":["Animación","Familia","Fantasía"],"type":"movie","platforms":["$c"],"tmdbId":129,"runtime":"$undefined","seasons":"$undefined"},{"id":872585,"title":"Oppenheimer","originalTitle":"Oppenheimer","overview":"Película sobre el físico J. Robert Oppenheimer y su papel como desarrollador de la bomba atómica. Basada en el libro 'American Prometheus: The Triumph and Tragedy of J. Robert Oppenheimer' de Kai Bird y Martin J. Sherwin.","posterPath":"https://image.tmdb.org/t/p/w500/ncKCQVXgk4BcQV6XbvesgZ2zLvZ.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/neeNHeXjMF5fXoCJRsOmkNGC7q.jpg","voteAverage":8,"voteCount":11733,"releaseDate":"2023-07-19","genres":["Drama","Historia"],"type":"movie","platforms":["$c"],"tmdbId":872585,"runtime":"$undefined","seasons":"$undefined"},{"id":550,"title":"El club de la lucha","originalTitle":"El club de la lucha","overview":"Un hombre consumido por el insomnio y una vida sin sentido conoce a Tyler Durden, un carismático anarquista que lo arrastra a un club secreto donde el dolor despierta algo dormido. Lo que comienza como liberación pronto se convierte en una guerra contra el sistema…","posterPath":"https://image.tmdb.org/t/p/w500/sgTAWJFaB2kBvdQxRGabYFiQqEK.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/xRyINp9KfMLVjRiO5nCsoRDdvvF.jpg","voteAverage":8.4,"voteCount":31986,"releaseDate":"1999-10-15","genres":["Drama","Suspense"],"type":"movie","platforms":["$c"],"tmdbId":550,"runtime":"$undefined","seasons":"$undefined"},{"id":693134,"title":"Dune: Parte dos","originalTitle":"Dune: Parte dos","overview":"Sigue el viaje mítico de Paul Atreides mientras se une a Chani y los Fremen en una guerra de venganza contra los conspiradores que destruyeron a su familia. Al enfrentarse a una elección entre el amor de su vida y el destino del universo conocido, Paul se esfuerza por evitar un futuro terrible que solo él puede prever.","posterPath":"https://image.tmdb.org/t/p/w500/xCHmhHeO7aOCMlzcNukGH6Q7EiD.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/xOMo8BRK7PfcJv9JCnx7s5hj0PX.jpg","voteAverage":8.1,"voteCount":7914,"releaseDate":"2024-02-27","genres":["Ciencia ficción","Aventura"],"type":"movie","platforms":["$c"],"tmdbId":693134,"runtime":"$undefined","seasons":"$undefined"},{"id":1087040,"title":"Hasta el fondo: La historia de Pornhub","originalTitle":"Hasta el fondo: La historia de Pornhub","overview":"Este documental ofrece un análisis en profundidad de los éxitos y escándalos de Pornhub a través de entrevistas con artistas, activistas y antiguos empleados.","posterPath":"https://image.tmdb.org/t/p/w500/uJldamB3Le1eELdjqaBd4APGU49.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/sGE6N1vJjxZLkOJEXdIOqTslxuL.jpg","voteAverage":5.8,"voteCount":355,"releaseDate":"2023-03-15","genres":["Documental"],"type":"movie","platforms":["$c"],"tmdbId":1087040,"runtime":"$undefined","seasons":"$undefined"},{"id":744,"title":"Top Gun: Ídolos del aire","originalTitle":"Top Gun: Ídolos del aire","overview":"La Marina de los Estados Unidos ha creado una escuela de élite para pilotos con el fin de sacar una promoción de expertos en técnicas de combate. En la academia, más conocida como Top Gun, a los mejores se les entrena para ser intrépidos y fríos al mismo tiempo, capaces de no perder los nervios en situaciones extremas y de no inmutarse al romper la barrera del sonido a los mandos de un F-14. A la escuela llega el joven Maverick, famoso por su temeraria aunque brillante forma de pilotar.","posterPath":"https://image.tmdb.org/t/p/w500/W8QUPhiBOCdj2urJDzc2D9xdQb.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/dBgxEkWe17R0AJDAvAhpeVELQx2.jpg","voteAverage":7.1,"voteCount":9534,"releaseDate":"1986-05-16","genres":["Acción","Drama","Romance"],"type":"movie","platforms":["$c"],"tmdbId":744,"runtime":"$undefined","seasons":"$undefined"},{"id":1290417,"title":"Embestida","originalTitle":"Embestida","overview":"Cuando un catastrófico huracán azota un pueblo costero, el nivel del mar sube rápidamente y sus habitantes deben sobrevivir a un montón de hambrientos tiburones.","posterPath":"https://image.tmdb.org/t/p/w500/osYy4GDE4nr69MGTJxRaZlqU82S.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/hniERZojXCEc7Fp3yljZUigOAhm.jpg","voteAverage":6,"voteCount":559,"releaseDate":"2026-04-10","genres":["Terror","Suspense"],"type":"movie","platforms":["$c"],"tmdbId":1290417,"runtime":"$undefined","seasons":"$undefined"},{"id":1268127,"title":"Humint","originalTitle":"Humint","overview":"Un agente surcoreano investiga una red de narcotráfico en Rusia y debe colaborar con un agente norcoreano, lo cual los lleva correr riesgos y descubrir secretos muy turbios.","posterPath":"https://image.tmdb.org/t/p/w500/3xI81SsZHRKY0ltVKbILbvU3wa4.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/5KFThZkdBEQkp9gPWWWNb5CI5yD.jpg","voteAverage":7.4,"voteCount":126,"releaseDate":"2026-02-11","genres":["Suspense","Acción","Drama"],"type":"movie","platforms":["$c"],"tmdbId":1268127,"runtime":"$undefined","seasons":"$undefined"},{"id":976893,"title":"Días Perfectos","originalTitle":"Días Perfectos","overview":"Hirayama parece totalmente satisfecho con su sencilla vida de limpiador de retretes en Tokio. Fuera de su estructurada rutina diaria, disfruta de su pasión por la música y los libros. Le encantan los árboles y les hace fotos. Una serie de encuentros inesperados revelan poco a poco más de su pasado.","posterPath":"https://image.tmdb.org/t/p/w500/efnvsuEdkdwiWR7WyQ2QgcGt8mM.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/hjWxngV6tidwDkfJDEgMjHD2KEz.jpg","voteAverage":7.8,"voteCount":1894,"releaseDate":"2023-11-10","genres":["Drama"],"type":"movie","platforms":["$c"],"tmdbId":976893,"runtime":"$undefined","seasons":"$undefined"},{"id":4935,"title":"El castillo ambulante","originalTitle":"El castillo ambulante","overview":"Sophie, una joven sobre la que pesa una horrible maldición que le confiere el aspecto de una anciana, decide pedir ayuda al mago Howl, que vive en un castillo ambulante, pero tal vez sea Howl quien necesite la ayuda de Sophie.","posterPath":"https://image.tmdb.org/t/p/w500/p8EARnEw8KPZzlZg3vkseYVMczu.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/nv5wwZou159v5OC61i4ElR7OqyY.jpg","voteAverage":8.4,"voteCount":11049,"releaseDate":"2004-09-09","genres":["Fantasía","Animación","Aventura"],"type":"movie","platforms":["$c"],"tmdbId":4935,"runtime":"$undefined","seasons":"$undefined"},{"id":1062722,"title":"Frankenstein","originalTitle":"Frankenstein","overview":"Un científico brillante y obsesivo, Victor Frankenstein, en su ambición por desafiar a la muerte, da vida a una criatura ensamblada con partes de cadáveres. Pese a tratarse de una proeza científica, Frankenstein considera que la criatura carece de inteligencia y la rechaza. Dolida, esta se rebela contra su creador.","posterPath":"https://image.tmdb.org/t/p/w500/hTj8x0ElKldJyAjTYvaqxkQNxxN.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/hpXBJxLD2SEf8l2CspmSeiHrBKX.jpg","voteAverage":7.6,"voteCount":3415,"releaseDate":"2025-10-17","genres":["Drama","Fantasía","Terror"],"type":"movie","platforms":["$c"],"tmdbId":1062722,"runtime":"$undefined","seasons":"$undefined"},{"id":396535,"title":"Train to Busan","originalTitle":"Train to Busan","overview":"Un virus letal se expande por Corea del Sur, provocando violentos altercados. Los pasajeros de un tren KTX que viaja de Seúl a Busan tendrán que luchar por su supervivencia.","posterPath":"https://image.tmdb.org/t/p/w500/anomz7b3GQtHPFH34SODDBBIUad.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/fVpFOcQyHJM2di9upgSIwWD5wac.jpg","voteAverage":7.7,"voteCount":8335,"releaseDate":"2016-07-20","genres":["Terror","Suspense","Acción","Aventura"],"type":"movie","platforms":["$c"],"tmdbId":396535,"runtime":"$undefined","seasons":"$undefined"},{"id":875828,"title":"Peaky Blinders: El hombre inmortal","originalTitle":"Peaky Blinders: El hombre inmortal","overview":"El gánster Tommy Shelby regresa a Birmingham para salvar a su familia —y a su país— cuando su hijo, del que se ha distanciado, se ve envuelto en un complot nazi.","posterPath":"https://image.tmdb.org/t/p/w500/l9S8MLUyi2diTc2Gf3KDAOQTuVx.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/aouxo2EaR7QSGBBUNTITuW0lj4z.jpg","voteAverage":7.2,"voteCount":928,"releaseDate":"2026-03-05","genres":["Crimen","Drama"],"type":"movie","platforms":["$c"],"tmdbId":875828,"runtime":"$undefined","seasons":"$undefined"},{"id":939243,"title":"Sonic 3: La película","originalTitle":"Sonic 3: La película","overview":"Sonic, Knuckles y Tails se reúnen para enfrentarse a un nuevo y poderoso adversario, Shadow, un misterioso villano cuyos poderes no se parecen a nada de lo que nuestros héroes han conocido hasta ahora. Con sus facultades superadas en todos los sentidos, el Equipo Sonic tendrá que establecer una insólita alianza con la esperanza de detener a Shadow y proteger el planeta.","posterPath":"https://image.tmdb.org/t/p/w500/3aDWCRXLYOCuxjrjiPfLd79tcI6.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/zOpe0eHsq0A2NvNyBbtT6sj53qV.jpg","voteAverage":7.6,"voteCount":3264,"releaseDate":"2024-12-19","genres":["Acción","Ciencia ficción","Comedia","Familia"],"type":"movie","platforms":["$c"],"tmdbId":939243,"runtime":"$undefined","seasons":"$undefined"},{"id":1446616,"title":"El último depredador","originalTitle":"El último depredador","overview":"Un rapero de Nalasopara y una influencer del sur de Bombay ponen su relación a prueba cuando un monzón los deja atrapados con un cocodrilo letal.","posterPath":"https://image.tmdb.org/t/p/w500/25AyYjTWP5KfZMG680mxdaTF9Hx.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/zIOBTZAqGwdKnOb5c6SvzxP7x86.jpg","voteAverage":6.3,"voteCount":38,"releaseDate":"2026-02-11","genres":["Suspense","Romance"],"type":"movie","platforms":["$c"],"tmdbId":1446616,"runtime":"$undefined","seasons":"$undefined"},{"id":949,"title":"Heat","originalTitle":"Heat","overview":"Neil McCauley es un experto ladrón. Su filosofía consiste en vivir sin ataduras que puedan constituir un obstáculo, si las cosas se complican. Su banda la forman criminales profesionales tan cualificados que pueden impresionar incluso al detective Vincent Hanna. Pero Hannah vive tan obsesionado con su trabajo que llega incluso a poner en peligro su relación sentimental. Cuando la banda de McCauley prepara el golpe definitivo y el equipo de Hannah intenta evitarlo, cada uno de ellos comprende que tiene que vérselas con una de las mentes más brillantes a la que se ha enfrentado en su carrera.","posterPath":"https://image.tmdb.org/t/p/w500/kRfh1NCkDXGFrWzL6zDmVnHjRKh.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/xKsnZDERG1dk95wuZ5q9iks3OL3.jpg","voteAverage":7.9,"voteCount":8314,"releaseDate":"1995-12-15","genres":["Crimen","Drama","Acción"],"type":"movie","platforms":["$c"],"tmdbId":949,"runtime":"$undefined","seasons":"$undefined"},{"id":216015,"title":"Cincuenta sombras de Grey","originalTitle":"Cincuenta sombras de Grey","overview":"Cuando la estudiante de Literatura Anastasia Steele recibe el encargo de entrevistar al exitoso y joven empresario Christian Grey, queda impresionada al encontrarse ante un hombre atractivo, seductor y también muy intimidante. La inexperta e inocente Ana intenta olvidarle, pero pronto comprende cuánto le desea. Cuando la pareja por fin inicia una apasionada relación, Ana se sorprende por las peculiares prácticas eróticas de Grey, al tiempo que descubre los límites de sus propios y más oscuros deseos.","posterPath":"https://image.tmdb.org/t/p/w500/mNZcZOIlTwDKd30xLnRR4p0ZELg.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/7IGKrY1f1KfwMipx9wZC4NRgIdF.jpg","voteAverage":5.9,"voteCount":12364,"releaseDate":"2015-02-11","genres":["Drama","Romance","Suspense"],"type":"movie","platforms":["$c"],"tmdbId":216015,"runtime":"$undefined","seasons":"$undefined"},{"id":198663,"title":"El corredor del laberinto","originalTitle":"El corredor del laberinto","overview":"Thomas abre los ojos y se da cuenta que está en un ascensor. Lo extraño es que no recuerda nada, ni dónde está, ni quién es. Lo único que aún permanece intacto en su memoria es su nombre, y ya es mucho. Antes de que le dé tiempo a cuestionarse algo sobre sí mismo las puertas se abrirán y aparecerá ante él un extraño mundo. Todo lo que ve son chicos de su edad que tienen su mismo estado de amnesia. Una aventura fantástica que pronto destapará la dura realidad bajo ese velo de incertidumbre: todos ellos están atrapados en un laberinto. Si quieren tener alguna posibilidad de salir de allí y recuperar su antigua vida y aquello que no son capaces de recordar deberán unir fuerzas para escapar. Un mundo post-apocalíptico que les acorralará e irá un paso por delante será el desafío que tengan que pasar estos jóvenes por la libertad.","posterPath":"https://image.tmdb.org/t/p/w500/egKi4jZKKVZzR8NaaNjEwMpEgHs.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/eTlcNXGv32zkVI7ZDHhfeaKHXKQ.jpg","voteAverage":7.2,"voteCount":18067,"releaseDate":"2014-09-10","genres":["Acción","Misterio","Ciencia ficción","Suspense"],"type":"movie","platforms":["$c"],"tmdbId":198663,"runtime":"$undefined","seasons":"$undefined"},{"id":337167,"title":"Cincuenta sombras liberadas","originalTitle":"Cincuenta sombras liberadas","overview":"Creyendo que han dejado atrás las sombras del pasado, Christian y Anastasia disfrutan de su relación y de su vida llena de lujos. Pero justo cuando Ana empieza a relajarse, aparecen nuevas amenazas que ponen en riesgo su felicidad.","posterPath":"https://image.tmdb.org/t/p/w500/sM8hwgWZlmZf0h4aOkNopb3HBIo.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/9ywA15OAiwjSTvg3cBs9B7kOCBF.jpg","voteAverage":6.7,"voteCount":8338,"releaseDate":"2018-01-17","genres":["Drama","Romance"],"type":"movie","platforms":["$c"],"tmdbId":337167,"runtime":"$undefined","seasons":"$undefined"},{"id":575265,"title":"Misión: Imposible - Sentencia final","originalTitle":"Misión: Imposible - Sentencia final","overview":"El agente Ethan Hunt continúa su misión de impedir que Gabriel controle el tecnológicamente omnipotente programa de IA conocido como \"the Entity\".","posterPath":"https://image.tmdb.org/t/p/w500/mKK7cVNg4mQmKl0Qry9fvr5AqP7.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/xPNDRM50a58uvv1il2GVZrtWjkZ.jpg","voteAverage":7.2,"voteCount":2785,"releaseDate":"2025-05-17","genres":["Acción","Suspense","Aventura"],"type":"movie","platforms":["$c"],"tmdbId":575265,"runtime":"$undefined","seasons":"$undefined"},{"id":429617,"title":"Spider-Man: Lejos de casa","originalTitle":"Spider-Man: Lejos de casa","overview":"Peter Parker decide irse junto a MJ, Ned y el resto de sus amigos a pasar unas vacaciones a Europa. Sin embargo, el plan de Parker por dejar de lado sus superpoderes durante unas semanas se ven truncados cuando Nick Fury contacta con él para solicitarle ayuda para frenar el ataque de unas criaturas elementales que están causando el caos en el continente. En ese momento, Parker vuelve a ponerse el traje de Spider-Man para cumplir con su labor.","posterPath":"https://image.tmdb.org/t/p/w500/o59zDVJDIehGcWZsMUGU5SN0V0D.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/34jW8LvjRplM8Pv06cBFDpLlenR.jpg","voteAverage":7.4,"voteCount":16918,"releaseDate":"2019-06-28","genres":["Acción","Aventura","Ciencia ficción"],"type":"movie","platforms":["$c"],"tmdbId":429617,"runtime":"$undefined","seasons":"$undefined"},{"id":16869,"title":"Malditos bastardos","originalTitle":"Malditos bastardos","overview":"Segunda Guerra Mundial. Durante la ocupación de Francia por los alemanes, Shosanna Dreyfus presencia la ejecución de su familia por orden del coronel nazi Hans Landa. Ella consigue huir a París, donde adopta una nueva identidad como propietaria de un cine. En otro lugar de Europa, el teniente Aldo Raine adiestra a un grupo de soldados judíos \"Los bastardos\" para atacar objetivos concretos. Los hombres de Raine y una actriz alemana, que trabaja para los aliados, deben llevar a cabo una misión que hará caer a los jefes del Tercer Reich. El destino quiere que todos se encuentren bajo la marquesina de un cine donde Shosanna espera para vengarse.","posterPath":"https://image.tmdb.org/t/p/w500/dqu7nUtKTLdpM7DaJvD4zcSXhn1.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/hwNtEmmugU5Yd7hpfprNWI0DGIn.jpg","voteAverage":8.2,"voteCount":24128,"releaseDate":"2009-08-02","genres":["Drama","Suspense","Bélica"],"type":"movie","platforms":["$c"],"tmdbId":16869,"runtime":"$undefined","seasons":"$undefined"},{"id":8966,"title":"Crepúsculo","originalTitle":"Crepúsculo","overview":"La joven Bella Swan siempre fue una chica muy diferente ya en sus años de niña en Phoenix. Cuando su madre se volvió a casar, la mandó a vivir con su padre, a la pequeña y lluviosa ciudad de Forks, Washington, una población sin ningún aliciente para Bella. Pero entonces conoce en el instituo al misterioso y atractivo Edward Cullen, un joven distinto a los demás que esconde un secreto...","posterPath":"https://image.tmdb.org/t/p/w500/40ollvfwHaVF85lkkg522SIl3Qc.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/weAYfu6FfrNxEDJ3xH1XpgQcqUv.jpg","voteAverage":6.3,"voteCount":14371,"releaseDate":"2008-11-20","genres":["Fantasía","Drama","Romance"],"type":"movie","platforms":["$c"],"tmdbId":8966,"runtime":"$undefined","seasons":"$undefined"},{"id":829560,"title":"365 días más","originalTitle":"365 días más","overview":"La relación de Laura y Massimo pende de un hilo mientras intentan superar los problemas de confianza y los celos, mientras que un tenaz Nacho trabaja para separarlos.","posterPath":"https://image.tmdb.org/t/p/w500/dvKpJZUxI1Rsgvrl8HHv62CpBBh.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/6cpRpfD3isvluFwXDGSiDVyibPJ.jpg","voteAverage":6.4,"voteCount":1314,"releaseDate":"2022-08-18","genres":["Romance","Drama"],"type":"movie","platforms":["$c"],"tmdbId":829560,"runtime":"$undefined","seasons":"$undefined"},{"id":9502,"title":"Kung Fu Panda","originalTitle":"Kung Fu Panda","overview":"El protagonista es un oso panda llamado Po, el más vago de todas las criaturas del Valle de la Paz. Con poderosos enemigos acercándose, la esperanza es depositada en una antigua profecía que dice que un héroe se alzará para salvarles. Voces originales de Jack Black, Angelina Jolie, Dustin Hoffman, Lucy Liu & Jackie Chan.","posterPath":"https://image.tmdb.org/t/p/w500/zcORJ8s9zsBjvKxP0k4FASQSjpf.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/qdthf9WrRDSaIkGVQGhhJ9pz1hn.jpg","voteAverage":7.3,"voteCount":12596,"releaseDate":"2008-06-04","genres":["Acción","Animación","Comedia","Familia"],"type":"movie","platforms":["$c"],"tmdbId":9502,"runtime":"$undefined","seasons":"$undefined"},{"id":111,"title":"El precio del poder","originalTitle":"El precio del poder","overview":"Un emigrante cubano frío y sanguinario, Tony Montana, llega de Cuba para instalarse en Miami, donde se propone hacerse con un nombre dentro del crimen organizado de Florida. Junto a su amigo, Manny Rivera, inicia una ascendente carrera delictiva.","posterPath":"https://image.tmdb.org/t/p/w500/iDABT5GD9OQmFiXM3wR0DJIxtkY.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/1qM2BYNE11Viby8ImC9LC00DgDr.jpg","voteAverage":8.2,"voteCount":12991,"releaseDate":"1983-12-09","genres":["Acción","Crimen","Drama"],"type":"movie","platforms":["$c"],"tmdbId":111,"runtime":"$undefined","seasons":"$undefined"},{"id":1291608,"title":"धुरंधर","originalTitle":"धुरंधर","overview":"Sin descripción disponible.","posterPath":"https://image.tmdb.org/t/p/w500/kOLkpkS2T4HAdA6J7uq4eipNTup.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/4DfxcN4w0FuYZHQ3JAHzpHWia1U.jpg","voteAverage":7.1,"voteCount":274,"releaseDate":"2025-12-05","genres":["Acción","Crimen","Suspense"],"type":"movie","platforms":["$c"],"tmdbId":1291608,"runtime":"$undefined","seasons":"$undefined"},{"id":953,"title":"Madagascar","originalTitle":"Madagascar","overview":"Cuenta la historia de cuatro divertidos animales del zoo de Central Park, Nueva York, (Alex el león, Marty la cebra, Gloria la hipopótamo y Melman la jirafa). Llevan toda su vida encerrados en cautividad sin poder experiemtnar el sabor de la libertad y se han propuesto idear un plan para salir de allí juntos. Un día, una serie de casualidades les llevan a lograr lo que tanto ansiaban y huyen de aquel lugar. Terminan en plena naturaleza, concretamente en la idílica isla de Madagascar. Allí descubrirán, a base de apasionantes aventuras, que la vida salvaje es muy diferente a lo que ellos pensaban y que vivir en libertad no es tan fácil como imaginaban.","posterPath":"https://image.tmdb.org/t/p/w500/zrV5GnfCcLWzyjrFgYTpjQPRMfl.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/tPaurpIUskVji5vwV0dhy9pq4Vs.jpg","voteAverage":6.9,"voteCount":11702,"releaseDate":"2005-05-25","genres":["Aventura","Animación","Comedia","Familia"],"type":"movie","platforms":["$c"],"tmdbId":953,"runtime":"$undefined","seasons":"$undefined"},{"id":38365,"title":"Niños grandes","originalTitle":"Niños grandes","overview":"Después de muchos años, su antiguo entrenador de basquet muere y cincos amigos deciden pasar un fin de semanas -ahora con sus respectivas familias- en la casa donde celebraron, antaño, el campeonato.","posterPath":"https://image.tmdb.org/t/p/w500/r1mDA1SLjw2yiYhhLiAjrd2Pt1l.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/kARonxQpuSZdFraTKlCThWOBCtu.jpg","voteAverage":6.4,"voteCount":6643,"releaseDate":"2010-06-24","genres":["Comedia"],"type":"movie","platforms":["$c"],"tmdbId":38365,"runtime":"$undefined","seasons":"$undefined"},{"id":823464,"title":"Godzilla y Kong: El nuevo imperio","originalTitle":"Godzilla y Kong: El nuevo imperio","overview":"Una aventura cinematográfica completamente nueva, que enfrentará al todopoderoso Kong y al temible Godzilla contra una colosal amenaza desconocida escondida dentro de nuestro mundo. La nueva y épica película profundizará en las historias de estos titanes, sus orígenes y los misterios de Isla Calavera y más allá, mientras descubre la batalla mítica que ayudó a forjar a estos seres extraordinarios y los unió a la humanidad para siempre.","posterPath":"https://image.tmdb.org/t/p/w500/2YqZ6IyFk7menirwziJvfoVvSOh.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/gvLG3Fnznkxl4SmYfcK8gUuqxM8.jpg","voteAverage":7.1,"voteCount":4651,"releaseDate":"2024-03-27","genres":["Acción","Aventura","Ciencia ficción"],"type":"movie","platforms":["$c"],"tmdbId":823464,"runtime":"$undefined","seasons":"$undefined"},{"id":228150,"title":"Corazones de acero","originalTitle":"Corazones de acero","overview":"Abril de 1945. Al mando del veterano sargento Wardaddy, un pelotón de cinco soldados americanos a bordo de un carro de combate -el Fury- ha de luchar contra un ejército nazi al borde de la desesperación, pues los alemanes saben que su derrota estaba ya cantada por aquel entonces.","posterPath":"https://image.tmdb.org/t/p/w500/kbtH5G8L8REzy72LkLmKYoBVaGv.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/95ckrV6wQgbffurAVmETQ5YKASL.jpg","voteAverage":7.5,"voteCount":12897,"releaseDate":"2014-10-15","genres":["Bélica","Drama","Acción"],"type":"movie","platforms":["$c"],"tmdbId":228150,"runtime":"$undefined","seasons":"$undefined"},{"id":1651233,"title":"El yerno","originalTitle":"El yerno","overview":"José Sánchez se convierte en una temible figura política tras una racha difícil. Pero esta vez, no serán suficientes ni su inconfundible bigote ni su lengua afilada.","posterPath":"https://image.tmdb.org/t/p/w500/2C6EUH0qSthnOM6wtjS7ZRCdVZU.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/hGgXH6s3klnWW3x2cbQYlrSVg0U.jpg","voteAverage":5.1,"voteCount":8,"releaseDate":"2026-04-18","genres":["Comedia","Drama"],"type":"movie","platforms":["$c"],"tmdbId":1651233,"runtime":"$undefined","seasons":"$undefined"},{"id":50619,"title":"La saga Crepúsculo: Amanecer - Parte 1","originalTitle":"La saga Crepúsculo: Amanecer - Parte 1","overview":"El amor que Edward y Bella sienten el uno por el otro se sella con la celebración de una gran ceremonia organizada por Alice. Durante la luna de miel, los recién casados tienen relaciones sexuales y Bella queda embarazada. El rápido crecimiento del feto, mitad humano mitad vampiro, afecta gravemente a su salud, llevándola al borde de la muerte...","posterPath":"https://image.tmdb.org/t/p/w500/27WlKKz9f3vMr6JvSf0LDBVdtaZ.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/hBwDYiOPwXHuwiYGP82ekFNSeBr.jpg","voteAverage":6.2,"voteCount":9254,"releaseDate":"2011-11-16","genres":["Aventura","Fantasía","Romance"],"type":"movie","platforms":["$c"],"tmdbId":50619,"runtime":"$undefined","seasons":"$undefined"},{"id":1659087,"title":"180","originalTitle":"180","overview":"Un inesperado incidente de tráfico deja a su hijo en estado crítico. El padre, enfurecido, se adentra en una oscura espiral de confusión emocional y venganza.","posterPath":"https://image.tmdb.org/t/p/w500/4nNuv41aosADsoQYYJDg7Y829YK.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/iQSXJs6RbTumcwxMjCedDoK99rx.jpg","voteAverage":5.7,"voteCount":98,"releaseDate":"2026-04-16","genres":["Suspense","Crimen","Drama","Película de TV"],"type":"movie","platforms":["$c"],"tmdbId":1659087,"runtime":"$undefined","seasons":"$undefined"},{"id":128,"title":"La princesa Mononoke","originalTitle":"La princesa Mononoke","overview":"Tras sufrir el ataque de un monstruoso jabalí maldito, el joven Ashitaka emprende el camino en busca de la cura que detenga la infección. Mientras, los humanos están acabando con los bosques y los dioses convertidos en temibles bestias hacen todo lo posible por protegerlo encabezados por Mononoke, una princesa guerrera. Ashikata deberá escoger bando y decidir si ayudar a los hombres o las deidades intentando detener la maldición de su herida que se extiende por su cuerpo sin cuartel.","posterPath":"https://image.tmdb.org/t/p/w500/xP466sdt19CPLVljpRwI7luEgFn.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/gl0jzn4BupSbL2qMVeqrjKkF9Js.jpg","voteAverage":8.3,"voteCount":8955,"releaseDate":"1997-07-12","genres":["Aventura","Fantasía","Animación"],"type":"movie","platforms":["$c"],"tmdbId":128,"runtime":"$undefined","seasons":"$undefined"},{"id":1662317,"title":"El choque","originalTitle":"El choque","overview":"Una joven se estrella con su coche contra un edificio y mata a su novio y a un amigo. En este documental, lo que parece un trágico accidente acaba en un caso de asesinato.","posterPath":"https://image.tmdb.org/t/p/w500/mTN9baARVvqjS8ZuMUQeFBW6z2l.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/2iqLoDsatVBwAvHTEzI71p3qBe9.jpg","voteAverage":6.4,"voteCount":10,"releaseDate":"2026-05-15","genres":["Documental","Crimen"],"type":"movie","platforms":["$c"],"tmdbId":1662317,"runtime":"$undefined","seasons":"$undefined"},{"id":6479,"title":"Soy leyenda","originalTitle":"Soy leyenda","overview":"Año 2012. Robert Neville es el último hombre vivo que hay sobre la Tierra, pero no está solo. Los demás seres humanos se han convertido en unos mutantes nocturnos llamados \"Darkseekers\" y todos ansían beber su sangre. Durante el día vive en estado de alerta, como un cazador, y busca a los muertos vivientes mientras duermen; pero durante la noche debe esconderse de ellos y esperar el amanecer. Esta pesadilla empezó hace tres años: Neville era un brillante científico, pero no pudo impedir la expansión de un terrible virus creado por el hombre. Él ha sobrevivido porque es inmune al virus; todos los días envía mensajes por radio con la esperanza de que haya otros supervivientes, pero es inútil. Lo único que puede hacer es buscar una fórmula que le permita utilizar su sangre inmune para devolverles a los hombres su naturaleza. Pero está en inferioridad de condiciones y el tiempo se acaba.","posterPath":"https://image.tmdb.org/t/p/w500/pO1SrJgf5BumqcIRkYviSGIFdmX.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/aTLq0TMKdsmIy1ZyFM1LfPs326d.jpg","voteAverage":7.2,"voteCount":16803,"releaseDate":"2007-12-12","genres":["Drama","Ciencia ficción","Suspense"],"type":"movie","platforms":["$c"],"tmdbId":6479,"runtime":"$undefined","seasons":"$undefined"},{"id":829557,"title":"365 días: Aquel día","originalTitle":"365 días: Aquel día","overview":"Laura y Massimo vuelven más fuertes que nunca, pero las ataduras familiares de Massimo y un misterioso hombre que quiere conquistar a Laura complican su relación.","posterPath":"https://image.tmdb.org/t/p/w500/k3J2GdYxhR6U2RfsHZOsmHVKW7m.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/zBG5Mg29NH9xxpWMMG7BIvKwYhL.jpg","voteAverage":5.9,"voteCount":1843,"releaseDate":"2022-04-26","genres":["Romance","Drama"],"type":"movie","platforms":["$c"],"tmdbId":829557,"runtime":"$undefined","seasons":"$undefined"},{"id":1620034,"title":"Marty, Life Is Short: El documental","originalTitle":"Marty, Life Is Short: El documental","overview":"Martin Short repasa toda una vida llena de alegría en este documental con clips clásicos, entrevistas recientes y vídeos caseros inéditos repletos de celebridades.","posterPath":"https://image.tmdb.org/t/p/w500/z4QdUukg4FnbcwM6qeP6ZCoQZhf.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/vate7k6MyLQDeFYkHqCrLhRes6m.jpg","voteAverage":8.4,"voteCount":8,"releaseDate":"2026-05-11","genres":["Documental"],"type":"movie","platforms":["$c"],"tmdbId":1620034,"runtime":"$undefined","seasons":"$undefined"},{"id":272,"title":"Batman Begins","originalTitle":"Batman Begins","overview":"¿Cómo cambia un hombre el mundo? Es una pregunta que obsesiona a Bruce Wayne al igual que el fantasma de sus padres, muertos a tiros ante sus ojos en las calles de Gotham una noche que cambió su vida para siempre. Atormentado por la culpa y la ira, el desilusionado heredero industrial desaparece de Gotham y viaja en secreto por el mundo, buscando los medios de luchar contra la injusticia y utilizar el miedo contra los que se aprovechan de los que tienen miedo. Con la ayuda de su leal mayordomo Alfred, el detective Jim Gordon - uno de los pocos buenos policías de las fuerzas del orden público de Gotham - y Lucius Fox, su aliado en la división de Ciencias Aplicadas de Wayne Enterprises, Bruce Wayne libera a su imponente alter ego: Batman, un justiciero enmascarado que utiliza la fuerza, la inteligencia y un despliegue de artefactos de alta tecnología para combatir las fuerzas siniestras que amenazan con destruir la ciudad.","posterPath":"https://image.tmdb.org/t/p/w500/6yMWU1vWkOBbNRIwOxhetd2aHhO.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/9IIBboV7MCT0bTxzXHmWK1Hq558.jpg","voteAverage":7.7,"voteCount":22556,"releaseDate":"2005-06-10","genres":["Drama","Crimen","Acción"],"type":"movie","platforms":["$c"],"tmdbId":272,"runtime":"$undefined","seasons":"$undefined"},{"id":19404,"title":"Un amor contra viento y marea","originalTitle":"Un amor contra viento y marea","overview":"Los Singh son una familia india con grandes convicciones culturales de su nación de origen, que emigraron a Reino Unido antes de nacer sus primeros hijos. Uno de ellos querrá casarse con una mujer ajena a su cultura y para ello deberá hacer todos los esfuerzos por convencer a su familia.","posterPath":"https://image.tmdb.org/t/p/w500/2CAL2433ZeIihfX1Hb2139CX0pW.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/6N5d02quKqMKqvTpOdFmBDy9scY.jpg","voteAverage":8.5,"voteCount":4588,"releaseDate":"1995-10-20","genres":["Comedia","Drama","Romance"],"type":"movie","platforms":["$c"],"tmdbId":19404,"runtime":"$undefined","seasons":"$undefined"},{"id":137113,"title":"Al filo del mañana","originalTitle":"Al filo del mañana","overview":"En un futuro no muy lejano, invade la Tierra una raza de extraterrestres invencibles. Al comandante William Cage, un oficial que nunca ha entrado en combate, le encargan una misión casi suicida y resulta muerto. Entra entonces en un bucle temporal, en el que se ve obligado a luchar y morir una y otra vez. Pero las múltiples batallas que libra lo hacen cada vez más hábil y eficaz en su lucha contra los alienígenas. Su compañera de combate es Rita Vrataski, una guerrera de las Fuerzas Especiales. Adaptación del manga de Hiroshi Sakurazaka.","posterPath":"https://image.tmdb.org/t/p/w500/vNjwi0STOwzmwE9laZSMYYh2JPE.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/4V1yIoAKPMRQwGBaSses8Bp2nsi.jpg","voteAverage":7.6,"voteCount":15024,"releaseDate":"2014-05-27","genres":["Acción","Ciencia ficción"],"type":"movie","platforms":["$c"],"tmdbId":137113,"runtime":"$undefined","seasons":"$undefined"},{"id":82702,"title":"Cómo entrenar a tu dragón 2","originalTitle":"Cómo entrenar a tu dragón 2","overview":"Han pasado cinco años desde que Hipo empezó a entrenar a su dragón, rompiendo la tradición vikinga de cazarlos. Astrid y el resto de la pandilla han conseguido difundir en la isla un nuevo deporte: las carreras de dragones. Mientras realizan una carrera, atraviesan los cielos llegando a territorios inhóspitos, donde nadie antes ha estado. Durante un viaje descubren una cueva cubierta de hielo que resulta ser el refugio de cientos de dragones salvajes, a los que cuida un misterioso guardián. Hipo y los suyos se unen al guardián para proteger a los dragones de las fuerzas malignas que quieren acabar con ellos.","posterPath":"https://image.tmdb.org/t/p/w500/bXcRw7FL8QzUZOvY2fZdwDv5ymQ.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/8AAuJtCzaibYkbE0QVHc8EBsELB.jpg","voteAverage":7.7,"voteCount":10416,"releaseDate":"2014-06-05","genres":["Fantasía","Acción","Aventura","Animación","Familia"],"type":"movie","platforms":["$c"],"tmdbId":82702,"runtime":"$undefined","seasons":"$undefined"},{"id":664413,"title":"365 días","originalTitle":"365 días","overview":"Massimo es miembro de la mafia siciliana y Laura es una directora de ventas. Ella no espera que un viaje a Sicilia salve su relación, pero Massimo la secuestrará durante 365 días para que se enamore de él.","posterPath":"https://image.tmdb.org/t/p/w500/jz8T3hrU6GuMqSuQ4Rbd4MJUeaq.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/29mZ5bR5m2w3xuvwJH7BHMFQQwH.jpg","voteAverage":7,"voteCount":9498,"releaseDate":"2020-02-07","genres":["Romance","Drama"],"type":"movie","platforms":["$c"],"tmdbId":664413,"runtime":"$undefined","seasons":"$undefined"},{"id":786892,"title":"Furiosa: De la saga Mad Max","originalTitle":"Furiosa: De la saga Mad Max","overview":"En un mundo postapocalíptico donde todo ha perdido su valor, los pocos supervivientes se guían por la ley del más fuerte. Sin aprecio por la vida, lo único que despierta un brutal interés es la gasolina, sinónimo de poder y objetivo de bandas armadas hasta los dientes y sin escrúpulos. En este contexto conoceremos la  historia de la arrebatadoramente despiadada, salvaje y joven Furiosa, quien cae en manos de una horda de motoristas y debe sobrevivir a muchas pruebas mientras reúne los medios para encontrar el camino de vuelta a casa. Precuela de 'Mad Max: Furia en la carretera' (2015).","posterPath":"https://image.tmdb.org/t/p/w500/tGHUlykWn9V2IIQ4ZaATIAq9VLB.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/raph7qjAGTMXaIjVxt6ZDSXRzUr.jpg","voteAverage":7.5,"voteCount":4850,"releaseDate":"2024-05-22","genres":["Acción","Ciencia ficción","Aventura"],"type":"movie","platforms":["$c"],"tmdbId":786892,"runtime":"$undefined","seasons":"$undefined"},{"id":335,"title":"Hasta que llegó su hora","originalTitle":"Hasta que llegó su hora","overview":"Mientras los constructores del ferrocarril avanzan imparables por el desierto de Arizona en su camino hacia el mar, Jill llega al pequeño pueblo de Flagstone con la intención de empezar una nueva vida.","posterPath":"https://image.tmdb.org/t/p/w500/upiek8u4rHTrOJW9B0woXe4A4h7.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/h31SOVlekuHXsMWVGxI8nPPfY82.jpg","voteAverage":8.3,"voteCount":4884,"releaseDate":"1968-12-21","genres":["Drama","Western"],"type":"movie","platforms":["$c"],"tmdbId":335,"runtime":"$undefined","seasons":"$undefined"},{"id":1339876,"title":"La mujer policia 3","originalTitle":"La mujer policia 3","overview":"Es una carrera contra el tiempo y no habrá piedad. Shivani Shivaji Roy regresa para rescatar a las chicas que desaparecen sin dejar rastro.","posterPath":"https://image.tmdb.org/t/p/w500/o9aV83ZxGafGseLK8us9QNKKWzG.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/pfcyWSaPKGagqdunfBXQYCqZHxx.jpg","voteAverage":7.4,"voteCount":29,"releaseDate":"2026-01-30","genres":["Acción","Crimen","Suspense"],"type":"movie","platforms":["$c"],"tmdbId":1339876,"runtime":"$undefined","seasons":"$undefined"},{"id":640,"title":"Atrápame si puedes","originalTitle":"Atrápame si puedes","overview":"Frank Abagnale Jr. trabajó como médico, abogado y copiloto de una de las grandes líneas aéreas, todo ello antes de cumplir los dieciocho años. También fue un genial falsificador y sus habilidades le otorgaron una plaza en la historia. A la edad de 17 años, Frank Abagnale Jr. se convirtió en el ladrón de bancos de más éxito en la historia de Estados Unidos. El agente del FBI Carl Hanratty dedicó la mayor parte de su tiempo a perseguir a Frank para llevarle ante la justicia, pero Frank siempre estaba un paso por delante, retándole a continuar la caza.","posterPath":"https://image.tmdb.org/t/p/w500/wcWi3xIEzIjDERTZyWoqryQGURA.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/ggC3Brchf4RqPitEh7cROFoeAWn.jpg","voteAverage":8,"voteCount":17054,"releaseDate":"2002-12-16","genres":["Drama","Crimen"],"type":"movie","platforms":["$c"],"tmdbId":640,"runtime":"$undefined","seasons":"$undefined"},{"id":2109,"title":"Hora punta","originalTitle":"Hora punta","overview":"Dos detectives diferentes son asignados en un mismo caso. Ambos tendrán que adaptarse a las costumbres del otro para poder concluir su trabajo con éxito, pero no va a ser una tarea fácil. El detective inspector Lee es el rey de las artes marciales y pertenece a la Royal Hong Kong Police. Su pupila preferida es la hija de once años del Cónsul chino, de la cual el inspector Lee es su guardaespaldas y su mejor amigo. Esta muchacha es capturada y llevada a los Estados Unidos por un peligroso grupo criminal. Hasta allí tendrá que viajar el inspector y, donde se unirá a la investigación con un departamento del FBI y, concretamente, al detective James Carter, un arrogante e impulsivo agente de policía. La explosiva pareja tendrá que enfrentarse a una banda de criminales muy peligrosa, y contarán con la ayuda de Tania Johnson, una experta en artefactos explosivos.","posterPath":"https://image.tmdb.org/t/p/w500/wQjBF386gMhiaQucVWwQYdtJ22s.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/9FrpAtF87VKblKkDEiIZzYgO40K.jpg","voteAverage":7.1,"voteCount":5635,"releaseDate":"1998-09-18","genres":["Acción","Comedia","Crimen"],"type":"movie","platforms":["$c"],"tmdbId":2109,"runtime":"$undefined","seasons":"$undefined"},{"id":1658982,"title":"The Roast of Kevin Hart","originalTitle":"The Roast of Kevin Hart","overview":"Kevin Hart se pone en la diana y se prepara para lo que venga en una noche de humor sin censura y sin piedad con Shane Gillis y un grupo de cómicos de primer nivel.","posterPath":"https://image.tmdb.org/t/p/w500/oOHRYG7LD2wPSPIvBn4MWdyVnbv.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/bDwOkqwRFDoGxUzyIe6KUSmye5e.jpg","voteAverage":6.9,"voteCount":13,"releaseDate":"2026-05-10","genres":["Comedia"],"type":"movie","platforms":["$c"],"tmdbId":1658982,"runtime":"$undefined","seasons":"$undefined"},{"id":19994,"title":"Jennifer's Body","originalTitle":"Jennifer's Body","overview":"Devil's Kettle es una pequeña ciudad de los Estados Unidos, donde Jennifer y Needy son amigas desde la infancia y viven juntas. Un día, las chicas van a un bar donde toca un nuevo grupo de rock, y allí se produce un inesperado accidente. Tras provocarse un gran incendio, muchos de los asistentes no consiguen sobrevivir, pero las chicas logran escapar. A partir de entonces, Jennifer será poseída por unas fuerzas malévolas que la impulsarán a cometer asesinatos... principalmente a aquellos que intenten seducirla.","posterPath":"https://image.tmdb.org/t/p/w500/5zjIlFApSZGCJvw88hNJfui7AgU.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/rNvn89IcEJPqRKxIgwTAPXl9qjJ.jpg","voteAverage":6,"voteCount":4219,"releaseDate":"2009-09-18","genres":["Terror","Comedia"],"type":"movie","platforms":["$c"],"tmdbId":19994,"runtime":"$undefined","seasons":"$undefined"},{"id":50620,"title":"La saga Crepúsculo: Amanecer - Parte 2","originalTitle":"La saga Crepúsculo: Amanecer - Parte 2","overview":"Bella concluye su transformación en vampiro y ahora debe familiarizarse con su nueva condición. Con el nacimiento de Renesmee, la familia Cullen deberá protegerse ante la amenaza de los Volturi ya que existe una ley para los vampiros que prohíbe a todos los clanes convertir a niños, pues son difíciles de controlar y pueden generar auténticas masacres que pongan en peligro la secreta existencia de los vampiros... Segunda parte de la adaptación de \"Amanecer\" que supone la quinta entrega de la franquicia cinematográfica Crepúsculo, basada en las novelas de Stephenie Meyer.","posterPath":"https://image.tmdb.org/t/p/w500/pPB3rQx0oBOmj5CHZxLWgexo5nS.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/qkl57wzSFrpi2sRpoc2mZJbMuLP.jpg","voteAverage":6.5,"voteCount":9362,"releaseDate":"2012-11-13","genres":["Fantasía","Drama","Romance"],"type":"movie","platforms":["$c"],"tmdbId":50620,"runtime":"$undefined","seasons":"$undefined"},{"id":466272,"title":"Érase una vez en… Hollywood","originalTitle":"Érase una vez en… Hollywood","overview":"Los Angeles, 1969. La estrella de televisión Rick Dalton, un actor en horas bajas especializado en westerns, y el doble de acción Cliff Booth, su mejor amigo, tratan de sobrevivir a una industria cinematográfica en constante cambio. Dalton es vecino de la joven y prometedora actriz y modelo Sharon Tate, que acaba de casarse con el prestigioso director polaco Roman Polanski…","posterPath":"https://image.tmdb.org/t/p/w500/vKSyaptSA7zZ9H8mSfaDnvyQl9k.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/kKTPv9LKKs5L3oO1y5FNObxAPWI.jpg","voteAverage":7.4,"voteCount":14807,"releaseDate":"2019-07-24","genres":["Comedia","Drama","Suspense"],"type":"movie","platforms":["$c"],"tmdbId":466272,"runtime":"$undefined","seasons":"$undefined"},{"id":572802,"title":"Aquaman y el reino perdido","originalTitle":"Aquaman y el reino perdido","overview":"Al no poder derrotar a Aquaman la primera vez, Black Manta, todavía impulsado por la necesidad de vengar la muerte de su padre, no se detendrá ante nada para derrotar a Aquaman de una vez por todas. Esta vez Black Manta es más formidable que nunca y ejerce el poder del mítico Tridente Negro, que desata una fuerza antigua y malévola.  Para derrotarlo, Aquaman recurrirá a su hermano encarcelado Orm, el ex rey de la Atlántida, para forjar una alianza improbable. Juntos, deben dejar de lado sus diferencias para proteger su reino y salvar a la familia de Aquaman, y al mundo, de una destrucción irreversible.","posterPath":"https://image.tmdb.org/t/p/w500/a0QwtpUNIKjOlNoOVmk7d2LFnQW.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/7S0bXv3BqCuPfImKRf5kkmBVYZR.jpg","voteAverage":6.5,"voteCount":3472,"releaseDate":"2023-12-20","genres":["Acción","Aventura","Fantasía"],"type":"movie","platforms":["$c"],"tmdbId":572802,"runtime":"$undefined","seasons":"$undefined"},{"id":333339,"title":"Ready Player One","originalTitle":"Ready Player One","overview":"Cuando el creador de una realidad virtual llamada OASIS muere, lanza un reto póstumo a todos sus usuarios para que busquen un huevo de pascua, que dará al que lo encuentre su fortuna y el control de su mundo.","posterPath":"https://image.tmdb.org/t/p/w500/2iuVrtC5IpwLtSFSgkIIIKLs0Zq.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/5a7lMDn3nAj2ByO0X1fg6BhUphR.jpg","voteAverage":7.6,"voteCount":16867,"releaseDate":"2018-03-28","genres":["Aventura","Acción","Ciencia ficción"],"type":"movie","platforms":["$c"],"tmdbId":333339,"runtime":"$undefined","seasons":"$undefined"},{"id":812583,"title":"Puñales por la espalda: De entre los muertos","originalTitle":"Puñales por la espalda: De entre los muertos","overview":"El detective Benoit Blanc se une a un joven y honesto sacerdote para investigar un crimen totalmente imposible en la iglesia de un pequeño pueblo con una oscura historia.","posterPath":"https://image.tmdb.org/t/p/w500/trGWfaYTkzkalkosXfxidpLum50.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/fiRDzpcJe7qz3yIR43hdXIE3NHv.jpg","voteAverage":7.2,"voteCount":2449,"releaseDate":"2025-11-26","genres":["Suspense","Misterio","Comedia"],"type":"movie","platforms":["$c"],"tmdbId":812583,"runtime":"$undefined","seasons":"$undefined"},{"id":558449,"title":"Gladiator II","originalTitle":"Gladiator II","overview":"Dieciséis años después de la muerte de Marco Aurelio, Roma está gobernada por los despiadados emperadores gemelos Geta y Caracalla. El nieto de Aurelio, Lucio Vero, vive bajo el seudónimo de Hanno con su esposa Arishat en el reino norteafricano de Numidia. El ejército romano dirigido por el general Acacio invade y conquista el reino, esclavizando a Lucio junto con otros supervivientes. Los esclavos son llevados a Ostia, donde Lucio es comprado por el maestro de cuadra Macrinus, que le promete la oportunidad de vengarse matando a Acacio si gana suficientes combates para llegar al Coliseo.","posterPath":"https://image.tmdb.org/t/p/w500/ckTXrwlr4cRVxpBFEZcEmDzrmea.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/tOqIwliWMovSIZ9DyvHcHI7p2im.jpg","voteAverage":6.6,"voteCount":4393,"releaseDate":"2024-11-13","genres":["Acción","Aventura","Drama"],"type":"movie","platforms":["$c"],"tmdbId":558449,"runtime":"$undefined","seasons":"$undefined"},{"id":198184,"title":"Chappie","originalTitle":"Chappie","overview":"En un futuro cercano, la policía mecanizada controla el crimen. Cuando un droide de la policía, Chappie, es robado y se le da una nueva programación, se convierte en el primer robot con la capacidad de pensar y sentir por sí mismo.","posterPath":"https://image.tmdb.org/t/p/w500/g2kVBpRljENCi8KskBi0tedK3UE.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/3pKIcv6KhUE35jsKnv3MylQ3OT2.jpg","voteAverage":6.8,"voteCount":8464,"releaseDate":"2015-03-04","genres":["Crimen","Acción","Ciencia ficción"],"type":"movie","platforms":["$c"],"tmdbId":198184,"runtime":"$undefined","seasons":"$undefined"},{"id":829487,"title":"Me llamo Agneta","originalTitle":"Me llamo Agneta","overview":"En busca de un nuevo comienzo, Agneta, desempleada, acepta un trabajo como ‘au pair’ en la Provenza que acaba convirtiéndose en una escapada y un despertar inesperado.","posterPath":"https://image.tmdb.org/t/p/w500/4D2Mj3oyCx9PsYl8GPv0O0rIprt.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/A3XP3vGg4DGDhEH75GnyyjsDDm1.jpg","voteAverage":7,"voteCount":24,"releaseDate":"2026-04-28","genres":["Comedia","Drama","Romance"],"type":"movie","platforms":["$c"],"tmdbId":829487,"runtime":"$undefined","seasons":"$undefined"},{"id":10191,"title":"Cómo entrenar a tu dragón","originalTitle":"Cómo entrenar a tu dragón","overview":"Ambientada en el mítico mundo de los rudos vikingos y los dragones salvajes, y basada en el libro infantil de Cressida Cowell, esta comedia de acción narra la historia de Hipo, un vikingo adolescente que no encaja exactamente en la antiquísima reputación de su tribu como cazadores de dragones. El mundo de Hipo se trastoca al encontrar a un dragón que le desafía a él y a sus compañeros vikingos, a ver el mundo desde un punto de vista totalmente diferente.","posterPath":"https://image.tmdb.org/t/p/w500/8ekxsUORMAsfmSc8GzHmG8gWPbp.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/59vDC1BuEQvti24OMr0ZvtAK6R1.jpg","voteAverage":7.9,"voteCount":14339,"releaseDate":"2010-03-18","genres":["Fantasía","Aventura","Animación","Familia"],"type":"movie","platforms":["$c"],"tmdbId":10191,"runtime":"$undefined","seasons":"$undefined"},{"id":546554,"title":"Puñales por la espalda","originalTitle":"Puñales por la espalda","overview":"Cuando el renombrado novelista de misterio Harlan Thrombey es encontrado muerto en su mansión justo después de su 85 cumpleaños, el inquisitivo y cortés detective Benoit Blanc es misteriosamente reclutado para investigar. Se moverá entre una red de pistas falsas y mentiras interesadas para tratar de descubrir la verdad tras la prematura muerte del escritor.","posterPath":"https://image.tmdb.org/t/p/w500/7scJ3fVmwdSpGG87wvxH3kk0RPc.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/4HWAQu28e2yaWrtupFPGFkdNU7V.jpg","voteAverage":7.8,"voteCount":13984,"releaseDate":"2019-11-27","genres":["Comedia","Crimen","Misterio"],"type":"movie","platforms":["$c"],"tmdbId":546554,"runtime":"$undefined","seasons":"$undefined"},{"id":940551,"title":"Migración. Un viaje patas arriba","originalTitle":"Migración. Un viaje patas arriba","overview":"La familia Mallard se ha quedado 'estancada'. Mientras papá Mack se siente realizado cuidando de su familia en su estanque de Nueva Inglaterra, mamá Pam se muere de ganas de vivir la vida y hacer descubrir a sus hijos –el adolescente Dax y la patita Gwen– el mundo en toda su amplitud. Después de que una familia de patos migratorios llegue a su estanque con maravillosas historias de lugares lejanos, Pam consigue convencer a Mack de que deben viajar a la tropical Jamaica pasando por Nueva York. Los Mallard emprenden el viaje hacia el sur para pasar el invierno, pero nada sale como estaba previsto. La experiencia les ayudará a descubrir horizontes desconocidos, a hacer nuevos amigos, a vivir experiencias que jamás imaginaron, y de paso, a conocerse mejor.","posterPath":"https://image.tmdb.org/t/p/w500/diEeiB2DmZZadHISkg24RO2n0rT.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/gklkxY0veMajdCiGe6ggsh07VG2.jpg","voteAverage":7.4,"voteCount":2234,"releaseDate":"2023-12-06","genres":["Familia","Comedia","Aventura","Animación"],"type":"movie","platforms":["$c"],"tmdbId":940551,"runtime":"$undefined","seasons":"$undefined"},{"id":331482,"title":"Mujercitas","originalTitle":"Mujercitas","overview":"Amy, Jo, Beth y Meg son cuatro hermanas adolescentes que se embarcan en unas vacaciones con su madre, pero sin su padre, un evangelista itinerante. A medida que atraviesan el estado de Massachusetts, sumido en plena Guerra Civil, descubren el amor y la importancia de los lazos familiares.","posterPath":"https://image.tmdb.org/t/p/w500/z2wBWFEQ9FE0RcjmWXz3vvSNPfT.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/lqxxwTRk0l7CubY6JkJdhnwJEkn.jpg","voteAverage":7.9,"voteCount":6821,"releaseDate":"2019-12-25","genres":["Drama","Romance"],"type":"movie","platforms":["$c"],"tmdbId":331482,"runtime":"$undefined","seasons":"$undefined"},{"id":24,"title":"Kill Bill: Volumen 1","originalTitle":"Kill Bill: Volumen 1","overview":"Uma Thurman es una asesina que, el día de su boda, es atacada por los miembros de la banda de su jefe, Bill (David Carradine). Logra sobrevivir al ataque, aunque queda en coma. Cinco años después despierta con un trozo de metal en la cabeza y un gran deseo de venganza en su corazón.","posterPath":"https://image.tmdb.org/t/p/w500/j5HFN6ZbGqZepIQ7sZRX9dMu8uk.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/iffzIhuLAO38Po6sh1s6ZEVwlNL.jpg","voteAverage":8,"voteCount":18890,"releaseDate":"2003-10-10","genres":["Acción","Crimen"],"type":"movie","platforms":["$c"],"tmdbId":24,"runtime":"$undefined","seasons":"$undefined"},{"id":787699,"title":"Wonka","originalTitle":"Wonka","overview":"Basada en el personaje que protagoniza \"Charlie y la fábrica de chocolate\", el libro infantil más emblemático de Roald Dahl y uno de los más vendidos de todos los tiempos, \"Wonka\" cuenta la historia de cómo el mayor inventor, mago y chocolatero del mundo se convirtió en el querido Willy Wonka que conocemos hoy en día.","posterPath":"https://image.tmdb.org/t/p/w500/6eHcR7zwvNSvkOl9jbctU0lvZQ1.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/uIk2g2bRkNwNywKZIhC5oIU94Kh.jpg","voteAverage":7,"voteCount":4372,"releaseDate":"2023-12-06","genres":["Comedia","Familia","Fantasía"],"type":"movie","platforms":["$c"],"tmdbId":787699,"runtime":"$undefined","seasons":"$undefined"},{"id":1232889,"title":"Malta","originalTitle":"Malta","overview":"Mariana quiere irse lejos de Bogotá, lejos de su familia, pero sobre todo lejos de sí misma. Malta es un lugar por donde empezar. Antes de llegar allí tendrá que adentrarse en otros territorios.","posterPath":"https://image.tmdb.org/t/p/w500/pPaakmxnJl4hS4AMa1zc27KfD1b.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/smbez2rHwIeogYl88hXMtq8EPQE.jpg","voteAverage":5.4,"voteCount":8,"releaseDate":"2024-03-08","genres":["Drama","Ciencia ficción"],"type":"movie","platforms":["$c"],"tmdbId":1232889,"runtime":"$undefined","seasons":"$undefined"},{"id":9509,"title":"El fuego de la venganza","originalTitle":"El fuego de la venganza","overview":"México D.F. Un agente del gobierno decepcionado con su vida, acepta a regañadientes un trabajo que consiste en proteger a una niña cuyos padres han recibido amenazas de secuestro. La relación con su pequeña protegida irá creciendo hasta despertar en él un espíritu perdido. Pero cuando la niña es secuestrada, su rabia se desatará contra los responsables.","posterPath":"https://image.tmdb.org/t/p/w500/Nsl1f7qLoe3ZGbb5kvhQQWBRx3.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/6c7j7MQCczzNVvcrNEiXbs8Kt2p.jpg","voteAverage":7.5,"voteCount":5657,"releaseDate":"2004-04-23","genres":["Acción","Drama","Suspense"],"type":"movie","platforms":["$c"],"tmdbId":9509,"runtime":"$undefined","seasons":"$undefined"},{"id":1511057,"title":"Compañeras de cuarto","originalTitle":"Compañeras de cuarto","overview":"Cuando Devon, tímida y recién llegada a la uni, le pide a la popular Celeste compartir cuarto, su nueva amistad se convierte en una guerra de pasivoagresividad.","posterPath":"https://image.tmdb.org/t/p/w500/hHOBxFzUK2CHmQ5djuOneyHkptS.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/uYVxuLVZsxnJfXK03YgZSzqiWiQ.jpg","voteAverage":6.6,"voteCount":104,"releaseDate":"2026-04-13","genres":["Comedia"],"type":"movie","platforms":["$c"],"tmdbId":1511057,"runtime":"$undefined","seasons":"$undefined"},{"id":2501,"title":"The Bourne Identity: El caso Bourne","originalTitle":"The Bourne Identity: El caso Bourne","overview":"Un hombre amnésico es rescatado por la tripulación de un barco pesquero italiano cuando flota a la deriva en el mar. Carece de identidad y de pasado, pero posee unas serie de talentos extraordinarios en artes lingüísticas, marciales y de autodefensa que sugieren una profesión de riesgo. Confuso y desorientado, emprende una frenética búsqueda para descubrir quién es y por qué su vida ha tomado un giro tan peligroso.","posterPath":"https://image.tmdb.org/t/p/w500/yYH7sqMQ1NJNd6scW44D1WjBmAw.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/kJaRWmy1BGq3pHyE94LOTteiHer.jpg","voteAverage":7.5,"voteCount":10067,"releaseDate":"2002-06-14","genres":["Acción","Drama","Misterio","Suspense"],"type":"movie","platforms":["$c"],"tmdbId":2501,"runtime":"$undefined","seasons":"$undefined"},{"id":7485,"title":"Shooter: El tirador","originalTitle":"Shooter: El tirador","overview":"Bob Lee Swagger (Mark Whalberg) es un ex-tirador de élite del ejército de los Estados Unidos que abandona las fuerzas armadas después del fracaso de una misión extraoficial. Cuando le piden que se reincorpore, regresa al servicio a regañadientes, pero vuelven a engañarlo. A pesar de llevar dos balas en el cuerpo y de ser el objetivo de una caza a nivel nacional, Swagger planea su venganza...","posterPath":"https://image.tmdb.org/t/p/w500/regcyuwMtiDV2ZrfF9OWmS6h3aO.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/uy2trYgO8MOQfQXlvMaLhBnkUqg.jpg","voteAverage":7.1,"voteCount":5432,"releaseDate":"2007-03-22","genres":["Drama","Acción","Suspense"],"type":"movie","platforms":["$c"],"tmdbId":7485,"runtime":"$undefined","seasons":"$undefined"},{"id":38575,"title":"The Karate Kid","originalTitle":"The Karate Kid","overview":"Dre Parker podría haber sido el más popular en Detroit, pero la carrera profesional de su madre los lleva a ambos a China. Allí logra hacer conexión con su compañera de clase Mei Ying y el sentimiento es mutuo, hasta que las diferencias culturales hacen que su amistad sea imposible. Para que la situación empeore, Dre se consigue un enemigo, el peleonero de la clase, Cheng. Dre no tiene amigos a quién acudir, excepto el encargado de mantenimiento, el Sr. Han.","posterPath":"https://image.tmdb.org/t/p/w500/tHoASPhXRGJM6XFvDooJHIFcP3r.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/v8DepuF6gizphLzIyNZeQiB0hij.jpg","voteAverage":6.6,"voteCount":6541,"releaseDate":"2010-06-10","genres":["Acción","Aventura","Drama","Familia"],"type":"movie","platforms":["$c"],"tmdbId":38575,"runtime":"$undefined","seasons":"$undefined"},{"id":458156,"title":"John Wick: Capítulo 3 - Parabellum","originalTitle":"John Wick: Capítulo 3 - Parabellum","overview":"John Wick (Keanu Reeves) regresa a la acción, solo que esta vez con una recompensa de 14 millones de dólares sobre su cabeza y con un ejército de mercenarios intentando darle caza. Tras asesinar a uno de los miembros del gremio de asesinos al que pertenecía, Wick es expulsado de la organización, pasando a convertirse en el centro de atención de multitud de asesinos a sueldo que esperan detrás de cada esquina para tratar de deshacerse de él.","posterPath":"https://image.tmdb.org/t/p/w500/aKw7oqYdfn4pkKYvp18Gd1YhK6m.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/vVpEOvdxVBP2aV166j5Xlvb5Cdc.jpg","voteAverage":7.4,"voteCount":11696,"releaseDate":"2019-05-15","genres":["Acción","Suspense","Crimen"],"type":"movie","platforms":["$c"],"tmdbId":458156,"runtime":"$undefined","seasons":"$undefined"},{"id":1035259,"title":"Agárralo como puedas","originalTitle":"Agárralo como puedas","overview":"El torpe teniente Frank Drebin Jr. intenta resolver un asesinato vinculado a un magnate tecnológico. Mientras investiga, su unidad policial corre peligro de ser cerrada. Con la ayuda de una escritora de crímenes, Frank se verá envuelto en situaciones tan absurdas como explosivas. Película reboot basada en la popular franquicia de comedia \"Agárralo como puedas\" y la serie de televisión \"Police Squad!\".","posterPath":"https://image.tmdb.org/t/p/w500/v8FpKw8mOsHxC0YElkgNNSCzGMl.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/kzeBfhXMRWiykBsqoL3UbfaM0S.jpg","voteAverage":6.4,"voteCount":1690,"releaseDate":"2025-07-30","genres":["Acción","Comedia","Crimen"],"type":"movie","platforms":["$c"],"tmdbId":1035259,"runtime":"$undefined","seasons":"$undefined"},{"id":324552,"title":"John Wick: Pacto de sangre","originalTitle":"John Wick: Pacto de sangre","overview":"El legendario asesino John Wick (Keanu Reeves) se ve obligado a salir del retiro por un ex-asociado que planea obtener el control de un misterioso grupo internacional de asesinos. Obligado a ayudarlo por un juramento de sangre, John emprende un viaje a Roma lleno de adrenalina estremecedora para pelear contra los asesinos más peligrosos del mundo.","posterPath":"https://image.tmdb.org/t/p/w500/tAAikrL3kH3TopsDC2Bgo4ARUiP.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/r17jFHAemzcWPPtoO0UxjIX0xas.jpg","voteAverage":7.3,"voteCount":14221,"releaseDate":"2017-02-08","genres":["Acción","Suspense","Crimen"],"type":"movie","platforms":["$c"],"tmdbId":324552,"runtime":"$undefined","seasons":"$undefined"},{"id":8392,"title":"Mi vecino Totoro","originalTitle":"Mi vecino Totoro","overview":"Dos chicas jóvenes, Mei y Satsuki, se mudan a una nueva casa cerca del hospital en el que se encuentra su madre. En el patio junto a la casa, existe un gran árbol que es el hogar de tres Totoros, dioses de la selva. Poco después, reciben noticias desde el hospital de que su madre no puede venir a casa como había prometido, por lo que Mei (la más joven) se escapa para ir a visitarla. Satsuki tiene que recurrir a un Totoro para ayudar a encontrarla.","posterPath":"https://image.tmdb.org/t/p/w500/uu6RaEAfkIQaolf20axWaRU4h3w.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/6O1mOoTXuc1WqjKd2R7MFQHZ7Eb.jpg","voteAverage":8.1,"voteCount":8788,"releaseDate":"1988-04-16","genres":["Fantasía","Animación","Familia"],"type":"movie","platforms":["$c"],"tmdbId":8392,"runtime":"$undefined","seasons":"$undefined"},{"id":819,"title":"Sleepers","originalTitle":"Sleepers","overview":"Durante los años 60, la iglesia de los Santos Ángeles y su escuela eran el centro de la \"Cocina del Infierno\", un barrio marginal de Nueva York. Allí podían refugiarse los niños marginados. John, Lorenzo, Michael y Tommy son cuatro amigos que tratan de sobrevivir en un barrio de inmigrantes y cuya única guía moral es el padre Robert Carillo, un tipo criado en las calles que intenta que no se desvíen del buen camino. Sin embargo, tras una fechoria colectiva en la que casi muere un hombre, los cuatro muchachos son enviados al Hogar Wilkinson.","posterPath":"https://image.tmdb.org/t/p/w500/e0bzX1pK2STzUAYXnretiU9gkiq.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/sDhABATFQX8nfTHShTfH8HeqKY1.jpg","voteAverage":7.6,"voteCount":3856,"releaseDate":"1996-10-18","genres":["Crimen","Drama","Suspense"],"type":"movie","platforms":["$c"],"tmdbId":819,"runtime":"$undefined","seasons":"$undefined"},{"id":718930,"title":"Bullet Train","originalTitle":"Bullet Train","overview":"Cinco asesinos a sueldo se encuentran a bordo de un tren bala que viaja de Tokio a Morioka con unas pocas paradas intermedias. Descubren que sus misiones no son ajenas entre sí. La pregunta es quién saldrá vivo del tren y qué les espera en la estación final.","posterPath":"https://image.tmdb.org/t/p/w500/ybSIUt48PsM08F4UZwHdjL9ZVG2.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/y2Ca1neKke2mGPMaHzlCNDVZqsK.jpg","voteAverage":7.4,"voteCount":7496,"releaseDate":"2022-08-03","genres":["Acción","Comedia","Suspense"],"type":"movie","platforms":["$c"],"tmdbId":718930,"runtime":"$undefined","seasons":"$undefined"},{"id":615,"title":"La pasión de Cristo","originalTitle":"La pasión de Cristo","overview":"Año 33 de nuestra era. En la provincia romana de Judea, un misterioso carpintero llamado Jesús de Nazareth comienza a anunciar la llegada del \"reino de Dios\" y se rodea de un grupo de humildes pescadores: los Apóstoles. Durante siglos, el pueblo judío había esperado la llegada del Mesías - personaje providencial que liberaría su sagrada patria e instauraría un nuevo orden basado en la justicia-. Las enseñanzas de Jesús atraen a una gran multitud de seguidores que lo reconocen como el Mesías. Alarmado por la situación, el Sanedrín, con la ayuda de Judas Iscariote, uno de los doce Apóstoles, arresta a Jesús. Acusado de traición a Roma, Cristo es entregado a Poncio Pilato, quien, para evitar un motín, lo condena a a morir en la cruz como un vulgar criminal.","posterPath":"https://image.tmdb.org/t/p/w500/qPSyfz3yzTHXh1s8KRNy5YMNQJL.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/4840rkbpsiuow5ew155oVKcqJwj.jpg","voteAverage":7.5,"voteCount":5192,"releaseDate":"2004-02-25","genres":["Drama"],"type":"movie","platforms":["$c"],"tmdbId":615,"runtime":"$undefined","seasons":"$undefined"},{"id":245891,"title":"John Wick (Otro día para matar)","originalTitle":"John Wick (Otro día para matar)","overview":"John Wick es un antiguo asesino a sueldo de Nueva York que se había retirado de la profesión después de perder a su esposa. Pero, al descubrir la oscura trama que la mafia había planeado para acabar con él, arrebatándole lo que más quería, volverá a introducirse en el negocio, esta vez por su cuenta, para vengarse.","posterPath":"https://image.tmdb.org/t/p/w500/tDl5ac1VJwMRvlgINDCsDCqg9CE.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/ff2ti5DkA9UYLzyqhQfI2kZqEuh.jpg","voteAverage":7.5,"voteCount":20788,"releaseDate":"2014-10-22","genres":["Acción","Suspense"],"type":"movie","platforms":["$c"],"tmdbId":245891,"runtime":"$undefined","seasons":"$undefined"},{"id":5175,"title":"Hora punta 2","originalTitle":"Hora punta 2","overview":"El detective James Carter se encuentra de vacaciones en Hong Kong con su buen amigo el detective Lee. Mientras Carter está ansioso por dedicarse a la juerga y las mujeres, Lee tiene que enfrentarse con un jefe de las Tríadas, responsable del asesinato de dos funcionarios de la embajada norteamericana. Conforme avancen en la investigación, descubrirán una trama de distribución de billetes falsos.","posterPath":"https://image.tmdb.org/t/p/w500/no3uHLYK0lQyjXiIXIj82fgUsZX.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/vPJwn9pp5f58CqdaXU3eOSLoJkl.jpg","voteAverage":6.8,"voteCount":4580,"releaseDate":"2001-08-03","genres":["Acción","Comedia","Crimen"],"type":"movie","platforms":["$c"],"tmdbId":5175,"runtime":"$undefined","seasons":"$undefined"},{"id":1359,"title":"American Psycho","originalTitle":"American Psycho","overview":"En un mundo moralmente plano en el que la ropa tiene más sentido que la piel, Patrick Bateman es un espécimen soberbiamente elaborado que cumple todos los requisitos de Master del Universo, desde el diseño de su vestuario hasta el de sus productos químicos. Es prácticamente perfecto, como casi todos en su mundo e intenta desesperadamente encajar en él. Cuando más intenta ser como cualquier otro hombre adinerado de Wall Street, más anónimo se vuelve y menos control tiene sobre sus terribles instintos y su insaciable sed de sangre, que lo arrastra a una vorágine en la que los objetos valen más que el cuerpo y el alma de una persona.","posterPath":"https://image.tmdb.org/t/p/w500/ySPCri7VfAjbLLkMKs7Zjn6Njco.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/5oaMV2q0qzxkIW2ukU3lldLu5q2.jpg","voteAverage":7.4,"voteCount":12245,"releaseDate":"2000-04-13","genres":["Suspense","Drama","Crimen"],"type":"movie","platforms":["$c"],"tmdbId":1359,"runtime":"$undefined","seasons":"$undefined"},{"id":851644,"title":"Una chica del siglo XX","originalTitle":"Una chica del siglo XX","overview":"Yeon-du le pide a su mejor amiga Bora que recopile toda la información que pueda sobre Baek Hyun-jin mientras ella está en los Estados Unidos para someterse a una cirugía de corazón. Bora decide acercarse primero al mejor amigo de Baek, Pung Woon-ho. Sin embargo, el torpe plan de Bora se desarrolla en una dirección inesperada. En 1999, un año antes del nuevo siglo, Bora, que cumple diecisiete años, cae en la fiebre del primer amor.","posterPath":"https://image.tmdb.org/t/p/w500/4kU4QFgExCgybhcKv1mzZ0vuND6.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/37y53Jt8K6MvN6s4zJVFa61luO2.jpg","voteAverage":8.2,"voteCount":813,"releaseDate":"2022-10-06","genres":["Romance","Drama"],"type":"movie","platforms":["$c"],"tmdbId":851644,"runtime":"$undefined","seasons":"$undefined"},{"id":1239198,"title":"Mi querida señorita","originalTitle":"Mi querida señorita","overview":"Una joven de una familia tradicional descubre que es intersexual, lo que desencadena un viaje de autodescubrimiento, de identidad de género y de hallar el amor en lo inesperado.","posterPath":"https://image.tmdb.org/t/p/w500/3Od2J0JICLLMQfQAUbpCJg82HYg.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/u0FLlb0vKQLvKmiGE6nyhHODFWH.jpg","voteAverage":6.2,"voteCount":24,"releaseDate":"2026-04-17","genres":["Drama","Romance"],"type":"movie","platforms":["$c"],"tmdbId":1239198,"runtime":"$undefined","seasons":"$undefined"},{"id":281957,"title":"El renacido","originalTitle":"El renacido","overview":"Durante una expedición en las tierras salvajes americanas, el legendario explorador Hugh Glass es brutalmente atacado por un oso y dado por muerto por los miembros de su propia partida de caza. En su cruzada por sobrevivir, Glass supera inimaginables tribulaciones, además de la traición de su confidente John Fitzgerald. Guiado por la pura determinación y el amor de su familia, Glass deberá superar un duro invierno mientras busca sin descanso un motivo para seguir adelante y encontrar la redención.","posterPath":"https://image.tmdb.org/t/p/w500/k3Jh7J5GGMx1lmr7qmynRxOvOK5.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/mNQtUJv1F3u0uSKILFrGjIHqkxx.jpg","voteAverage":7.5,"voteCount":19276,"releaseDate":"2015-12-25","genres":["Western","Drama","Aventura"],"type":"movie","platforms":["$c"],"tmdbId":281957,"runtime":"$undefined","seasons":"$undefined"},{"id":1575337,"title":"La princesa Kaguya del cosmos","originalTitle":"La princesa Kaguya del cosmos","overview":"La vida de Iroha se sale de control cuando Kaguya, una despreocupada fugitiva de la Luna, se muda con ella y la convence para actuar juntas en un mundo virtual.","posterPath":"https://image.tmdb.org/t/p/w500/9YrbOSKoreS4oIjuwx9YjkAU8KP.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/1jdPUUSy37Wzw3xuc8otI86X2gv.jpg","voteAverage":8.3,"voteCount":80,"releaseDate":"2026-01-22","genres":["Animación","Fantasía","Música","Ciencia ficción"],"type":"movie","platforms":["$c"],"tmdbId":1575337,"runtime":"$undefined","seasons":"$undefined"},{"id":153518,"title":"Angry Birds: La película","originalTitle":"Angry Birds: La película","overview":"Basada en la colección de videojuegos \"Angry Birds\", la historia se desarrolla en una isla poblada por aves felices que no vuelan. En este paraíso, Red, un pájaro con muy mal genio, el veloz Chuck y el volátil Bomb nunca han terminado de encajar. Pero cuando llegan a la isla unos misteriosos cerdos verdes, serán estos tres marginados los que averigüen qué traman los extraños visitantes.","posterPath":"https://image.tmdb.org/t/p/w500/wHlxud7DzsolgvasBFt6gFHIUwP.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/l9jEItb8GRyhZfny92QeqpCeOu.jpg","voteAverage":6.3,"voteCount":3986,"releaseDate":"2016-05-11","genres":["Animación","Aventura","Comedia","Familia"],"type":"movie","platforms":["$c"],"tmdbId":153518,"runtime":"$undefined","seasons":"$undefined"},{"id":605,"title":"Matrix Revolutions","originalTitle":"Matrix Revolutions","overview":"Quedan veinte horas para la irrupción de las máquinas en Sión, el último bastión de los humanos libres. Mientras el cuerpo de Neo permanece en coma, su consciencia se encuentra en tierra de nadie, en un lugar entre el mundo humano y el de las máquinas.","posterPath":"https://image.tmdb.org/t/p/w500/zi1UMF9jIM2JnQz0u2AyUw8QFZi.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/kJYPag1YrA4PsXIftFdq3QEaanV.jpg","voteAverage":6.8,"voteCount":10783,"releaseDate":"2003-11-05","genres":["Aventura","Acción","Suspense","Ciencia ficción"],"type":"movie","platforms":["$c"],"tmdbId":605,"runtime":"$undefined","seasons":"$undefined"},{"id":120467,"title":"El gran hotel Budapest","originalTitle":"El gran hotel Budapest","overview":"El Sr. Gustave H., un legendario conserje de un famoso hotel europeo de entreguerras, entabla amistad con Zero Moustafa, un joven empleado al que convierte en su protegido. La historia trata sobre el robo y la recuperación de una pintura renacentista de valor incalculable y sobre la batalla que enfrenta a los miembros de una familia por una inmensa fortuna. Como telón de fondo, los levantamientos que transformaron Europa durante la primera mitad del siglo XX.","posterPath":"https://image.tmdb.org/t/p/w500/1wk0vpNCX5T40KsGQKjfoDAhmJw.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/9udCLTxTFl28RxnK8Q05E154ZGa.jpg","voteAverage":8,"voteCount":16056,"releaseDate":"2014-02-26","genres":["Comedia","Drama"],"type":"movie","platforms":["$c"],"tmdbId":120467,"runtime":"$undefined","seasons":"$undefined"},{"id":316029,"title":"El gran showman","originalTitle":"El gran showman","overview":"Biopic sobre Phineas Taylor Barnum (1810-1891), un empresario circense estadounidense que fundó el \"Ringling Bros. and Barnum & Bailey Circus\", conocido como \"el mayor espectáculo en la tierra\".","posterPath":"https://image.tmdb.org/t/p/w500/5HjkqEeLPubkMPM9TgV6kB3Iyn0.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/lrNKm3HNvGdZoAfiBKu7b04FLHN.jpg","voteAverage":7.9,"voteCount":10043,"releaseDate":"2017-12-20","genres":["Drama"],"type":"movie","platforms":["$c"],"tmdbId":316029,"runtime":"$undefined","seasons":"$undefined"},{"id":75656,"title":"Ahora me ves...","originalTitle":"Ahora me ves...","overview":"Un equipo del FBI debe enfrentarse a una banda de criminales expertos en magia. Ellos son 'los cuatro jinetes', un grupo formado por los mejores ilusionistas del mundo, dedicado a realizar grandes robos contra hombres de negocios corruptos. Su gran golpe es pasar desapercibidos para hacer llover el dinero robado a su público. En un mundo de magia y espectáculo, nada es lo que parece.","posterPath":"https://image.tmdb.org/t/p/w500/iN3fPrPLozgPDrHO1IILh1Cx0C3.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/xEY0MV2jSQBz9iOJfCFvLTiPGMA.jpg","voteAverage":7.3,"voteCount":16741,"releaseDate":"2013-05-29","genres":["Suspense","Crimen"],"type":"movie","platforms":["$c"],"tmdbId":75656,"runtime":"$undefined","seasons":"$undefined"},{"id":508883,"title":"El chico y la garza","originalTitle":"El chico y la garza","overview":"La película muestra el crecimiento psicológico de un adolescente a través de interacciones con sus amigos y su tío. Está basada en el libro de 1937 del mismo nombre escrito por Genzaburo Yoshino.","posterPath":"https://image.tmdb.org/t/p/w500/cUZop9T440Bx25P8Ptc0qXkLYEa.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/a0GM57AnJtNi7lMOCamniiyV10W.jpg","voteAverage":7.4,"voteCount":2624,"releaseDate":"2023-07-14","genres":["Animación","Fantasía","Drama"],"type":"movie","platforms":["$c"],"tmdbId":508883,"runtime":"$undefined","seasons":"$undefined"},{"id":299054,"title":"Los mercen4rios","originalTitle":"Los mercen4rios","overview":"Cuarta entrega de la saga Los Mercenarios. El veterano mercenario Barney “Esquizo” Ross (Sylvester Stallone) y su equipo de estrellas, formado por los hombres más duros (Jason Statham, Dolph Lundgren, 50 Cent, Megan Fox…), afrontan un nuevo desafío, en una trama cargada de acción. Para superarlo y salir airosos, deberán recurrir a su ingenio, experiencia y a la fuerza bruta que los caracteriza.","posterPath":"https://image.tmdb.org/t/p/w500/2qxRrkayxSYiib4JCYRM3sasQe0.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/rMvPXy8PUjj1o8o1pzgQbdNCsvj.jpg","voteAverage":6.1,"voteCount":1876,"releaseDate":"2023-09-15","genres":["Acción","Aventura","Suspense"],"type":"movie","platforms":["$c"],"tmdbId":299054,"runtime":"$undefined","seasons":"$undefined"},{"id":810693,"title":"Jujutsu Kaisen 0","originalTitle":"Jujutsu Kaisen 0","overview":"Yuta Okkotsu es un nervioso estudiante de instituto que sufre un grave problema: su amiga de la infancia Rika se ha convertido en una maldición y no le deja en paz. Como Rika no es una maldición cualquiera, su situación es percibida por Satoru Gojo, un profesor del instituto Jujutsu, una escuela donde los exorcistas noveles aprenden a combatir las maldiciones. Gojo convence a Yuta para que se matricule, pero ¿podrá aprender lo suficiente a tiempo para enfrentarse a la Maldición que le persigue?","posterPath":"https://image.tmdb.org/t/p/w500/2ndvx03fmREMxEgaZ1vWt756TOQ.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/rcEDPOOOUTLFxLLQJggfLffbofe.jpg","voteAverage":8.1,"voteCount":1731,"releaseDate":"2021-12-24","genres":["Animación","Acción","Fantasía"],"type":"movie","platforms":["$c"],"tmdbId":810693,"runtime":"$undefined","seasons":"$undefined"},{"id":1213898,"title":"Violencia en la frontera 2","originalTitle":"Violencia en la frontera 2","overview":"Jóvenes combatientes indios se prepararon para proteger su patria de una amenaza mayor durante la guerra indo-pakistaní de 1971.","posterPath":"https://image.tmdb.org/t/p/w500/bGMxbKjxzOUUnV0YCUYsNdV8db3.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/fzo85eKFEjfmJ781gubJQjpQAwF.jpg","voteAverage":7.2,"voteCount":25,"releaseDate":"2026-01-23","genres":["Acción","Drama","Bélica"],"type":"movie","platforms":["$c"],"tmdbId":1213898,"runtime":"$undefined","seasons":"$undefined"},{"id":140300,"title":"Kung Fu Panda 3","originalTitle":"Kung Fu Panda 3","overview":"Cuando el durante mucho tiempo perdido padre de Po aparece de repente, el dúo ya reunido viaja a un paraíso secreto de pandas para conocer a montones de nuevos e hilarantes osos. Pero cuando el villano sobrenatural Kai comienza a recorrer toda China venciendo a todos los maestros de kung fu, Po deberá hacer lo imposible: aprender a entrenar a una comunidad repleta de divertidos y torpes hermanos para formar el equipo definitivo de Kung Fu Pandas.","posterPath":"https://image.tmdb.org/t/p/w500/t11f8palNbICK9Ip5QLrUfhLJYq.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/s3FiHTdpQVpqIqdBxLLiy40wGut.jpg","voteAverage":6.9,"voteCount":6564,"releaseDate":"2016-01-23","genres":["Animación","Acción","Aventura","Comedia","Familia"],"type":"movie","platforms":["$c"],"tmdbId":140300,"runtime":"$undefined","seasons":"$undefined"},{"id":49444,"title":"Kung Fu Panda 2","originalTitle":"Kung Fu Panda 2","overview":"Po está ahora viviendo su sueño como el Guerrero del Dragón, protegiendo el Valle de la Paz junto a sus amigos y sus compañeros maestros del kung fu. Los Cinco Furiosos. Pero su nueva e impresionante vida se encuentra amenazada por la aparición de un villano formidable, que planea usar un arma secreta imparable para conquistar China y destruir el kung fu. Po debe volver la vista a su pasado para descubrir los secretos de su misterioso origen; solo entonces podrá adquirir la fuerza que necesita para vencer.","posterPath":"https://image.tmdb.org/t/p/w500/aNji9U9SPTecmoqGippQUBEyouy.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/7BdxZXbSkUiVeCRXKD3hi9KYeWm.jpg","voteAverage":7.1,"voteCount":7860,"releaseDate":"2011-05-25","genres":["Animación","Familia","Comedia","Acción"],"type":"movie","platforms":["$c"],"tmdbId":49444,"runtime":"$undefined","seasons":"$undefined"},{"id":1526650,"title":"El muñeco de arcilla","originalTitle":"El muñeco de arcilla","overview":"Mientras diseña un videojuego de terror, Hsu-Chuan se lleva por error a casa un muñeco de arcilla de la empresa, sin sospechar que alberga un espíritu vengativo que ansía liberarse.","posterPath":"https://image.tmdb.org/t/p/w500/zawpsRiy2GFeVsnvEmuJ9TKggIT.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/pmGkvEWKFDapogIzkG7TqB0aeYE.jpg","voteAverage":7.1,"voteCount":42,"releaseDate":"2025-10-09","genres":["Terror","Suspense"],"type":"movie","platforms":["$c"],"tmdbId":1526650,"runtime":"$undefined","seasons":"$undefined"},{"id":9757,"title":"Norbit","originalTitle":"Norbit","overview":"Norbit (Eddie Murphy) no ha tenido una vida fácil. De pequeño fue abandonado ante la puerta de un restaurante chino, que hacía las veces de orfanato, donde le crió el Sr. Wong (Eddie Murphy). Las cosas se ponen aún peor cuando se ve obligado a casarse con Rasputia (Eddie Murphy), la malvada y tragona reina de la comida basura. Cuando Norbit ya no puede más y está a punto de rendirse, reaparece Kate (Thandie Newton), su gran amor de infancia...","posterPath":"https://image.tmdb.org/t/p/w500/cCAeo4Yx2osjmj2YHNUyQmZJxdj.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/nMgQD51KzAqrt4F6iwxw5TetVLW.jpg","voteAverage":5.7,"voteCount":2589,"releaseDate":"2007-02-08","genres":["Comedia"],"type":"movie","platforms":["$c"],"tmdbId":9757,"runtime":"$undefined","seasons":"$undefined"},{"id":291805,"title":"Ahora me ves 2","originalTitle":"Ahora me ves 2","overview":"Un año después de despistar al FBI y conseguir la admiración del público con sus espectáculos mentales, los cuatro jinetes vuelven a la luz pública, pero un nuevo enemigo se propone arruinar su golpe más espectacular y peligroso hasta la fecha.","posterPath":"https://image.tmdb.org/t/p/w500/pjGt13AXXTLxvkmdF6SpA1feFOw.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/oFQilRMEq6yQbtMPxIYWpXeQ5ZN.jpg","voteAverage":6.8,"voteCount":11552,"releaseDate":"2016-06-02","genres":["Crimen","Suspense"],"type":"movie","platforms":["$c"],"tmdbId":291805,"runtime":"$undefined","seasons":"$undefined"},{"id":135397,"title":"Jurassic World","originalTitle":"Jurassic World","overview":"Veintidós años después de lo ocurrido en Jurassic Park, la isla Nublar ha sido transformada en un parque temático, Jurassic Wold, con versiones «domesticadas» de algunos de los dinosaurios más conocidos. Cuando todo parece ir a la perfección y ser el negocio del siglo, un nuevo dinosaurio de especie todavía desconocida y que es mucho más inteligente de lo que se pensaba, comienza a causar estragos entre los visitantes del Parque.","posterPath":"https://image.tmdb.org/t/p/w500/sOgfattHPWE5sWdVCGHQ08GEbaP.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/s5QfDFqRO6sjgPtKkjxD0WqXQef.jpg","voteAverage":6.7,"voteCount":21542,"releaseDate":"2015-06-06","genres":["Aventura","Ciencia ficción"],"type":"movie","platforms":["$c"],"tmdbId":135397,"runtime":"$undefined","seasons":"$undefined"},{"id":16859,"title":"Nicky, la aprendiz de bruja","originalTitle":"Nicky, la aprendiz de bruja","overview":"Nicky no es una niña como otra cualquiera porque es aprendiz de bruja. Con solo 13 años y por tradición del oficio que está aprendiendo, la niña tiene que abandonar la casa de sus padres y buscar algún sitio donde sean necesarios sus servicios de bruja. Para emprender el viaje, Nicky se acompaña de su amigo Jiji y también de su gato; juntos, y sobre una escoba voladora, los amigos se instalan en un pueblecito que da al mar, donde la niña empezará a conocerse verdaderamente a sí misma.","posterPath":"https://image.tmdb.org/t/p/w500/psw0tp25DNBkdEAfwjZYcgbpgme.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/h5pAEVma835u8xoE60kmLVopLct.jpg","voteAverage":7.8,"voteCount":4555,"releaseDate":"1989-07-29","genres":["Animación","Familia","Fantasía"],"type":"movie","platforms":["$c"],"tmdbId":16859,"runtime":"$undefined","seasons":"$undefined"},{"id":646380,"title":"No mires arriba","originalTitle":"No mires arriba","overview":"Dos astrónomos emprenden una gira mediática para avisar a la humanidad de un cometa que va a impactar con la Tierra. ¿Cuál es la respuesta de un mundo apático? «¡Bah!».","posterPath":"https://image.tmdb.org/t/p/w500/78olDfo1tQmI1OtyBPovWb98wLD.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/xMJvffWIaW9MtlY9aIXKViUNeIO.jpg","voteAverage":7.1,"voteCount":9318,"releaseDate":"2021-12-08","genres":["Comedia","Ciencia ficción","Drama"],"type":"movie","platforms":["$c"],"tmdbId":646380,"runtime":"$undefined","seasons":"$undefined"},{"id":51876,"title":"Sin límites","originalTitle":"Sin límites","overview":"Un escritor (Bradley Cooper), que sufre una crisis de creatividad, prueba un día una nueva droga que lo pone en condiciones de usar al máximo todas sus facultades mentales; es una especie de píldora inteligente gracias a la cual consigue triunfar en Nueva York. Un poderoso financiero de Wall Street (De Niro) siente una extraordinaria curiosidad por averiguar qué se esconde detrás de tanto éxito...","posterPath":"https://image.tmdb.org/t/p/w500/iwOyBV7B4Y7YQKc6ZOmmdEMhjyf.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/9V6Yq2ZVUmyAPcPyDcCBPnkluKF.jpg","voteAverage":7.2,"voteCount":11451,"releaseDate":"2011-03-17","genres":["Suspense","Misterio","Ciencia ficción"],"type":"movie","platforms":["$c"],"tmdbId":51876,"runtime":"$undefined","seasons":"$undefined"},{"id":18491,"title":"Neon Genesis Evangelion: The End of Evangelion","originalTitle":"Neon Genesis Evangelion: The End of Evangelion","overview":"Seele ordena un ataque sin cuartel contra NERV con el objetivo de destruir los Evas antes de que Gendo pueda provocar el Tercer Impacto y la unión de las almas humanas.","posterPath":"https://image.tmdb.org/t/p/w500/9jbxvKB937BWeYAmMKZTqPxBLsk.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/xLMJCCSatxENpHO9rLW9yD8A12C.jpg","voteAverage":8.3,"voteCount":1845,"releaseDate":"1997-07-19","genres":["Animación","Ciencia ficción","Drama","Fantasía"],"type":"movie","platforms":["$c"],"tmdbId":18491,"runtime":"$undefined","seasons":"$undefined"},{"id":353069,"title":"Feliz día de la madre","originalTitle":"Feliz día de la madre","overview":"Sandy (Jennifer Aniston) es una mujer recientemente divorciada que lucha por mantener la cordura cuando su ex se casa con una mujer más joven que ella; Miranda (Julia Roberts) es una presentadora estrella de una importante Cadena de TV cuya vida dará un vuelco cuando la hija que dió en adopción cuando era una adolescente venga en su búsqueda; Jesse (Kate Hudson) ama tanto a su marido que ha cortado toda relación con su racista madre sacándola de su vida completamente y ocultando a su marido debido a su raza; y Bradley (Jason Sudeikis) teme que llegue el Día de la Madre ya que será el primer año que él y sus dos hijas viven ese día desde que su esposa falleció.","posterPath":"https://image.tmdb.org/t/p/w500/5I427X5vl10xgnhweX0wEpT3KGt.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/3wRjFLgFbMcA05oIRD3jL58pBCm.jpg","voteAverage":6,"voteCount":1317,"releaseDate":"2016-04-28","genres":["Comedia","Drama","Romance"],"type":"movie","platforms":["$c"],"tmdbId":353069,"runtime":"$undefined","seasons":"$undefined"},{"id":1317920,"title":"ซองแดงแต่งผี","originalTitle":"ซองแดงแต่งผี","overview":"Sin descripción disponible.","posterPath":"https://image.tmdb.org/t/p/w500/sOxB9Cw5fooumk5EdJUgyW0YZhc.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/pV1tdlFgqEY8hDDZLXyvmd9cKPM.jpg","voteAverage":7.3,"voteCount":16,"releaseDate":"2025-03-20","genres":["Comedia"],"type":"movie","platforms":["$c"],"tmdbId":1317920,"runtime":"$undefined","seasons":"$undefined"},{"id":940721,"title":"Godzilla Minus One","originalTitle":"Godzilla Minus One","overview":"En el Japón de la posguerra, Godzilla trae una nueva devastación a un paisaje ya abrasado. Sin intervención militar ni ayuda gubernamental a la vista, los supervivientes deben unirse frente a la desesperación y luchar contra un horror implacable.","posterPath":"https://image.tmdb.org/t/p/w500/q35kdC8ci9Fm2gVQazJdsohtGpD.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/oHBhHoNe59VH6bUMazDtJmWOFSS.jpg","voteAverage":7.6,"voteCount":3153,"releaseDate":"2023-11-03","genres":["Ciencia ficción","Terror","Acción"],"type":"movie","platforms":["$c"],"tmdbId":940721,"runtime":"$undefined","seasons":"$undefined"},{"id":666277,"title":"Vidas pasadas","originalTitle":"Vidas pasadas","overview":"La familia de Nora emigra a Canadá cuando ella tiene 10 años. Pierde el contacto con su amor de la infancia. Muchos años después, cuando Nora está estudiando teatro en Nueva York, se reencuentra con él online.","posterPath":"https://image.tmdb.org/t/p/w500/jWrJrLMD7SZoxc65KSYej6QOw12.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/7HR38hMBl23lf38MAN63y4pKsHz.jpg","voteAverage":7.7,"voteCount":2305,"releaseDate":"2023-06-02","genres":["Drama","Romance"],"type":"movie","platforms":["$c"],"tmdbId":666277,"runtime":"$undefined","seasons":"$undefined"},{"id":184315,"title":"Hércules","originalTitle":"Hércules","overview":"Hércules, como todos los héroes griegos, es un semidios. Tras realizar los terribles doce trabajos que le fueron impuestos y tras perder a su familia, decide darle la espalda a los dioses y encontrar consuelo en la búsqueda de aventuras. Gracias a sus andanzas, ha encontrado hombres afines que se han unido a él, pues comparten su amor por el combate y no temen la presencia constante de la muerte en sus vidas. El rey de Tracia pretende que estos hombres formen un ejército invencible. Adaptación de la novela gráfica de 2008 \"Hercules: The Thracian War\".","posterPath":"https://image.tmdb.org/t/p/w500/2q9Ic0Q4vMcs2AbTE640fRuB0Qe.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/nl18gyzai02Tu99VkURu7kCFrR8.jpg","voteAverage":5.8,"voteCount":4334,"releaseDate":"2014-07-23","genres":["Acción","Aventura"],"type":"movie","platforms":["$c"],"tmdbId":184315,"runtime":"$undefined","seasons":"$undefined"},{"id":1472638,"title":"Buen Camino","originalTitle":"Buen Camino","overview":"Un padre abandona su zona de confort y recorre el Camino de Santiago en busca de su hija desaparecida. Su peregrinación trae ampollas, encuentros inesperados y autodescubrimiento.","posterPath":"https://image.tmdb.org/t/p/w500/xqnLxbA4Ak4kew3CrcFLTXksh4a.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/qo2VoL7vyDWKvUejikxrdIFUDIa.jpg","voteAverage":6.3,"voteCount":523,"releaseDate":"2025-12-25","genres":["Comedia","Familia","Aventura"],"type":"movie","platforms":["$c"],"tmdbId":1472638,"runtime":"$undefined","seasons":"$undefined"},{"id":24021,"title":"La saga Crepúsculo: Eclipse","originalTitle":"La saga Crepúsculo: Eclipse","overview":"En esta tercera entrega de la exitosa saga de vampiros de las novelas de Stephenie Meyer, Bella tendrá que elegir entre Edward y Jacob. La ciudad de Seattle es devastada por una serie de misteriosos asesinatos que va en aumento, mientras una vampiresa busca venganza. Bella debe escoger entre su amor por Edward y su amistad con Jacob, consciente de que su decisión puede iniciar una batalla entre vampiros y licántropos. Rodeada de peligro y con su graduación acercándose, ahora se enfrenta a la decisión más importante de su vida.","posterPath":"https://image.tmdb.org/t/p/w500/mckJPxNAQ51beBQw82evAa9a2Wd.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/oguoQWtQJcqIkmmUNbe3CmLx6AP.jpg","voteAverage":6.2,"voteCount":9236,"releaseDate":"2010-06-23","genres":["Aventura","Fantasía","Drama","Romance"],"type":"movie","platforms":["$c"],"tmdbId":24021,"runtime":"$undefined","seasons":"$undefined"},{"id":351286,"title":"Jurassic World: El reino caído","originalTitle":"Jurassic World: El reino caído","overview":"Tras cuatro años de abandono del complejo turístico Jurassic World, la isla Nublar sólo está habitada por los dinosaurios supervivientes. Cuando el volcán inactivo de la isla comienza a cobrar vida, Owen y Claire montan una campaña para rescatar a los dinosaurios restantes en la isla.","posterPath":"https://image.tmdb.org/t/p/w500/yHa2I7qxZvZUASLHrIR8vQLmZ4B.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/6WA9stUMbIkEPxn3D5SWlA8FIi7.jpg","voteAverage":6.5,"voteCount":12733,"releaseDate":"2018-06-06","genres":["Aventura","Ciencia ficción","Suspense"],"type":"movie","platforms":["$c"],"tmdbId":351286,"runtime":"$undefined","seasons":"$undefined"},{"id":22803,"title":"Un ciudadano ejemplar","originalTitle":"Un ciudadano ejemplar","overview":"Clyde Shelton es un ciudadano normal que lo ha perdido todo. Diez años antes su mujer y su hija fueron brutalmente asesinadas y los criminales nunca fueron condenados. El culpable es Nick Rice, el ambicioso ayudante del fiscal del distrito, porque hizo un pacto con el abogado de uno de ellos. Pero Clyde descubre ese acuerdo, y su deseo de venganza lo lleva a cometer una serie de asesinatos","posterPath":"https://image.tmdb.org/t/p/w500/iaY5L2gY60La8ImK7ll7QBXXk26.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/nazre7z7MoUwAqimnrSlMlfLR5t.jpg","voteAverage":7.4,"voteCount":5658,"releaseDate":"2009-10-15","genres":["Drama","Crimen","Suspense"],"type":"movie","platforms":["$c"],"tmdbId":22803,"runtime":"$undefined","seasons":"$undefined"},{"id":507089,"title":"Five Nights at Freddy's","originalTitle":"Five Nights at Freddy's","overview":"Un hombre comienza un trabajo como guardia de seguridad nocturno en el restaurante Freddy Fazbear's Pizza, donde descubre que los animatrónicos se mueven por la noche y matan a cualquiera que vean. Adaptación de la exitosa saga de videojuegos homónima creada en 2014 por Scott Cawthon.","posterPath":"https://image.tmdb.org/t/p/w500/t6RSJ1z8bDEYpk4fLwxfkXciUak.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/7NRGAtu8E4343NSKwhkgmVRDINw.jpg","voteAverage":7.3,"voteCount":5000,"releaseDate":"2023-10-25","genres":["Terror","Suspense"],"type":"movie","platforms":["$c"],"tmdbId":507089,"runtime":"$undefined","seasons":"$undefined"},{"id":818647,"title":"A través de mi ventana","originalTitle":"A través de mi ventana","overview":"Raquel lleva toda la vida loca por Ares, su atractivo y misterioso vecino. Lo observa sin ser vista y es que, muy a su pesar, no han intercambiado ni una palabra. Raquel tiene muy claro su objetivo: conseguir que Ares se enamore de ella. Pero ella no es una niña inocente y no está dispuesta a perderlo todo por el camino, y mucho menos a sí misma...","posterPath":"https://image.tmdb.org/t/p/w500/3F5MkMadQOWiZNVaNuOuw6UaK7a.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/4rsomWxlqnHt3muGYK06auhOib6.jpg","voteAverage":7.3,"voteCount":3338,"releaseDate":"2022-02-04","genres":["Romance","Drama","Comedia"],"type":"movie","platforms":["$c"],"tmdbId":818647,"runtime":"$undefined","seasons":"$undefined"},{"id":400535,"title":"Sicario: El día del soldado","originalTitle":"Sicario: El día del soldado","overview":"La guerra contra los cárteles de la droga se ha intensificado en la frontera entre Estados Unidos y México a medida que éstos se han metido en el negocio de tráfico de personas, introduciendo en suelo americano a terroristas islámicos. Para hacer frente a esta nueva guerra sucia, el agente federal Matt Graver planea una idea para que los carteles se enfrenten entre ellos. Para ello volverá a reclutar para la peligrosa misión al volátil mercenario Alejandro Gillick… Secuela de 'Sicario' (2015).","posterPath":"https://image.tmdb.org/t/p/w500/ySqkGvL7TS9U3u6rtaVZsd89wU5.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/13VjjUeJ6mcDUB36XRu4YFpYNSm.jpg","voteAverage":6.9,"voteCount":4026,"releaseDate":"2018-06-27","genres":["Acción","Crimen","Suspense"],"type":"movie","platforms":["$c"],"tmdbId":400535,"runtime":"$undefined","seasons":"$undefined"},{"id":49519,"title":"Los Croods","originalTitle":"Los Croods","overview":"La película está ambientada en la prehistoria, donde Crug lidera a su familia más allá de la comodidad de su hogar después de que este sea destruido por un gran terremoto. Mientras intentan viajar por el desconocido y aterrador mundo, se encuentran con un nómada que cautiva a su clan, en especial a su hermana mayor, con su mente moderna.","posterPath":"https://image.tmdb.org/t/p/w500/3X3qtBTgKt5mCB30RJwbIjgjzdw.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/wFN8llYh215M8i2fqWAcPV8CSyL.jpg","voteAverage":6.9,"voteCount":7521,"releaseDate":"2013-03-15","genres":["Animación","Aventura","Familia","Comedia"],"type":"movie","platforms":["$c"],"tmdbId":49519,"runtime":"$undefined","seasons":"$undefined"},{"id":4982,"title":"American Gangster","originalTitle":"American Gangster","overview":"Nueva York, 1968. Frank Lucas es el taciturno chófer de un importante mafioso negro de Harlem. Cuando su jefe muere inesperadamente, Frank aprovecha la oportunidad para construir su propio imperio. Gracias a su talento, se convierte no sólo en el principal narcotraficante de la ciudad, inundando las calles con productos de mejor calidad y precio, sino también en un hombre público muy respetado. Richie Roberts, un policía incorruptible marginado por su honradez que conoce bien las calles, se da cuenta de que una persona ajena a los clanes trepa por la escalera del poder. Tanto Roberts como Lucas comparten un estricto código ético que les aparta de los demás y los convierte en dos figuras solitarias en lados opuestos de la ley. Cuando se encuentren, el enfrentamiento entre ellos será inevitable.","posterPath":"https://image.tmdb.org/t/p/w500/pn4A89Rdv0fI7KuugdhSbgfJZs7.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/bdsxhTLpYIMlO88yQH0AzGUCXPI.jpg","voteAverage":7.6,"voteCount":6023,"releaseDate":"2007-11-02","genres":["Drama","Crimen"],"type":"movie","platforms":["$c"],"tmdbId":4982,"runtime":"$undefined","seasons":"$undefined"},{"id":13483,"title":"Despierto","originalTitle":"Despierto","overview":"Clay Beresford (Hayden Christensen) es un joven multimillonario que debe someterse a un transplante de corazón. Para ello, deja que su mejor amigo, el doctor Jack Harper (Terrence Howard), sea el encargado de realizar la operación. Durante la intervención, Clay experimenta un extraño fenómeno que le hace estar consciente y completamente paralizado mientras le operan. Mientras tanto, su novia, Sam (Jessica Alba) debe hacer frente a una serie de decisiones que serán determinantes para el futuro de Clay. Según transcurre la acción, todo da un vuelco, haciendo que nada sea lo que en principio parecía.","posterPath":"https://image.tmdb.org/t/p/w500/rl3jz0ovDcuKDvHdKVifiQfFzVL.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/nAVntSurtINQNtYPU7ijgCtgz7W.jpg","voteAverage":6.6,"voteCount":1530,"releaseDate":"2007-11-28","genres":["Suspense","Crimen","Misterio"],"type":"movie","platforms":["$c"],"tmdbId":13483,"runtime":"$undefined","seasons":"$undefined"},{"id":294254,"title":"El corredor del laberinto: Las pruebas","originalTitle":"El corredor del laberinto: Las pruebas","overview":"En este nuevo capítulo de la trepidante saga \"El Corredor del Laberinto\", Thomas (Dylan O'Brien) y el resto de clarianos tendrán que enfrentarse a su mayor desafío hasta el momento: buscar pistas sobre la misteriosa y poderosa organización conocida como CRUEL. Este viaje les llevará a “La Quemadura”, un apocalíptico lugar repleto de inimaginables obstáculos. Formando equipo con miembros de la resistencia, los clarianos deberán desenmascarar a las fuerzas superiores de CRUEL y averiguar qué planes tienen para todos ellos.","posterPath":"https://image.tmdb.org/t/p/w500/43K7XwlFzO5PGdNMFY5s36jXdWo.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/4mcOCiR06dqQ5eoEJcG3zvonjOa.jpg","voteAverage":6.7,"voteCount":11000,"releaseDate":"2015-09-09","genres":["Ciencia ficción","Acción","Suspense","Aventura"],"type":"movie","platforms":["$c"],"tmdbId":294254,"runtime":"$undefined","seasons":"$undefined"},{"id":68735,"title":"Warcraft: El origen","originalTitle":"Warcraft: El origen","overview":"El pacífico reino de Azeroth está a punto de entrar en guerra para enfrentarse a unos terribles invasores: orcos guerreros que han dejado su destruido mundo para colonizar otro. Al abrirse un portal que conecta ambos mundos, un ejército se enfrenta a la destrucción, y el otro, a la extinción. Dos héroes, uno en cada bando, están a punto de chocar en un enfrentamiento que cambiará el destino de su familia, su pueblo y su hogar. Así empieza una espectacular saga de poder y sacrificio donde se descubren las numerosas caras de la guerra y donde cada uno lucha por lo suyo. Adaptación del popular videojuego homónimo.","posterPath":"https://image.tmdb.org/t/p/w500/r62koy47q5TpDfCVzH0opsk7ZXv.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/riaO9lEYnzlmkILiLG3Y6HtJaM3.jpg","voteAverage":6.4,"voteCount":7243,"releaseDate":"2016-05-25","genres":["Acción","Aventura","Fantasía"],"type":"movie","platforms":["$c"],"tmdbId":68735,"runtime":"$undefined","seasons":"$undefined"},{"id":5559,"title":"Bee Movie","originalTitle":"Bee Movie","overview":"Una abeja llamada Barry B. Benson (Jerry Seinfeld) acaba de graduarse en la Universidad, pero le invade la desilusión cuando comprende que solo tiene una opción profesional, la miel. Sale por primera vez de la colmena y transgrede una de las reglas cardinales del mundo de las abejas al hablar con un ser humano, una florista de Nueva York llamada Vanessa (Renée Zellweger). Se queda atónito al descubrir que los humanos llevan siglos robando la miel de las abejas y entiende que su auténtica vocación es restablecer el orden de las cosas y demandar a las raza humana por robar la miel.","posterPath":"https://image.tmdb.org/t/p/w500/AiaVAIc9KsYsNkAFNGiHtmmoZ2d.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/lVfqLDmfrxIXFU2TcWTsG3ePdER.jpg","voteAverage":6,"voteCount":5257,"releaseDate":"2007-10-28","genres":["Familia","Animación","Aventura","Comedia"],"type":"movie","platforms":["$c"],"tmdbId":5559,"runtime":"$undefined","seasons":"$undefined"},{"id":107,"title":"Snatch. Cerdos y diamantes","originalTitle":"Snatch. Cerdos y diamantes","overview":"Franky es una ladrón de diamantes que tiene que entregar una enorme pieza a su jefe Avi, pero en el camino es tentado por Boris para apostar en un combate ilegal de boxeo. En realidad, es una trampa para atracarle por lo que, cuando Avi se entera, contrata a Tony para encontrar a Franky y el diamante. Pronto se descubre el triste destino de Franky, y la caza y captura de la gema desaparecida lleva a todo el mundo a un juego de locos que corre el riesgo de descontrolarse, donde el engaño, el chantaje y el fraude se mezclan de forma sangrienta con perros, diamantes, boxeadores y gran variedad de armas en una caótica merienda de negros.","posterPath":"https://image.tmdb.org/t/p/w500/ziWecvSRGjqeNKPx3kMqlYwssDo.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/gTghF8ardwJ48XLHkiapWk3ZmSo.jpg","voteAverage":7.8,"voteCount":9952,"releaseDate":"2000-09-01","genres":["Crimen","Comedia"],"type":"movie","platforms":["$c"],"tmdbId":107,"runtime":"$undefined","seasons":"$undefined"},{"id":483906,"title":"Polar","originalTitle":"Polar","overview":"Duncan Vizla, el asesino más letal del mundo, conocido como Black Káiser (Mads Mikkelsen), está a punto de jubilarse. Pero su antiguo jefe le ha puesto precio a su cabeza. Y, en contra de su voluntad, tiene que plantarle cara a un grupo de sicarios más jóvenes, rápidos y despiadados, dispuestos a todo para eliminarlo. Adaptación de la novela gráfica \"Polar: Came From the Cold\" de Victor Santos.","posterPath":"https://image.tmdb.org/t/p/w500/tjbdSpHqd8dmkrx0K0qYqh5W5Qn.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/lSCKo6QGJ88Gn3espNnvL87CinA.jpg","voteAverage":6.4,"voteCount":2482,"releaseDate":"2019-01-25","genres":["Acción","Crimen","Drama"],"type":"movie","platforms":["$c"],"tmdbId":483906,"runtime":"$undefined","seasons":"$undefined"},{"id":897087,"title":"Freelance","originalTitle":"Freelance","overview":"Mason Petit (John Cena) es un soldado retirado de las fuerzas especiales que, tras años de paz, tranquilidad y monotonía, decide abandonar su aburrido retiro en los suburbios para volver al trabajo y proteger a la periodista (Alison Brie) mientras entrevista a un cruel dictador (Juan Pablo Raba). En mitad de la entrevista, estallará un golpe militar que hará peligrar sus vidas y les llevará a esconderse en la selva donde deberán emplearse a fondo para sobrevivir.","posterPath":"https://image.tmdb.org/t/p/w500/AbOgZFAKSrYfnfMHd4vUq61J0LV.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/zIYROrkHJPYB3VTiW1L9QVgaQO.jpg","voteAverage":6.4,"voteCount":1155,"releaseDate":"2023-10-05","genres":["Acción","Comedia"],"type":"movie","platforms":["$c"],"tmdbId":897087,"runtime":"$undefined","seasons":"$undefined"},{"id":1032823,"title":"La trampa","originalTitle":"La trampa","overview":"Un padre y su hija adolescente asisten a un concierto de música pop, donde se dan cuenta de que están en el centro de un oscuro y siniestro suceso.","posterPath":"https://image.tmdb.org/t/p/w500/j81fGYj8hjDhpdNSHzREWMaE8p8.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/dCgrFY6uTqhEpyhe8MzP1oExyLt.jpg","voteAverage":6.2,"voteCount":2807,"releaseDate":"2024-07-31","genres":["Crimen","Terror","Suspense"],"type":"movie","platforms":["$c"],"tmdbId":1032823,"runtime":"$undefined","seasons":"$undefined"},{"id":59440,"title":"Warrior","originalTitle":"Warrior","overview":"Un veterano de Vietnam abandona el mundo de las artes marciales mixtas para trabajar en una fundición de acero. Sus graves problemas con el alcohol han destrozado a su familia, pero llega un momento en que, arrepentido, deja la bebida y decide entrenar a su hijo más joven para que participe en un torneo de artes marciales, en el que también participará su hermano mayor.","posterPath":"https://image.tmdb.org/t/p/w500/4R8oxk5twJrZ5U5pYdT0oa0hnli.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/zb7b40ieuRGiIc9ebIEapneaCsl.jpg","voteAverage":7.8,"voteCount":5006,"releaseDate":"2011-09-09","genres":["Drama","Acción"],"type":"movie","platforms":["$c"],"tmdbId":59440,"runtime":"$undefined","seasons":"$undefined"},{"id":458423,"title":"Mamma Mia! Una y otra vez","originalTitle":"Mamma Mia! Una y otra vez","overview":"\"Mamma mia: Una y otra vez\" nos lleva de viaje al verano donde comenzó todo. Desde su vida en el presente, los protagonistas de \"Mamma mia!\" nos cuentan los hechos acontecidos el mágico verano en el que comenzó esta historia de los tres posibles padres de Sophie.","posterPath":"https://image.tmdb.org/t/p/w500/ian2GqgxsKjhup9P9a6lqIYOmlQ.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/gtv2H1u9eGffjxVqNfJBZuFCKxR.jpg","voteAverage":7.1,"voteCount":3567,"releaseDate":"2018-07-18","genres":["Comedia","Romance"],"type":"movie","platforms":["$c"],"tmdbId":458423,"runtime":"$undefined","seasons":"$undefined"},{"id":149,"title":"Akira","originalTitle":"Akira","overview":"Corre el año 2019. Un estado policial, políticos tramposos, sectas religiosas, revolucionarios y un proyecto científico secreto se combinan para causar una atmósfera explosiva en Neo-Tokyo. Todos los grupos rivales quieren controlar a Akira, un chico con extraños poderes psíquicos que ha sido mantenido bajo custodia criogénica por más de 30 años. En medio de esta tensa atmósfera, un joven psíquico llamado Tetsuo libera a Akira.","posterPath":"https://image.tmdb.org/t/p/w500/vjPt8HYymLOkRv82x9JwVO7M2a5.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/fK40VGYIm7hmKrLJ26fgPQU0qRG.jpg","voteAverage":7.9,"voteCount":4760,"releaseDate":"1988-06-10","genres":["Animación","Ciencia ficción","Acción"],"type":"movie","platforms":["$c"],"tmdbId":149,"runtime":"$undefined","seasons":"$undefined"},{"id":1593,"title":"Noche en el museo","originalTitle":"Noche en el museo","overview":"Un padre divorciado trata de establecerse, impresionar a su hijo y encontrar su destino. Él se presenta para un trabajo como vigilante nocturno en el Museo Americano de Historia Natural de la ciudad de Nueva York y, posteriormente, descubre que los objetos expuestos, animados por un artefacto mágico de Egipto, vuelven a la vida durante la noche. Al principio le va muy mal tratando de mantener el orden y la calma en el museo, pero al final se vuelve muy buen amigo de todos y juntos ayudan a recuperar aquel artefacto mágico egipcio, ya que ha sido robado por los antiguos vigilantes del museo.","posterPath":"https://image.tmdb.org/t/p/w500/1Esw7HZUmHzDeJIZq4ZmTZrhunT.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/1ZVlzOBYCggLzvVYHK7Im6LohjC.jpg","voteAverage":6.6,"voteCount":10938,"releaseDate":"2006-12-20","genres":["Fantasía","Familia","Comedia"],"type":"movie","platforms":["$c"],"tmdbId":1593,"runtime":"$undefined","seasons":"$undefined"},{"id":787,"title":"Sr. y Sra. Smith","originalTitle":"Sr. y Sra. Smith","overview":"Jane y John Smith forman una pareja de vida acomodada dentro de un ordinario y monótono matrimonio suburbano. Además ambos ocultan algo por lo que su pareja mataría por saber: los dos son agentes secretos, asesinos increíblemente eficientes que trabajan para organizaciones que compiten entre sí. Además, un día el Sr. y la Sra. Smith descubren una nueva fuente de emoción en su matrimonio cuando se les contrata para asesinarse mutuamente, pues será entonces cuando comienza la verdadera diversión...","posterPath":"https://image.tmdb.org/t/p/w500/wNi7Axc8U4cI9BgryeuF5tpi0I1.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/iFaWUETEE2umP1WY0LUAmjSpzm7.jpg","voteAverage":6.7,"voteCount":11196,"releaseDate":"2005-06-07","genres":["Acción","Comedia","Drama","Suspense"],"type":"movie","platforms":["$c"],"tmdbId":787,"runtime":"$undefined","seasons":"$undefined"},{"id":840326,"title":"Sisu","originalTitle":"Sisu","overview":"En lo profundo de la naturaleza salvaje de Laponia, Aatami Korpi está buscando oro, pero después de tropezar con una patrulla nazi, comienza una persecución impresionante y hambrienta de oro a través de la naturaleza salvaje de Laponia destruida y minada.","posterPath":"https://image.tmdb.org/t/p/w500/iaKee6RBwx7UxgZt7PWQUAAkaG7.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/pBdQ4iorzRV2G38mdS6rzrmUfMA.jpg","voteAverage":7.4,"voteCount":2816,"releaseDate":"2022-09-09","genres":["Acción","Bélica","Suspense"],"type":"movie","platforms":["$c"],"tmdbId":840326,"runtime":"$undefined","seasons":"$undefined"},{"id":10555,"title":"El espantatiburones","originalTitle":"El espantatiburones","overview":"Oscar es un pececito de verbo rápido que sueña con ser un pez gordo. Pero sus sueños le meten en agua estancada cuando una gran mentira le convierte en un improbable héroe. Al principio los demás peces se tragan el anzuelo de Oscar y le llueve la fama y la fortuna. Todo va con la marea a favor hasta que empieza a quedar claro que la historia que ha propagado Oscar de que es el gran defensor del atolón hace agua por todas partes. El pececito descubre que ser un héroe significa que su vida está de rebajas: su mentira le va a convertir en la pesca del día. Oscar debe aprender a navegar entre dos aguas para volver a encontrar la corriente a su favor.","posterPath":"https://image.tmdb.org/t/p/w500/3vI17Q3mfkIEpvwItomxMy5w1gw.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/7ZmZxar3bYORcl0TPA4oceyxcaE.jpg","voteAverage":6,"voteCount":6693,"releaseDate":"2004-09-20","genres":["Animación","Acción","Comedia","Familia"],"type":"movie","platforms":["$c"],"tmdbId":10555,"runtime":"$undefined","seasons":"$undefined"},{"id":1271,"title":"300","originalTitle":"300","overview":"Adaptación del cómic de Frank Miller (autor del cómic 'Sin City') sobre la famosa batalla de las Termópilas (480 a.C.). El objetivo de Jerjes, emperador de Persia, era la conquista de Grecia, lo que desencadenó las Guerras Médicas. Dada la gravedad de la situación, el rey Leónidas de Esparta (Gerard Butler) y 300 espartanos se enfrentaron a un ejército persa que era inmensamente superior.","posterPath":"https://image.tmdb.org/t/p/w500/h7Lcio0c9ohxPhSZg42eTlKIVVY.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/lgBZlJ1LHQel5nneNQMoesmvc7l.jpg","voteAverage":7.2,"voteCount":14684,"releaseDate":"2007-03-07","genres":["Acción","Aventura","Bélica"],"type":"movie","platforms":["$c"],"tmdbId":1271,"runtime":"$undefined","seasons":"$undefined"},{"id":474350,"title":"It: Capítulo 2","originalTitle":"It: Capítulo 2","overview":"Han pasado casi 30 años desde que el \"Club de los Perdedores\", formado por Bill, Beverly, Richie, Ben, Eddie, Mike y Stanley, se enfrentaran al macabro y despiadado Pennywise (Bill Skarsgård). En cuanto tuvieron oportunidad, abandonaron el pueblo de Derry, en el estado de Maine, que tantos problemas les había ocasionado. Sin embargo, ahora, siendo adultos, parece que no pueden escapar de su pasado. Todos deberán enfrentarse de nuevo al temible payaso para descubrir si de verdad están preparados para superar sus traumas de la infancia.","posterPath":"https://image.tmdb.org/t/p/w500/9oERKIVyTWpHNum3STVsAGD4ojz.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/6LVSrgm83UYWlrLTCVGmWhFKYO0.jpg","voteAverage":6.8,"voteCount":9590,"releaseDate":"2019-09-04","genres":["Terror","Suspense","Drama"],"type":"movie","platforms":["$c"],"tmdbId":474350,"runtime":"$undefined","seasons":"$undefined"},{"id":73723,"title":"Lorax. En busca de la trúfula perdida","originalTitle":"Lorax. En busca de la trúfula perdida","overview":"Un chico se propone conquistar el afecto de la chica de sus sueños. Para conseguirlo, debe averiguar la historia del Lorax, una encantadora aunque gruñona criatura que lucha por proteger un mundo en vías de extinción.","posterPath":"https://image.tmdb.org/t/p/w500/b7FMtquHglzxIi938cHIgVQuPx5.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/71FjlP0qZPc1iymcHf8u5vXfH50.jpg","voteAverage":6.5,"voteCount":3861,"releaseDate":"2012-03-01","genres":["Animación","Familia"],"type":"movie","platforms":["$c"],"tmdbId":73723,"runtime":"$undefined","seasons":"$undefined"},{"id":9323,"title":"Ghost in the Shell","originalTitle":"Ghost in the Shell","overview":"En un futuro no muy lejano, un grupo de agentes especiales se disponen a encontrar a un hacker misterioso conocido como \"Puppet Master\". En la búsqueda descubrirán alarmantes secretos acerca de la evolución de la inteligencia artificial. La película fue una gran inspiración para la trilogía de Matrix.","posterPath":"https://image.tmdb.org/t/p/w500/mo4PUj0SWiX33uQMgxyzE2ZOPBK.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/jIpagj2Dud9g3ZVJFvaWikEWsYz.jpg","voteAverage":7.9,"voteCount":3874,"releaseDate":"1995-11-18","genres":["Acción","Animación","Ciencia ficción"],"type":"movie","platforms":["$c"],"tmdbId":9323,"runtime":"$undefined","seasons":"$undefined"},{"id":718821,"title":"Twisters","originalTitle":"Twisters","overview":"Kate Carter, una ex cazadora de tormentas perseguida por un devastador encuentro con un tornado, es llamada por su amigo Javi de regreso a las llanuras para probar un nuevo e innovador sistema de seguimiento. Allí, se cruza con el encantador e imprudente ídolo de las redes sociales Tyler Owens y su estridente equipo. A medida que la temporada de tormentas se intensifica, se desatan fenómenos terroríficos nunca vistos, y Kate, Tyler y sus equipos competidores se encuentran directamente en el camino de múltiples sistemas de tormentas que convergen sobre Oklahoma en lo que será una lucha por sobrevivir.","posterPath":"https://image.tmdb.org/t/p/w500/50xgtaDR0xJkLSVghdTGUeMoPHP.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/58D6ZAvOKxlHjyX9S8qNKSBE9Y.jpg","voteAverage":6.8,"voteCount":2963,"releaseDate":"2024-07-10","genres":["Acción","Suspense"],"type":"movie","platforms":["$c"],"tmdbId":718821,"runtime":"$undefined","seasons":"$undefined"},{"id":615677,"title":"Superniños","originalTitle":"Superniños","overview":"Cuando unos invasores  alienígenas capturan a los superhéroes de la Tierra, sus hijos tienen que aprender a trabajar en equipo parea rescatarlos... y salvar el planeta.","posterPath":"https://image.tmdb.org/t/p/w500/5AcJFpvxcqjLNADrCNAUYOsIrQP.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/y6FYAhaeFMj9Lsk8OdF2NeWQkbd.jpg","voteAverage":5.9,"voteCount":817,"releaseDate":"2020-12-25","genres":["Familia","Acción","Fantasía","Comedia"],"type":"movie","platforms":["$c"],"tmdbId":615677,"runtime":"$undefined","seasons":"$undefined"},{"id":4011,"title":"Bitelchús","originalTitle":"Bitelchús","overview":"¿Qué debería hacer una pareja de fantasmas si su estrafalario hogar de Nueva Inglaterra se llenara de elegantes visitantes neoyorquinos? Pedir ayuda a un exorcista para aterrorizar a los intrusos con el fin de que abandonen la casa. Bitelchús es una criatura de ultratumba repugnante y terrorífica, un fenómeno asustando y bromeando que se gira y se transforma en grotescas formas, traga insectos y no puede dejar a las mujeres (vivas o muertas) en paz.","posterPath":"https://image.tmdb.org/t/p/w500/fS9uBsxTs3TWdv0wSEpwyhhvCnO.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/yRKyJJYIzfeiVDHBe4LXguPQCvD.jpg","voteAverage":7.4,"voteCount":8428,"releaseDate":"1988-03-30","genres":["Fantasía","Comedia"],"type":"movie","platforms":["$c"],"tmdbId":4011,"runtime":"$undefined","seasons":"$undefined"},{"id":1117857,"title":"En sueños","originalTitle":"En sueños","overview":"Stevie y su hermano pequeño Elliot viajan al absurdo mundo de sus sueños para pedirle a Sandman que les conceda un deseo: la familia perfecta.","posterPath":"https://image.tmdb.org/t/p/w500/z2v3lNAA2ymrZuKof4J2vqFIBdw.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/cTuFz80FozP54Aob9TYl4mF1wKk.jpg","voteAverage":7,"voteCount":215,"releaseDate":"2025-11-07","genres":["Aventura","Animación","Comedia","Familia","Fantasía"],"type":"movie","platforms":["$c"],"tmdbId":1117857,"runtime":"$undefined","seasons":"$undefined"},{"id":512200,"title":"Jumanji: Siguiente nivel","originalTitle":"Jumanji: Siguiente nivel","overview":"En esta ocasión, los 'jugadores' vuelven al juego, pero sus personajes se han intercambiado entre sí, lo que ofrece un curioso plantel: los mismos héroes con distinta apariencia. Pero, ¿dónde está el resto de la gente? Los participantes sólo tienen una opción: jugar una vez más a esta peligrosa partida para descubrir qué es realmente lo que está sucediendo.","posterPath":"https://image.tmdb.org/t/p/w500/gvR0l5NQ62DJe0Ppxb2sroHlwaa.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/qgch2rFskIxDMgwrD5lWTaB4nBl.jpg","voteAverage":6.9,"voteCount":9339,"releaseDate":"2019-12-04","genres":["Aventura","Comedia","Fantasía"],"type":"movie","platforms":["$c"],"tmdbId":512200,"runtime":"$undefined","seasons":"$undefined"},{"id":70981,"title":"Prometheus","originalTitle":"Prometheus","overview":"Un grupo de científicos y exploradores emprende un viaje espacial a un remoto planeta, en el que sus límites físicos y mentales serán puestos a prueba. El motivo de la misión es que los humanos creen que allá podrán encontrar las respuestas a las preguntas más profundas y al mayor de los misterios: el origen de la vida en la Tierra.","posterPath":"https://image.tmdb.org/t/p/w500/5oYpDom6T7c1YiL2j5IImKklws7.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/sM42bpH73dmf3kJrE8xr4kztYqR.jpg","voteAverage":6.6,"voteCount":13224,"releaseDate":"2012-05-30","genres":["Ciencia ficción","Misterio","Terror"],"type":"movie","platforms":["$c"],"tmdbId":70981,"runtime":"$undefined","seasons":"$undefined"},{"id":3049,"title":"Ace Ventura, un detective diferente","originalTitle":"Ace Ventura, un detective diferente","overview":"El detective Ace Ventura, especializado en rescatar animales secuestrados, recibe el encargo de localizar y rescatar el delfin Copo de Nieve, mascota del equipo de fútbol de Miami, que ha sido secuestrado el día anterior a la gran final que debe disputar el equipo.","posterPath":"https://image.tmdb.org/t/p/w500/zByKfhPuFUEymc0uzHGdIfO7dx5.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/nbvREKIjX16mwNZtFqAoQTTHPnQ.jpg","voteAverage":6.6,"voteCount":6373,"releaseDate":"1994-02-04","genres":["Comedia","Misterio","Crimen"],"type":"movie","platforms":["$c"],"tmdbId":3049,"runtime":"$undefined","seasons":"$undefined"},{"id":39513,"title":"Paul","originalTitle":"Paul","overview":"Un viajero espacial muy listillo llamado Paul (SETH ROGEN, The Green Hornet, Lío embarazoso) lleva sesenta años encerrado en una base militar ultrasecreta, aconsejando a los líderes mundiales acerca de otros alienígenas. Cuando empieza a darse cuenta de que ya no es tan útil y de que la mesa de disección se acerca peligrosamente, Paul decide escapar en la primera autocaravana que se detiene cerca de la base militar en el Área 51. Por suerte para él, en dicha autocaravana van dos terrícolas perfectamente dispuestos a rescatar y albergar a un alienígena con problemas.","posterPath":"https://image.tmdb.org/t/p/w500/e57pNjhWbRos9BTvgeUYUzB8VfO.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/kl3rMfydlxyLDsZidSUCEWm8K0M.jpg","voteAverage":6.7,"voteCount":6253,"releaseDate":"2011-02-14","genres":["Aventura","Comedia","Ciencia ficción"],"type":"movie","platforms":["$c"],"tmdbId":39513,"runtime":"$undefined","seasons":"$undefined"},{"id":18239,"title":"La saga Crepúsculo: Luna nueva","originalTitle":"La saga Crepúsculo: Luna nueva","overview":"Edward Cullen decide abandonar a Bella Swan para mantenerla alejada de los peligros del mundo vampírico. Con la ayuda de Jacob Black, su amigo de la infancia y miembro de la misteriosa tribu quileute, Bella intentará superar el abandono de Edward, que la ha dejado sumida en el mayor de los desconsuelos. Pero los peligros siguen acechando a la joven; nuevas y asombrosas criaturas sobrenaturales se cruzarán en su camino, y Bella sólo contará con el apoyo del cada vez más cercano e irresistible Jacob. Repentinamente, Bella se encuentra inmersa en el mundo de los hombres lobo, ancestrales enemigos de los vampiros, y su lealtad es puesta a prueba...","posterPath":"https://image.tmdb.org/t/p/w500/l5lF8VHTO5QKObAKE3Wp2QQfGZJ.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/dF2c20sRDgySZLaLS2OUerL07sz.jpg","voteAverage":6,"voteCount":9730,"releaseDate":"2009-11-18","genres":["Aventura","Fantasía","Drama","Romance"],"type":"movie","platforms":["$c"],"tmdbId":18239,"runtime":"$undefined","seasons":"$undefined"},{"id":7518,"title":"Vecinos invasores","originalTitle":"Vecinos invasores","overview":"Cuando R.J. (un travieso mapache estafador), Verne (una tímida tortuga), y sus amigos del bosque descubren que alguien ha construido unas casas en su territorio, la primera reacción de la tortuga es meterse en su caparazón y retroceder, pero el mapache oportunista se da cuenta de las posibilidades que ofrecen sus nuevos e ingenuos vecinos. Verne y R.J. formarán una inesperada asociación mientras aprenden a coexistir con este extraño mundo llamado “urbanización”, e incluso a explotarlo.","posterPath":"https://image.tmdb.org/t/p/w500/5lHMB2jwlQV43RBfT5g3BRGN0Tm.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/reK7SgAFlyxg3s9R7neh6M970kh.jpg","voteAverage":6.6,"voteCount":4827,"releaseDate":"2006-05-17","genres":["Aventura","Animación","Comedia","Familia"],"type":"movie","platforms":["$c"],"tmdbId":7518,"runtime":"$undefined","seasons":"$undefined"},{"id":929590,"title":"Civil War","originalTitle":"Civil War","overview":"En un futuro cercano, donde América está sumida en una cruenta guerra civil, un equipo de periodistas y fotógrafos de guerra emprenderá un viaje por carretera en dirección a Washington DC. Su misión: llegar antes de que las fuerzas rebeldes asalten la Casa Blanca y arrebaten el control al presidente de Estados Unidos.","posterPath":"https://image.tmdb.org/t/p/w500/q0oN2KVQ2W94YNwDGmqaYNmiOnR.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/en3GU5uGkKaYmSyetHV4csHHiH3.jpg","voteAverage":6.9,"voteCount":4306,"releaseDate":"2024-04-10","genres":["Bélica","Acción","Drama"],"type":"movie","platforms":["$c"],"tmdbId":929590,"runtime":"$undefined","seasons":"$undefined"},{"id":668489,"title":"Estragos","originalTitle":"Estragos","overview":"Cuando un robo de drogas tiene consecuencias fatales, un policía lucha contra el submundo criminal de una ciudad corrupta para salvar al hijo de un político.","posterPath":"https://image.tmdb.org/t/p/w500/tbsDLmo2Ej8YFM0HKcOGfNMTlyJ.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/7rKyFSg6SdLoCRCVoWLjL5k658k.jpg","voteAverage":6.4,"voteCount":1213,"releaseDate":"2025-04-25","genres":["Acción","Crimen","Suspense","Drama"],"type":"movie","platforms":["$c"],"tmdbId":668489,"runtime":"$undefined","seasons":"$undefined"},{"id":393,"title":"Kill Bill: Volumen 2","originalTitle":"Kill Bill: Volumen 2","overview":"Tras eliminar a algunos de los miembros de la banda que intentó asesinarla el día de su boda, \"Mamba Negra\" prosigue su venganza e intenta acabar con el resto de la banda, en especial con su antiguo jefe, Bill, que la dio por muerta dejándola en coma.","posterPath":"https://image.tmdb.org/t/p/w500/oEbYyyl3w2dptDZCfXr8NHEHFkl.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/pgG6tzJzC8mjGqhaT8IWwEk00xf.jpg","voteAverage":7.9,"voteCount":15032,"releaseDate":"2004-04-16","genres":["Acción","Crimen","Suspense"],"type":"movie","platforms":["$c"],"tmdbId":393,"runtime":"$undefined","seasons":"$undefined"},{"id":11631,"title":"Mamma Mia! La película","originalTitle":"Mamma Mia! La película","overview":"Versión cinematográfica del popular musical de ABBA. Una joven que ha crecido en una pequeña isla griega, ha sido educada por una madre rebelde y poco convencional, que siempre se ha negado a revelarle la identidad de su padre. Cuando, por fin, parece que la joven está a punto de saberlo, aparecen tres posibles candidatos.","posterPath":"https://image.tmdb.org/t/p/w500/4QthG4HsSQ30Uit2CpOz6YRikX1.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/8IGO8rF5asa7tnO0aEtx3e5R4Z5.jpg","voteAverage":7,"voteCount":6981,"releaseDate":"2008-07-03","genres":["Comedia","Romance"],"type":"movie","platforms":["$c"],"tmdbId":11631,"runtime":"$undefined","seasons":"$undefined"},{"id":137106,"title":"La LEGO película","originalTitle":"La LEGO película","overview":"Película basada en los clásicos juguetes LEGO. Emmet, el protagonista de la película, trabaja como constructor en la ciudad Lego, pero sus conocimientos de construcción no van más allá de colocar las fichas atendiendo pormenorizadamente las instrucciones de edificación. Sin embargo, sin saber cómo ni por qué, Emmet es confundido con un 'MasterBuilder' e introducido como cabecilla de una misión que tiene por objetivo evitar que un malvado acabe con la ciudad de bloques. Por suerte, los habitantes de tan atípico lugar no están solos. Los mismísimos Superman y Batman han tomado la forma de muñecos Lego para tomar parte de esta gran aventura.","posterPath":"https://image.tmdb.org/t/p/w500/faKcUazMUagPhx9N3kKNaUCrES4.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/6gI1dAkOaUQ6659OdRPsTLlsem5.jpg","voteAverage":7.4,"voteCount":8455,"releaseDate":"2014-02-06","genres":["Animación","Familia","Aventura","Comedia","Fantasía"],"type":"movie","platforms":["$c"],"tmdbId":137106,"runtime":"$undefined","seasons":"$undefined"},{"id":38321,"title":"El sicario de Dios","originalTitle":"El sicario de Dios","overview":"En un mundo asolado por siglos de guerra entre el hombre y los vampiros, Paul Bettany es un legendario guerrero que destacó durante la última Guerra del Vampiro, pero ahora es sólo un sacerdote que vive en compañía de otros hombres en las amuralladas ciudades distópicas controladas por la Iglesia. Sin embargo, cuando su joven sobrina es secuestrada por un grupo de vampiros asesinos que viven en los páramos desolados del exterior, el sacerdote rompe sus sagrados votos y emprende su búsqueda decidido a vengarse de los secuestradores, especialmente de su brutal líder. En esta aventura le acompaña Hicks, el novio de la chica, un sheriff y una sacerdotisa, miembro de la legión de asesinos de vampiros y poseedora de habilidades de combate sobrenaturales.","posterPath":"https://image.tmdb.org/t/p/w500/fBs0ScJQPb2xi0Jt9BGPcdaITvh.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/srrzHjAzhYzUulBbllQCNekgnQb.jpg","voteAverage":5.9,"voteCount":2515,"releaseDate":"2011-05-05","genres":["Acción","Fantasía","Terror"],"type":"movie","platforms":["$c"],"tmdbId":38321,"runtime":"$undefined","seasons":"$undefined"},{"id":49046,"title":"Sin novedad en el frente","originalTitle":"Sin novedad en el frente","overview":"Paul Baumer y sus amigos Albert y Muller, incitados por sueños románticos de heroísmo, se alistan voluntariamente en el ejército alemán. Llenos de emoción y fervor patriótico, los muchachos marchan con entusiasmo hacia una guerra en la que creen. Pero una vez en el frente occidental, descubren el horror destructor del alma de la Primera Guerra Mundial.","posterPath":"https://image.tmdb.org/t/p/w500/vTfqiOZ4bZZZpIJp8sXT1UB6QS5.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/xBwtP27cx8WfjHJVFkpuV6F1RES.jpg","voteAverage":7.7,"voteCount":4645,"releaseDate":"2022-10-07","genres":["Bélica","Drama"],"type":"movie","platforms":["$c"],"tmdbId":49046,"runtime":"$undefined","seasons":"$undefined"},{"id":153,"title":"Lost in Translation","originalTitle":"Lost in Translation","overview":"Bob Harris y Charlotte son dos norteamericanos que se encuentran en Tokio. Bob es una estrella de cine de mediana edad que ha venido a rodar un anuncio. Charlotte es una mujer joven que acompaña a todas partes a su marido, un fanático del trabajo. Incapaces de dormir, los caminos de Bob y Charlotte se cruzan por casualidad y no tardará en nacer entre ellos una sorprendente amistad. Se aventuran juntos en la vida nocturna de Tokio, comparten inolvidables experiencias con los habitantes de la ciudad y terminan descubriendo una nueva manera de ver la vida.","posterPath":"https://image.tmdb.org/t/p/w500/ybXq8xTs6VMx3hM4RDYMXaDZwcz.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/6ITVHoipvxAS8luzKtHTbPaHLtT.jpg","voteAverage":7.4,"voteCount":8064,"releaseDate":"2003-09-18","genres":["Drama","Comedia","Romance"],"type":"movie","platforms":["$c"],"tmdbId":153,"runtime":"$undefined","seasons":"$undefined"},{"id":2502,"title":"El mito de Bourne","originalTitle":"El mito de Bourne","overview":"Jason Bourne pensaba que había dejado atrás su pasado dos años antes. Durante ese tiempo, atormentado por un pasado que no consigue recordar, Bourne y Marie se trasladan de una ciudad a otra, viviendo de manera anónima y clandestina. Tratan de huir de una amenaza que creen percibir en la mirada de cualquier extraño, en cada llamada telefónica \"equivocada\". Cuando un agente aparece por la tranquila villa en la que se alojan, la pareja huye precipitadamente. Pero el juego del ratón y el gato ha vuelto a comenzar, obligando a entrar en acción a Bourne para enfrentarse a un grupo de implacables asesinos profesionales.","posterPath":"https://image.tmdb.org/t/p/w500/kTFFwQHdaTUb5MJmB8KBGO7lh7N.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/fE7RqvVHbGHjBC9NjIjlLh2t4zK.jpg","voteAverage":7.3,"voteCount":8132,"releaseDate":"2004-07-23","genres":["Acción","Drama","Suspense"],"type":"movie","platforms":["$c"],"tmdbId":2502,"runtime":"$undefined","seasons":"$undefined"},{"id":4922,"title":"El curioso caso de Benjamin Button","originalTitle":"El curioso caso de Benjamin Button","overview":"Un hombre nace con ochenta años y va rejuveneciendo a medida que pasa el tiempo, es decir, en lugar de cumplir años los descumple. Ésta es la historia de un hombre extraordinario, de la gentes que va conociendo, de sus amores, pero sobre todo de su relación con Daisy.","posterPath":"https://image.tmdb.org/t/p/w500/t5nG1UuIZ5VEPUFdEsHwRmxToeo.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/2fswjyrY3GEzeoVn6mF8pNeNcgf.jpg","voteAverage":7.6,"voteCount":13698,"releaseDate":"2008-12-25","genres":["Drama","Fantasía","Romance"],"type":"movie","platforms":["$c"],"tmdbId":4922,"runtime":"$undefined","seasons":"$undefined"},{"id":936108,"title":"Pitufos","originalTitle":"Pitufos","overview":"Película musical de animación centrada en las icónicas creaciones de Peyo. Cuando Papá Pitufo es secuestrado de forma misteriosa por los malvados brujos Razamel y Gargamel, Pitufina lleva a los Pitufos a una misión al mundo real para salvarle. Con la ayuda de nuevos amigos, los Pitufos deberán descubrir qué define su destino para salvar el universo.","posterPath":"https://image.tmdb.org/t/p/w500/zBdQclxQnEDOhDOjkKgKPW6jEHh.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/9whEVuKte4Qi0LI4TzPf7glinJW.jpg","voteAverage":5.8,"voteCount":262,"releaseDate":"2025-06-30","genres":["Animación","Familia","Fantasía"],"type":"movie","platforms":["$c"],"tmdbId":936108,"runtime":"$undefined","seasons":"$undefined"},{"id":23169,"title":"Recuérdame","originalTitle":"Recuérdame","overview":"Tyler Roth (Robert Pattinson) es un joven afectado por el suicidio de su hermano, situación que desencadenará el divorcio de sus padres (Pierce Brosnan y Lena Olin), incapaces de superar la traumática pérdida. Totalmente solo, y con una familia rota, conoce a una chica (Emile De Ravin) que hará que su vida vuelva a tener sentido.","posterPath":"https://image.tmdb.org/t/p/w500/ayxWYQOi5WxWF0bNTnxpnEEde5Y.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/kbxk09QgBJfJjnp66ey3JCEshKf.jpg","voteAverage":7.1,"voteCount":3720,"releaseDate":"2010-03-11","genres":["Drama","Romance"],"type":"movie","platforms":["$c"],"tmdbId":23169,"runtime":"$undefined","seasons":"$undefined"},{"id":568,"title":"Apolo 13","originalTitle":"Apolo 13","overview":"El Apolo 13 inicia su viaje a la luna en abril de 1970. Cuando la tripulación está a punto de llegar a su destino, una explosión en el espacio les hace perder oxígeno, energía y el curso de la nave... Todo se convierte en una situación desesperada para los tres hombres tripulantes, especialmente cuando el oxígeno amenaza con agotarse. Mientras, el mundo entero, que apenas un año antes conoció la gloria de la aventura espacial cuando el hombre pisó la luna, contiene la respiración a la espera de ver cómo acaba tan angustiosa espera.","posterPath":"https://image.tmdb.org/t/p/w500/h6RBssorNWZQYZN5M4ys9V6Uy0I.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/n0FDJI9c0uWiZwm8wgXVjaMBn96.jpg","voteAverage":7.5,"voteCount":5892,"releaseDate":"1995-06-30","genres":["Drama","Historia"],"type":"movie","platforms":["$c"],"tmdbId":568,"runtime":"$undefined","seasons":"$undefined"},{"id":166428,"title":"Cómo entrenar a tu dragón 3","originalTitle":"Cómo entrenar a tu dragón 3","overview":"Lo que comenzó como la inesperada amistad entre un joven vikingo y un temible dragón, Furia Nocturna,  se ha convertido en una épica trilogía que ha recorrido sus vidas. En esta nueva entrega, Hipo y Desdentao descubrirán finalmente su verdadero destino: para uno, gobernar Isla Mema junto a Astrid; para el otro, ser el líder de su especie. Pero, por el camino, deberán poner a prueba los lazos que los unen, plantando cara a la mayor amenaza que jamás haya afrontado... y a la aparición de una Furia Nocturna hembra.","posterPath":"https://image.tmdb.org/t/p/w500/rhnoAReqO3Xoe6GbJhT3409lnq8.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/h3KN24PrOheHVYs9ypuOIdFBEpX.jpg","voteAverage":7.8,"voteCount":7081,"releaseDate":"2019-01-03","genres":["Animación","Familia","Aventura"],"type":"movie","platforms":["$c"],"tmdbId":166428,"runtime":"$undefined","seasons":"$undefined"},{"id":916224,"title":"Suzume","originalTitle":"Suzume","overview":"Suzume, una joven chica de diecisiete años que vive en un pueblo tranquilo en la región de Kyushu, en el suroeste de Japón. La historia comienza cuando Suzume conoce a un misterioso joven que busca una 'puerta'. Los dos viajan juntos y encuentran una puerta vieja en una casa abandonada en las montañas. Como si algo tirara de ella, Suzume extiende su mano hacia la puerta, lo que comienza una serie de eventos desafortunados en todo Japón.","posterPath":"https://image.tmdb.org/t/p/w500/j61GLMo7nWcNwHneL0lhT4NvgCH.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/4tdV5AeojEdbvn6VpeQrbuDlmzs.jpg","voteAverage":7.9,"voteCount":1727,"releaseDate":"2022-11-11","genres":["Animación","Drama","Aventura","Fantasía"],"type":"movie","platforms":["$c"],"tmdbId":916224,"runtime":"$undefined","seasons":"$undefined"},{"id":12429,"title":"Ponyo en el acantilado","originalTitle":"Ponyo en el acantilado","overview":"La historia se centra en Sosuke, un niño de 5 años, y su relación con una princesa pez que ansía convertirse en un ser humano. Libre adaptación de \"La sirenita\" que obtuvo muy buena acogida de la crítica en el Festival de Venecia 2008.","posterPath":"https://image.tmdb.org/t/p/w500/ew6o3jOBGnx8GETvCkIanorvjka.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/shqLeIkqPAAXM8iT6wVDiXUYz1p.jpg","voteAverage":7.8,"voteCount":4794,"releaseDate":"2008-07-19","genres":["Animación","Fantasía","Familia"],"type":"movie","platforms":["$c"],"tmdbId":12429,"runtime":"$undefined","seasons":"$undefined"},{"id":889737,"title":"Joker: Folie à Deux","originalTitle":"Joker: Folie à Deux","overview":"Tras crear el caos, Arthur Fleck ha sido internado en Arkham a la espera de juicio por sus crímenes como Joker. Mientras lidia con su doble identidad, Arthur no sólo se topa con el amor verdadero, sino que también descubre la música que siempre ha estado dentro de él.","posterPath":"https://image.tmdb.org/t/p/w500/i90gQD1ogdrX2EE2bYCtYSuqjRV.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/AVWlQpVhpudyFsSh3OQIieHHYf.jpg","voteAverage":5.4,"voteCount":2901,"releaseDate":"2024-10-01","genres":["Drama","Crimen","Suspense"],"type":"movie","platforms":["$c"],"tmdbId":889737,"runtime":"$undefined","seasons":"$undefined"},{"id":1592,"title":"Las dos caras de la verdad","originalTitle":"Las dos caras de la verdad","overview":"Martin Vail (Richard Gere) es un ambicioso abogado de Chicago, capaz de aceptar cualquier caso con tal de salir en la prensa. Un día acepta un caso en apariencia imposible de ganar: la defensa de Aaron (Edward Norton), un joven acusado de asesinar al arzobispo de Chicago tras ser detenido huyendo del lugar del crimen. El caso parece fácil, pero la pesadilla para Martin acaba de empezar.","posterPath":"https://image.tmdb.org/t/p/w500/8EkX8965Hb2hZdkpEcFShrlrklw.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/dZM71rHXh3Oo3WZlw8YpMMsoVB5.jpg","voteAverage":7.7,"voteCount":3909,"releaseDate":"1996-04-03","genres":["Crimen","Drama","Misterio","Suspense"],"type":"movie","platforms":["$c"],"tmdbId":1592,"runtime":"$undefined","seasons":"$undefined"},{"id":9737,"title":"Dos policías rebeldes","originalTitle":"Dos policías rebeldes","overview":"Un alijo de heroína valorada en unos 100 millones de dólares es robado del mismísimo depósito de la policía. El caso le será asignado a los agentes Burnett y Lowery, una pareja muy peculiar por los métodos que utilizan. La única pista que tienen para comenzar es la de un testigo que les ayudará a identificar a los atracadores y a la que tendrán que proteger.","posterPath":"https://image.tmdb.org/t/p/w500/ZYpSdXaTMFYCGbmVmXOFbdJmSv.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/wOLTJxfv98miIQcn0oNXq9fIgXM.jpg","voteAverage":6.8,"voteCount":6934,"releaseDate":"1995-04-07","genres":["Acción","Comedia","Crimen","Suspense"],"type":"movie","platforms":["$c"],"tmdbId":9737,"runtime":"$undefined","seasons":"$undefined"},{"id":1180831,"title":"Trol 2","originalTitle":"Trol 2","overview":"Cuando un nuevo y peligroso trol amenaza con devastar su país, Nora, Andreas y el comandante Kris se embarcan en la misión más peligrosa de sus vidas.","posterPath":"https://image.tmdb.org/t/p/w500/AisyKEN1zLKRcAPpeJ5G5DaBhyw.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/lZYMXx74pWmbj5Q5jp1QaMvmuuR.jpg","voteAverage":6.4,"voteCount":467,"releaseDate":"2025-11-30","genres":["Acción","Fantasía","Suspense"],"type":"movie","platforms":["$c"],"tmdbId":1180831,"runtime":"$undefined","seasons":"$undefined"},{"id":1426964,"title":"Hermandad: Estado de terror","originalTitle":"Hermandad: Estado de terror","overview":"En medio de una ola de violencia inédita que sacude São Paulo, una abogada ligada al mundo criminal debe pactar con la policía para salvar a su sobrina secuestrada.","posterPath":"https://image.tmdb.org/t/p/w500/xdyCFS4jUzp7kghoptaiYqir48X.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/1Xdsq7U7bvJJd2X7Jg4qNaKVkYO.jpg","voteAverage":5.7,"voteCount":69,"releaseDate":"2026-02-10","genres":["Acción","Suspense","Crimen","Drama"],"type":"movie","platforms":["$c"],"tmdbId":1426964,"runtime":"$undefined","seasons":"$undefined"},{"id":2503,"title":"El ultimátum de Bourne","originalTitle":"El ultimátum de Bourne","overview":"Jason Bourne sigue investigando quién es y qué hay realmente detrás del programa secreto de la CIA llamado Treadstone. Ahora un reportero británico de \"The Guardian\" le pone sobre una nueva pista con el nombre de Blackbriar. Bourne dará con él en Londres, en un intento de encajar las últimas piezas de ese pasado que él aún intenta recuperar.","posterPath":"https://image.tmdb.org/t/p/w500/ifuhCKw2DZ3ROlz7oSFxtJnznR7.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/qiBILuWhv7ipF0pxiEqIJdkQzj8.jpg","voteAverage":7.4,"voteCount":8342,"releaseDate":"2007-08-03","genres":["Acción","Drama","Misterio","Suspense"],"type":"movie","platforms":["$c"],"tmdbId":2503,"runtime":"$undefined","seasons":"$undefined"},{"id":398978,"title":"El irlandés","originalTitle":"El irlandés","overview":"Pennsylvania, 1956. Frank Sheeran, un veterano de guerra de origen irlandés que trabaja como camionero, conoce accidentalmente al mafioso Russell Bufalino. Una vez convertido en su hombre de confianza, Bufalino envía a Frank a Chicago con el encargo de ayudar a Jimmy Hoffa, un poderoso líder sindical relacionado con el crimen organizado, con quien Frank mantendrá una estrecha amistad durante casi veinte años.","posterPath":"https://image.tmdb.org/t/p/w500/sNilmIAwBbH0DmBOWBS6gWvNDex.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/1RDto0tLo8Fhq7OcwgDaM7nECb7.jpg","voteAverage":7.6,"voteCount":7491,"releaseDate":"2019-11-01","genres":["Crimen","Drama","Historia"],"type":"movie","platforms":["$c"],"tmdbId":398978,"runtime":"$undefined","seasons":"$undefined"},{"id":1173558,"title":"El lado dulce de la traición","originalTitle":"El lado dulce de la traición","overview":"En esta adaptación del libro de Sue Hecker, una contable ve la traición de su pareja como una oportunidad para vivir un despertar sexual... con consecuencias peligrosas.","posterPath":"https://image.tmdb.org/t/p/w500/2GlfW6wbvUvX7Z2dUv4ZI70TjLe.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/a65WMR49PnWmSaCzaCyMNNHKQfn.jpg","voteAverage":6.2,"voteCount":242,"releaseDate":"2023-10-25","genres":["Drama","Misterio","Romance"],"type":"movie","platforms":["$c"],"tmdbId":1173558,"runtime":"$undefined","seasons":"$undefined"},{"id":9928,"title":"Robots","originalTitle":"Robots","overview":"Rodney Hojalata es un joven y genial inventor que sueña con hacer del mundo un lugar mejor. Cappy es una atractiva ejecutiva robot de la que Rodney se queda prendado al instante. Ratchet es el tirano corporativo; y luego está el Gran Soldador, un magistral inventor que ha perdido el norte … hasta que tropieza con el irreprimible soñador de Rodney. Además está un grupo de robots inadaptados conocidos como los Oxidados liderados por Manivela.","posterPath":"https://image.tmdb.org/t/p/w500/e5GTdGwZAvaPgO8kOEsGltzgIUX.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/8p4gCdDT55PMY3UMDvo6ybzMrai.jpg","voteAverage":6.5,"voteCount":4903,"releaseDate":"2005-03-10","genres":["Animación","Comedia","Familia","Ciencia ficción"],"type":"movie","platforms":["$c"],"tmdbId":9928,"runtime":"$undefined","seasons":"$undefined"},{"id":545609,"title":"Tyler Rake","originalTitle":"Tyler Rake","overview":"Tyler Rake, un intrépido mercenario que ofrece sus servicios en el mercado negro, emprende una peligrosa misión cuando es contratado para rescatar al hijo secuestrado de un señor del crimen de Bombay.","posterPath":"https://image.tmdb.org/t/p/w500/cNu6VozUfD9jjQUjGuGBRoMlpYA.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/1R6cvRtZgsYCkh8UFuWFN33xBP4.jpg","voteAverage":7.3,"voteCount":6590,"releaseDate":"2020-04-23","genres":["Acción","Suspense"],"type":"movie","platforms":["$c"],"tmdbId":545609,"runtime":"$undefined","seasons":"$undefined"},{"id":982843,"title":"El gran diluvio","originalTitle":"El gran diluvio","overview":"En el que podría ser el último día en la Tierra, una lucha a vida o muerte en un piso inundado se convierte en la única esperanza de supervivencia de la humanidad.","posterPath":"https://image.tmdb.org/t/p/w500/qIzSyT2AmDxkcQ0zOAeTbtZR9EQ.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/218MafWtM9XpPRuNdh0uhrNezi5.jpg","voteAverage":6,"voteCount":691,"releaseDate":"2025-09-18","genres":["Ciencia ficción","Aventura","Drama"],"type":"movie","platforms":["$c"],"tmdbId":982843,"runtime":"$undefined","seasons":"$undefined"},{"id":814338,"title":"El amante de Lady Chatterley","originalTitle":"El amante de Lady Chatterley","overview":"Adaptación de la novela de D.H. Lawrence sobre una mujer que rompe con las formas y tradiciones de su tiempo cuando se desenamora de su marido y comienza una tórrida aventura con un hombre que trabaja en su finca inglesa.","posterPath":"https://image.tmdb.org/t/p/w500/6N5UH8fn7bJJKXXfGDdNikwoY33.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/tPKmDydEzqJPj5yol2zFCrraUcM.jpg","voteAverage":6.7,"voteCount":517,"releaseDate":"2022-11-22","genres":["Drama","Romance"],"type":"movie","platforms":["$c"],"tmdbId":814338,"runtime":"$undefined","seasons":"$undefined"},{"id":10515,"title":"El castillo en el cielo","originalTitle":"El castillo en el cielo","overview":"La huérfana Sheeta ha heredado un misterioso cristal que la une al mítico reino de las nubes de Laputa. Con la ayuda del  ingenioso Pazu y una graciosa banda de piratas del cielo, dirige su camino hacia las ruinas de la que fué, una gran civilización. Sheeta y Pazu deben ser más listos que el malvado Muska, quien planea usar la tecnología de Laputa para dominar el mundo.","posterPath":"https://image.tmdb.org/t/p/w500/6EkloGi5FUtPLZl5NtGvVGIfX0B.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/z6OZ2Q4FYELeGoBj9tVDWCvevkj.jpg","voteAverage":8,"voteCount":4671,"releaseDate":"1986-08-02","genres":["Aventura","Fantasía","Animación","Acción","Familia"],"type":"movie","platforms":["$c"],"tmdbId":10515,"runtime":"$undefined","seasons":"$undefined"},{"id":6114,"title":"Drácula de Bram Stoker","originalTitle":"Drácula de Bram Stoker","overview":"Antes de convertirse en vampiro, el conde Drácula era el príncipe Vlad, quien tras conocer la muerte de su prometida, vendió su alma al diablo. Cuatro siglos después, en Londres, encuentra a Mina, reencarnación de su amor perdido.","posterPath":"https://image.tmdb.org/t/p/w500/3D4UhX6dzfBTHdVWkgjadcl8YkW.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/jhs21DDKZM6J9k448R1m0w67pD.jpg","voteAverage":7.5,"voteCount":5747,"releaseDate":"1992-11-13","genres":["Romance","Terror"],"type":"movie","platforms":["$c"],"tmdbId":6114,"runtime":"$undefined","seasons":"$undefined"},{"id":917496,"title":"Bitelchús Bitelchús","originalTitle":"Bitelchús Bitelchús","overview":"Tras una inesperada tragedia familiar, tres generaciones de la familia Deetz regresan a Winter River. La vida de Lydia, todavía atormentada por Bitelchús, da un vuelco cuando su rebelde hija adolescente, Astrid, descubre la misteriosa maqueta de la ciudad en el desván y el portal al Más Allá se abre accidentalmente. Con los problemas que se avecinan en ambos reinos, es sólo cuestión de tiempo que alguien diga el nombre de Bitelchús tres veces y el travieso demonio regrese para desatar su propio caos.","posterPath":"https://image.tmdb.org/t/p/w500/kWJw7dCWHcfMLr0irTHAPIKrJ4I.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/kF8ljC7Y4p1UsmKBi2LxelZpqw.jpg","voteAverage":6.9,"voteCount":3104,"releaseDate":"2024-09-04","genres":["Comedia","Fantasía","Terror"],"type":"movie","platforms":["$c"],"tmdbId":917496,"runtime":"$undefined","seasons":"$undefined"},{"id":9631,"title":"Negociador","originalTitle":"Negociador","overview":"Víctima de una compleja conspiración, Danny Roman, un experto negociador de la policía especializado en secuestros, se ve obligado a tomar rehenes con el fin de probar su inocencia. Además, con la ayuda de un prestigioso colega, intentará descubrir quién está detrás de la trampa que le han tendido.","posterPath":"https://image.tmdb.org/t/p/w500/xW1Q1hm4yTViK8ogiVQ32tq9sbi.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/y4TbQOC9DCzZop9HwKuX73rKbYO.jpg","voteAverage":7.1,"voteCount":2371,"releaseDate":"1998-07-29","genres":["Acción","Crimen","Drama","Suspense"],"type":"movie","platforms":["$c"],"tmdbId":9631,"runtime":"$undefined","seasons":"$undefined"},{"id":1678844,"title":"Le Bus : Les Bleus en grève","originalTitle":"Le Bus : Les Bleus en grève","overview":"Sin descripción disponible.","posterPath":"https://image.tmdb.org/t/p/w500/xy5oC3dWw2OuSUHXIBPm6XQLk8n.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/dTEbfFiaYupyhgFg9ZC4NpH5p8G.jpg","voteAverage":7.1,"voteCount":20,"releaseDate":"2026-05-13","genres":["Documental"],"type":"movie","platforms":["$c"],"tmdbId":1678844,"runtime":"$undefined","seasons":"$undefined"},{"id":608,"title":"Hombres de negro II","originalTitle":"Hombres de negro II","overview":"El agente J es enviado para encontrar al agente K y devolverle la memoria tras la reaparición de un caso del pasado de K.","posterPath":"https://image.tmdb.org/t/p/w500/zX1Hi0j7Yn4jv2eDHyIMlHP8lDb.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/o1l6OCqA3pYDZHIc5L1s7CEzCMv.jpg","voteAverage":6.4,"voteCount":10625,"releaseDate":"2002-07-03","genres":["Acción","Comedia","Ciencia ficción"],"type":"movie","platforms":["$c"],"tmdbId":608,"runtime":"$undefined","seasons":"$undefined"},{"id":9023,"title":"Spirit: El corcel indomable","originalTitle":"Spirit: El corcel indomable","overview":"Sigue las aventuras de un corcel mustang salvaje e ingobernable que recorre la indómita frontera norteamericana. Cuando encuentra a un hombre por primera vez, un joven de la tribu de los Lakota llamado Little Creek, Spirit se niega a dejarse domar por él pero sí se hace amigo suyo. El valiente corcel también encuentra el amor con una hermosa yegua llamada Rain. Spirit se conviertirá en uno de los grandes héroes anónimos del Viejo Oeste.","posterPath":"https://image.tmdb.org/t/p/w500/gNRQdU3KEsYTIl4y9Xte3onUSsx.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/b8hPBW0NJmiIVzvQjT3CwIpAdzl.jpg","voteAverage":7.7,"voteCount":4879,"releaseDate":"2002-05-24","genres":["Animación","Aventura","Familia","Drama","Western"],"type":"movie","platforms":["$c"],"tmdbId":9023,"runtime":"$undefined","seasons":"$undefined"},{"id":2668,"title":"Sleepy Hollow (El Jinete sin Cabeza)","originalTitle":"Sleepy Hollow (El Jinete sin Cabeza)","overview":"Durante la Guerra de Secesión Americana, un policía de Nueva York que utiliza avanzados métodos de investigación es enviado al pueblo de Sleepy Hollow para descubrir qué hay de verdad en la leyenda de un jinete sin cabeza que aterroriza a los habitantes del lugar. Una vez allí adopta la identidad de un profesor de escuela y se enamora de Katrina, que mantiene relaciones con uno de los hombres más conocidos del pueblo. Realidad y ficción se darán la mano en el momento menos pensado.","posterPath":"https://image.tmdb.org/t/p/w500/sEsDyXI4LTjS0RmlUehHUGI7Xny.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/m8t7K3LcAY7bpyQ7iQ5kGsrcjnh.jpg","voteAverage":7.2,"voteCount":7347,"releaseDate":"1999-11-19","genres":["Fantasía","Suspense","Misterio","Terror"],"type":"movie","platforms":["$c"],"tmdbId":2668,"runtime":"$undefined","seasons":"$undefined"},{"id":81,"title":"Nausicaä del valle del viento","originalTitle":"Nausicaä del valle del viento","overview":"En un futuro lejano, en un mundo post-apocalíptico, la Tierra está cubierta por unos bosques llenos de hongos venenosos e insectos gigantescos. Los humanos han quedado reducidos a unos pocos pueblos aislados que intentan sobrevivir a la plaga mientras luchan entre ellos. En medio de todo esto la princesa Nausicaä, del Valle del Viento, quien ama a los insectos, buscará comprender el origen del problema y conseguir la paz entre los hombres, y sobre todo entre éstos y el bosque.","posterPath":"https://image.tmdb.org/t/p/w500/z7vvu0n1F8pXQtmE113Gwd5KhRN.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/ulVUa2MvnJAjAeRt7h23FFJVRKH.jpg","voteAverage":8,"voteCount":4058,"releaseDate":"1984-03-11","genres":["Aventura","Animación","Fantasía"],"type":"movie","platforms":["$c"],"tmdbId":81,"runtime":"$undefined","seasons":"$undefined"},{"id":360920,"title":"El Grinch","originalTitle":"El Grinch","overview":"El Grinch, la película de animación basada en el popular clásico navideño del Dr. Seuss, cuenta la historia de un cínico cascarrabias que se propone robar la Navidad hasta que el desbordante espíritu navideño de una niña le hace cambiar de opinión. Divertida, enternecedora y visualmente impactante, se trata de una historia universal sobre el indómito poder del optimismo.","posterPath":"https://image.tmdb.org/t/p/w500/o3b6DOiePNlNOiqLCzCvqvDvHpL.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/5lWIYxYEqWi8j3ZloxXntw3ImBo.jpg","voteAverage":6.9,"voteCount":4430,"releaseDate":"2018-11-08","genres":["Animación","Comedia","Familia","Fantasía"],"type":"movie","platforms":["$c"],"tmdbId":360920,"runtime":"$undefined","seasons":"$undefined"}],"series":[{"id":79744,"title":"The Rookie","originalTitle":"The Rookie","overview":"Comenzar de nuevo no es fácil, especialmente para el chico de una ciudad pequeña John Nolan que, después de un incidente que cambia su vida, está persiguiendo su sueño de ser un oficial de policía de Los Ángeles. Como el novato más viejo de la fuerza, se ha encontrado con el escepticismo de algunos de los superiores que lo ven como una crisis ambulante.","posterPath":"https://image.tmdb.org/t/p/w500/g39Rn6PcZjK2yLzz5Z5oBKSpsZR.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/6iNWfGVCEfASDdlNb05TP5nG0ll.jpg","voteAverage":8.5,"voteCount":3216,"releaseDate":"2018-10-16","genres":["Crimen","Drama","Comedia"],"type":"series","platforms":["$c"],"tmdbId":79744,"runtime":"$undefined","seasons":"$undefined"},{"id":2734,"title":"Ley y orden: Unidad de Víctimas Especiales","originalTitle":"Ley y orden: Unidad de Víctimas Especiales","overview":"‘Ley y Orden: Unidad de Víctimas Especiales’ es una serie de televisión estadounidense grabada en Nueva York donde es también principalmente producida. Con el estilo de la original ‘Ley y Orden’ los episodios son usualmente \"sacados de los titulares\" o basados libremente en verdaderos asesinatos que han recibido la atención de los medios.","posterPath":"https://image.tmdb.org/t/p/w500/kvo558UKEhp8v3JoRGCSIx3Xxab.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/obtdxPgmfykYwVnvuYXC5f2xKlQ.jpg","voteAverage":7.9,"voteCount":4195,"releaseDate":"1999-09-20","genres":["Crimen","Drama","Misterio"],"type":"series","platforms":["$c"],"tmdbId":2734,"runtime":"$undefined","seasons":"$undefined"},{"id":5920,"title":"El mentalista","originalTitle":"El mentalista","overview":"El mentalista es una serie policiaca americana sobre Patrick Jane, ex médium, que trabaja de asesor para la Oficina de Investigación de California (California Bureau of Investigation), usando su altamente desarrollada capacidad de observación, que anteriormente usaba para \"leer\" mentes.","posterPath":"https://image.tmdb.org/t/p/w500/snKUzvCl3kGv0RWBjEjnOXMGvdl.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/q3pCsNvJ7CmdJUz2sJEEUY3pOPC.jpg","voteAverage":8.3,"voteCount":4284,"releaseDate":"2008-09-23","genres":["Crimen","Drama","Misterio"],"type":"series","platforms":["$c"],"tmdbId":5920,"runtime":"$undefined","seasons":"$undefined"},{"id":308014,"title":"Berlín y la dama del armiño","originalTitle":"Berlín y la dama del armiño","overview":"Ansioso por dar un nuevo golpe, Berlín reúne a su banda en Sevilla y convierte a un ambicioso duque en víctima de su propio plan: robar una obra de arte de Leonardo da Vinci.","posterPath":"https://image.tmdb.org/t/p/w500/3uhJ3AHKxSsEWe1BUG9pV0bpqna.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/ntPgSYKwPg9xKO4VvLJYfInSyZa.jpg","voteAverage":7.9,"voteCount":35,"releaseDate":"2026-05-15","genres":["Drama","Crimen"],"type":"series","platforms":["$c"],"tmdbId":308014,"runtime":"$undefined","seasons":"$undefined"},{"id":259837,"title":"Los SUPERfrikis","originalTitle":"Los SUPERfrikis","overview":"En esta disparatada comedia de acción, un grupo de vecinos de lo más pintoresco adquieren superpoderes por accidente y luchan contra el mal en plena histeria apocalíptica.","posterPath":"https://image.tmdb.org/t/p/w500/zEZuIW4UDU9OHTwN7zMf8BE5tOF.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/810mXC0xkxXVtoKIPGGVgO9PuLh.jpg","voteAverage":9.4,"voteCount":35,"releaseDate":"2026-05-15","genres":["Action & Adventure","Comedia","Sci-Fi & Fantasy","Drama"],"type":"series","platforms":["$c"],"tmdbId":259837,"runtime":"$undefined","seasons":"$undefined"},{"id":1911,"title":"Bones","originalTitle":"Bones","overview":"Una antropóloga forense y un engreído agente del FBI forman equipo para investigar las causas de los homicidios que investigan.","posterPath":"https://image.tmdb.org/t/p/w500/eyTu5c8LniVciRZIOSHTvvkkgJa.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/4AXxajuAz9tHAOe6h5zDg8z1X2s.jpg","voteAverage":8.2,"voteCount":3478,"releaseDate":"2005-09-13","genres":["Crimen","Drama"],"type":"series","platforms":["$c"],"tmdbId":1911,"runtime":"$undefined","seasons":"$undefined"},{"id":1408,"title":"House","originalTitle":"House","overview":"House M. D. es un drama médico Estadounidense que se emitió originalmente por la cadena Fox durante ocho temporadas, desde el 16 de noviembre de 2004 al 21 de mayo de 2012. El protagonista de la serie es el Dr. Gregory House, un médico nada convencional, genio, misántropo y adicto a las drogas que dirige un equipo de diagnósticos en el \"Princeton-Plainsboro Teaching Hospital\" (nombre ficticio) en Nueva Jersey.","posterPath":"https://image.tmdb.org/t/p/w500/lW7MvZ4m49IUj2UrUu4z0xVVl81.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/r0Q6eeN9L1ORL9QsV0Sg8ZV3vnv.jpg","voteAverage":8.6,"voteCount":7561,"releaseDate":"2004-11-16","genres":["Drama"],"type":"series","platforms":["$c"],"tmdbId":1408,"runtime":"$undefined","seasons":"$undefined"},{"id":34307,"title":"Shameless","originalTitle":"Shameless","overview":"En la peculiar familia Gallagher, Frank, un padre soltero y alcohólico, intenta educar a sus seis inteligentes, salvajes e independientes hijos.\n\nEs un remake estadounidense de la serie británica del mismo nombre.","posterPath":"https://image.tmdb.org/t/p/w500/ifo31fMWLmyOVpdak9K0kY4jldQ.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/5s9XHTB9SLPdg3mNU6BlSLnZ9Qq.jpg","voteAverage":8.2,"voteCount":3309,"releaseDate":"2011-01-09","genres":["Drama","Comedia"],"type":"series","platforms":["$c"],"tmdbId":34307,"runtime":"$undefined","seasons":"$undefined"},{"id":56570,"title":"Outlander","originalTitle":"Outlander","overview":"Sigue la historia de Claire Randall, una enfermera de combate casada en los años 40, que misteriosamente es arrastrada atrás en el tiempo hasta 1743, donde se lanza de inmediato a un mundo desconocido, viéndose amenazada su propia vida. Cuando se ve obligada a casarse con Jamie Fraser, un joven guerrero escocés caballeroso y romántico, Claire comienza un pasional triángulo entre dos hombres muy diferentes con dos vidas irreconciliables.","posterPath":"https://image.tmdb.org/t/p/w500/wwxKbrMlwMrC06B7aCIkDy3SAo6.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/nf3Vlxm3C9U1aKUUQHmKFZmxPSc.jpg","voteAverage":8.2,"voteCount":2854,"releaseDate":"2014-08-09","genres":["Drama","Sci-Fi & Fantasy"],"type":"series","platforms":["$c"],"tmdbId":56570,"runtime":"$undefined","seasons":"$undefined"},{"id":66732,"title":"Stranger Things","originalTitle":"Stranger Things","overview":"A raíz de la desaparición de un niño, un pueblo desvela un misterio relacionado con experimentos secretos, fuerzas sobrenaturales aterradoras y una niña muy extraña.","posterPath":"https://image.tmdb.org/t/p/w500/1sRJ8D1vpXE5WQBGrUBky3uUwvX.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/56v2KjBlU4XaOv9rVYEQypROD7P.jpg","voteAverage":8.6,"voteCount":21161,"releaseDate":"2016-07-15","genres":["Action & Adventure","Misterio","Sci-Fi & Fantasy"],"type":"series","platforms":["$c"],"tmdbId":66732,"runtime":"$undefined","seasons":"$undefined"},{"id":73586,"title":"Yellowstone","originalTitle":"Yellowstone","overview":"John Dutton es el propietario del rancho más grande de Estados Unidos. Él y sus hijos entablarán una lucha sin cuartel contra una reserva india y contra el Gobierno federal de Estados Unidos que intenta expandir el parque nacional contiguo a la propiedad de los Dutton.","posterPath":"https://image.tmdb.org/t/p/w500/peNC0eyc3TQJa6x4TdKcBPNP4t0.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/ynSOcgDLZfdLCZfRSYZGiTgYJVo.jpg","voteAverage":8.3,"voteCount":3104,"releaseDate":"2018-06-20","genres":["Western","Drama"],"type":"series","platforms":["$c"],"tmdbId":73586,"runtime":"$undefined","seasons":"$undefined"},{"id":1396,"title":"Breaking Bad","originalTitle":"Breaking Bad","overview":"Un profesor de química con cáncer terminal se asocia con un exalumno suyo para fabricar y vender metanfetamina a fin de que su familia no pase apuros económicos.","posterPath":"https://image.tmdb.org/t/p/w500/ztkUQFLlC19CCMYHW9o1zWhJRNq.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/tsRy63Mu5cu8etL1X7ZLyf7UP1M.jpg","voteAverage":8.9,"voteCount":17727,"releaseDate":"2008-01-20","genres":["Drama","Crimen"],"type":"series","platforms":["$c"],"tmdbId":1396,"runtime":"$undefined","seasons":"$undefined"},{"id":65334,"title":"Prodigiosa: Las aventuras de Ladybug","originalTitle":"Prodigiosa: Las aventuras de Ladybug","overview":"Cuando París corre peligro, Marinette se convierte en Ladybug. Lo que no sabe, es que su apuesto amigo Adrien es Cat Noir, otro superhéroe al servicio de la ciudad.","posterPath":"https://image.tmdb.org/t/p/w500/z9n5ZOECtbug5h07kq7RxoLRBOZ.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/lH22EnM0ofC7GsVGU8dAA2RXV1c.jpg","voteAverage":8.1,"voteCount":4580,"releaseDate":"2015-10-19","genres":["Action & Adventure","Animación","Kids"],"type":"series","platforms":["$c"],"tmdbId":65334,"runtime":"$undefined","seasons":"$undefined"},{"id":46952,"title":"The Blacklist","originalTitle":"The Blacklist","overview":"El criminal más buscado del mundo, Thomas Raymond Reddington, se entrega misteriosamente y se ofrece a delatar a todos los que alguna vez han colaborado con él. Su única condición: sólo colaborará con Elisabeth King, una nueva agente del FBI, con quien parece tener alguna conexión que ella desconoce.","posterPath":"https://image.tmdb.org/t/p/w500/2jDYeTaDSIYnVOS4BD3d17JBkfP.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/2eIlCirgcvEwmCSYh2wDfz5Sxvz.jpg","voteAverage":7.6,"voteCount":3559,"releaseDate":"2013-09-23","genres":["Drama","Crimen","Misterio"],"type":"series","platforms":["$c"],"tmdbId":46952,"runtime":"$undefined","seasons":"$undefined"},{"id":60574,"title":"Peaky Blinders","originalTitle":"Peaky Blinders","overview":"Una familia de pandilleros asentada en Birmingham, Reino Unido, tras la Primera Guerra Mundial (1914-1918), dirige un local de apuestas hípicas. Las actividades del ambicioso jefe de la banda llaman la atención del Inspector jefe Chester Campbell, un detective de la Real Policía Irlandesa que es enviado desde Belfast para limpiar la ciudad y acabar con la banda.","posterPath":"https://image.tmdb.org/t/p/w500/zUqNyXRfYkFAFXsqJJjKMZpjYus.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/wiE9doxiLwq3WCGamDIOb2PqBqc.jpg","voteAverage":8.5,"voteCount":11059,"releaseDate":"2013-09-12","genres":["Drama","Crimen"],"type":"series","platforms":["$c"],"tmdbId":60574,"runtime":"$undefined","seasons":"$undefined"},{"id":37680,"title":"Suits: la clave del éxito","originalTitle":"Suits: la clave del éxito","overview":"Michael Ross se gana la vida sobre la delgada línea de la legalidad. Es un joven con una inteligencia abrumadora, pero las malas compañías con las que se junta en la universidad le hicieron salirse y buscar una opción más vistosa a corto plazo, mejorar su economía.\n\nEntre sus triquiñuelas destaca el número de veces que se presenta en nombre de otros a los exámenes de acceso a la facultad de derecho.\n\nEl azar le acabará situando en el despacho de uno de los abogados más jóvenes y brillantes de Manhattan, Harvey Specter.\n\nLa inteligencia y dotes de Michael le asombrarán tanto que le tomará como su pupilo, a pesar de que no tenga la licenciatura. Juntos trabajarán mano a mano, ocultándole al resto del mundo la verdad: que juntos sólo suman un único título universitario.","posterPath":"https://image.tmdb.org/t/p/w500/nZsdLWlvZgA5waLpKl9koRg1VbJ.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/cwKuMNndfjSl8iQIcAISL0C1tDZ.jpg","voteAverage":8.2,"voteCount":5678,"releaseDate":"2011-06-23","genres":["Drama"],"type":"series","platforms":["$c"],"tmdbId":37680,"runtime":"$undefined","seasons":"$undefined"},{"id":4604,"title":"Smallville","originalTitle":"Smallville","overview":"Serie que narra los inicios de Superman -Clark Kent- en su pueblo natal, Smallville. Allí vivía con sus padres, estudiaba en el instituto local y conoció a su primera novia, Lana Lang, y a su futuro rival, Lex Luthor.","posterPath":"https://image.tmdb.org/t/p/w500/mHZSq8LA5Dt48JjaOZ5tcPXQRVN.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/4wVq9ICc4MI2XcssrumpCOhKLpI.jpg","voteAverage":8.2,"voteCount":4443,"releaseDate":"2001-10-16","genres":["Sci-Fi & Fantasy","Action & Adventure","Drama"],"type":"series","platforms":["$c"],"tmdbId":4604,"runtime":"$undefined","seasons":"$undefined"},{"id":1402,"title":"The Walking Dead","originalTitle":"The Walking Dead","overview":"El oficial Rick Grimes se despierta del coma para descubrir que el mundo está en ruinas y debe guiar a un grupo de sobrevivientes para permanecer con vida.","posterPath":"https://image.tmdb.org/t/p/w500/hUblG1KZCTRpHc3wqqoU0DW98Q3.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/rAOjnEFTuNysY7bot8zonhImGMh.jpg","voteAverage":8.1,"voteCount":17775,"releaseDate":"2010-10-31","genres":["Action & Adventure","Drama","Sci-Fi & Fantasy"],"type":"series","platforms":["$c"],"tmdbId":1402,"runtime":"$undefined","seasons":"$undefined"},{"id":2316,"title":"The Office","originalTitle":"The Office","overview":"Steve Carell protagoniza The Office, un fresco y divertido vistazo, con formato pseudo-documental, al día a día en la vida de unos excéntricos trabajadores de la empresa Dunder Mifflin. El serio pero despistadísimo director Michael Scott se considera un magnífico jefe y mentor, pero realmente inspira más críticas que respeto a sus empleados.","posterPath":"https://image.tmdb.org/t/p/w500/5uwetbr0X8BPRy3Wmh63S9EhsiY.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/mLyW3UTgi2lsMdtueYODcfAB9Ku.jpg","voteAverage":8.6,"voteCount":5169,"releaseDate":"2005-03-24","genres":["Comedia"],"type":"series","platforms":["$c"],"tmdbId":2316,"runtime":"$undefined","seasons":"$undefined"},{"id":95479,"title":"Jujutsu Kaisen","originalTitle":"Jujutsu Kaisen","overview":"La vida de Itadori cambia para siempre cuando, para salvar a un compañero de clase, se come el dedo de Ryomen Sukuna y absorbe una poderosa maldición.","posterPath":"https://image.tmdb.org/t/p/w500/80eHrBl03xWcQYecoTO1LlkXpN1.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/lthkKBLe1rX6iThgVFg22O02sJw.jpg","voteAverage":8.6,"voteCount":4416,"releaseDate":"2020-10-03","genres":["Animación","Action & Adventure","Sci-Fi & Fantasy"],"type":"series","platforms":["$c"],"tmdbId":95479,"runtime":"$undefined","seasons":"$undefined"},{"id":4629,"title":"Stargate SG-1","originalTitle":"Stargate SG-1","overview":"Stargate SG-1 es una serie televisiva estadounidense derivada del largometraje de ciencia ficción 'Stargate: Puerta a las Estrellas' (1994). Producida por los estudios Metro Goldwyn Mayer. Esta serie se centra en las vivencias y aventuras de un equipo de militares y científicos miembros de un proyecto ultra-secreto de las Fuerzas Aéreas de los Estados Unidos, que utiliza un ingenio extraterrestre (Stargate) para desplazarse a otros planetas de manera casi instantánea.","posterPath":"https://image.tmdb.org/t/p/w500/dQjmI7XxI47v8IM2MUysHG0LuU2.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/yOyzlRw54oYaGvhUBdPr7TFwtrX.jpg","voteAverage":8.3,"voteCount":1806,"releaseDate":"1997-07-27","genres":["Sci-Fi & Fantasy","Action & Adventure"],"type":"series","platforms":["$c"],"tmdbId":4629,"runtime":"$undefined","seasons":"$undefined"},{"id":235930,"title":"Devil May Cry","originalTitle":"Devil May Cry","overview":"En esta lucha entre el bien y el mal, nada está claro. Pero un cazador de demonios irresistiblemente atractivo podría ser la mejor baza para salvar el mundo.","posterPath":"https://image.tmdb.org/t/p/w500/mX9tqfpjqwreONJHhap7SnSSowe.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/nLyXXIDMpDHvUgxchezxuhoJ4Ej.jpg","voteAverage":8.2,"voteCount":366,"releaseDate":"2025-04-03","genres":["Animación","Action & Adventure","Sci-Fi & Fantasy"],"type":"series","platforms":["$c"],"tmdbId":235930,"runtime":"$undefined","seasons":"$undefined"},{"id":18165,"title":"Crónicas vampíricas","originalTitle":"Crónicas vampíricas","overview":"\"Crónicas Vampíricas\" cuenta la historia de dos hermanos vampiros obsesionados con la misma chica en un pequeño pueblo, donde seres sobrenaturales viven en secreto entre sus residentes.","posterPath":"https://image.tmdb.org/t/p/w500/rKNnzmOA1REgxODY5wVe5UEr70w.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/cJYLon9ejKJV7ua03ab8Tj9u067.jpg","voteAverage":8.3,"voteCount":9586,"releaseDate":"2009-09-10","genres":["Drama","Sci-Fi & Fantasy"],"type":"series","platforms":["$c"],"tmdbId":18165,"runtime":"$undefined","seasons":"$undefined"},{"id":1407,"title":"Homeland","originalTitle":"Homeland","overview":"El sargento de la Marina Nicholas Brody regresa a casa ocho años después de su desaparición en Irak, donde vivió encarcelado y sometido a tortura. Finalmente, un comando de las fuerzas especiales lo localiza durante una misión. La joven Carrie Mathison, una impulsiva e intuitiva agente de la CIA, sospecha que Brody se ha pasado al enemigo durante su cautiverio, pues unos meses antes un terrorista condenado a muerte le habló de un soldado norteamericano que había cambiado de bando.","posterPath":"https://image.tmdb.org/t/p/w500/6GAvS2e6VIRsms9FpVt33PsCoEW.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/391ixi0wVbFtFLQnOy8ZncWv2io.jpg","voteAverage":7.6,"voteCount":2563,"releaseDate":"2011-10-02","genres":["Drama","War & Politics","Crimen"],"type":"series","platforms":["$c"],"tmdbId":1407,"runtime":"$undefined","seasons":"$undefined"},{"id":60735,"title":"The Flash","originalTitle":"The Flash","overview":"Después de que un acelerador de partículas cause una extraña tormenta, al investigador científico de la policía, Barry Allen, le cae un rayo y entra en coma. Meses después despierta con el poder de moverse a súper velocidad permitiéndole ser el ángel de la guardia de Central City. Aunque al principio se siente entusiasmado con sus nuevos poderes, Barry descubre que no es el único “meta-humano” que se originó tras la explosión del acelerador – y no todo el mundo está usando sus nuevos poderes para el bien. Los compañeros del laboratorio STAR dedican su vida a ayudar a Barry a proteger a los inocentes. Por ahora, solo algunos amigos cercanos saben que Barry es, literalmente, el hombre más rápido del mundo, pero no pasará mucho hasta que el mundo conozca que ahora Barry Allen es … Flash.","posterPath":"https://image.tmdb.org/t/p/w500/7ci4qqkBJorLxSBwTj28vwh0bU.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/gFkHcIh7iE5G0oVOgpmY8ONQjhl.jpg","voteAverage":7.8,"voteCount":11591,"releaseDate":"2014-10-07","genres":["Drama","Sci-Fi & Fantasy"],"type":"series","platforms":["$c"],"tmdbId":60735,"runtime":"$undefined","seasons":"$undefined"},{"id":71712,"title":"The Good Doctor","originalTitle":"The Good Doctor","overview":"Un cirujano joven y autista que padece el síndrome del sabio empieza a trabajar en un hospital prestigioso. Allá tendrá que vencer el escepticismo con el que sus colegas lo reciben.","posterPath":"https://image.tmdb.org/t/p/w500/hnrzBrLKekwmSNPL4cJXzhdCX0k.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/f3cin9kOz4nOrlYEMxGFQhv4bdN.jpg","voteAverage":8.5,"voteCount":12821,"releaseDate":"2017-09-25","genres":["Drama"],"type":"series","platforms":["$c"],"tmdbId":71712,"runtime":"$undefined","seasons":"$undefined"},{"id":146176,"title":"Berlín","originalTitle":"Berlín","overview":"En sus días de gloria, Berlín y una banda de ladrones se reunieron en París para ejecutar un ambicioso golpe: robar 44 millones de euros en joyas en una noche.","posterPath":"https://image.tmdb.org/t/p/w500/oFTv9kayoU1xECGct7DgwTZ6Ymy.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/wJxZLiPbXrU601c6e9A6kYLejso.jpg","voteAverage":7.6,"voteCount":647,"releaseDate":"2023-12-29","genres":["Drama","Action & Adventure","Crimen"],"type":"series","platforms":["$c"],"tmdbId":146176,"runtime":"$undefined","seasons":"$undefined"},{"id":71790,"title":"S.W.A.T.: Los hombres de Harrelson","originalTitle":"S.W.A.T.: Los hombres de Harrelson","overview":"La serie sigue a Daniel \"Hondo\" Harrelson, un teniente S.W.A.T. que se ve dividido entre la lealtad a las calles y el deber con sus compañeros oficiales, cuando el agresivo y confiado líder del equipo 10-David SWAT, Jeff Mumford, lo asigna para dirigir una unidad altamente capacitada de la policía, que estará encargada de detener los crímenes en Los Ángeles.","posterPath":"https://image.tmdb.org/t/p/w500/ttzrYMdsKWR8PTRLw7uo4noqaOJ.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/7j4ug9B6JXVeh5HhQjjPScrdj4Z.jpg","voteAverage":8.1,"voteCount":1562,"releaseDate":"2017-11-02","genres":["Crimen","Action & Adventure","Drama"],"type":"series","platforms":["$c"],"tmdbId":71790,"runtime":"$undefined","seasons":"$undefined"},{"id":1411,"title":"Vigilados, Person of Interest","originalTitle":"Vigilados, Person of Interest","overview":"John Reese (J. Caviezel) era un agente de la CIA que resolvía personalmente las misiones más peligrosas, pero ahora es un vagabundo que se ha dado a la bebida. El señor Finch (M. Emerson), un filántropo millonario muy peculiar, le ofrece trabajo con el fin de crear una sociedad muy beneficiosa moralmente para ambos. Finch pone a disposición de Reese un mecanismo capaz de predecir los delitos, lo que le permitirá arrestar a los delincuentes y proteger a los ciudadanos.","posterPath":"https://image.tmdb.org/t/p/w500/A5C2lNBCrL2M0HV73CtSpv3XcFC.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/1UkDX6CK8hJ0oUtUycDTp5Vh9wO.jpg","voteAverage":8.1,"voteCount":2025,"releaseDate":"2011-09-22","genres":["Drama","Action & Adventure","Crimen","Sci-Fi & Fantasy"],"type":"series","platforms":["$c"],"tmdbId":1411,"runtime":"$undefined","seasons":"$undefined"},{"id":46296,"title":"Spartacus","originalTitle":"Spartacus","overview":"Traicionado por su país. Convertido en esclavo. Renacido como guerrero. Spartacus protagoniza la historia más gráfica y visceral del gladiador más famoso de Roma. Con un reparto estelar, asistimos a una mezcla única de acción, efectos gráficos y brutales batallas. Separado del amor de su vida, Spartacus tendrá que luchar por su supervivencia, participando en un espectáculo, donde el principal entretenimiento es la muerte. En un mundo de corrupción, violencia, sexo y fama acabará interviniendo en política y vivirá atormentado por el deseo de venganza.","posterPath":"https://image.tmdb.org/t/p/w500/c2GKN4VHCj1dnjFMANRpGkCVBae.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/zbfXS4o6UykeXsD8djFTyV7Cj4N.jpg","voteAverage":8,"voteCount":2919,"releaseDate":"2010-01-22","genres":["Drama"],"type":"series","platforms":["$c"],"tmdbId":46296,"runtime":"$undefined","seasons":"$undefined"},{"id":63174,"title":"Lucifer","originalTitle":"Lucifer","overview":"La serie se centrará en Lucifer (Tom Ellis) quien, aburrido e infeliz como el Señor del Infierno, dimite de su trono y abandona su reino para trasladarse a la ciudad de Los Angeles y abrir un lujoso piano-bar llamado Lux. Una vez allí ayudará a la policía a castigar a los más peligrosos criminales de la ciudad.","posterPath":"https://image.tmdb.org/t/p/w500/wQh2ytX0f8IfC3b2mKpDGOpGTXS.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/mAXOCbZzvmDa6PCh5dcIPOB51Qc.jpg","voteAverage":8.4,"voteCount":15437,"releaseDate":"2016-01-25","genres":["Crimen","Sci-Fi & Fantasy"],"type":"series","platforms":["$c"],"tmdbId":63174,"runtime":"$undefined","seasons":"$undefined"},{"id":60059,"title":"Better Call Saul","originalTitle":"Better Call Saul","overview":"Esta precuela de \"Breaking Bad\" nominada al Emmy narra la vida del picapleitos Jimmy McGill y su transformación en Saul Goodman, el abogado de moral laxa.","posterPath":"https://image.tmdb.org/t/p/w500/zjg4jpK1Wp2kiRvtt5ND0kznako.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/og2jKploGHYnCz68vV1nRSEE0xV.jpg","voteAverage":8.7,"voteCount":6457,"releaseDate":"2015-02-08","genres":["Crimen","Drama"],"type":"series","platforms":["$c"],"tmdbId":60059,"runtime":"$undefined","seasons":"$undefined"},{"id":60572,"title":"Pokémon (Pokemon)","originalTitle":"Pokémon (Pokemon)","overview":"La serie narra las aventuras del joven entrenador Pokemon de diez años Ash Ketchum, que decide comenzar su aventura para llegar a convertirse un día en un gran Maestro de Pokemon. Para ello deberá recorrer distintas regiones, capturar cuantos más pokemon pueda, y conseguir las medallas de gimnasio necesarias y así participar en la Liga Pokemon, ganarla y así estar un paso más cerca de convertirse en Maestro Pokemon. Para ello cuenta con la ayuda de Pikachu, su primer pokemon, que obtuvo de manos del Profesor Oak. En su recorrido conocerá y hará nuevos amigos, como Brock o Misty, que le acompañarán y ayudarán para conseguir alcanzar su sueño.","posterPath":"https://image.tmdb.org/t/p/w500/uoBwsiZNyOFDBh9WdDhpxc2JERM.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/yYpQV25I7XB6S0POJOScPjxYWV5.jpg","voteAverage":8,"voteCount":2166,"releaseDate":"1997-04-01","genres":["Animación","Action & Adventure","Sci-Fi & Fantasy"],"type":"series","platforms":["$c"],"tmdbId":60572,"runtime":"$undefined","seasons":"$undefined"},{"id":44217,"title":"Vikingos","originalTitle":"Vikingos","overview":"Sigue las aventuras de Ragnar Lothbrok, el héroe más grande de su época. La serie narra las sagas de la banda de hermanos vikingos de Ragnar y su familia, cuando él se levanta para convertirse en el rey de las tribus vikingas. Además de ser un guerrero valiente, Ragnar encarna las tradiciones nórdicas de la devoción a los dioses, la leyenda dice que él era un descendiente directo de Odín, el dios de la guerra y los guerreros.","posterPath":"https://image.tmdb.org/t/p/w500/x0BOmMjIslyH9ZP5h2eMOdaZ8QX.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/13kblIK8DnxMurcRDkeyy2sGR7v.jpg","voteAverage":8.1,"voteCount":7604,"releaseDate":"2013-03-03","genres":["Action & Adventure","Drama","War & Politics"],"type":"series","platforms":["$c"],"tmdbId":44217,"runtime":"$undefined","seasons":"$undefined"},{"id":60625,"title":"Rick y Morty","originalTitle":"Rick y Morty","overview":"Comedia animada que narra las aventuras de un científico loco Rick Sánchez, que regresa después de 20 años para vivir con su hija, su marido y sus hijos Morty y Summer.","posterPath":"https://image.tmdb.org/t/p/w500/5Yiep9EwcQgLolg013ETBVqHxuD.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/Ao5pBFuWY32cVuh6iYjEjZMEscN.jpg","voteAverage":8.7,"voteCount":10840,"releaseDate":"2013-12-02","genres":["Animación","Comedia","Sci-Fi & Fantasy","Action & Adventure"],"type":"series","platforms":["$c"],"tmdbId":60625,"runtime":"$undefined","seasons":"$undefined"},{"id":1400,"title":"Seinfeld","originalTitle":"Seinfeld","overview":"El cómico Jerry Seinfeld y sus excéntricos amigos (Constanza, Kramer y Elaine) viven en Nueva York y les pasan innumerables peripecias en esta genial comedia de situación donde la menor excusa sirve para regalarnos un delirante episodio. Batió todos los récords de audiencia que se pusieron por delante, y aún hoy en día sus reposiciones siguen contando con innumerables seguidores, no en vano \"Seinfeld\" es una verdadera leyenda de la televisión americana. \"Media hora acerca de nada\", así definió Jerry Seinfeld su teleserie cuando la presentó a los ejecutivos de la NBC, a comienzos de 1990. Contra todo pronóstico, ellos aceptaron. No en vano Seinfeld era ya por entonces uno de los cómicos más populares de Estados Unidos. ¿Su secreto? Sacar punta a las rutinas de cada día hasta convertirlas en reflexiones filosóficas dignas de figurar en un tratado sobre las grandezas y las miserias humanas.","posterPath":"https://image.tmdb.org/t/p/w500/aCw8ONfyz3AhngVQa1E2Ss4KSUQ.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/tMRdEsMg9MyXAkcufK9YJEeIaNW.jpg","voteAverage":8.3,"voteCount":2322,"releaseDate":"1989-07-05","genres":["Comedia"],"type":"series","platforms":["$c"],"tmdbId":1400,"runtime":"$undefined","seasons":"$undefined"},{"id":285807,"title":"Némesis","originalTitle":"Némesis","overview":"Un implacable policía de Los Ángeles se obsesiona con atrapar al ladrón responsable de una serie de robos... y solo uno puede salir victorioso.","posterPath":"https://image.tmdb.org/t/p/w500/NY7ZwSMw5PjoJdK2CObqiTj7Bm.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/pxnJeLSBdUikUOrWdNgrK1HQy2u.jpg","voteAverage":6.1,"voteCount":26,"releaseDate":"2026-05-14","genres":["Action & Adventure","Drama","Crimen"],"type":"series","platforms":["$c"],"tmdbId":285807,"runtime":"$undefined","seasons":"$undefined"},{"id":57532,"title":"La Patrulla Canina","originalTitle":"La Patrulla Canina","overview":"Protagonizada por 6 heroicos cachorros: Chase, Marshall, Rocky, Zuma, Rubble y Skye, que son entrenados y dirigidos por Ryder, un niño de 10 años que los rescató y les enseñó a utilizar sus habilidades para ayudar a los demás, formando la patrulla canina.","posterPath":"https://image.tmdb.org/t/p/w500/aTDo8zoo3wOW789rWYfHT83ufJ9.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/7OrV2aAH5Yp7hA9zCCvUloLvZtl.jpg","voteAverage":7,"voteCount":808,"releaseDate":"2013-08-12","genres":["Animación","Kids"],"type":"series","platforms":["$c"],"tmdbId":57532,"runtime":"$undefined","seasons":"$undefined"},{"id":210268,"title":"Cenizas del pasado","originalTitle":"Cenizas del pasado","overview":"Su madre asumió la culpa de un trágico incendio hace 13 años. Ahora, Anzu se infiltra como ama de llaves en el hogar de su fría madrastra para vengarse.","posterPath":"https://image.tmdb.org/t/p/w500/AurLEp91XVWnkgRsn5dR5vkPFYM.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/g0UxlBGBBFTYgv4Gk2b3ZlZCjQa.jpg","voteAverage":7.2,"voteCount":68,"releaseDate":"2023-07-13","genres":["Drama","Misterio"],"type":"series","platforms":["$c"],"tmdbId":210268,"runtime":"$undefined","seasons":"$undefined"},{"id":71728,"title":"El joven Sheldon","originalTitle":"El joven Sheldon","overview":"En esta serie derivada de 'Big Bang', Sheldon Cooper tiene 9 años y se salta cuatro cursos para entrar directamente a la secundaria junto con su hermano mayor, menos listo que él. La vida en ella no será fácil, ya que sus compañeros, sus padres, su hermana melliza, su abuela y sus vecinos no entienden a Sheldon.","posterPath":"https://image.tmdb.org/t/p/w500/Jxl5Z1JBWnd2JWJUgYsm8FIzG4.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/nlDBlCtorM7nx130wYnfR5ZmyLX.jpg","voteAverage":8,"voteCount":2964,"releaseDate":"2017-09-25","genres":["Comedia","Familia","Drama"],"type":"series","platforms":["$c"],"tmdbId":71728,"runtime":"$undefined","seasons":"$undefined"},{"id":209867,"title":"Frieren: Tras finalizar el viaje","originalTitle":"Frieren: Tras finalizar el viaje","overview":"Décadas después de que su grupo derrotara al Rey Demonio, el funeral de un viejo amigo lleva a la hechicera elfa Frieren a embarcarse en un viaje de autodescubrimiento.","posterPath":"https://image.tmdb.org/t/p/w500/3NyQpXmkaBVWgYM8miDHEFqGMCB.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/rBOnrVlck7BIlGeWVlzYiZeg4l2.jpg","voteAverage":8.8,"voteCount":815,"releaseDate":"2023-09-29","genres":["Animación","Action & Adventure","Drama","Sci-Fi & Fantasy"],"type":"series","platforms":["$c"],"tmdbId":209867,"runtime":"$undefined","seasons":"$undefined"},{"id":78191,"title":"You","originalTitle":"You","overview":"Cuando un brillante administrador de librería se cruza con un aspirante a escritor, utiliza Internet y las redes sociales para reunir los detalles más íntimos y acercarse a ella. Un enamoramiento encantador e incómodo rápidamente se convierte en obsesión mientras quita silenciosamente y estratégicamente cada obstáculo, y persona, en su camino.","posterPath":"https://image.tmdb.org/t/p/w500/30vdq2GJKUgYW3utQnXDOiE6tvn.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/gzOIymABxmetAECXtazEYCpMmfb.jpg","voteAverage":8,"voteCount":3911,"releaseDate":"2018-09-09","genres":["Misterio","Crimen","Drama"],"type":"series","platforms":["$c"],"tmdbId":78191,"runtime":"$undefined","seasons":"$undefined"},{"id":200709,"title":"Un héroe débil","originalTitle":"Un héroe débil","overview":"Yeon Shi Eun, un estudiante modelo con calificaciones que pertenecen al 1% superior de la escuela. Se ve débil pero lucha contra numerosas violencias dentro y fuera de la escuela. Representa a un chico naturalmente débil en términos de apariencia, dominando una escuela parecida a una jungla usando su cerebro, poder analítico y herramientas.","posterPath":"https://image.tmdb.org/t/p/w500/wmYQAByUOf3mQp0xOQa0Xkf5ea1.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/cLTAda6fMRirkCY1xfO4pmcHVkk.jpg","voteAverage":8.7,"voteCount":416,"releaseDate":"2022-11-18","genres":["Action & Adventure","Drama"],"type":"series","platforms":["$c"],"tmdbId":200709,"runtime":"$undefined","seasons":"$undefined"},{"id":34524,"title":"Teen Wolf","originalTitle":"Teen Wolf","overview":"Un animal muerde a un chico y lo convierte en hombre lobo. De repente, es el rey del deporte y de las chicas del instituto. Pero también afronta nuevos problemas.","posterPath":"https://image.tmdb.org/t/p/w500/ycj1ReH56364LiubRLLS4mY7hJw.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/1F2RnXLc0fmRt7iWfBK4mNVsjno.jpg","voteAverage":8.5,"voteCount":4699,"releaseDate":"2011-06-05","genres":["Sci-Fi & Fantasy","Drama","Comedia"],"type":"series","platforms":["$c"],"tmdbId":34524,"runtime":"$undefined","seasons":"$undefined"},{"id":4656,"title":"Raw","originalTitle":"Raw","overview":"Sin descripción disponible.","posterPath":"https://image.tmdb.org/t/p/w500/fstEe6RsyNyPUnMwNcL20iNl0nE.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/eGPH1IwktalozwCmeLTp3aPbHGC.jpg","voteAverage":6.8,"voteCount":356,"releaseDate":"1993-01-11","genres":["Reality"],"type":"series","platforms":["$c"],"tmdbId":4656,"runtime":"$undefined","seasons":"$undefined"},{"id":37854,"title":"One Piece","originalTitle":"One Piece","overview":"Esta historia se sitúa en el momento más álgido de la Gran Era de los Piratas, cuando el joven Monkey D. Luffy quiere llegar a ser el Rey de los Piratas y hacerse al fin con un legendario tesoro, el One Piece.","posterPath":"https://image.tmdb.org/t/p/w500/8f33Q5AuM2G5ZqFeusbIqDjr3cI.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/4Mt7WHox67uJ1yErwTBFcV8KWgG.jpg","voteAverage":8.7,"voteCount":5292,"releaseDate":"1999-10-20","genres":["Action & Adventure","Comedia","Animación"],"type":"series","platforms":["$c"],"tmdbId":37854,"runtime":"$undefined","seasons":"$undefined"},{"id":91239,"title":"Los Bridgerton","originalTitle":"Los Bridgerton","overview":"Ambientada en la alta sociedad londinense de principios del siglo XIX, la historia se centra en la familia Bridgerton, formada por varios hermanos y hermanas que se debaten entre el amor, el deber y la vocación. Cada temporada refleja la vida amorosa de un hermano Bridgerton, empezando por Daphne y siguiendo por Anthony, Colin y Benedict.","posterPath":"https://image.tmdb.org/t/p/w500/4MQf8yWM47OVjjtxRdhc1SzoZVE.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/6umsRLI7t0ydFwCl0JNEIO0q2LH.jpg","voteAverage":8.1,"voteCount":3289,"releaseDate":"2020-12-25","genres":["Drama"],"type":"series","platforms":["$c"],"tmdbId":91239,"runtime":"$undefined","seasons":"$undefined"},{"id":127529,"title":"Perros de caza","originalTitle":"Perros de caza","overview":"Dos jóvenes boxeadores se alían con un prestamista benévolo para acabar con un despiadado usurero que se aprovecha de los más endeudados... y desesperados.","posterPath":"https://image.tmdb.org/t/p/w500/5utMaM6TGm2GhlmauFFS2BTnuPP.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/zhsEnDNCQX5dlI2wbKzV90pV0B9.jpg","voteAverage":8.4,"voteCount":673,"releaseDate":"2023-06-09","genres":["Drama","Action & Adventure","Crimen"],"type":"series","platforms":["$c"],"tmdbId":127529,"runtime":"$undefined","seasons":"$undefined"},{"id":4588,"title":"Urgencias","originalTitle":"Urgencias","overview":"Urgencias fue una serie de televisión producida en Estados Unidos por la cadena NBC. Tiene un perfil dramático. Fue creada por el novelista Michael Crichton. Trata acerca de lo que ocurre en la sala de urgencias del hospital ficticio County General en Cook County, Chicago, Illinois, y de la compleja vida personal de los médicos que trabajan en ella.","posterPath":"https://image.tmdb.org/t/p/w500/bYSE2ER5LZlUAC9RFakZELHGD4u.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/b1t0mS2MAqnMdh5opqi94rlDEjn.jpg","voteAverage":7.8,"voteCount":918,"releaseDate":"1994-09-19","genres":["Drama"],"type":"series","platforms":["$c"],"tmdbId":4588,"runtime":"$undefined","seasons":"$undefined"},{"id":220542,"title":"Los diarios de la boticaria","originalTitle":"Los diarios de la boticaria","overview":"Maomao llevaba una vida tranquila ayudando a su padre, un boticario. Todo cambia el día que la venden como sirvienta al palacio del emperador, pero la vida entre nobles y realeza no es para ella. Cuando la familia imperial enferma, ella decide intervenir para encontrar una cura, lo que llama la atención de Jinshi, un guapo oficial de palacio que decide ascenderla como dama de compañía de una de las concubinas del emperador. ¡Su habilidad con la medicina la hará conocida en el palacio por ayudar a resolver muchos misterios!","posterPath":"https://image.tmdb.org/t/p/w500/bYPACmBf5Nomw3I2IEGGTNwgvWj.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/gffVOVZ2Y9cmVIZ26Gt9ByMGCYH.jpg","voteAverage":8.6,"voteCount":558,"releaseDate":"2023-10-22","genres":["Animación","Drama","Misterio"],"type":"series","platforms":["$c"],"tmdbId":220542,"runtime":"$undefined","seasons":"$undefined"},{"id":93405,"title":"El juego del calamar","originalTitle":"El juego del calamar","overview":"Cientos de personas con problemas de dinero aceptan una invitación rarísima para competir en juegos infantiles. Dentro los esperan un tentador premio y desafíos letales.","posterPath":"https://image.tmdb.org/t/p/w500/g72YfmqUU0AlbDXRiYmDZWs28f7.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/2meX1nMdScFOoV4370rqHWKmXhY.jpg","voteAverage":7.9,"voteCount":17386,"releaseDate":"2021-09-17","genres":["Action & Adventure","Misterio","Drama"],"type":"series","platforms":["$c"],"tmdbId":93405,"runtime":"$undefined","seasons":"$undefined"},{"id":42009,"title":"Black Mirror","originalTitle":"Black Mirror","overview":"Las historias más retorcidas pueblan esta alucinante serie antológica que muestra los peores rasgos de la humanidad, sus mayores innovaciones y mucho más.","posterPath":"https://image.tmdb.org/t/p/w500/6nDRo824oyBwg1prOZHc8UtonVB.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/dg3OindVAGZBjlT3xYKqIAdukPL.jpg","voteAverage":8.3,"voteCount":6163,"releaseDate":"2011-12-04","genres":["Sci-Fi & Fantasy","Drama","Misterio"],"type":"series","platforms":["$c"],"tmdbId":42009,"runtime":"$undefined","seasons":"$undefined"},{"id":12225,"title":"Peppa Pig","originalTitle":"Peppa Pig","overview":"La protagonista de esta serie es Peppa, una cerdita de rasgos antropomórficos que vive con su hermanito George y sus padres: Mamá (Mummy) Pig y Papá (Daddy) Pig. Tiene como escenario principal su hogar, es ahí donde ocurren las tramas de los episodios. En algunos episodios, se muestra a su familia saliendo de casa, paseando con su coche, en casa de sus amigos o estando ya en otro lugar.","posterPath":"https://image.tmdb.org/t/p/w500/iwKVo3HlsyVNXCzFEkd0xHz3kGi.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/fnyS6gOv9tTjhHPl4A1aKEDgWEG.jpg","voteAverage":6.5,"voteCount":746,"releaseDate":"2004-05-31","genres":["Animación","Kids"],"type":"series","platforms":["$c"],"tmdbId":12225,"runtime":"$undefined","seasons":"$undefined"},{"id":46298,"title":"Hunter × Hunter","originalTitle":"Hunter × Hunter","overview":"Gon Frecks, un niño de 12 años, vive con su tía Mito y su abuela en Isla Ballena, huérfano de madre y según su tía también de padre. Un día Gon es atacado por un oso del bosque, pero es salvado por un cazador quien le explica que está en busca de su maestro para así convertirse en un cazador, él es quien le dice que su padre Gin está vivo. Enterado de esto Gon decide convertirse en cazador para poder encontrar a su padre.","posterPath":"https://image.tmdb.org/t/p/w500/43wEsSJxuV8SZuipKpolOsuGVRZ.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/bFKKyCI89Xq98Gul8cGox8K3sZa.jpg","voteAverage":8.7,"voteCount":2087,"releaseDate":"2011-10-02","genres":["Animación","Action & Adventure","Sci-Fi & Fantasy"],"type":"series","platforms":["$c"],"tmdbId":46298,"runtime":"$undefined","seasons":"$undefined"},{"id":69478,"title":"El cuento de la criada","originalTitle":"El cuento de la criada","overview":"Para enfrentarse a una tasa de natalidad en declive, un régimen fundamentalista ha empezado a tratar a las mujeres como propiedades. Como una de las pocas mujeres fértiles que quedan, Defred es una criada, una más de la casta de mujeres forzadas a una servidumbre sexual para intentar repoblar el mundo.","posterPath":"https://image.tmdb.org/t/p/w500/kAHyUzUkFv8xgJARoWEdiz9LgeY.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/atb20IUkdYcZISq3DJ769nc3h1G.jpg","voteAverage":8.1,"voteCount":3214,"releaseDate":"2017-04-26","genres":["Drama","Sci-Fi & Fantasy","Action & Adventure"],"type":"series","platforms":["$c"],"tmdbId":69478,"runtime":"$undefined","seasons":"$undefined"},{"id":48891,"title":"Brooklyn Nine-Nine","originalTitle":"Brooklyn Nine-Nine","overview":"El detective Jake Peralta y el capitán Ray Holt encabezan esta comedia sobre conflictos generacionales en una comisaría de Nueva York. Uno es un detective que no se toma en serio las reglas de sus superiores, mientras que el otro es un inspector empeñado en que madure de una vez y trabaje conforme a las normas del departamento.","posterPath":"https://image.tmdb.org/t/p/w500/A3SymGlOHefSKbz1bCOz56moupS.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/wyspZaGs7CXceV3Ct7NJhcKNDkn.jpg","voteAverage":8.2,"voteCount":3947,"releaseDate":"2013-09-17","genres":["Comedia","Crimen"],"type":"series","platforms":["$c"],"tmdbId":48891,"runtime":"$undefined","seasons":"$undefined"},{"id":4586,"title":"Las chicas Gilmore","originalTitle":"Las chicas Gilmore","overview":"Historia de la jovencita Rory Gilmore y su moderna madre soltera Lorelai, en la pequeña y encantadora población de Stars Hollow, Connecticut. Rory acaba de entrar en la etapa adolescente, sigue siendo una buena estudiante y se lo pasa en grande con su amiga Kim, pero ya le gusta un chico y está claro que ha pasado la época de las muñecas. Mientras, su alocada madre Lorelai dirige un hotel restaurante e intenta, por el bien de su hija, volver a entablar una relación cordial con sus acaudalados y estirados padres, pues se marchó de casa cuando se quedó embarazada.","posterPath":"https://image.tmdb.org/t/p/w500/xcszRCNHd4Gq0AwhcSDSEmktq5w.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/8U2ndZrneigI2zkvGuTJtt1ZsxK.jpg","voteAverage":7.9,"voteCount":1240,"releaseDate":"2000-10-05","genres":["Comedia","Drama"],"type":"series","platforms":["$c"],"tmdbId":4586,"runtime":"$undefined","seasons":"$undefined"},{"id":46260,"title":"Naruto","originalTitle":"Naruto","overview":"Naruto es un joven aprendiz de ninja marginado y temido en la Villa Oculta de la Hoja tanto por su carácter hiperactivo y gamberro como por el terrible poder sellado en su interior. Acompañado por el intenso Sasuke y la ingeniosa Sakura, Naruto comienza su aprendizaje decidido a convertirse en maestro Hokage, la más alta distinción entre los ninjas, para ganarse el reconocimiento de los suyos.","posterPath":"https://image.tmdb.org/t/p/w500/oOkvQ1anSMvdYbUGGf7NAnfwHUt.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/mpsYIytXhDXjI9yYC1Fp1S3PxsS.jpg","voteAverage":8.4,"voteCount":5968,"releaseDate":"2002-10-03","genres":["Animación","Action & Adventure","Sci-Fi & Fantasy"],"type":"series","platforms":["$c"],"tmdbId":46260,"runtime":"$undefined","seasons":"$undefined"},{"id":195670,"title":"Besos, Kitty","originalTitle":"Besos, Kitty","overview":"Los dictados del corazón la llevan a un instituto elitista de Seúl y la joven celestina Kitty se da cuenta de que la vida, el amor y la familia son más complicados de lo que creía.","posterPath":"https://image.tmdb.org/t/p/w500/3y3uLS6HV3IJebjXHnd9K640F3Q.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/h0CQ36rm9cSLznve5ocCDtYlnwN.jpg","voteAverage":8.1,"voteCount":654,"releaseDate":"2023-05-18","genres":["Comedia","Drama"],"type":"series","platforms":["$c"],"tmdbId":195670,"runtime":"$undefined","seasons":"$undefined"},{"id":74016,"title":"The Resident","originalTitle":"The Resident","overview":"Un joven e idealista médico comienza su primer día ansioso por salvar vidas. Bajo la supervisión de un duro y brillante residente senior, pronto descubrirá que su profesión no es lo que él imaginaba y que las líneas éticas suelen ser borrosas. \"The Resident\" es un nuevo y provocativo drama médico que revela la verdad de lo que ocurre en los hospitales.","posterPath":"https://image.tmdb.org/t/p/w500/2IkYQJlT26yXef2iot7dhRtavSC.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/9oVp0xfKW2igxDEo5wr3JTMQBub.jpg","voteAverage":8.4,"voteCount":1309,"releaseDate":"2018-01-21","genres":["Drama"],"type":"series","platforms":["$c"],"tmdbId":74016,"runtime":"$undefined","seasons":"$undefined"},{"id":76669,"title":"Élite","originalTitle":"Élite","overview":"Las Encinas, un exclusivo colegio privado al que la élite social del país envía a sus hijos. Pero en el centro son admitidos tres adolescentes de familias humildes después de que un terremoto destruyera el colegio público en el que estudiaban. El choque de clases genera diversos problemas que se agravan hasta que, de repente, se produce un asesinato.","posterPath":"https://image.tmdb.org/t/p/w500/c07WqB99Igco0rua794q9k9QJYm.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/uU6YW3N11qECNfz18LNGAGg3Uir.jpg","voteAverage":8,"voteCount":9367,"releaseDate":"2018-10-05","genres":["Crimen","Misterio","Drama"],"type":"series","platforms":["$c"],"tmdbId":76669,"runtime":"$undefined","seasons":"$undefined"},{"id":120089,"title":"SPY x FAMILY","originalTitle":"SPY x FAMILY","overview":"El espía \"Twilight\" recibe la misión de infiltrarse en la familia de un líder político. Para ello, crea una falsa familia con una hija que lee mentes y una esposa asesina, mientras ocultan sus secretos y viven juntos en una aventura peligrosa para mantener la paz mundial.","posterPath":"https://image.tmdb.org/t/p/w500/vaIREdPGZOnW9Jrs86mheVVlIQQ.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/lysUnU6V0VfcthDbviuVlIqgHOR.jpg","voteAverage":8.5,"voteCount":2249,"releaseDate":"2022-04-09","genres":["Animación","Action & Adventure","Comedia"],"type":"series","platforms":["$c"],"tmdbId":120089,"runtime":"$undefined","seasons":"$undefined"},{"id":45790,"title":"JoJo's Bizarre Adventure","originalTitle":"JoJo's Bizarre Adventure","overview":"La trama se desarrolla en torno a la historia del linaje Joestar, una poderosa familia de origen británico destinada a combatir fuerzas sobrenaturales malvadas usando poderes adquiridos; la obra abarca varias generaciones de dicho linaje, las cuales son adaptadas en cada parte poniendo un descendiente como protagonista, empezando con Jonathan en el año 1880.  El nombre «JoJo», presente en el título de la obra, consiste en un juego de palabras compuesto por el nombre de los protagonistas de cada parte, los cuales pueden abreviarse como «Jojo» y usarse a forma de apodo; sin embargo, en las últimas partes de la obra se hacen juegos de palabras más complejos: por ejemplo, Josuke es un juego de palabras en japonés en que la sílaba «suke» (助) se puede leer también como «jo», y el diminutivo de Giorno Giovana (Gio. Gio.) tiene una pronunciación bastante similar a «Jojo». Todos los Joestar se identifican porque tienen una marca de nacimiento en forma de estrella de cinco puntas.","posterPath":"https://image.tmdb.org/t/p/w500/ieP7Q9z24sNUfVNFC38rYBw6yxq.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/mLKN1dsimKPiXCZ48KED0X8a02t.jpg","voteAverage":8.6,"voteCount":1586,"releaseDate":"2012-10-06","genres":["Animación","Action & Adventure","Sci-Fi & Fantasy"],"type":"series","platforms":["$c"],"tmdbId":45790,"runtime":"$undefined","seasons":"$undefined"},{"id":66025,"title":"Animal Kingdom","originalTitle":"Animal Kingdom","overview":"La serie se centra en una familia de criminales mientras se enfrentan a la policía. Sus vidas quedan atrapadas en medio de esta lucha y se ven en la obligación de tomar bandos.","posterPath":"https://image.tmdb.org/t/p/w500/rzvdKrnSRKPFI0pgqMQknDPpRC9.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/eQJwfyMqSra10ck8HOoiCrbQR32.jpg","voteAverage":7.7,"voteCount":532,"releaseDate":"2016-06-14","genres":["Crimen","Drama"],"type":"series","platforms":["$c"],"tmdbId":66025,"runtime":"$undefined","seasons":"$undefined"},{"id":69050,"title":"Riverdale","originalTitle":"Riverdale","overview":"Archie y sus amigos de Riverdale se verán envueltos en un siniestro misterio al tiempo que lidian con las complicaciones del sexo, el amor, los estudios y la familia.","posterPath":"https://image.tmdb.org/t/p/w500/mlk5jA1ewWUxle6LY9bEi7aiI97.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/kb9XvtEnDhBVVit4eeKygqll4EA.jpg","voteAverage":8.4,"voteCount":13711,"releaseDate":"2017-01-26","genres":["Crimen","Drama","Misterio"],"type":"series","platforms":["$c"],"tmdbId":69050,"runtime":"$undefined","seasons":"$undefined"},{"id":71912,"title":"The Witcher","originalTitle":"The Witcher","overview":"Geralt, un brujo que se dedica a cazar monstruos genéticamente modificados, busca su lugar en un mundo donde a menudo los humanos demuestran ser peores que las bestias.","posterPath":"https://image.tmdb.org/t/p/w500/gvn0m0LCIslrURjSo7UG5Rx6mV2.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/foGkPxpw9h8zln81j63mix5B7m8.jpg","voteAverage":7.9,"voteCount":6662,"releaseDate":"2019-12-20","genres":["Drama","Action & Adventure"],"type":"series","platforms":["$c"],"tmdbId":71912,"runtime":"$undefined","seasons":"$undefined"},{"id":65494,"title":"The Crown","originalTitle":"The Crown","overview":"Drama sobre las rivalidades políticas y los romances acaecidos durante el reinado de Isabel II, así como de los eventos que moldearían la segunda mitad del siglo XX.","posterPath":"https://image.tmdb.org/t/p/w500/1ZMVKJoWK5KfxaQA8BwpfOEYKKy.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/8VXhcrl5z2I1zEU9X3pkkNrZlD.jpg","voteAverage":8.2,"voteCount":2336,"releaseDate":"2016-11-04","genres":["Drama"],"type":"series","platforms":["$c"],"tmdbId":65494,"runtime":"$undefined","seasons":"$undefined"},{"id":119051,"title":"Miércoles","originalTitle":"Miércoles","overview":"Miércoles Addams, lista, sarcástica y un poco muerta por dentro, investiga misterios retorcidos mientras hace amigos —y enemigos— en la Academia Nunca Más.","posterPath":"https://image.tmdb.org/t/p/w500/bNKwoYqkCXfIhhr5Jz8slrsw32r.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/iHSwvRVsRyxpX7FE7GbviaDvgGZ.jpg","voteAverage":8.3,"voteCount":10496,"releaseDate":"2022-11-23","genres":["Sci-Fi & Fantasy","Misterio","Comedia"],"type":"series","platforms":["$c"],"tmdbId":119051,"runtime":"$undefined","seasons":"$undefined"},{"id":94664,"title":"Mushoku Tensei Jobless Reincarnation","originalTitle":"Mushoku Tensei Jobless Reincarnation","overview":"Cuando un autobús atropella a un joven de 34 años que no ha logrado mucho en su vida, su historia no termina ahí. Habiendo reencarnado en un niño, Rudy aprovechará cada oportunidad para vivir la vida que siempre quiso. ¡Con la ayuda de sus amigos, unas habilidades mágicas recién adquiridas, y el coraje para hacer las cosas que siempre ha soñado, se embarca en una aventura épica, con su experiencia pasada intacta!","posterPath":"https://image.tmdb.org/t/p/w500/sviEqFIPJW5gFtuYy8XyE0Uscid.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/j9fRIimor0AMFJR9kjZubXcABzZ.jpg","voteAverage":8.6,"voteCount":1458,"releaseDate":"2021-01-11","genres":["Action & Adventure","Animación","Sci-Fi & Fantasy"],"type":"series","platforms":["$c"],"tmdbId":94664,"runtime":"$undefined","seasons":"$undefined"},{"id":85077,"title":"The Chosen (Los elegidos)","originalTitle":"The Chosen (Los elegidos)","overview":"Por primera vez, la historia más grande jamás contada se presenta en una serie de varias temporadas. Enfocada en los personajes y el contexto histórico de los Evangelios, la primera temporada del mayor proyecto audiovisual producido mediante crowdfunding nos muestra a personas como Pedro, Nicodemo, María Magdalena, Mateo y, por supuesto, Jesús, de una manera nunca vista antes en pantalla. La serie muestra la parte más auténtica e íntima de la vida y el ministerio de una de las figuras más importantes e influyentes de la Historia de la humanidad.","posterPath":"https://image.tmdb.org/t/p/w500/sADRlqLn9na8p7S1mLWMOU04uit.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/3siv3RaQrdr2tQiv9jHq71sLlzo.jpg","voteAverage":8.7,"voteCount":852,"releaseDate":"2019-04-21","genres":["Action & Adventure","Familia","Drama"],"type":"series","platforms":["$c"],"tmdbId":85077,"runtime":"$undefined","seasons":"$undefined"},{"id":31910,"title":"Naruto Shippuden","originalTitle":"Naruto Shippuden","overview":"La historia transcurre en un mundo dominado por aldeas ninja. En las cuales el papel del ninja se traduce como el poder de cada país. Cada uno de estos cuenta con su aldea oculta que es donde estudian, entrenan, graduan y forman cada ninja. Los ninjas utilizan todo tipo de artes marciales desde la lucha cuerpo a cuerpo a ilusiones o técnicas secretas como por ejemplo la manipulación de elementos.  El protagonista es un joven aspirante a ninja Uzumaki Naruto, un muchacho que sueña en convertirse algun dia en el líder de su aldea (Hokage). Será para él una tarea difícil ya que cuando era solo un bebé le fué confiado en su interior el poder de un ser malvado, que antaño causo grandes males en su aldea (Konoha) y el cual irá poco a poco descubriendo y dominando. Por culpa de ese poder Naruto pasa una dura infancia con desprecio y negación por parte de los vecinos de su aldea...","posterPath":"https://image.tmdb.org/t/p/w500/ews8shcDbRG3tY33dF0jClNvgIK.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/z0YhJvomqedHF85bplUJEotkN5l.jpg","voteAverage":8.5,"voteCount":8630,"releaseDate":"2007-02-15","genres":["Animación","Action & Adventure","Sci-Fi & Fantasy"],"type":"series","platforms":["$c"],"tmdbId":31910,"runtime":"$undefined","seasons":"$undefined"},{"id":1422,"title":"The Middle","originalTitle":"The Middle","overview":"La de Frankie Heck es una familia de libro: tiene un hijo adolescente que se pasa el día en su cuarto y cuando se pasea lo hace sin camiseta ni pantalones; una hija que es un desastre en casi todo lo que intenta; y otro chico, el pequeño, que repite las últimas palabras en susurros porque le hace sentir bien. Además, intenta vender coches cuando su marido no se olvida de ir a recoger a los chicos al colegio.","posterPath":"https://image.tmdb.org/t/p/w500/u6FluiFx3ocVS0MgZszfpPKXT2p.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/82D01BlixH1JD0BCQoERabDjp7h.jpg","voteAverage":7.6,"voteCount":737,"releaseDate":"2009-09-30","genres":["Comedia"],"type":"series","platforms":["$c"],"tmdbId":1422,"runtime":"$undefined","seasons":"$undefined"},{"id":38693,"title":"LEGO Ninjago: Maestros del Spinjitzu","originalTitle":"LEGO Ninjago: Maestros del Spinjitzu","overview":"Kai, Jay, Cole y Zane deben perfeccionar sus poderes elementales y armas Spinjitzu para proteger las tierras de Ninjago.","posterPath":"https://image.tmdb.org/t/p/w500/beKgqwruOGmVAvRwRvfuOcXwl2Z.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/ptEtIr3rVuAJpmbwaLJJqND6HVq.jpg","voteAverage":8,"voteCount":768,"releaseDate":"2012-01-11","genres":["Animación","Action & Adventure","Sci-Fi & Fantasy","Comedia","Familia"],"type":"series","platforms":["$c"],"tmdbId":38693,"runtime":"$undefined","seasons":"$undefined"},{"id":63333,"title":"The Last Kingdom","originalTitle":"The Last Kingdom","overview":"La serie está ambientada en el siglo IX donde lo que hoy se conoce como Inglaterra eran varios reinos independientes. Las tierras anglosajonas son atacadas y en muchos casos gobernadas por fuerzas vikingas. El reino de Wessex se ha dejado solo bajo el mando del Rey Alfred el Grande. Uhtred, hijo huérfano de un noble sajón, es secuestrado por los normandos y criado como uno de ellos. Así, es obligado a elegir entre un reino que comparte sus ancestros y la gente a la que es leal.","posterPath":"https://image.tmdb.org/t/p/w500/pnM3U7NMJeFNpzhpYP10zBdIuPM.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/QbtctI8EzlhsyFDMUMyG3fli8B.jpg","voteAverage":8.3,"voteCount":1952,"releaseDate":"2015-10-10","genres":["Action & Adventure","Drama","War & Politics"],"type":"series","platforms":["$c"],"tmdbId":63333,"runtime":"$undefined","seasons":"$undefined"},{"id":220150,"title":"Horizontes Pokémon","originalTitle":"Horizontes Pokémon","overview":"¡Acompaña a Liko y Rod en sus increíbles aventuras mientras desvelan los misterios que les rodean y conocen a Friede, Capitán Pikachu y Amethio, entre otros!","posterPath":"https://image.tmdb.org/t/p/w500/2RwGhjr0KLTdgQMxGikB5Omfkb3.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/d0axpGojOqDag5lDa0eNSEtw11l.jpg","voteAverage":8.6,"voteCount":102,"releaseDate":"2023-04-14","genres":["Animación","Action & Adventure","Sci-Fi & Fantasy","Kids"],"type":"series","platforms":["$c"],"tmdbId":220150,"runtime":"$undefined","seasons":"$undefined"},{"id":279388,"title":"En Busca del Jade","originalTitle":"En Busca del Jade","overview":"Este drama sigue a Fan Chang Yu, hija de un carnicero, y a Xie Zheng, un noble caído en desgracia que busca venganza, Su falso matrimonio se convierte en amor verdadero, pero la guerra los separa. Decidida, Fan Chang Yu empuña su cuchillo de carnicero en el campo de batalla, buscando justicia y a su esposo.","posterPath":"https://image.tmdb.org/t/p/w500/8cAMBWFHOTfx4Zm66O4vFJPnB5s.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/yiUZ8Ck86FF3obLztVvSQqeBi0Y.jpg","voteAverage":7.8,"voteCount":62,"releaseDate":"2026-03-06","genres":["Drama"],"type":"series","platforms":["$c"],"tmdbId":279388,"runtime":"$undefined","seasons":"$undefined"},{"id":1395,"title":"Gossip Girl","originalTitle":"Gossip Girl","overview":"Los niños pijos de un instituto privado de Manhattan se salen siempre con la suya, hasta que una bloguera anónima, llamada la Reina Cotilla, espía sus movimientos.","posterPath":"https://image.tmdb.org/t/p/w500/fmegxZBz7GF8k4eme4ZJXXGI0TO.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/5RWAjCYhu3D8Ai2QBYP7GjaxFb3.jpg","voteAverage":8.2,"voteCount":2301,"releaseDate":"2007-09-19","genres":["Drama"],"type":"series","platforms":["$c"],"tmdbId":1395,"runtime":"$undefined","seasons":"$undefined"},{"id":127865,"title":"El caso Hartung","originalTitle":"El caso Hartung","overview":"En un parque infantil de una tranquila zona residencial de Copenhague, la policía encuentra a una joven brutalmente asesinada a la que le han seccionado una mano. Sobre la chica cuelga un muñequito hecho con castañas. El caso se asigna a la ambiciosa y joven detective Naia Thulin y a su nuevo compañero, Mark Hess.","posterPath":"https://image.tmdb.org/t/p/w500/9if9wfo0SSvHbZDN8IamLXjr9Zh.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/fIXTetAsXkPO6UUUw85IU4oactf.jpg","voteAverage":7.5,"voteCount":677,"releaseDate":"2021-09-29","genres":["Drama","Crimen"],"type":"series","platforms":["$c"],"tmdbId":127865,"runtime":"$undefined","seasons":"$undefined"},{"id":285838,"title":"Si los deseos mataran...","originalTitle":"Si los deseos mataran...","overview":"Una enigmática aplicación concede deseos, pero inicia una cuenta atrás mortal. Un grupo de adolescentes se ven atrapados en este círculo y deberán romperlo para sobrevivir.","posterPath":"https://image.tmdb.org/t/p/w500/sk8icdCLOKcCbMeDGvwvTLw67mM.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/zV9WYOfFr4MAnzXXD8PR5J6JnN3.jpg","voteAverage":8.1,"voteCount":94,"releaseDate":"2026-04-24","genres":["Misterio","Drama"],"type":"series","platforms":["$c"],"tmdbId":285838,"runtime":"$undefined","seasons":"$undefined"},{"id":116799,"title":"El abogado del Lincoln","originalTitle":"El abogado del Lincoln","overview":"Mickey Haller, el famoso abogado de Los Ángeles, hace lo que sea necesario para ganar sus casos mientras lidia con el sistema de justicia penal desde su emblemático Lincoln.","posterPath":"https://image.tmdb.org/t/p/w500/w4kfFjqanJuvkVOg1nb2ag1VG2e.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/jBFOVEE5sMIyT141YIqIwyU8Y1D.jpg","voteAverage":7.7,"voteCount":497,"releaseDate":"2022-05-13","genres":["Drama","Crimen"],"type":"series","platforms":["$c"],"tmdbId":116799,"runtime":"$undefined","seasons":"$undefined"},{"id":70523,"title":"Dark","originalTitle":"Dark","overview":"Tras la desaparición de un niño, cuatro familias desesperadas tratan de entender lo ocurrido a medida que van desvelando un retorcido misterio que abarca tres décadas.","posterPath":"https://image.tmdb.org/t/p/w500/hRP7N2uI0pokxnkcMFONoOZnxbv.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/3jDXL4Xvj3AzDOF6UH1xeyHW8MH.jpg","voteAverage":8.4,"voteCount":7529,"releaseDate":"2017-12-01","genres":["Crimen","Drama","Sci-Fi & Fantasy","Misterio"],"type":"series","platforms":["$c"],"tmdbId":70523,"runtime":"$undefined","seasons":"$undefined"},{"id":14929,"title":"Heartland","originalTitle":"Heartland","overview":"Amy (Amber Marshall) y Lou (Michelle Morgan) son dos hermanas que se mudan desde Nueva York a Heartland (en Alberta, Canadá), el viejo rancho con caballos de su abuelo Jack (Shaun Johnston), después de la inesperada muerte de su madre.","posterPath":"https://image.tmdb.org/t/p/w500/uc2gtWczT58BiAUJWFz9P5aZmNF.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/11nGiX6hLdexBD4TVUAAVzSIAQy.jpg","voteAverage":8.3,"voteCount":574,"releaseDate":"2007-10-14","genres":["Familia","Drama","Comedia"],"type":"series","platforms":["$c"],"tmdbId":14929,"runtime":"$undefined","seasons":"$undefined"},{"id":71446,"title":"La casa de papel","originalTitle":"La casa de papel","overview":"Un enigmático personaje llamado el Profesor planea algo grande: llevar a cabo el mayor atraco de la historia. Para ello recluta una banda de ocho personas que reúnen un único requisito, ninguno tiene nada que perder. Cinco meses de reclusión memorizando cada paso, cada detalle, cada probabilidad… y por fin, once días de encierro en la Fábrica Nacional de Moneda, rodeados de cuerpos de policía y con decenas de rehenes en su poder para saber si su apuesta suicida será todo o nada.","posterPath":"https://image.tmdb.org/t/p/w500/z01Dc0Ly2GmCpLe6Scx4d3dPP1S.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/gFZriCkpJYsApPZEF3jhxL4yLzG.jpg","voteAverage":8.2,"voteCount":19416,"releaseDate":"2017-05-02","genres":["Crimen","Drama"],"type":"series","platforms":["$c"],"tmdbId":71446,"runtime":"$undefined","seasons":"$undefined"},{"id":77169,"title":"Cobra Kai","originalTitle":"Cobra Kai","overview":"Enemigos acérrimos. Dojos rivales. Sangre fresca. En esta secuela de las películas de ‘Karate Kid’, Daniel y Johnny reavivan viejas rencillas en el West Valley.","posterPath":"https://image.tmdb.org/t/p/w500/imfqLcv6oHNn6bDdEUUUlxy0Ch9.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/5NrSIzfcBOFI9HRGV4nRYgMGhDU.jpg","voteAverage":8.2,"voteCount":6879,"releaseDate":"2018-05-02","genres":["Action & Adventure","Drama","Comedia"],"type":"series","platforms":["$c"],"tmdbId":77169,"runtime":"$undefined","seasons":"$undefined"},{"id":4608,"title":"Rockefeller Plaza","originalTitle":"Rockefeller Plaza","overview":"Liz Lemon (Tina Fey), la principal guionista de un show de televisión que consiste en sketches cómicos, debe enfrentarse todos los días a su arrogante nuevo jefe (Alec Baldwin) y a la estrella del programa, al tiempo que trata de conducirlo y conseguir el éxito televisivo sin perder los nervios...","posterPath":"https://image.tmdb.org/t/p/w500/rY4ZbKLbd5OUisdykcJCch5WXvx.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/cK5AbLFBY2JDoqEdVXk0697e2SV.jpg","voteAverage":7.5,"voteCount":794,"releaseDate":"2006-10-11","genres":["Comedia"],"type":"series","platforms":["$c"],"tmdbId":4608,"runtime":"$undefined","seasons":"$undefined"},{"id":30983,"title":"Detective Conan","originalTitle":"Detective Conan","overview":"Shinichi Kudo es un joven detective que consigue esclarecer cualquier misterio, por difícil que sea. Un día, nuestro protagonista descubre los maléficos planes de una peligrosa organización criminal y es envenenado. Sin embargo, el veneno no lo mata, sino que por accidente, lo encoge y lo convierte en un niño de apenas 6 años. Atrapado en este cuerpo, Shinichi, bajo el seudónimo de Conan Edogawa, deberá resolver los casos más difíciles mientras intenta encontrar un antídoto que lo devuelva a la normalidad y hacer lo posible para que su amiga, Ran Mouri, no sospeche quién es realmente el sabiondo Conan...","posterPath":"https://image.tmdb.org/t/p/w500/gW14n6xxONXrya8CIDhRe5Ada7U.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/5546GF3zT3yA25ydCz0KlujjRA3.jpg","voteAverage":8,"voteCount":747,"releaseDate":"1996-01-08","genres":["Animación","Crimen","Misterio","Comedia"],"type":"series","platforms":["$c"],"tmdbId":30983,"runtime":"$undefined","seasons":"$undefined"},{"id":212989,"title":"LEGO Ninjago: El renacer de los dragones","originalTitle":"LEGO Ninjago: El renacer de los dragones","overview":"Varios reinos legendarios se han fusionado de forma repentina... e inestable. Un maestro de Spinjitzu debe entrenar a una nueva generación de héroes ninja capaces de encontrar a los Dragones Elementales: son los que pueden salvar el planeta antes de que las fuerzas del mal accedan a esa energía dracónica para aniquilar el nuevo mundo.","posterPath":"https://image.tmdb.org/t/p/w500/yxBgVqRwfpAU1wL6xsAWulIhhoL.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/p1P0QJ3cqeBnODfyQd2ceEZ23KQ.jpg","voteAverage":8.1,"voteCount":97,"releaseDate":"2023-06-01","genres":["Animación","Kids","Action & Adventure"],"type":"series","platforms":["$c"],"tmdbId":212989,"runtime":"$undefined","seasons":"$undefined"},{"id":502,"title":"Barrio Sesamo","originalTitle":"Barrio Sesamo","overview":"Barrio Sésamo fue una serie de programas infantiles emitidos por la primera cadena de TVE, entre 1979 y 2000. Aunque todos tuvieron el mismo esquema de tele-teatro infantil, con actores (en el caso de los protagonistas, disfrazados) acompañados de tiras de guiñol, sólo las dos primeras entregas eran productos de la familia Henson. El Barrio Sésamo español incluía los sketches del programa en el que se había basado, el Sesame Street (1969) del creador estadounidense de marionetas Jim Henson, en el que diversos personajes de guiñol acabarían por convertirse en auténticas estrellas del mundo del espectáculo y el show-bussiness.","posterPath":"https://image.tmdb.org/t/p/w500/23VG5Ryb9ET7JFoBwVstF0KglGT.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/tNi2aJPdCKfielGYzIi3IKxStz9.jpg","voteAverage":7.1,"voteCount":280,"releaseDate":"1969-11-10","genres":["Kids","Comedia"],"type":"series","platforms":["$c"],"tmdbId":502,"runtime":"$undefined","seasons":"$undefined"},{"id":37606,"title":"El asombroso mundo de Gumball","originalTitle":"El asombroso mundo de Gumball","overview":"Narra las divertidas aventuras de Gumball y su peculiar familia en el idílico pueblecito de Elmore. Un papá conejo rosa de 1,95 metros, una madre que se gana la vida vendiendo arco iris, un gato azul muy torpe y una conejita con un cerebro superdotado componen la familia protagonista. No hay que olvidar a Darwin, un pez rojo que se convirtió en miembro del clan el día en que le crecieron piernas y pulmones. Así es el asombroso mundo de Gumball.","posterPath":"https://image.tmdb.org/t/p/w500/dMYY2XqsQvDEdTtPfykTEOUZngK.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/gmO3aezFgDcrhcymhNSJLGZ3CT.jpg","voteAverage":8.5,"voteCount":1721,"releaseDate":"2011-05-03","genres":["Animación","Familia","Sci-Fi & Fantasy","Comedia"],"type":"series","platforms":["$c"],"tmdbId":37606,"runtime":"$undefined","seasons":"$undefined"},{"id":61222,"title":"BoJack Horseman","originalTitle":"BoJack Horseman","overview":"Conoce al caballo más querido de los 90… veinte años después. Vive en Los Ángeles donde humanos y animales antropomórficos coexisten, BoJack Horseman es la historia de un hombre (bueno, un caballo-hombre) que llegó muy rápido a la cima y ahora tiene que averiguar qué hacer.","posterPath":"https://image.tmdb.org/t/p/w500/6JFWzlChcGgLiIUo2COgNlWGFKy.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/qFYDJUIFh8zgEDy3EvnHwhgOl0S.jpg","voteAverage":8.5,"voteCount":2831,"releaseDate":"2014-08-22","genres":["Animación","Comedia","Drama"],"type":"series","platforms":["$c"],"tmdbId":61222,"runtime":"$undefined","seasons":"$undefined"},{"id":31911,"title":"Fullmetal Alchemist: Brotherhood","originalTitle":"Fullmetal Alchemist: Brotherhood","overview":"Remake de Fullmetal Alchemist. Edward y Alphonse rompieron la regla basica de la alquimia, la cual les trajo graves consecuencias. Para remediar esto, se embarcan en busca de alguna forma de solucionar sus males","posterPath":"https://image.tmdb.org/t/p/w500/vIkH7fUQf8Olo8Apq56FQLGDXOo.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/A6tMQAo6t6eRFCPhsrShmxZLqFB.jpg","voteAverage":8.7,"voteCount":2441,"releaseDate":"2009-04-05","genres":["Animación","Action & Adventure","Sci-Fi & Fantasy","Drama"],"type":"series","platforms":["$c"],"tmdbId":31911,"runtime":"$undefined","seasons":"$undefined"},{"id":186,"title":"Weeds","originalTitle":"Weeds","overview":"Ambientada en Agrestic, una ciudad californiana de ficción, la serie narra la historia de Nancy Botwin (Mary-Louise Parker), una madre de familia, cuyo marido Judah (Jeffrey Dean Morgan) ha fallecido reciente y repentinamente, y termina vendiendo marihuana a sus vecinos del barrio residencial donde vive para poder mantener el nivel de vida de clase alta al que está acostumbrada. Su vida gira en torno a sus dos hijos, Shane Botwin (Alexander Gould), un excéntrico y solitario niño de 10 años, y Silas Botwin (Hunter Parrish), un adolescente obsesionado con las relaciones sexuales. Los tres viven en Agrestic, un barrio idílico en apariencia, pero que en realidad oculta oscuros secretos tras las atildadas puertas de sus casas.","posterPath":"https://image.tmdb.org/t/p/w500/8QjwQpFllRipS1AbSyp7CO8RmVJ.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/6k6vAUa0Fm73HB0QBOJbFGTgPq5.jpg","voteAverage":7.5,"voteCount":982,"releaseDate":"2005-08-07","genres":["Comedia","Crimen","Drama"],"type":"series","platforms":["$c"],"tmdbId":186,"runtime":"$undefined","seasons":"$undefined"},{"id":1424,"title":"Orange Is the New Black","originalTitle":"Orange Is the New Black","overview":"Las consecuencias de un antiguo delito le pasan factura a una rica neoyorquina que acaba en una cárcel para mujeres. Allí hace amistades y algún que otro enemigo.","posterPath":"https://image.tmdb.org/t/p/w500/ekaa7YjGPTkFLcPhwWXTnARuCEU.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/zJiWhsEYCy5BkFCBONoMnUunyZQ.jpg","voteAverage":7.6,"voteCount":2794,"releaseDate":"2013-07-11","genres":["Drama","Comedia","Crimen"],"type":"series","platforms":["$c"],"tmdbId":1424,"runtime":"$undefined","seasons":"$undefined"},{"id":105,"title":"Sexo en Nueva York","originalTitle":"Sexo en Nueva York","overview":"Esta comedia muestra con una mirada fresca y divertida el mundo del sexo y las citas en Nueva York.","posterPath":"https://image.tmdb.org/t/p/w500/jVmKVsPIq13ZajQEKARqgAFaVGo.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/jvHw1zF20kYA9gbF2VprXD6uJpq.jpg","voteAverage":7.4,"voteCount":2148,"releaseDate":"1998-06-06","genres":["Drama","Comedia"],"type":"series","platforms":["$c"],"tmdbId":105,"runtime":"$undefined","seasons":"$undefined"},{"id":33765,"title":"My Little Pony: La magia de la amistad","originalTitle":"My Little Pony: La magia de la amistad","overview":"Tercera serie de la franquicia de Hasbro. Twilight Sparkle, discípula de la princesa Celestia, soberana de Equestria, es enviada a Ponyville. Allí conocerá a Pinkie Pie, Rainbow Dash, Applejack, Fluttershy y Rarity, y descubrirá la fuerza de la amistad.","posterPath":"https://image.tmdb.org/t/p/w500/fwW7WgJIjhBsnzk87Gyh6g9187m.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/4zhISjHkEoeNkVGJRHIy9jND2ta.jpg","voteAverage":8.2,"voteCount":725,"releaseDate":"2010-10-10","genres":["Animación","Comedia","Sci-Fi & Fantasy","Kids"],"type":"series","platforms":["$c"],"tmdbId":33765,"runtime":"$undefined","seasons":"$undefined"},{"id":129552,"title":"El agente nocturno","originalTitle":"El agente nocturno","overview":"Unidos por una llamada a medianoche, un agente del FBI y una experta en ciberseguridad deben desentrañar una intrincada red de conspiraciones políticas.","posterPath":"https://image.tmdb.org/t/p/w500/uYNgC4Zd9NMcpMVug9NTgeIqfTy.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/gklrevVndG98GHGDwfm8y8kxESo.jpg","voteAverage":7.7,"voteCount":1140,"releaseDate":"2023-03-23","genres":["Action & Adventure","Drama","Misterio"],"type":"series","platforms":["$c"],"tmdbId":129552,"runtime":"$undefined","seasons":"$undefined"},{"id":33907,"title":"Downton Abbey","originalTitle":"Downton Abbey","overview":"Serie británica que se desarrolla en el año 1912, durante el reinado de Jorge V, y que retrata a la sociedad aristocrática de aquella época y sus litigios para ganar o mantener sus títulos nobiliarios.","posterPath":"https://image.tmdb.org/t/p/w500/7HgDYRYjym4BwbhKaqTQq771SKb.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/1wgqpYNtQDn7TDkyQ2jsIAqxorW.jpg","voteAverage":8.1,"voteCount":1188,"releaseDate":"2010-09-26","genres":["Drama"],"type":"series","platforms":["$c"],"tmdbId":33907,"runtime":"$undefined","seasons":"$undefined"},{"id":42705,"title":"Espíritu de lucha: Hajime no Ippo","originalTitle":"Espíritu de lucha: Hajime no Ippo","overview":"\"Hajime no Ippo\" sigue a Makunouchi Ippo, un joven de 17 años que, cansado de ser considerado débil, entra al mundo del boxeo inspirado por Mamoru Takamura, un reconocido boxeador profesional en Japón.","posterPath":"https://image.tmdb.org/t/p/w500/umMYjHm7FjsyllUnC8lWDy9rrZQ.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/bHSgCHRYko757BdmntddESfEEgt.jpg","voteAverage":8.6,"voteCount":1187,"releaseDate":"2000-10-03","genres":["Animación","Comedia","Drama","Action & Adventure"],"type":"series","platforms":["$c"],"tmdbId":42705,"runtime":"$undefined","seasons":"$undefined"},{"id":223386,"title":"El fuego de la venganza","originalTitle":"El fuego de la venganza","overview":"Atormentado por su pasado y perseguido por sus enemigos, un veterano de las Fuerzas Especiales lucha por salvar a una joven en las peligrosas calles de Río de Janeiro.","posterPath":"https://image.tmdb.org/t/p/w500/9jQSxMZuadcnzKb1OYJ9Jn3V6g0.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/dMCfHJRnAZfKoPTjYyZk2QCL8au.jpg","voteAverage":7.1,"voteCount":119,"releaseDate":"2026-04-30","genres":["Action & Adventure","Crimen"],"type":"series","platforms":["$c"],"tmdbId":223386,"runtime":"$undefined","seasons":"$undefined"},{"id":135157,"title":"Alquimia de almas","originalTitle":"Alquimia de almas","overview":"Una poderosa hechicera atrapada en el cuerpo de una mujer ciega se encuentra con un integrante de una prestigiosa familia, que necesita su ayuda para cambiar su destino.","posterPath":"https://image.tmdb.org/t/p/w500/1TtUh6UT1eLcOxYsBaUBdaBrSws.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/nBZyWSGAUEzCH7Mna0zUNTpBQlQ.jpg","voteAverage":8.6,"voteCount":767,"releaseDate":"2022-06-18","genres":["Drama","Sci-Fi & Fantasy","Action & Adventure","Misterio"],"type":"series","platforms":["$c"],"tmdbId":135157,"runtime":"$undefined","seasons":"$undefined"},{"id":96648,"title":"Sweet Home","originalTitle":"Sweet Home","overview":"Cuando unos monstruos brutales siembran el terror y amenazan a la humanidad, un adolescente problemático y atormentado es la mejor baza de sus vecinos para sobrevivir.","posterPath":"https://image.tmdb.org/t/p/w500/474kBht8w1y0HFKbfwk7FX1MKoh.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/mceCXNTny6a5F3rQgShLoyARw4l.jpg","voteAverage":8.2,"voteCount":1555,"releaseDate":"2020-12-18","genres":["Sci-Fi & Fantasy","Action & Adventure"],"type":"series","platforms":["$c"],"tmdbId":96648,"runtime":"$undefined","seasons":"$undefined"},{"id":45140,"title":"Teen Titans Go!","originalTitle":"Teen Titans Go!","overview":"Teen Titans Go! es una serie de animación que sigue las aventuras de los Jóvenes Titanes cuando no están salvando el mundo mientras viven juntos como adolescentes sin adultos que se entrometan. Las situaciones son, a diferencia de la mayoría de las series superheróicas, cómicas, alocadas y paródicas; por ejemplo, bromas juveniles que alcanzan nuevas cotas de peligrosidad, obtener el permiso de conducir tras destrozar el Batmóvil o lavar los trajes tras mancharlos al luchar contra sus enemigos.","posterPath":"https://image.tmdb.org/t/p/w500/dFRzEMjRuAF778RnYg6VsMMlKwx.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/bIHCUqaapZdRjd2kzSDiwzYyrpC.jpg","voteAverage":6.5,"voteCount":699,"releaseDate":"2013-04-23","genres":["Animación","Action & Adventure","Comedia","Familia","Sci-Fi & Fantasy"],"type":"series","platforms":["$c"],"tmdbId":45140,"runtime":"$undefined","seasons":"$undefined"},{"id":94605,"title":"Arcane","originalTitle":"Arcane","overview":"Con las dispares ciudades de Piltover y Zaun como telón de fondo, dos hermanas luchan en bandos opuestos de una guerra entre tecnologías mágicas y creencias enfrentadas.","posterPath":"https://image.tmdb.org/t/p/w500/i1vSPUbiBe2iK2HapGDfHItBFlC.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/q8eejQcg1bAqImEV8jh8RtBD4uH.jpg","voteAverage":8.8,"voteCount":5873,"releaseDate":"2021-11-06","genres":["Animación","Action & Adventure","Sci-Fi & Fantasy"],"type":"series","platforms":["$c"],"tmdbId":94605,"runtime":"$undefined","seasons":"$undefined"},{"id":1425,"title":"House of Cards","originalTitle":"House of Cards","overview":"Traicionado por la Casa Blanca, el congresista Frank Underwood emprende su implacable ascenso al poder. El chantaje, la seducción y la ambición serán sus armas.","posterPath":"https://image.tmdb.org/t/p/w500/hKWxWjFwnMvkWQawbhvC0Y7ygQ8.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/A3bigAAa4u6EbDvmMpDc0GNIEtG.jpg","voteAverage":8,"voteCount":3149,"releaseDate":"2013-02-01","genres":["Drama"],"type":"series","platforms":["$c"],"tmdbId":1425,"runtime":"$undefined","seasons":"$undefined"},{"id":5371,"title":"iCarly","originalTitle":"iCarly","overview":"Carly es una estrella cibernética de 13 años que se dio a conocer a través de la página web que creó con unos amigos. La joven, a pesar de su popularidad, intenta aprender a llevar una vida normal.","posterPath":"https://image.tmdb.org/t/p/w500/ny0vxdc2733gQVpXvXNds9M9Kpo.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/u3rph1KVUOKbOtrPIgCb27H08Fy.jpg","voteAverage":8,"voteCount":1540,"releaseDate":"2007-09-08","genres":["Comedia","Kids","Familia","Drama"],"type":"series","platforms":["$c"],"tmdbId":5371,"runtime":"$undefined","seasons":"$undefined"},{"id":15226,"title":"C.I.D","originalTitle":"C.I.D","overview":"Un equipo de hombres y mujeres comprometidos con la investigación de crímenes lo arriesgará todo para resolver los más oscuros casos de Bombay.","posterPath":"https://image.tmdb.org/t/p/w500/zNCpkoHN3LSK9yi1C2M0Z1rOv6J.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/1gZrOa2E9DOohEvSLLBJqus2zGu.jpg","voteAverage":5.9,"voteCount":29,"releaseDate":"1998-01-21","genres":["Action & Adventure","Crimen","Drama","Misterio"],"type":"series","platforms":["$c"],"tmdbId":15226,"runtime":"$undefined","seasons":"$undefined"},{"id":69740,"title":"Ozark","originalTitle":"Ozark","overview":"Un asesor financiero arrastra a su familia de Chicago hasta Misuri con la misión de lavar 500 millones de dólares en cinco años para apaciguar a un capo de la droga.","posterPath":"https://image.tmdb.org/t/p/w500/8Q87HCPhj98Afc0XAHOuaLgTTpO.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/aatG9iVAUL7U7OyFEmupESpOrD2.jpg","voteAverage":8.2,"voteCount":2751,"releaseDate":"2017-07-21","genres":["Crimen","Drama"],"type":"series","platforms":["$c"],"tmdbId":69740,"runtime":"$undefined","seasons":"$undefined"},{"id":110316,"title":"Alice in Borderland","originalTitle":"Alice in Borderland","overview":"Un aficionado a los videojuegos y sus dos amigos se ven atrapados en una versión paralela de Tokio, donde deben competir en sádicos juegos para sobrevivir.","posterPath":"https://image.tmdb.org/t/p/w500/xcOnCOpwe86Deau7P1VQNe0X6cg.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/QZaPkNUvhdcKONuO2fXuqtcQRo.jpg","voteAverage":8.1,"voteCount":2687,"releaseDate":"2020-12-10","genres":["Misterio","Drama","Action & Adventure"],"type":"series","platforms":["$c"],"tmdbId":110316,"runtime":"$undefined","seasons":"$undefined"},{"id":123249,"title":"My Dress-Up Darling","originalTitle":"My Dress-Up Darling","overview":"Gojo Wakana, un estudiante que sueña con hacer muñecas Hina, se une a Marin Kitagawa, la chica popular de su clase, cuando ella comparte un secreto que los acerca.","posterPath":"https://image.tmdb.org/t/p/w500/5qk1GjRczsJQLChZZvVdH9i37nW.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/gWPK2RIVJ6i3myf7Xdw8DqlznT8.jpg","voteAverage":8.4,"voteCount":890,"releaseDate":"2022-01-09","genres":["Animación","Comedia","Drama"],"type":"series","platforms":["$c"],"tmdbId":123249,"runtime":"$undefined","seasons":"$undefined"},{"id":126027,"title":"Fantasmas","originalTitle":"Fantasmas","overview":"Samantha y Jay se olvidan de la precaución cuando convierten su finca recién heredada en un alojamiento y desayuno. Llámalo planes extraviados. El lugar no solo se está desmoronando, sino que también está habitado por espíritus de residentes anteriores, a quienes solo Samantha puede ver y escuchar.","posterPath":"https://image.tmdb.org/t/p/w500/kFiJUxYDuFzvnVoWuTcapGgSJ0y.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/3MmRal3Uw3O0TVMvhfM63Z3mPz3.jpg","voteAverage":8,"voteCount":396,"releaseDate":"2021-10-07","genres":["Comedia","Sci-Fi & Fantasy"],"type":"series","platforms":["$c"],"tmdbId":126027,"runtime":"$undefined","seasons":"$undefined"},{"id":67075,"title":"Mob Psycho 100","originalTitle":"Mob Psycho 100","overview":"Kageyama Shigeo, más conocido por el apodo \"Mob\", parece un chico tímido con problemas para relacionarse con los demás, pero en realidad. es un poderoso Esper. Mob quiere ser un niño normal y corriente pero, para mantener su poder psíquico bajo control, tiene que reprimir constantemente sus emociones. Sin embargo, los problemas le persiguen, y vive rodeado por falsos Espers, espíritus malignos y misteriosas organizaciones.","posterPath":"https://image.tmdb.org/t/p/w500/aFcv9zeJtSbJHSYUlQCOQYV3Gio.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/kP5duNJEbTfXpBs6CITsaZ88pQi.jpg","voteAverage":8.5,"voteCount":1295,"releaseDate":"2016-07-12","genres":["Animación","Action & Adventure","Comedia","Sci-Fi & Fantasy"],"type":"series","platforms":["$c"],"tmdbId":67075,"runtime":"$undefined","seasons":"$undefined"},{"id":128839,"title":"La Brea","originalTitle":"La Brea","overview":"Un agujero gigantesco, de origen inexplicable, destruye Los Ángeles y separa a una familia en dos mundos distintos: la madre y el hijo quedan atrapados en una tierra salvaje, mientras que, en la superficie, el padre y la hija intentan rescatarlos.","posterPath":"https://image.tmdb.org/t/p/w500/jyHK7qFX2HvaAULSAO7aztdanyr.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/qhaPuyznsxb13wSQbpqSDqtNuX8.jpg","voteAverage":7.4,"voteCount":1581,"releaseDate":"2021-09-28","genres":["Sci-Fi & Fantasy","Drama","Action & Adventure"],"type":"series","platforms":["$c"],"tmdbId":128839,"runtime":"$undefined","seasons":"$undefined"},{"id":10283,"title":"Archer","originalTitle":"Archer","overview":"En la agencia de espionaje internacional ISIS, las crisis mundiales no son más que una excusa para que sus empleados se hagan la vida imposible los unos a los otros. En el centro de la acción está Archer, un maestro del espionaje. Trabaja para su autoritaria madre, la directora de ISIS Malory. Su compañera de trabajo (y ex-novia) Lana ahora sale con Cyril el contable.","posterPath":"https://image.tmdb.org/t/p/w500/vhnrkTGYPqcB63ALcSJm0WoaKHT.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/c4dymvMQT45P1j9RnscRyeyyqSg.jpg","voteAverage":8,"voteCount":1417,"releaseDate":"2009-09-17","genres":["Comedia","Action & Adventure","Animación"],"type":"series","platforms":["$c"],"tmdbId":10283,"runtime":"$undefined","seasons":"$undefined"},{"id":111110,"title":"ONE PIECE","originalTitle":"ONE PIECE","overview":"El joven pirata Monkey D. Luffy y su variopinta tripulación emprenden un viaje épico en busca de un tesoro.","posterPath":"https://image.tmdb.org/t/p/w500/gCZ18cl7Pc4tgiwMPWHTgjABrhy.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/qD211Hb5XwFxrszzBBe5EUYJerh.jpg","voteAverage":8.1,"voteCount":1746,"releaseDate":"2023-08-31","genres":["Action & Adventure","Sci-Fi & Fantasy"],"type":"series","platforms":["$c"],"tmdbId":111110,"runtime":"$undefined","seasons":"$undefined"},{"id":227371,"title":"Perfil falso","originalTitle":"Perfil falso","overview":"Camila conoce a su príncipe azul en una aplicación de citas. Después de una relación idílica, decide darle una sorpresa... y acaba atrapada en un falso paraíso.","posterPath":"https://image.tmdb.org/t/p/w500/luF32PEmbBaLK86qtW2l9uQPvSd.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/7e7GKWe49a8g96KP037PcrGtG6I.jpg","voteAverage":7.2,"voteCount":204,"releaseDate":"2023-05-31","genres":["Drama"],"type":"series","platforms":["$c"],"tmdbId":227371,"runtime":"$undefined","seasons":"$undefined"},{"id":30981,"title":"Monster","originalTitle":"Monster","overview":"El neurocirujano Kenzo Tenma pierde su trabajo y su novia tras salvar a un niño en lugar de al alcalde. Cuando los médicos responsables de su destitución aparecen muertos, Tenma se convierte en sospechoso y comienza a investigar la verdad detrás de las muertes.","posterPath":"https://image.tmdb.org/t/p/w500/en7EgMFKYxPKSHpljzveLf6YYfH.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/6T19aRp9zLMghZo1dTEwoNyreNZ.jpg","voteAverage":8.5,"voteCount":765,"releaseDate":"2004-04-07","genres":["Animación","Drama","Misterio","Crimen"],"type":"series","platforms":["$c"],"tmdbId":30981,"runtime":"$undefined","seasons":"$undefined"},{"id":246246,"title":"Beauty in Black","originalTitle":"Beauty in Black","overview":"El destino de una stripper da un vuelco cuando se cruza con una rica familia disfuncional que maneja un emporio de cosmética y un retorcido negocio de tráfico de personas.","posterPath":"https://image.tmdb.org/t/p/w500/i98Jl46WBpK7ymttNOakowtNuFF.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/ywJcUIMTCjstPLvvyIiPWP3G3m3.jpg","voteAverage":7.7,"voteCount":173,"releaseDate":"2024-10-24","genres":["Drama"],"type":"series","platforms":["$c"],"tmdbId":246246,"runtime":"$undefined","seasons":"$undefined"},{"id":96580,"title":"Resident Alien","originalTitle":"Resident Alien","overview":"La historia sigue a Harry, un extraterrestre que aterriza en la Tierra y se hace pasar por un médico humano de un pequeño pueblo. Al llegar con una misión secreta para matar a todos los humanos, Harry comienza a vivir una vida simple… Pero las cosas se ponen un poco difíciles cuando se ve obligado a resolver un asesinato local y se da cuenta de que necesita asimilarse a su nuevo mundo. Mientras lo hace, comienza a luchar con el dilema moral de su misión y a plantearse las grandes preguntas de la vida como: “¿Vale la pena salvar a los seres humanos?” y “¿Por qué doblan la pizza antes de comerla?”","posterPath":"https://image.tmdb.org/t/p/w500/5van3ktOTqWr5lcixh5aR8NlqqW.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/aCbOj4wc6vQUUVNKppssj2PYUy0.jpg","voteAverage":7.8,"voteCount":959,"releaseDate":"2021-01-27","genres":["Sci-Fi & Fantasy"],"type":"series","platforms":["$c"],"tmdbId":96580,"runtime":"$undefined","seasons":"$undefined"},{"id":79696,"title":"Manifest","originalTitle":"Manifest","overview":"Cuando el vuelo 828 de Montego Air aterriza de manera segura después de un vuelo turbulento pero de rutina, la tripulación y los pasajeros se sienten aliviados. Sin embargo, aunque para ellos han pasado pocas horas, el mundo ha envejecido cinco años y sus amigos, familias y colegas, después de llorar su pérdida, han perdido la esperanza y están intentando seguir adelante. Ahora, frente a lo imposible, a todos se les da una segunda oportunidad. Pero, a medida que se aclaran sus nuevas realidades, se enfrentan a un misterio más profundo y algunos de los pasajeros pronto se dan cuenta de que pueden estar destinados a algo más grande de lo que alguna vez creyeron posible.","posterPath":"https://image.tmdb.org/t/p/w500/oRM98LENegR9LfPpLH5BaWH1tjz.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/iZu83GB1IM7VXL2X90m7iLHYUHU.jpg","voteAverage":7.6,"voteCount":1780,"releaseDate":"2018-09-24","genres":["Sci-Fi & Fantasy","Misterio","Drama"],"type":"series","platforms":["$c"],"tmdbId":79696,"runtime":"$undefined","seasons":"$undefined"},{"id":219246,"title":"Si la vida te da mandarinas...","originalTitle":"Si la vida te da mandarinas...","overview":"En la isla de Jeju, una chica llena de vida y un joven decidido viven una historia repleta de desafíos y triunfos que demuestra que el amor puede trascender el tiempo.","posterPath":"https://image.tmdb.org/t/p/w500/h3Sv1qMAc6ADS6xWoIrUAzdXarf.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/mwczMJeoQrsPERcyP1e900jo3Jv.jpg","voteAverage":8.7,"voteCount":520,"releaseDate":"2025-03-07","genres":["Drama"],"type":"series","platforms":["$c"],"tmdbId":219246,"runtime":"$undefined","seasons":"$undefined"},{"id":63351,"title":"Narcos","originalTitle":"Narcos","overview":"La verdadera historia de los poderosos y violentos cárteles colombianos sirve de hilo conductor en esta serie dramática de mafiosos de gran realismo.","posterPath":"https://image.tmdb.org/t/p/w500/hbe0lyWfTu7Rm9bC9HsjTNVKOBU.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/y9ekzkPFmWSqUU3Kj0wHmYUM8qu.jpg","voteAverage":8.1,"voteCount":3272,"releaseDate":"2015-08-28","genres":["Crimen","Drama"],"type":"series","platforms":["$c"],"tmdbId":63351,"runtime":"$undefined","seasons":"$undefined"},{"id":46080,"title":"Masha y el Oso","originalTitle":"Masha y el Oso","overview":"Masha vive en el bosque con sus mascotas: un perro, una cabra y un cerdo. Ella obliga a los animales del bosque a que jueguen con ella, por lo que ellos le temen. Masha vive cerca del transiberiano y una mañana, Masha mira a una mariposa y la sigue cuando viene a darse cuenta entra a la casa de un oso que había salido a purgar. Mientras juega allí, Masha termina haciendo un gran desorden en la casa. El oso regresa a su hogar y ve el desastre causado por Masha. El oso intenta sin éxito deshacerse de ella. Al final, Masha y el oso se vuelven amigos.","posterPath":"https://image.tmdb.org/t/p/w500/fwvNu121w5zGWA5i7d7gDBrLgmN.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/mZmxNM7XMMT1QroznAQWmRf7duP.jpg","voteAverage":6.9,"voteCount":414,"releaseDate":"2009-01-07","genres":["Animación","Familia","Kids","Comedia"],"type":"series","platforms":["$c"],"tmdbId":46080,"runtime":"$undefined","seasons":"$undefined"},{"id":3570,"title":"Sailor Moon","originalTitle":"Sailor Moon","overview":"Narra la historia de Usagi Tsukino, una adolescente de 14 años muy distraída e imprudente cuya vida cambiará totalmente cuando un día por casualidad conoce a una gata llamada Luna, la cual le habla acerca de su misión como Sailor Scout y de salvar a la Tierra de futuros invasores malignos. Con el tiempo, surgen las demás sailors en su orden: Sailor Mercury (Ami Mizuno), Sailor Mars (Rei Hino), Sailor Jupiter (Makoto Kino) y Sailor Venus (Minako Aino).","posterPath":"https://image.tmdb.org/t/p/w500/m0e8QxAM0n3XK9GPvkxzRB0YL4k.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/sNCpbcCcRadDBMTh6An1dBMakqr.jpg","voteAverage":8.4,"voteCount":1015,"releaseDate":"1992-03-07","genres":["Action & Adventure","Animación","Comedia","Sci-Fi & Fantasy","Kids"],"type":"series","platforms":["$c"],"tmdbId":3570,"runtime":"$undefined","seasons":"$undefined"},{"id":75450,"title":"Titanes","originalTitle":"Titanes","overview":"Después de lanzarse a actuar por su cuenta, el excompañero de Batman se encuentra con una serie de jóvenes héroes con problemas que necesitan desesperadamente un mentor.","posterPath":"https://image.tmdb.org/t/p/w500/t1wuU7nUxyAFpCep4epXIGP8dtJ.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/iAzH3jFEaDMkjEsNNBUpGzSJ6VR.jpg","voteAverage":7.9,"voteCount":2828,"releaseDate":"2018-10-12","genres":["Drama","Action & Adventure","Sci-Fi & Fantasy"],"type":"series","platforms":["$c"],"tmdbId":75450,"runtime":"$undefined","seasons":"$undefined"},{"id":31991,"title":"WWE NXT","originalTitle":"WWE NXT","overview":"Sin descripción disponible.","posterPath":"https://image.tmdb.org/t/p/w500/9nLBX5Bf7PW4FAaWJLXpFFdeTlV.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/8BaPwADDUeg752Dxf0VSUHMQuYc.jpg","voteAverage":6.7,"voteCount":126,"releaseDate":"2010-02-23","genres":["Action & Adventure","Drama"],"type":"series","platforms":["$c"],"tmdbId":31991,"runtime":"$undefined","seasons":"$undefined"},{"id":81356,"title":"Sex Education","originalTitle":"Sex Education","overview":"La serie gira en torno a Otis, un adolescente calificado como \"bicho raro\" en el instituto, quien además es virgen. Como el tímido Otis tiene todas las respuestas para dudas sobre sexo porque su madre es sexóloga, su compañera Maeve le propone montar una consulta en el instituto para ayudar a sus compañeros con sus problemas sexuales.","posterPath":"https://image.tmdb.org/t/p/w500/oOEOg8rawAtc1nRbgGkf5fYcMB4.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/u23G9KZregWHs1use6ir1fX27gl.jpg","voteAverage":8.2,"voteCount":7833,"releaseDate":"2019-01-11","genres":["Comedia","Drama"],"type":"series","platforms":["$c"],"tmdbId":81356,"runtime":"$undefined","seasons":"$undefined"},{"id":157744,"title":"1923","originalTitle":"1923","overview":"Sigue a una nueva generación de la familia Dutton a principios del siglo XX cuando las pandemias, la sequía histórica, el fin de la Prohibición y la Gran Depresión plagan el oeste montañoso y los Dutton que lo llaman hogar.","posterPath":"https://image.tmdb.org/t/p/w500/aE7pMhO58iCn9CdU1VYcyTfKr1o.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/vIioWssbxRtEkIzgj8r0pCWYkYM.jpg","voteAverage":8.2,"voteCount":747,"releaseDate":"2022-12-18","genres":["Drama","Western"],"type":"series","platforms":["$c"],"tmdbId":157744,"runtime":"$undefined","seasons":"$undefined"},{"id":62117,"title":"Younger","originalTitle":"Younger","overview":"Trata sobre una madre soltera (Foster) que de repente tiene que volver al mundo laboral, pero con su edad va a resultar muy difícil.","posterPath":"https://image.tmdb.org/t/p/w500/feWw6i09zaX2apzRqd7QbKEAsx9.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/wCdhtaLMNtQ37j4OEch4dSKXyoE.jpg","voteAverage":6.9,"voteCount":238,"releaseDate":"2015-03-31","genres":["Drama","Comedia"],"type":"series","platforms":["$c"],"tmdbId":62117,"runtime":"$undefined","seasons":"$undefined"},{"id":62017,"title":"El hombre en el castillo","originalTitle":"El hombre en el castillo","overview":"Adaptación de la novela homónima de Philip K. Dick \"El hombre en el castillo\". Las fuerzas del Eje (Alemania y Japón) ganaron la II Guerra Mundial y ahora Estados Unidos está dividida en tres partes. Joe Blake, un luchador de la resistencia, parte de la Nueva York alemana con un misterioso cargamento hacia la zona neutral de Colorado. Por su parte, en la San Francisco japonesa, Juliana Crane recibe de manos de su hermana unas filmaciones que muestran una realidad alternativa en la que los aliados ganan la guerra.","posterPath":"https://image.tmdb.org/t/p/w500/4IljeGfUK3QpYxDUJKyi7K411Ro.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/pLio7Lod6YoNMM7ybFVjIJjwIxe.jpg","voteAverage":7.5,"voteCount":1472,"releaseDate":"2015-01-15","genres":["Sci-Fi & Fantasy","Drama"],"type":"series","platforms":["$c"],"tmdbId":62017,"runtime":"$undefined","seasons":"$undefined"},{"id":112888,"title":"Belleza verdadera","originalTitle":"Belleza verdadera","overview":"[True Beauty] Después de ver vídeos de belleza en Internet, una tímida fanática del cómic domina el arte del maquillaje y ve cómo su posición social se dispara cuando se convierte en la chica más bonita de su escuela, literalmente, de la noche a la mañana. ¿Pero su estatus de élite será de corta duración? ¿Cuánto tiempo puede ella mantener su \"yo real\" en secreto? ¿Y qué hay de ese chico lindo que le gusta? ¿Te imaginas si se enterara de la verdad? Lee Su Ho es el único que ha visto su rostro desnudo, quien no solo es uno de los mejores estudiantes, sino que también llama la atención de todas las chicas que lo rodean. A pesar de su popularidad, Lee Su Ho tiene un lado tímido, se pone rojo brillante cuando se avergüenza y dice cosas que lamenta. Por otro lado están Han Seo Jun, un chico alto y atractivo como un modelo, rudo a primera vista pero también con un par de secretos; y Kang Su Jin, una diosa en toda regla, al menos físicamente hablando.","posterPath":"https://image.tmdb.org/t/p/w500/zfKcn6xqCu0zopDdWPiYC7t4R2g.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/3E1GroTJCRdIYHa5n62GqjmqxQR.jpg","voteAverage":8.2,"voteCount":2626,"releaseDate":"2020-12-09","genres":["Comedia","Drama"],"type":"series","platforms":["$c"],"tmdbId":112888,"runtime":"$undefined","seasons":"$undefined"},{"id":21762,"title":"Parenthood","originalTitle":"Parenthood","overview":"Los cuatro hermanos Braverman, tienen que afrontar todo tipo de problemas en sus vidas, teniendo entre ellos un denominador común, todos son padres.","posterPath":"https://image.tmdb.org/t/p/w500/9KjKLJrrUI1sU9bNsQaQ5H8kTyY.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/72zLfNDaL8JpfLDwmQ2b8DPbeHc.jpg","voteAverage":7.5,"voteCount":174,"releaseDate":"2010-03-02","genres":["Drama"],"type":"series","platforms":["$c"],"tmdbId":21762,"runtime":"$undefined","seasons":"$undefined"},{"id":79141,"title":"Scissor Seven","originalTitle":"Scissor Seven","overview":"Este aprendiz de sicario empuña de noche sus tijeras de peluquero para ganar dinero y recordar su pasado mientras lidia con unos compañeros poco amistosos.","posterPath":"https://image.tmdb.org/t/p/w500/jz9ii5sft8l6zP3lzu51xNWmgiO.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/80AhZSbY4eYe7HZnmkqX18ZcAFj.jpg","voteAverage":8.6,"voteCount":769,"releaseDate":"2018-04-25","genres":["Animación","Comedia","Action & Adventure","Sci-Fi & Fantasy"],"type":"series","platforms":["$c"],"tmdbId":79141,"runtime":"$undefined","seasons":"$undefined"},{"id":35610,"title":"InuYasha","originalTitle":"InuYasha","overview":"InuYasha es el nombre de un demonio que en su día sellaron para que no provocara más problemas. Pero Kagome, fruto del destino, consigue atravesar la barrera mágica que separa el mundo actual con el de las guerras civiles, y quita el sello a Inu Yasha debido a la amenaza de cierto monstruo. Kagome posee la joya de las cuatro almas, que permite ganar gran poder, y ella será fruto del recelo de muchos monstruos en busca de ella. Pero la joya se ha roto en mil y un pedazos, e Inu Yasha y Kagome partirán en busca de todos los trozos de la joya.","posterPath":"https://image.tmdb.org/t/p/w500/5pMVrmb6tGmNAH0sX7guM9WbrU3.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/mVE1ULmLaYhCkBQPt3JC5xZC6T6.jpg","voteAverage":8.6,"voteCount":2068,"releaseDate":"2000-10-16","genres":["Animación","Action & Adventure","Sci-Fi & Fantasy"],"type":"series","platforms":["$c"],"tmdbId":35610,"runtime":"$undefined","seasons":"$undefined"},{"id":287011,"title":"Un amor que no se agota","originalTitle":"Un amor que no se agota","overview":"Una presentadora de la teletienda se va al campo para pensar en una forma de mejorar la audiencia de su programa, pero un misterioso granjero trastoca sus planes… y su corazón.","posterPath":"https://image.tmdb.org/t/p/w500/ah91RIeK91AXYPDCsKHozRSgEox.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/dL5mViE22ZHnhrUU9wlklzIU4Iy.jpg","voteAverage":7.7,"voteCount":10,"releaseDate":"2026-04-22","genres":["Comedia","Drama"],"type":"series","platforms":["$c"],"tmdbId":287011,"runtime":"$undefined","seasons":"$undefined"},{"id":289424,"title":"Hacemos lo que podemos","originalTitle":"Hacemos lo que podemos","overview":"Tras 20 años tratando de hacer su primera película, un aspirante a director toca fondo. Pero entonces conoce a una productora saturada que le ayuda a volver a creer en sí mismo.","posterPath":"https://image.tmdb.org/t/p/w500/EQMMCm2IMUxU8m9Opq0trg7vAN.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/4ZXZi107TbfBJFGT4cnqbavQIoc.jpg","voteAverage":8.7,"voteCount":15,"releaseDate":"2026-04-18","genres":["Drama"],"type":"series","platforms":["$c"],"tmdbId":289424,"runtime":"$undefined","seasons":"$undefined"},{"id":117465,"title":"Hell's Paradise","originalTitle":"Hell's Paradise","overview":"Ante la posibilidad de la absolución, un asesino ninja se une a otros criminales condenados en la búsqueda de una isla misteriosa para recuperar un elíxir de inmortalidad.","posterPath":"https://image.tmdb.org/t/p/w500/fusvI9NECr7T97JpRwV50BKTk9p.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/vjiIuR3XGpoGSumQ7DziPAmxIYR.jpg","voteAverage":8.2,"voteCount":452,"releaseDate":"2023-04-01","genres":["Animación","Action & Adventure","Sci-Fi & Fantasy"],"type":"series","platforms":["$c"],"tmdbId":117465,"runtime":"$undefined","seasons":"$undefined"},{"id":99966,"title":"Estamos muertos","originalTitle":"Estamos muertos","overview":"Un grupo de estudiantes se da cuenta de que tienen que enfrentarse con las pocas existencias que tienen a una situación de crisis extrema. Estos quedan atrapados en el instituto donde estudian mientras que un virus zombie se propaga por todo el mundo.\n\nLa escuela está llena de infectados, pero nadie puede salir de allí. El gupo de amigos deberá hacer todo lo posible para sobrevivir y salir del colegio sanos y salvos cuando el apocalipsis zombie termine.","posterPath":"https://image.tmdb.org/t/p/w500/8jClvC5U756Uhd8zDYek50ihO49.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/8hp2CuGnw1iP5dLBVMAPUv23swx.jpg","voteAverage":8.3,"voteCount":4323,"releaseDate":"2022-01-28","genres":["Action & Adventure","Drama","Sci-Fi & Fantasy"],"type":"series","platforms":["$c"],"tmdbId":99966,"runtime":"$undefined","seasons":"$undefined"},{"id":205050,"title":"Shangri La Frontier","originalTitle":"Shangri La Frontier","overview":"\"¿Cuándo fue la última vez que jugué a un juego que no fuera una mierda?\" Este es un mundo en el futuro cercano donde los juegos que usan pantallas se consideran retro, y muchos juegos de realidad virtual no llegan a un mínimo de calidad: son los llamados \"juegos de mierda\". A los que dedican sus vidas a completar estos juegos se les llama \"cazadores de juegos de mierda\", y Rakuro Hizutome es uno de ellos. El juego que ha elegido empezar a continuación es Shangri-La Frontier, un juego que goza de una gran crítica y más de 30 millones de jugadores. ¡La mejor historia de aventuras escrita por el jugador más fuerte de \"juegos de mierda\" está a punto de comenzar!","posterPath":"https://image.tmdb.org/t/p/w500/5CFYv4WYLZXizAyRwRhP0vZLNx.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/yErVUZkLVak2ICxFC7mMfl3vcNP.jpg","voteAverage":8.1,"voteCount":216,"releaseDate":"2023-10-01","genres":["Animación","Action & Adventure","Comedia","Sci-Fi & Fantasy"],"type":"series","platforms":["$c"],"tmdbId":205050,"runtime":"$undefined","seasons":"$undefined"},{"id":79680,"title":"Snowpiercer: Rompenieves","originalTitle":"Snowpiercer: Rompenieves","overview":"En un futuro en el que la Tierra ha quedado cubierta por hielos perpetuos, los pocos supervivientes humanos se han refugiado en un tren que recorre el planeta sin parar nunca. Ahí, los pasajeros se han repartido siguiendo un estricto sistema de clases en el que los más pudientes se encuentran en los vagones de la cabeza y los más pobres están en la cola y deben alimentar el motor del tren.","posterPath":"https://image.tmdb.org/t/p/w500/zPP3OtYGOrFJgdapPcJBqlQanlm.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/zFJxwXtW3Y7FSDrc2FnVFpQCcY1.jpg","voteAverage":7.4,"voteCount":1405,"releaseDate":"2020-05-17","genres":["Sci-Fi & Fantasy","Drama"],"type":"series","platforms":["$c"],"tmdbId":79680,"runtime":"$undefined","seasons":"$undefined"},{"id":86831,"title":"Love, Death & Robots","originalTitle":"Love, Death & Robots","overview":"Seres terroríficos, sorpresas retorcidas y humor negro convergen en esta antología de relatos animados para adultos presentada por Tim Miller y David Fincher.","posterPath":"https://image.tmdb.org/t/p/w500/vL5BQvXH96cJzmNK5n7QliQxy90.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/nBrkOZyI75artyizuBFeya48KbO.jpg","voteAverage":8.2,"voteCount":3977,"releaseDate":"2019-03-15","genres":["Animación","Sci-Fi & Fantasy"],"type":"series","platforms":["$c"],"tmdbId":86831,"runtime":"$undefined","seasons":"$undefined"},{"id":246,"title":"Avatar: La leyenda de Aang","originalTitle":"Avatar: La leyenda de Aang","overview":"La historia transcurre en un mundo de gente principalmente asiática (el estilo de vida en la serie se basa en la primera mitad del siglo XIX), donde predominan las artes marciales y la manipulación de los elementos en combinación con el misticismo oriental, dando seguimiento a las aventuras de Aang, el más reciente sucesor de una larga línea de avatares, y sus amigos en un intento por salvar su místico mundo de la despiadada Nación del Fuego que busca conquistar a las demás naciones. Durante sus travesías son acechados insistentemente por el desterrado príncipe del fuego Zuko, cuyo objetivo es capturar al avatar para recuperar su honor. Esta serie es presentada como si se tratara de una serie de libros, en donde cada episodio actúa como un «capítulo», y cada temporada como un solo «libro», los cuales se titulan por el elemento temático de la temporada.","posterPath":"https://image.tmdb.org/t/p/w500/ucNtkZfpZ6KgxqPo039nN4LAyFR.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/kU98MbVVgi72wzceyrEbClZmMFe.jpg","voteAverage":8.8,"voteCount":4820,"releaseDate":"2005-02-21","genres":["Animación","Action & Adventure","Sci-Fi & Fantasy"],"type":"series","platforms":["$c"],"tmdbId":246,"runtime":"$undefined","seasons":"$undefined"},{"id":251883,"title":"Gracias, ¿el siguiente?","originalTitle":"Gracias, ¿el siguiente?","overview":"Tras una dolorosa ruptura, una joven abogada se lanza al complicado mundo de las citas actual, sabiendo que sus mejores amigas son su red de seguridad.","posterPath":"https://image.tmdb.org/t/p/w500/lLXumtpW0fpEMmQ6xCKtpLG7UOz.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/sdl9K3IZDo6Z2pqIUiNUz2YyNDJ.jpg","voteAverage":7.3,"voteCount":47,"releaseDate":"2024-05-09","genres":["Drama","Comedia"],"type":"series","platforms":["$c"],"tmdbId":251883,"runtime":"$undefined","seasons":"$undefined"},{"id":202297,"title":"Fire Country","originalTitle":"Fire Country","overview":"Bode Leone es un joven convicto que busca redención y una reducción de su condena al unirse a un programa de lucha contra incendios forestales para presos en el norte de California. En este programa, Bode y otros internos trabajan codo a codo con bomberos de élite para extinguir incendios masivos e impredecibles en la región. Es una misión de alto riesgo y grandes recompensas.\n\nLa tensión aumenta cuando Bode es asignado al programa en su pequeño pueblo natal, donde alguna vez fue un héroe local hasta que sus problemas comenzaron. Hace cinco años, Bode lo perdió todo y dejó el pueblo con un gran secreto. Ahora ha vuelto, con un historial criminal y la audacia de creer en una segunda oportunidad de redención con Cal Fire.","posterPath":"https://image.tmdb.org/t/p/w500/6XnA02VRG4dhBpTZWGZuXQdYGDW.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/r6jUY6q3ObYOeFFWxM7jemS7IWE.jpg","voteAverage":8.1,"voteCount":166,"releaseDate":"2022-10-07","genres":["Drama","Crimen"],"type":"series","platforms":["$c"],"tmdbId":202297,"runtime":"$undefined","seasons":"$undefined"},{"id":63926,"title":"One Punch Man","originalTitle":"One Punch Man","overview":"La historia tiene lugar en una de las metrópolis ficticias de la Tierra, la Ciudad Z en Japón. El mundo está lleno de extraños monstruos que misteriosamente aparecen y causan muchos desastres. Saitama, el protagonista, es un poderoso superhéroe que derrota fácilmente a los monstruos u otros villanos con un único golpe. Debido a esto, Saitama ha encontrado aburrida su fuerza y siempre está tratando de encontrar rivales más poderosos que le puedan igualar.","posterPath":"https://image.tmdb.org/t/p/w500/xY3E9JNLwwQvkNk4TcvvAu9pAOe.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/s0w8JbuNNxL1YgaHeDWih12C3jG.jpg","voteAverage":8.4,"voteCount":4096,"releaseDate":"2015-10-05","genres":["Animación","Comedia","Action & Adventure","Sci-Fi & Fantasy"],"type":"series","platforms":["$c"],"tmdbId":63926,"runtime":"$undefined","seasons":"$undefined"},{"id":4589,"title":"Arrested Development","originalTitle":"Arrested Development","overview":"Es la historia, ganadora del premio Emmy, de una familia adinerada que lo perdió todo y el hijo que tuvo que mantener a todos unidos.","posterPath":"https://image.tmdb.org/t/p/w500/p4r4RD7RsNcJVoz0H6z3dBoTBtW.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/8qn0u64JXSgnGKe2KkKqrfH7V84.jpg","voteAverage":7.9,"voteCount":1644,"releaseDate":"2003-11-02","genres":["Comedia"],"type":"series","platforms":["$c"],"tmdbId":4589,"runtime":"$undefined","seasons":"$undefined"},{"id":240411,"title":"DAN DA DAN","originalTitle":"DAN DA DAN","overview":"Cuando Momo, una estudiante de instituto de una familia de médiums espirituales, conoce a su compañero de clase Okarun, un friki del ocultismo, discuten: Momo cree en los fantasmas pero no en los extraterrestres, y Okarun cree en los extraterrestres pero no en los fantasmas. Cuando resulta que ambos fenómenos son reales, en Momo surge un poder oculto y en Okarun el poder de una maldición. Juntos, deberán desafiar a las fuerzas paranormales que amenazan su mundo.","posterPath":"https://image.tmdb.org/t/p/w500/wQy1dCYgdSwoY78aKFTWFT1xADX.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/uNTrRKIOyKYISthoeizghtXPEOK.jpg","voteAverage":8.6,"voteCount":834,"releaseDate":"2024-10-04","genres":["Animación","Action & Adventure","Comedia","Sci-Fi & Fantasy"],"type":"series","platforms":["$c"],"tmdbId":240411,"runtime":"$undefined","seasons":"$undefined"},{"id":90802,"title":"Sandman","originalTitle":"Sandman","overview":"Después de pasar años encarcelado, Morfeo (el Rey de los Sueños) emprende un viaje por diferentes mundos para encontrar lo que le fue arrebatado y recuperar su poder.","posterPath":"https://image.tmdb.org/t/p/w500/dnDGWdBwBC1zexCYcv8ihQKQPVT.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/i8taDLjpF8cCbp53N8kOFt1LSkW.jpg","voteAverage":7.9,"voteCount":2588,"releaseDate":"2022-08-05","genres":["Sci-Fi & Fantasy","Drama","Action & Adventure"],"type":"series","platforms":["$c"],"tmdbId":90802,"runtime":"$undefined","seasons":"$undefined"},{"id":45857,"title":"Katekyo Hitman Reborn!","originalTitle":"Katekyo Hitman Reborn!","overview":"Tsuna es un estudiante de instituto bastante tímido y que es un fracaso en absolutamente todo: los estudios, los deportes y socializando con los demás. Pero todo cambia de repente cuando ante Tsuna aparece un bebé que dice llamarse Reborn y ser un Tutor Mafioso enviado por la Familia Vongola, una poderosa Familia de la mafia italiana. Reborn acude a Tsuna para entrenarlo como ¡el décimo jefe de los Vongola!","posterPath":"https://image.tmdb.org/t/p/w500/6x7mx9f3ufHCC3pNgMoMnzVo3jw.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/3wztM15Bq7TX3Kc8IzApqsOQQjK.jpg","voteAverage":8.2,"voteCount":184,"releaseDate":"2006-10-07","genres":["Animación","Comedia","Action & Adventure"],"type":"series","platforms":["$c"],"tmdbId":45857,"runtime":"$undefined","seasons":"$undefined"},{"id":66788,"title":"Por trece razones","originalTitle":"Por trece razones","overview":"A pesar del desconcierto que supone volver a oír la voz de Hannah, Clay descubrirá que son trece las razones por las cuales ha decidido quitarse la vida, trece caras de cassete y que, por ello, son trece las personas que deben escucharlas. Él es una de ellas.","posterPath":"https://image.tmdb.org/t/p/w500/xcaPztQp9Lvlh9eLoOaGdq4JfxL.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/c4CSgKL6QfkJxsWcGYDyTxpbzpW.jpg","voteAverage":7.5,"voteCount":4533,"releaseDate":"2017-03-31","genres":["Drama","Misterio"],"type":"series","platforms":["$c"],"tmdbId":66788,"runtime":"$undefined","seasons":"$undefined"},{"id":60863,"title":"Haikyuu!! Los ases del vóley","originalTitle":"Haikyuu!! Los ases del vóley","overview":"Un hecho fortuito desencadena el amor de Shouyou Hinata por el voleibol. Su club no tenía ningún miembro, pero de algún modo perseveró y finalmente realizó su primer y último partido regular de la escuela secundaria, donde fue aniquilado por Tobio Kageyama, un jugador superestrella conocido como \"Rey de la Corte.\" ¡Jurando venganza, Hinata ingresa en el club de voleibol Karasuno, de secundaria alta, solo para volver a encontrarse cara a cara con su odiado rival, Kageyama!","posterPath":"https://image.tmdb.org/t/p/w500/k8YZ296JIxo6qr3rS7fxGGJyY4H.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/zr1MDQCPVB5uJEHxiO6Tukn4OjH.jpg","voteAverage":8.6,"voteCount":1494,"releaseDate":"2014-04-06","genres":["Animación","Comedia","Drama"],"type":"series","platforms":["$c"],"tmdbId":60863,"runtime":"$undefined","seasons":"$undefined"},{"id":61852,"title":"Henry Danger","originalTitle":"Henry Danger","overview":"Henry Hart consigue un trabajo de medio tiempo como Kid Danger, un compañero de lucha del super héroe anticrimen Capitán Man/Ray. A pesar de que Ray le dijo a Henry que mantuviera el secreto sobre su trabajo, también lo tiene que hacer con sus mejores amigos Charlotte y Jasper. Sus padres y su hermana menor Piper no saben sobre su secreto. Una tienda llamada \"Junk'n'Stuff\", tiene una guarida secreta escondida debajo, donde Ray hace su trabajo. Pero capítulos adelante la historia cambia un poco, ya que Charlotte descubre que su amigo Henry es Kid Danger, entonces él se lo cuenta a Ray el cual lo despidió, y más adelante por una hazaña heroica, lo recontrata y contrata a Charlotte, desde entonces los dos trabajan para Capitán Man. Luego de que Jasper descubriera el secreto de Henry, el show dio un giro inesperado, ya que Capitán Man contrató a Jasper como empleado en \"Junk'n'Stuff\", de igual manera como ayudante de Kid Danger y Capitán Man en la capicueva.","posterPath":"https://image.tmdb.org/t/p/w500/onddStWYELFaz4BbV8kavU11oCo.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/1pnaMzcTXU6LmBd9rf4ZvNGBnce.jpg","voteAverage":8.3,"voteCount":1144,"releaseDate":"2014-07-26","genres":["Comedia","Familia","Kids","Sci-Fi & Fantasy"],"type":"series","platforms":["$c"],"tmdbId":61852,"runtime":"$undefined","seasons":"$undefined"},{"id":119495,"title":"The Eminence in Shadow","originalTitle":"The Eminence in Shadow","overview":"Los Shadowbrokers son aquellos que pasan desapercibidos, haciéndose pasar por personas corrientes, cuando en realidad controlan todo desde las sombras. Sid quiere ser alguien así más que nada en el mundo, ¡y algo tan insignificante como la aburrida realidad no se interpondrá en su camino! Entrena en secreto todas las noches, preparándose para su eventual ascenso al poder, solo para que un accidente de tráfico común y corriente (pero mortal) le niegue su destino. Pero cuando despierta en otro mundo y de repente se encuentra al frente de una organización secreta real que lucha contra el mal en las sombras, ¡por fin tendrá la oportunidad de llevar a cabo todas sus fantasías delirantes!","posterPath":"https://image.tmdb.org/t/p/w500/r3IHw82QFkLmggTG9QpBFpYArVM.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/htD5SJpPOvkmAowU80KrWnN59WO.jpg","voteAverage":8,"voteCount":274,"releaseDate":"2022-10-05","genres":["Animación","Comedia","Sci-Fi & Fantasy","Action & Adventure"],"type":"series","platforms":["$c"],"tmdbId":119495,"runtime":"$undefined","seasons":"$undefined"},{"id":131041,"title":"BLUELOCK","originalTitle":"BLUELOCK","overview":"Yoichi es un joven al que acaban de eliminar junto a su equipo. De pronto recibe una carta donde lo convocan para participar en un extraño experimento sobre fútbol.","posterPath":"https://image.tmdb.org/t/p/w500/9aICTTHECyRwB2pBHm3rAj1SgGg.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/seMRyWVwIVBWbC9xaMzDMZJ8fUH.jpg","voteAverage":8.2,"voteCount":589,"releaseDate":"2022-10-09","genres":["Animación","Action & Adventure","Drama"],"type":"series","platforms":["$c"],"tmdbId":131041,"runtime":"$undefined","seasons":"$undefined"},{"id":113268,"title":"A la caza de espíritus malignos","originalTitle":"A la caza de espíritus malignos","overview":"Empleados de un restaurante de día, cazadores de demonios de noche. Ellos usan sus habilidades especiales para derrotar espíritus malignos que persiguen humanos.","posterPath":"https://image.tmdb.org/t/p/w500/qKO8ZSEwq50EGk3BeAh8J9Gr34K.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/jNyK0FF7t7oaU4wMpRkEnEIOVlW.jpg","voteAverage":8.3,"voteCount":424,"releaseDate":"2020-11-28","genres":["Drama","Misterio","Action & Adventure"],"type":"series","platforms":["$c"],"tmdbId":113268,"runtime":"$undefined","seasons":"$undefined"},{"id":47,"title":"El Chavo del Ocho","originalTitle":"El Chavo del Ocho","overview":"\"El Chavo del Ocho\" es una serie mexicana que narra las historias de un niño mexicano de 8 años (El Chavo) que vive en una vecindad de la Ciudad de México, y con frecuencia se encuentra dentro de un barril situado en el patio de la vecindad. El programa explora, de manera cómica, los problemas que muchos niños de la calle experimentan a diario como el hambre, la tristeza y el no tener a alguien que cuide de ellos. El argumento pasaba por una serie de enredos y confusiones en que participan los personajes que creó el escritor Roberto Gómez Bolaños, Chespirito.","posterPath":"https://image.tmdb.org/t/p/w500/1TdBpVOASafzfWlnecwW17UL6a5.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/8BPGi66pHTNybfkqX0lIdM4rnxT.jpg","voteAverage":8,"voteCount":2018,"releaseDate":"1973-02-26","genres":["Comedia","Familia","Drama"],"type":"series","platforms":["$c"],"tmdbId":47,"runtime":"$undefined","seasons":"$undefined"},{"id":67335,"title":"Sin senos sí hay paraíso","originalTitle":"Sin senos sí hay paraíso","overview":"Catalina Manrique es hija de Doña Hilda y Albeiro y nació el día en que su madre se enteró que su hija mayor había sido asesinada. Hilda, destrozada por la muerte de su hija Catalina, la grande decidió que su segunda hija llevaría el mismo nombre. La infancia de Catalina, la pequeña estará marcada por el fantasma de su difunta hermana, ya que su madre y su padre harán todo lo posible para alejarla del entorno de mafiosos que acabaron con la vida de su primera hija. Catalina tendrá que desenterrar los dolorosos secretos de sus padres y soportar la maldad de La Diabla, quien tratará de convencerla de operarse los senos para ofrecerle su inocencia y virginidad a los narcos y políticos poderosos. Pero lo que muchos no saben es que Catalina tiene una personalidad desafiante y demostrará que sin senos sí hay paraíso.","posterPath":"https://image.tmdb.org/t/p/w500/7lBJ6lOS0uQqsH13U9iMTikawQS.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/oAkpvVvoyZWMo9cpNk3aQoVKsjM.jpg","voteAverage":7.6,"voteCount":2911,"releaseDate":"2016-07-19","genres":["Action & Adventure","Crimen","Drama","Misterio"],"type":"series","platforms":["$c"],"tmdbId":67335,"runtime":"$undefined","seasons":"$undefined"},{"id":254821,"title":"El pretendiente perfecto","originalTitle":"El pretendiente perfecto","overview":"Recién llegada a una nueva ciudad, una madre debe forjarse una nueva vida y encargarse de su mayor desafío: ayudar a sus cinco temperamentales hijas a encontrar el amor.","posterPath":"https://image.tmdb.org/t/p/w500/bNPVb2Sv4N3CO7l6AdfjxNkMTfN.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/pg4xOroBDlxIhRK1m5xFyLgXrVD.jpg","voteAverage":8.1,"voteCount":62,"releaseDate":"2025-01-25","genres":["Drama"],"type":"series","platforms":["$c"],"tmdbId":254821,"runtime":"$undefined","seasons":"$undefined"},{"id":34967,"title":"Falling Skies","originalTitle":"Falling Skies","overview":"Falling Skies cuenta la historia de las secuelas de una invasión alienígena que, además de neutralizar toda la tecnología avanzada y la generación de electricidad, elimina a la gran mayoría de las fuerzas militares de todos los países en un tiempo corto. Se infiere que cerca del 90% de la población mundial fue eliminada en la primera ola del ataque. La historia comienza 6 meses después de la invasión.","posterPath":"https://image.tmdb.org/t/p/w500/uP6p0aWcIpYwA0HjY4bYR4naz5g.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/lUincM93AWXWQbq0Y3PIKu10HEL.jpg","voteAverage":7.1,"voteCount":1313,"releaseDate":"2011-06-19","genres":["Action & Adventure","Sci-Fi & Fantasy","Drama"],"type":"series","platforms":["$c"],"tmdbId":34967,"runtime":"$undefined","seasons":"$undefined"},{"id":39852,"title":"The Sinner","originalTitle":"The Sinner","overview":"Una madre, víctima de un inexplicable ataque de rabia, comete un sorprendente acto de violencia y horror en el que, para mayor desconcierto, no tiene ni idea de por qué. El investigador se encuentra obsesionado con descubrir el motivo oculta de la mujer. Juntos viajarán por un viaje desgarrador hacia las profundidades de su psique y los violentos secretos escondidos en su pasado.","posterPath":"https://image.tmdb.org/t/p/w500/w87GVXlXRFyknBXjhbIoyWYWE81.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/lVWku9LX2qdJTtAbRzaCDhhWeTK.jpg","voteAverage":7.5,"voteCount":1230,"releaseDate":"2017-08-02","genres":["Crimen","Drama"],"type":"series","platforms":["$c"],"tmdbId":39852,"runtime":"$undefined","seasons":"$undefined"},{"id":902,"title":"Yu-Gi-Oh! Duel Monsters","originalTitle":"Yu-Gi-Oh! Duel Monsters","overview":"Yu-Gi-Oh (Significa Rey de los Juegos), Su personaje principal Yugi M?t? en compañía de sus mejores amigos Katsuya Jonouchi (Joseph Wheeler), Anzu Mazaki (Téa Gardner), y Hiroto Honda (Tristán Taylor), pero también tiene la compañía de un espíritu de un Antiguo Faraón \"Atem\"; tienen aventuras que están estrechamente ligadas a un juego de cartas \"Duelo de Monstruos\", un juego ligado con el pasado de egipto el cual se jugaba en tiempos antiguos y que es descubierto por Pegasus J. Crawford (maximilian Pegasus), este es el creador de el Juego \"Duelo de Monstruos\" tomando como base lo que paso en egipto hace mucho tiempo. Del juego se crean torneos y campeonatos nacionales e internacionales, participando Yugi M?t? obteniendo el titulo de \"Rey de los Juegos\". Yugi M?t? y su contraparte el Antiguo Faraón \"Atem\" se enfrentan a muchas vicisitudes ocasionadas por enemigos en su mayoia del pasado de el faraon, teniendo el faron con la ayuda de Yugi la labor de detenerlos.","posterPath":"https://image.tmdb.org/t/p/w500/dJas6Y7lXzgPHgr4ro0qCOTgNiM.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/gJYZBM200Flldo6im3EEdXslR1j.jpg","voteAverage":8.2,"voteCount":1020,"releaseDate":"2000-04-18","genres":["Animación","Action & Adventure"],"type":"series","platforms":["$c"],"tmdbId":902,"runtime":"$undefined","seasons":"$undefined"},{"id":72002,"title":"Dinastía","originalTitle":"Dinastía","overview":"Los Carrington y los Colby se disputan el control de su fortuna (y de sus hijos) en este remake actualizado del gran clásico de la televisión.","posterPath":"https://image.tmdb.org/t/p/w500/rVQ35erLIoV8hyh7lIKAMiChmOO.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/bq6AcviGsBmynArhhCpLkR8YN6U.jpg","voteAverage":8.1,"voteCount":898,"releaseDate":"2017-10-11","genres":["Drama","Soap"],"type":"series","platforms":["$c"],"tmdbId":72002,"runtime":"$undefined","seasons":"$undefined"},{"id":68398,"title":"Kim, El Doctor Romántico","originalTitle":"Kim, El Doctor Romántico","overview":"[Romantic Doctor, Teacher Kim] - ¿Qué podría causar que un famoso cirujano apodado la \"Mano de Dios\" renuncie a todo? Boo Yong Joo (Han Suk Kyu) fue una vez un famoso cirujano en el pico de su carrera en un importante hospital. Pero repentinamente abandona todo un día para vivir en reclusión y trabajar como un médico de barrio en una ciudad pequeña. Ahora él es el \"Maestro Kim\" y se refiere a sí mismo como el \"Doctor Romántico\". Kang Dong Joo (Yoo Yeon Seok) se convirtió en médico para hacer algo de sí mismo después de crecer pobre, y busca pacientes VIP para lograr el éxito que quiere desesperadamente. Yoon Seo Jung (Seo Hyun Jin) es una cirujana joven apasionada que es perseguida por un error de su pasado y trata de superarlo. Cuando Dong Joo y Seo Jung Kim conocen al peculiar profesor, sus vidas y sus carreras nunca volverán a ser lo mismo.","posterPath":"https://image.tmdb.org/t/p/w500/3IefzMCadJxoSGchlmKiFmFt8tu.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/cmk8d1e1GxrwTaau0Tj4zm1osm0.jpg","voteAverage":8.2,"voteCount":122,"releaseDate":"2016-11-07","genres":["Drama"],"type":"series","platforms":["$c"],"tmdbId":68398,"runtime":"$undefined","seasons":"$undefined"},{"id":13916,"title":"Death Note","originalTitle":"Death Note","overview":"Light Yagami, un estudiante japonés, encuentra un cuaderno llamado Death Note que permite matar a cualquier persona cuyo nombre se escriba en él. Usando este poder, decide crear un mundo \"perfecto\" eliminando a los criminales. Sin embargo, su plan empieza a torcerse cuando L, un brillante detective, intenta descifrar el misterio que rodea a todas estas muertes.","posterPath":"https://image.tmdb.org/t/p/w500/cFirFPdzle2QYyjFlLVwWUP5YAo.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/koBa94NxTaGe2FoDzlXMuJptsv0.jpg","voteAverage":8.6,"voteCount":4891,"releaseDate":"2006-10-04","genres":["Animación","Misterio","Sci-Fi & Fantasy"],"type":"series","platforms":["$c"],"tmdbId":13916,"runtime":"$undefined","seasons":"$undefined"},{"id":278275,"title":"Manto de sombras","originalTitle":"Manto de sombras","overview":"Lu Wuyi es la zorra más joven de las nueve colas de la misteriosa organización \"Luna sin Forma\". Junto a su hermana mayor Wu Wangyan, busca a la zorra fugitiva Wei e infiltra la Mansión Wei en Luo'an. Allí también llegan Wu Shiguang, con una profunda sed de venganza, y los magos Ji Ling y Li Jie. En su búsqueda de la verdad, entre pruebas y alianzas, cada uno persigue sus propios objetivos. En repetidas luchas por la fuerza del Dios Dragón, cambian el rumbo del destino. Para proteger la paz en el mundo, toman decisiones difíciles y sacrifican mucho, hasta finalmente derrotar al líder de todos los demonios, Jiuying, y completar la eterna búsqueda del amor verdadero y la redención.","posterPath":"https://image.tmdb.org/t/p/w500/wyZiCmvP8s3KT6e70xTcmqOD1Qp.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/aiB8FUWA2suTybceLsOnfBWk8L6.jpg","voteAverage":8.5,"voteCount":16,"releaseDate":"2026-04-01","genres":["Drama","Sci-Fi & Fantasy"],"type":"series","platforms":["$c"],"tmdbId":278275,"runtime":"$undefined","seasons":"$undefined"},{"id":4344,"title":"Rescue Me: Equipo de rescate","originalTitle":"Rescue Me: Equipo de rescate","overview":"Se centra en el trabajo de la Brigada 62 de bomberos de la ciudad de Nueva York, después del 11S y más en particular en un bombero divorciado, Tommy Gavin (Denis Leary), que intenta lidiar con el miedo a su trabajo y la ansiedad que sufre viendo a su mujer saliendo con otros hombres.  Para poder estar más pendiente de su ex y cerca de sus tres hijos, Tommy se traslada a vivir enfrente de ellos.","posterPath":"https://image.tmdb.org/t/p/w500/gnOwOb82chSJkQEZ9pd6jf2ZrEX.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/bmPIJET1BbQqvUEYSfjdz0BxGRR.jpg","voteAverage":7.6,"voteCount":183,"releaseDate":"2004-07-21","genres":["Drama"],"type":"series","platforms":["$c"],"tmdbId":4344,"runtime":"$undefined","seasons":"$undefined"},{"id":203737,"title":"Oshi no Ko","originalTitle":"Oshi no Ko","overview":"Un médico de pueblo se ve arrastrado al implacable mundo del entretenimiento cuando se cruza con una estrella juvenil que esconde un secreto.","posterPath":"https://image.tmdb.org/t/p/w500/wXNebTabVlyeRh77uozHWBqbMao.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/gArCVC4ML529WMCEqOXbALdQbUq.jpg","voteAverage":8.3,"voteCount":323,"releaseDate":"2023-04-12","genres":["Animación","Drama"],"type":"series","platforms":["$c"],"tmdbId":203737,"runtime":"$undefined","seasons":"$undefined"},{"id":154524,"title":"Urusei Yatsura","originalTitle":"Urusei Yatsura","overview":"No hay mucho que destacar del lascivo Ataru Moroboshi, pero su extraordinaria mala suerte sobresale como los cuernos de la cabeza de un alienígena. Cuando la Tierra se ve amenazada por una flota de invasores alienígenas conocidos como los Oni, Ataru es seleccionado para representar a la humanidad en un duelo contra uno de ellos. Para Ataru es un golpe de suerte que el duelo sea en realidad jugar al pilla-pilla y que su oponente sea Lum, hija del líder de los Oni, que antepone su dignidad personal a la victoria, como descubre Ataru al apoderarse de la parte superior del bikini de Lum y, con ella, de la victoria.","posterPath":"https://image.tmdb.org/t/p/w500/8umfDfSpBs277MsXuezi2zEy6Mc.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/9C8klg2GszX2tXKw5xEzJwrL4Do.jpg","voteAverage":6.9,"voteCount":46,"releaseDate":"2022-10-14","genres":["Animación","Comedia","Action & Adventure","Sci-Fi & Fantasy"],"type":"series","platforms":["$c"],"tmdbId":154524,"runtime":"$undefined","seasons":"$undefined"},{"id":90937,"title":"Beastars","originalTitle":"Beastars","overview":"En un mundo donde conviven bestias de todo tipo, los instintos carnívoros de un amable lobo despiertan mientras su instituto debe lidiar con un asesinato.","posterPath":"https://image.tmdb.org/t/p/w500/jjsLEOThEri8jES4eQq9Nwvrvsr.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/oU6akWOEEvdoaaK9Sdpzowmi2gR.jpg","voteAverage":8.4,"voteCount":1285,"releaseDate":"2019-10-10","genres":["Animación","Drama","Misterio","Crimen"],"type":"series","platforms":["$c"],"tmdbId":90937,"runtime":"$undefined","seasons":"$undefined"},{"id":67026,"title":"Sucesor designado","originalTitle":"Sucesor designado","overview":"El destino de Estados Unidos depende de un funcionario de rango medio cuando el gobierno queda diezmado tras sufrir un ataque.","posterPath":"https://image.tmdb.org/t/p/w500/plmuDppjb6xZ7hwKWWDeOQxmvew.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/AhufsCP0kYIkpr0Iy2GrLSM1noL.jpg","voteAverage":7.1,"voteCount":1117,"releaseDate":"2016-09-21","genres":["Drama","War & Politics"],"type":"series","platforms":["$c"],"tmdbId":67026,"runtime":"$undefined","seasons":"$undefined"},{"id":61223,"title":"Akame ga Kill!","originalTitle":"Akame ga Kill!","overview":"El joven Tatsumi viaja a la capital del Imperio con el propósito de ganar dinero para su pueblo hambriento y se encuentra con un mundo de depravación inimaginable, dominado por el despiadado Primer Ministro que controla al niño Emperador. Tatsumi es reclutado por Night Raid, un grupo de asesinos dedicado a eliminar la corrupción matando sin piedad a funcionarios y nobles privilegiados.","posterPath":"https://image.tmdb.org/t/p/w500/pPpUEVN9229LGwvYwcHNCmX7hxJ.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/3XAGgklKkJhv5M9m5NkfhBYb7l8.jpg","voteAverage":8.3,"voteCount":1201,"releaseDate":"2014-07-07","genres":["Animación","Drama","Action & Adventure"],"type":"series","platforms":["$c"],"tmdbId":61223,"runtime":"$undefined","seasons":"$undefined"},{"id":38251,"title":"Toriko","originalTitle":"Toriko","overview":"En un mundo donde el sabor y la comida son lo mas importante esta Toriko, un cazador de la comida mas preciada que es regularmente contratado por restaurantes y ricos. Toriko es un hombre con talento inhumano para cazar los más feroces y raros animales para completar su \"menú completo de comida\". Luego esta su tímido compañero quien es inspirado por la grandeza de Toriko y quien lo acompaña a lo largo de su aventura en la búsqueda del sabor definitivo.","posterPath":"https://image.tmdb.org/t/p/w500/B4LfAocYy0EEpPNYpJpkj3o23p.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/j6u5ekbEjavBLUYBPfoXZh4G4Jg.jpg","voteAverage":7.5,"voteCount":33,"releaseDate":"2011-04-03","genres":["Animación","Sci-Fi & Fantasy","Action & Adventure"],"type":"series","platforms":["$c"],"tmdbId":38251,"runtime":"$undefined","seasons":"$undefined"},{"id":262928,"title":"Amor en las Nubes","originalTitle":"Amor en las Nubes","overview":"En los Seis Reinos de Hexu, durante la anual \"Conferencia Nubes\", Ji Bozai (interpretado por Hou Minghao) —un combatiente de Jixingyuan con antecedentes de reo— logra derrotar de un solo golpe a Ming Yi (Lu Yuxiao), la diosa guerrera invicta durante siete años. De la noche a la mañana, Ji Bozai se convierte en la estrella más aclamada de Jixingyuan. Mientras tanto, Ming Yi oculta su verdadera identidad y se disfraza de bailarina para acercarse a Ji Bozai. Con ambos envueltos en secretos, su feroz enfrentamiento se enciende con pasión y amor, defendiendo la justicia hasta culminar en una conmovedora historia romántica.","posterPath":"https://image.tmdb.org/t/p/w500/pBq1okuu66VXtRfZm6SusJSwsoH.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/lAJCsUD3f6KhwdtbnevSAI1E9EU.jpg","voteAverage":8.8,"voteCount":38,"releaseDate":"2025-10-08","genres":["Drama","Sci-Fi & Fantasy"],"type":"series","platforms":["$c"],"tmdbId":262928,"runtime":"$undefined","seasons":"$undefined"},{"id":242874,"title":"Valle salvaje","originalTitle":"Valle salvaje","overview":"1763. La vida de Adriana, una mujer valiente y leal a su familia, sufre un inesperado revés cuando recibe un duro golpe: su padre ha fallecido y, consecuencia de un pacto firmado en secreto, deberá viajar desde la Villa de Madrid hasta Valle Salvaje, en el norte de España, para desposar con un desconocido. Un oscuro secreto del pasado la persigue hasta el remoto valle, hogar de la familia de su prometido y de su complicada tía, doña Victoria. Allí su vida cambiará para siempre. Conocerá el verdadero amor, la traición, y el peligro cuando trate de descubrir la verdad sobre la muerte de su padre.","posterPath":"https://image.tmdb.org/t/p/w500/qB356qujmLpMZrY4TobXE9Wtalm.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/oncTvFY9goRyWAQRdDh2FKQ5Zhs.jpg","voteAverage":7.6,"voteCount":76,"releaseDate":"2024-09-18","genres":["Drama","Soap"],"type":"series","platforms":["$c"],"tmdbId":242874,"runtime":"$undefined","seasons":"$undefined"},{"id":97645,"title":"Solar Opposites","originalTitle":"Solar Opposites","overview":"Una familia de alienígenas aterriza en la Tierra y debe refugiarse en el centro de Estados Unidos.","posterPath":"https://image.tmdb.org/t/p/w500/nuBD4dlO7gfg4RhW0sS0pTeiYRc.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/1cVt0Tm7erwYT5lyae9vUkPr4XY.jpg","voteAverage":7.8,"voteCount":605,"releaseDate":"2020-05-08","genres":["Comedia","Animación","Sci-Fi & Fantasy"],"type":"series","platforms":["$c"],"tmdbId":97645,"runtime":"$undefined","seasons":"$undefined"},{"id":35935,"title":"Berserk: La Historia de la Espada Feroz","originalTitle":"Berserk: La Historia de la Espada Feroz","overview":"Durante más de 100 años, los magníficos ejércitos de Chuder y los de la región central han luchado en sangrientas batallas. Tan sólo la impenetrable fortaleza Doldery mantiene al Imperio de Chuder a salvo de todas las guerras que les rodean. La banda de los Halcones han tomado posiciones en la gran ofensiva. En esta batalla, las tropas de la región central podrán llegar hasta las puertas de la legendaria fortaleza de Chuder y desafiar al ejército invencible del General Boscongn.","posterPath":"https://image.tmdb.org/t/p/w500/9uoJ0PmfV72h3gc1xDJ7ghvuIIz.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/99Y64VK0KwyRWfaW6VdpDfPKNMo.jpg","voteAverage":8.5,"voteCount":778,"releaseDate":"1997-10-08","genres":["Action & Adventure","Sci-Fi & Fantasy","Animación"],"type":"series","platforms":["$c"],"tmdbId":35935,"runtime":"$undefined","seasons":"$undefined"},{"id":890,"title":"Neon Genesis Evangelion","originalTitle":"Neon Genesis Evangelion","overview":"En 2015, tras el catastrófico \"Segundo Impacto\" que devastó la Tierra, los \"Ángeles\" regresan para atacar. La organización NERV crea los Evas, robots bio-mecánicos pilotados por jóvenes como Shinji, Rei y Asuka, los únicos capaces de enfrentarlos. Mientras luchan, descubren oscuros secretos sobre la humanidad y su destino.","posterPath":"https://image.tmdb.org/t/p/w500/8t5BmqgaYQQckYXF4Q9M1cVnqXt.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/z2RumCOIZ6HO3oMvfINzZlFnPAw.jpg","voteAverage":8.6,"voteCount":2067,"releaseDate":"1995-10-04","genres":["Sci-Fi & Fantasy","Animación","Drama"],"type":"series","platforms":["$c"],"tmdbId":890,"runtime":"$undefined","seasons":"$undefined"},{"id":80240,"title":"La Reina del Flow","originalTitle":"La Reina del Flow","overview":"La serie se desarrolla en el seductor ambiente del reggaeton, género que se ha tomado al mundo. Esta es la historia de Yeimy Montoya, una talentosa joven compositora que paga una injusta condena en una prisión de Nueva York tras ser engañada por Charly, el hombre que ama y que posteriormente le roba sus canciones, con las que logra alcanzar la fama y convertirse en una estrella. El único deseo de Yeimy es salir a cobrar venganza contra todos aquellos que acabaron con su vida y su familia.","posterPath":"https://image.tmdb.org/t/p/w500/fuVuDYrs8sxvEolnYr0wCSvtyTi.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/cWJJk2C3QMZg2FgG3tVu6T1IiY0.jpg","voteAverage":8,"voteCount":1561,"releaseDate":"2018-06-12","genres":["Drama","Crimen"],"type":"series","platforms":["$c"],"tmdbId":80240,"runtime":"$undefined","seasons":"$undefined"},{"id":226688,"title":"Beyblade X","originalTitle":"Beyblade X","overview":"Sin descripción disponible.","posterPath":"https://image.tmdb.org/t/p/w500/66wkm14IWdrY5LaKZDAbkD2T9Jt.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/6OAvlyDxLhfxxPB9Mn9w43EaR3N.jpg","voteAverage":6.8,"voteCount":10,"releaseDate":"2023-10-06","genres":["Animación","Action & Adventure","Comedia","Sci-Fi & Fantasy","Kids"],"type":"series","platforms":["$c"],"tmdbId":226688,"runtime":"$undefined","seasons":"$undefined"},{"id":72750,"title":"Killing Eve","originalTitle":"Killing Eve","overview":"Basada en las novelas de Luke Jennings, Killing Eve se centra en dos mujeres muy diferentes. Eve es una ingeniosa agente del MI5 cuyo aburrido trabajo se aleja de su sueño de ser espía. Villanelle es una asesina experta que disfruta de los lujos que su violento trabajo le brinda. Estas dos inteligentes e intensas mujeres se enfrentarán en un épico juego del gato y el ratón.","posterPath":"https://image.tmdb.org/t/p/w500/6GuSeCFANzety0QPLigfCDOfYAv.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/2eR0H27Us1tvbjd95oW7WhiKioC.jpg","voteAverage":7.9,"voteCount":1480,"releaseDate":"2018-04-08","genres":["Crimen","Drama"],"type":"series","platforms":["$c"],"tmdbId":72750,"runtime":"$undefined","seasons":"$undefined"},{"id":126280,"title":"Sexo-Vida","originalTitle":"Sexo-Vida","overview":"El atrevido pasado sexual de una mujer choca con su presente de casada con hijos cuando el exchico malo con el que no puede dejar de fantasear vuelve a entrar en su vida.","posterPath":"https://image.tmdb.org/t/p/w500/7xKl8dPErKtu3wY41dWPnF2IhmC.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/9nBVkNBe4x9HKDAzxjxlIqecxCW.jpg","voteAverage":7.1,"voteCount":1381,"releaseDate":"2021-06-25","genres":["Drama"],"type":"series","platforms":["$c"],"tmdbId":126280,"runtime":"$undefined","seasons":"$undefined"},{"id":74204,"title":"Big Mouth","originalTitle":"Big Mouth","overview":"En esta comedia políticamente incorrecta de Nick Kroll y Andrew Goldberg, unos adolescentes descubren las maravillas y los horrores de la pubertad.","posterPath":"https://image.tmdb.org/t/p/w500/91GvggfQWxRygmXytWlvZWEej7c.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/uM6WJodeCyTp7h7NhE4rgd0RbRZ.jpg","voteAverage":7.6,"voteCount":1208,"releaseDate":"2017-09-29","genres":["Comedia","Animación"],"type":"series","platforms":["$c"],"tmdbId":74204,"runtime":"$undefined","seasons":"$undefined"},{"id":207250,"title":"Peligros en mi corazón","originalTitle":"Peligros en mi corazón","overview":"Kyotaro Ichikawa es un estudiante de secundaria que pasa todo su tiempo observando a su compañera de clase, Anna Yamada, y especialmente imaginando cómo podría asesinarla. Pero cuando la mira, se da cuenta de que Yamada puede ser diferente de la imagen que tenía de ella.","posterPath":"https://image.tmdb.org/t/p/w500/gSC8pcRXdLJWLR8d0UtIZm1SMiH.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/31VJnwcy3VOhoqETJEFIO58ZVfF.jpg","voteAverage":8.5,"voteCount":230,"releaseDate":"2023-04-02","genres":["Animación","Comedia","Drama"],"type":"series","platforms":["$c"],"tmdbId":207250,"runtime":"$undefined","seasons":"$undefined"},{"id":75006,"title":"The Umbrella Academy","originalTitle":"The Umbrella Academy","overview":"Un grupo disuelto de superhéroes se reúne después de que su padre adoptivo, quien los entrenó para salvar el mundo, muere.","posterPath":"https://image.tmdb.org/t/p/w500/5rhtcR1xl1tSmH3FcMH3IJ8gNGC.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/gHJhN9AJV4PmJ7YpLFa9ldDWuG8.jpg","voteAverage":8.5,"voteCount":9957,"releaseDate":"2019-02-15","genres":["Action & Adventure","Sci-Fi & Fantasy","Drama"],"type":"series","platforms":["$c"],"tmdbId":75006,"runtime":"$undefined","seasons":"$undefined"},{"id":31251,"title":"Victorious","originalTitle":"Victorious","overview":"El caos empieza a reinar en la vida de Tori Vega, cuando con 16 años es admitida en un nuevo instituto. Pero no en uno cualquiera, sino Hollywood Arts, una escuela de artes escénicas donde locos con talento estudian para convertirse en verdaderos artistas. Hasta ahora, Tori no creía tener mucho talento, y se contentaba con vivir a la sombra de su hermana mayor, Trina. Ahora, todo está a punto de cambiar... Sin embargo, Hollywood Arts sigue siendo un instituto, y Tori sigue siendo la chica nueva: tendrá que encontrar nuevos amigos, hacer los deberes, y simplemente tratar de encajar. ¿Conseguirá Tori cazar un papel protagonista en su nueva vida?","posterPath":"https://image.tmdb.org/t/p/w500/5YJT7qzswtdYhOGfLulXtBhUcl1.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/jpR7mT5nFAzWSGPseLpfFisoUtN.jpg","voteAverage":8.2,"voteCount":1713,"releaseDate":"2010-03-27","genres":["Comedia","Kids"],"type":"series","platforms":["$c"],"tmdbId":31251,"runtime":"$undefined","seasons":"$undefined"},{"id":108545,"title":"El problema de los 3 cuerpos","originalTitle":"El problema de los 3 cuerpos","overview":"Una decisión tomada en China en los años 60 trasciende el tiempo y el espacio, obligando a unos científicos a afrontar la peor amenaza para la humanidad en el presente.","posterPath":"https://image.tmdb.org/t/p/w500/6Dc9mMl083cVpNknWzALCw7JYPH.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/ciizJ9Okzt9tBBGK7Q3T14LFT2j.jpg","voteAverage":7.5,"voteCount":1487,"releaseDate":"2024-03-21","genres":["Sci-Fi & Fantasy","Misterio","Drama"],"type":"series","platforms":["$c"],"tmdbId":108545,"runtime":"$undefined","seasons":"$undefined"},{"id":116135,"title":"Vikingos: Valhalla","originalTitle":"Vikingos: Valhalla","overview":"Secuela de 'Vikingos' ambientada 100 años después y centrada en las aventuras de Leif Erikson, Freydis, Harald Hardrada y el rey normando Guillermo el Conquistador.","posterPath":"https://image.tmdb.org/t/p/w500/hZfPArlmeLS18oecv5yErmmf9lo.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/k47JEUTQsSMN532HRg6RCzZKBdB.jpg","voteAverage":7.6,"voteCount":1031,"releaseDate":"2022-02-25","genres":["Action & Adventure","Drama","War & Politics"],"type":"series","platforms":["$c"],"tmdbId":116135,"runtime":"$undefined","seasons":"$undefined"},{"id":67744,"title":"MINDHUNTER","originalTitle":"MINDHUNTER","overview":"Un agente del FBI, experto en asesinos en serie, inventa técnicas de creación de perfiles mientras persigue a violadores y asesinos famosos.","posterPath":"https://image.tmdb.org/t/p/w500/eg2eepJtJeRtCZEUJvIYyb2PnYD.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/lpDVJuIro21gtMj9iXMFKHuroZN.jpg","voteAverage":8.1,"voteCount":2937,"releaseDate":"2017-10-13","genres":["Drama","Crimen"],"type":"series","platforms":["$c"],"tmdbId":67744,"runtime":"$undefined","seasons":"$undefined"},{"id":154385,"title":"Bronca","originalTitle":"Bronca","overview":"Un incidente de tráfico entre dos desconocidos (un contratista fracasado y una empresaria descontenta) desata un conflicto que saca a relucir su lado más oscuro.","posterPath":"https://image.tmdb.org/t/p/w500/mymu4UmxV1ht8avuQYXjJpE1hL5.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/2VHbof9yaNhovEnaancBkXEULCT.jpg","voteAverage":7.7,"voteCount":929,"releaseDate":"2023-04-06","genres":["Comedia","Drama"],"type":"series","platforms":["$c"],"tmdbId":154385,"runtime":"$undefined","seasons":"$undefined"},{"id":58981,"title":"Los Thunderman","originalTitle":"Los Thunderman","overview":"Los Thunderman son una típica familia de los suburbios, que pasa a tener unos asombrosos superpoderes. Los gemelos Thunderman, de 14 años, comparten el mismo cuarto de baño y la misma escuela. La diferencia es que la hermana es una estudiante estupenda con un carácter alegre que espera ser algún día una superheroina, y su hermano gemelo es un supervillano.","posterPath":"https://image.tmdb.org/t/p/w500/Aei0mVdyiYPMrK1QWJFjcrCiHNZ.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/7Z4mwfQGoARtNxxQEPp5hKNclJi.jpg","voteAverage":8,"voteCount":599,"releaseDate":"2013-10-14","genres":["Action & Adventure","Comedia","Familia","Sci-Fi & Fantasy"],"type":"series","platforms":["$c"],"tmdbId":58981,"runtime":"$undefined","seasons":"$undefined"},{"id":271607,"title":"La nobleza de las flores","originalTitle":"La nobleza de las flores","overview":"Cuando el imponente Rintaro conoce a la abierta y curiosa Kaoruko, surge entre ellos una inesperada amistad. Pero hay un problema: sus institutos se odian a muerte.","posterPath":"https://image.tmdb.org/t/p/w500/e2zegxrA6tyT1nobxXoMTWlQjJf.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/dl3pdT1NZiqRM4aDBwsD2TtO8x9.jpg","voteAverage":8.6,"voteCount":198,"releaseDate":"2025-07-06","genres":["Animación","Drama"],"type":"series","platforms":["$c"],"tmdbId":271607,"runtime":"$undefined","seasons":"$undefined"},{"id":204832,"title":"MASHLE: MAGIC AND MUSCLES","originalTitle":"MASHLE: MAGIC AND MUSCLES","overview":"Este es un mundo de magia.\n\nEste es un mundo en el que todos usan la magia habitualmente.\n\nEn un bosque profundo y oscuro de este mundo de magia, hay un chico que se ejercita a diario.\n\nSu nombre es Mash Burnedead y tiene un secreto: no puede usar magia.\n\nLo único que quería era vivir tranquilo con su familia, pero cuando un día intentan matarlo por no poder usar magia, las cosas se salen de control y acaba inscrito en una escuela mágica, donde su objetivo será convertirse en el \"Iluminado Divino\", el alumno más formidable, el elegido de Dios.\n\n¿Podrán sus poderosos músculos derrotar a los más brillantes usuarios de magia?\n\n¡Se alza el telón de esta historia de magia y fantasía peculiar en el que la fuerza puede con la magia!","posterPath":"https://image.tmdb.org/t/p/w500/9rvbqwoEis7SZjbfiIYjzE2uWz3.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/p1swd15DRtCnNj20U904dbXeVsi.jpg","voteAverage":8.3,"voteCount":633,"releaseDate":"2023-04-08","genres":["Animación","Comedia","Action & Adventure","Sci-Fi & Fantasy"],"type":"series","platforms":["$c"],"tmdbId":204832,"runtime":"$undefined","seasons":"$undefined"},{"id":72755,"title":"Absentia","originalTitle":"Absentia","overview":"Mientras persigue a un asesino en serie, una agente del FBI desaparece y es dada por muerta, dejando solos a su marido, también agente, y a su hijo de 3 años. Pero 6 años después reaparece para sorpresa de todos. Sin recordar nada de lo sucedido desde su secuestro, tiene que adaptarse a una nueva realidad en la que su marido ha rehecho su vida con otra mujer y su hijo no la conoce. Además, una nueva serie de asesinatos hacen pensar a algunos de sus compañeros que ella podría ser la autora.","posterPath":"https://image.tmdb.org/t/p/w500/4jMwp7l9gtXvCHKmmtyGz2nuWva.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/uXY6k8Gd45cTGzlz5s0A2ejDBXa.jpg","voteAverage":7.3,"voteCount":380,"releaseDate":"2017-09-25","genres":["Crimen","Drama","Misterio"],"type":"series","platforms":["$c"],"tmdbId":72755,"runtime":"$undefined","seasons":"$undefined"},{"id":115,"title":"A Different World","originalTitle":"A Different World","overview":"Sin descripción disponible.","posterPath":"https://image.tmdb.org/t/p/w500/v7fuifcJjcqQxAsOjPviupcmFIZ.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/ebTL1Lyvr0LVBrMlhgQp6lqijC6.jpg","voteAverage":7,"voteCount":73,"releaseDate":"1987-09-24","genres":["Comedia","Familia"],"type":"series","platforms":["$c"],"tmdbId":115,"runtime":"$undefined","seasons":"$undefined"},{"id":65820,"title":"Van Helsing","originalTitle":"Van Helsing","overview":"Tras pasar tres años en coma, Vanessa se despierta en un mundo asolado por vampiros. Ella y un variopinto grupo de amigos supervivientes luchan por seguir con vida.","posterPath":"https://image.tmdb.org/t/p/w500/r8ODGmfNbZQlNhiJl2xQENE2jsk.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/5VltHQJXdmbSD6gEJw3R8R1Kbmc.jpg","voteAverage":7,"voteCount":921,"releaseDate":"2016-09-23","genres":["Misterio","Sci-Fi & Fantasy","Action & Adventure"],"type":"series","platforms":["$c"],"tmdbId":65820,"runtime":"$undefined","seasons":"$undefined"},{"id":261145,"title":"El Asombroso Circo Digital","originalTitle":"El Asombroso Circo Digital","overview":"Una mujer de 25 años queda atrapada en un loco mundo virtual junto a otros cinco humanos y ahora están sujetos a los caprichos de una alocada IA y a sus propios traumas personales.","posterPath":"https://image.tmdb.org/t/p/w500/uJ1nT3Ez5te1zStsj7DFYFLx8gY.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/vPVdWiLUNQyaGMazyZGVAyRcYBG.jpg","voteAverage":8.4,"voteCount":182,"releaseDate":"2023-10-13","genres":["Animación","Comedia","Drama","Sci-Fi & Fantasy"],"type":"series","platforms":["$c"],"tmdbId":261145,"runtime":"$undefined","seasons":"$undefined"},{"id":94404,"title":"Dorohedoro","originalTitle":"Dorohedoro","overview":"Caimán quiere matar al hechicero responsable de la maldición por la que tiene una cabeza de reptil. Aunque cuente con la ayuda de una amiga, no resultará fácil.","posterPath":"https://image.tmdb.org/t/p/w500/mmpGV6laOLyNeo21aOFM9oB9HYw.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/sASxGVO6wioRG6jNM2LHOjBAgWu.jpg","voteAverage":8.3,"voteCount":412,"releaseDate":"2020-01-13","genres":["Animación","Action & Adventure","Comedia","Sci-Fi & Fantasy"],"type":"series","platforms":["$c"],"tmdbId":94404,"runtime":"$undefined","seasons":"$undefined"},{"id":82596,"title":"Emily en París","originalTitle":"Emily en París","overview":"Nuevas pasiones. Nuevas modas. ¿Nueva Emily? Una intrépida estadounidense experta en marketing alza el vuelo en la vida y el amor tras conseguir el trabajo de sus sueños en París.","posterPath":"https://image.tmdb.org/t/p/w500/oNyz3A1cPzNbYYyCUlcXU96ZsDh.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/jXTZaHarR9TZiMoQwiQWsGYXqnS.jpg","voteAverage":7.6,"voteCount":1550,"releaseDate":"2020-10-02","genres":["Drama","Comedia"],"type":"series","platforms":["$c"],"tmdbId":82596,"runtime":"$undefined","seasons":"$undefined"},{"id":117581,"title":"Ginny y Georgia","originalTitle":"Ginny y Georgia","overview":"La independiente Georgia y sus dos hijos, Ginny y Austin, se mudan al norte en busca de una nueva vida... pero descubren que empezar de cero puede ser complicado.","posterPath":"https://image.tmdb.org/t/p/w500/vOwunzW4dx3n0J5mH40n9jTRSwY.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/lPmUu3xkoksz3xsa1feIUoOBZrg.jpg","voteAverage":8,"voteCount":1782,"releaseDate":"2021-02-24","genres":["Comedia","Drama"],"type":"series","platforms":["$c"],"tmdbId":117581,"runtime":"$undefined","seasons":"$undefined"},{"id":241454,"title":"Amor en la puerta de al lado","originalTitle":"Amor en la puerta de al lado","overview":"Bae Seok Ryu siempre ha sido una persona destacada y llena de energía. Después de graduarse de la universidad, fue contratada por un gran conglomerado global como directora de proyectos. Sin embargo, un incidente en su trabajo la lleva a renunciar y quedarse desempleada, enfrentándose a una crisis personal.  En medio de esta crisis, Bae Seok Ryu se reencuentra con Choi Seung Hyo, el hijo de la amiga de su madre. Él es el joven arquitecto más destacado del país y dirige el taller de arquitectura \"In\". No solo es casi perfecto como arquitecto, sino que también es muy atractivo y tiene una gran personalidad. Desde que sus madres se hicieron amigas cuando tenían cuatro años, ambos han compartido muchas experiencias, incluyendo momentos embarazosos que Seung Hyo quiere borrar de su vida. Ahora, ya adultos, sus caminos se cruzan de nuevo cuando Seok Ryu, tratando de reiniciar su vida defectuosa, reaparece en la pacífica vida de Seung Hyo.","posterPath":"https://image.tmdb.org/t/p/w500/b84utD8XBPsOodnNruqawiv7KmB.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/blNanzce8lKnrfjDqWLdPNPy7mo.jpg","voteAverage":8,"voteCount":242,"releaseDate":"2024-08-17","genres":["Drama","Comedia"],"type":"series","platforms":["$c"],"tmdbId":241454,"runtime":"$undefined","seasons":"$undefined"},{"id":210879,"title":"Rurouni Kenshin","originalTitle":"Rurouni Kenshin","overview":"Readaptación de la serie manga principal.\n\nHace ciento cuarenta años en Kioto, con la llegada de los \"Barcos Negros\" estadounidenses, surgió un guerrero que, derribando hombres con su espada ensangrentada, se ganó el nombre de Hitokiri, ¡asesino! Su espada asesina ayudó a cerrar la turbulenta era de Bakumatsu y abrió la era progresiva conocida como Meiji. Luego desapareció y, con el correr de los años, se convirtió en leyenda.","posterPath":"https://image.tmdb.org/t/p/w500/mCafSOuO3PqgoxaweNCo45KpctE.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/xV0Xro8G20SgxYfGrXun26k7eVp.jpg","voteAverage":8.3,"voteCount":138,"releaseDate":"2023-07-07","genres":["Animación","Action & Adventure"],"type":"series","platforms":["$c"],"tmdbId":210879,"runtime":"$undefined","seasons":"$undefined"},{"id":262280,"title":"Leyendas","originalTitle":"Leyendas","overview":"Mientras las drogas arrasan Gran Bretaña en los años 90, un equipo de funcionarios infiltrados trata de destruir a los cárteles responsables.","posterPath":"https://image.tmdb.org/t/p/w500/1Em0VjO0IFSneoF9a8u7ibDGPK8.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/4CtOMphAmfHJ6cztlAYjkdStkHP.jpg","voteAverage":7.8,"voteCount":40,"releaseDate":"2026-05-07","genres":["Action & Adventure","Crimen","Drama"],"type":"series","platforms":["$c"],"tmdbId":262280,"runtime":"$undefined","seasons":"$undefined"},{"id":303143,"title":"Mi némesis con aires de realeza","originalTitle":"Mi némesis con aires de realeza","overview":"Una pérfida coreana de la era Joseon es condenada a muerte… y abre los ojos en la actual Seúl, donde el vil heredero de un ‘chaebol’ parece la única opción para cambiar su destino.","posterPath":"https://image.tmdb.org/t/p/w500/gRkBqyHrIqcjsIoTdbRmWgxMKpV.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/p1ntnKJwn1URGv1xpU6NN33Y11O.jpg","voteAverage":8.7,"voteCount":7,"releaseDate":"2026-05-08","genres":["Drama","Comedia","Sci-Fi & Fantasy"],"type":"series","platforms":["$c"],"tmdbId":303143,"runtime":"$undefined","seasons":"$undefined"}]}]
