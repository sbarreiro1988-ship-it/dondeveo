2:["$","$Lb",null,{"platform":{"id":"googleplay","name":"Google Play","shortName":"GPLAY","color":"#4285F4","bgColor":"#4285F4","textColor":"#ffffff","url":"https://play.google.com/store/movies","type":"rent"},"movies":[{"id":350,"title":"El diablo viste de Prada","originalTitle":"El diablo viste de Prada","overview":"En el vertiginoso mundo de la moda en Nueva York, la revista 'Runway' es el Santo Grial. Dirigida con puño de hierro y elegante manicura por Miranda Priestly, trabajar en ella es un temible reto para todo aquel que quiera triunfar en ese mundo. Hacerlo como ayudante de Miranda podría abrirle cualquier puerta a Andy Sachs, recientemente graduada. Pero ella es una chica que destaca por su desaliño dentro del pequeño ejército de guapísimas redactoras de la revista. Andy comprende muy pronto que para triunfar en ese negocio va a necesitar algo más que iniciativa y determinación. Y la prueba definitiva está delante de ella, vestida de Prada de pies a cabeza.  Es una mierda de película!!","posterPath":"https://image.tmdb.org/t/p/w500/y0FiGt44M7rveQYnYkIO3UttbTP.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/gkh6Nt8DtY1XT4gQsyFq9XAVJlJ.jpg","voteAverage":7.4,"voteCount":13457,"releaseDate":"2006-06-29","genres":["Drama","Comedia"],"type":"movie","platforms":[],"tmdbId":350,"runtime":"$undefined","seasons":"$undefined"},{"id":460465,"title":"Mortal Kombat","originalTitle":"Mortal Kombat","overview":"Un boxeador fracasado descubre un secreto familiar que lo lleva a un torneo místico llamado Mortal Kombat donde se encuentra con un grupo de guerreros que luchan hasta la muerte para salvar los reinos del malvado hechicero Shang Tsung.","posterPath":"https://image.tmdb.org/t/p/w500/2acqTZDykiX8U4oDVBIsNcm5O2o.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/6ELCZlTA5lGUops70hKdB83WJxH.jpg","voteAverage":7,"voteCount":6540,"releaseDate":"2021-04-07","genres":["Acción","Fantasía","Aventura"],"type":"movie","platforms":[],"tmdbId":460465,"runtime":"$undefined","seasons":"$undefined"},{"id":976912,"title":"Graphic Desires","originalTitle":"Graphic Desires","overview":"Cuando el recluso Franklin engaña a su chica con una misteriosa mujer que conoce en una aplicación de citas, se convierte en el inicio de una obsesión mortal.","posterPath":"https://image.tmdb.org/t/p/w500/fLHXk8eN7Rh2snjjB5KhEE9tqgo.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/rHnANzYUmV3WZw3n0yWOLiR3pen.jpg","voteAverage":7,"voteCount":64,"releaseDate":"2023-08-31","genres":["Suspense","Crimen"],"type":"movie","platforms":[],"tmdbId":976912,"runtime":"$undefined","seasons":"$undefined"},{"id":157336,"title":"Interstellar","originalTitle":"Interstellar","overview":"Un grupo de exploradores hacen uso de un agujero de gusano recientemente descubierto para superar las limitaciones de los viajes espaciales tripulados y vencer las inmensas distancias que tiene un viaje interestelar.","posterPath":"https://image.tmdb.org/t/p/w500/9cTfZWP5TfdnmAjiD6ZBXWIJ7O9.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/2ssWTSVklAEc98frZUQhgtGHx7s.jpg","voteAverage":8.5,"voteCount":39720,"releaseDate":"2014-11-05","genres":["Aventura","Drama","Ciencia ficción"],"type":"movie","platforms":[],"tmdbId":157336,"runtime":"$undefined","seasons":"$undefined"},{"id":78192,"title":"Michael Jackson. La vida de un ídolo","originalTitle":"Michael Jackson. La vida de un ídolo","overview":"\"Michael Jackson: La vida de un Ídolo\" muestra la vida del cantante detrás de las cámaras, desde su infancia con los Jackson 5, pasando por su consagración como solista a nivel mundial y recordando los momentos previos a su repentina muerte en 2009. Dirigido por Andrew Eastel y producido por un amigo íntimo de la infancia de Michael Jackson, David Gest, “Michael Jackson: la vida de un ídolo” supone para Katherine Jackson la primera oportunidad de ofrecer su versión de la historia sobre su hijo: su infancia en Gary, su ciudad natal; su apoyo durante los juicios a los que se enfrentó Michael; y cómo salieron adelante tras estos capítulos.","posterPath":"https://image.tmdb.org/t/p/w500/z2MFDKcgTI7vqYNIT3lEbNsdLAM.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/wz1eLrNxK77xAY7JYi4iYrtiMEd.jpg","voteAverage":8.1,"voteCount":167,"releaseDate":"2011-11-02","genres":["Documental","Música"],"type":"movie","platforms":[],"tmdbId":78192,"runtime":"$undefined","seasons":"$undefined"},{"id":24428,"title":"Los Vengadores","originalTitle":"Los Vengadores","overview":"Cuando un enemigo inesperado surge como una gran amenaza para la seguridad mundial, Nick Fury, director de la Agencia SHIELD, decide reclutar a un equipo para salvar al mundo de un desastre casi seguro.","posterPath":"https://image.tmdb.org/t/p/w500/ugX4WZJO3jEvTOerctAWJLinujo.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/9BBTo63ANSmhC4e6r62OJFuK2GL.jpg","voteAverage":8,"voteCount":37870,"releaseDate":"2012-04-25","genres":["Ciencia ficción","Acción","Aventura"],"type":"movie","platforms":[],"tmdbId":24428,"runtime":"$undefined","seasons":"$undefined"},{"id":278,"title":"Cadena perpetua","originalTitle":"Cadena perpetua","overview":"Acusado del asesinato de su mujer, Andrew Dufresne, tras ser condenado a cadena perpetua, es enviado a la prisión de Shawshank. Con el paso de los años conseguirá ganarse la confianza del director del centro y el respeto de sus compañeros presidiarios, especialmente de Red, el jefe de la mafia de los sobornos.","posterPath":"https://image.tmdb.org/t/p/w500/uRRTV7p6l2ivtODWJVVAMRrwTn2.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/zfbjgQE1uSd9wiPTX4VzsLi0rGG.jpg","voteAverage":8.7,"voteCount":30352,"releaseDate":"1994-09-23","genres":["Drama","Crimen"],"type":"movie","platforms":[],"tmdbId":278,"runtime":"$undefined","seasons":"$undefined"},{"id":440249,"title":"Cuando se acaba el porno 2","originalTitle":"Cuando se acaba el porno 2","overview":"En esta secuela de After Porn Ends se entrevista a un nuevo grupo de ex-estrellas del porno para ser testigos de cómo son sus vidas después de abandonar la industria del cine para adultos. Entre las entrevistadas, leyendas del género como Ginger Lynn (Ten Little Maidens) o Georgina Spelvin (Devil in Miss Jones).","posterPath":"https://image.tmdb.org/t/p/w500/eLYKLIIJDBhbXEtmagkHCcDt8eD.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/3Sq9c1Lxh75neQ2BC9thaTO74FZ.jpg","voteAverage":5.4,"voteCount":251,"releaseDate":"2017-03-28","genres":["Documental"],"type":"movie","platforms":[],"tmdbId":440249,"runtime":"$undefined","seasons":"$undefined"},{"id":299536,"title":"Vengadores: Infinity War","originalTitle":"Vengadores: Infinity War","overview":"El todopoderoso Thanos ha despertado con la promesa de arrasar con todo a su paso, portando el Guantelete del Infinito, que le confiere un poder incalculable. Los únicos capaces de pararle los pies son los Vengadores y el resto de superhéroes de la galaxia, que deberán estar dispuestos a sacrificarlo todo por un bien mayor. Capitán América e Ironman deberán limar sus diferencias, Black Panther apoyará con sus tropas desde Wakanda, Thor y los Guardianes de la Galaxia e incluso Spider-Man se unirán antes de que los planes de devastación y ruina pongan fin al universo. ¿Serán capaces de frenar el avance del titán del caos?","posterPath":"https://image.tmdb.org/t/p/w500/ksBQ4oHQDdJwND8H90ay8CbMihU.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/mDfJG3LC3Dqb67AZ52x3Z0jU0uB.jpg","voteAverage":8.2,"voteCount":31932,"releaseDate":"2018-04-25","genres":["Aventura","Acción","Ciencia ficción"],"type":"movie","platforms":[],"tmdbId":299536,"runtime":"$undefined","seasons":"$undefined"},{"id":238,"title":"El padrino","originalTitle":"El padrino","overview":"Don Vito Corleone, conocido dentro de los círculos del hampa como 'El Padrino', es el patriarca de una de las cinco familias que ejercen el mando de la Cosa Nostra en Nueva York en los años cuarenta. Don Corleone tiene cuatro hijos: una chica, Connie, y tres varones; Sonny, Michael y Fredo. Cuando el Padrino reclina intervenir en el negocio de estupefacientes, empieza una cruenta lucha de violentos episodios entre las distintas familias del crimen organizado.","posterPath":"https://image.tmdb.org/t/p/w500/ApiEfzSkrqS4m1L5a2GwWXzIiAs.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/tSPT36ZKlP2WVHJLM4cQPLSzv3b.jpg","voteAverage":8.7,"voteCount":22905,"releaseDate":"1972-03-14","genres":["Drama","Crimen"],"type":"movie","platforms":[],"tmdbId":238,"runtime":"$undefined","seasons":"$undefined"},{"id":502356,"title":"Super Mario Bros: La película","originalTitle":"Super Mario Bros: La película","overview":"Mientras trabajan en una avería subterránea, los fontaneros de Brooklyn, Mario y su hermano Luigi, viajan por una misteriosa tubería hasta un nuevo mundo mágico. Pero, cuando los hermanos se separan, Mario deberá emprender una épica misión para encontrar a Luigi. Con la ayuda del champiñón local Toad y unas cuantas nociones de combate de la guerrera líder del Reino Champiñón, la princesa Peach, Mario descubre todo el poder que alberga en su interior.","posterPath":"https://image.tmdb.org/t/p/w500/5AIZhT8vwdut7ILImXk0bfRPbaX.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/9n2tJBplPbgR2ca05hS5CKXwP2c.jpg","voteAverage":7.6,"voteCount":10670,"releaseDate":"2023-04-05","genres":["Familia","Comedia","Aventura","Fantasía","Animación"],"type":"movie","platforms":[],"tmdbId":502356,"runtime":"$undefined","seasons":"$undefined"},{"id":603,"title":"Matrix","originalTitle":"Matrix","overview":"Thomas Anderson lleva una doble vida: por el día es programador en una importante empresa de software, y por la noche un hacker informático llamado Neo. Su vida no volverá a ser igual cuando unos misteriosos personajes le inviten a descubrir la respuesta a la pregunta que no le deja dormir: ¿qué es Matrix?","posterPath":"https://image.tmdb.org/t/p/w500/8rT9kG2EYkZpJmYCuTJNnPDEube.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/tlm8UkiQsitc8rSuIAscQDCnP8d.jpg","voteAverage":8.2,"voteCount":27842,"releaseDate":"1999-03-31","genres":["Acción","Ciencia ficción"],"type":"movie","platforms":[],"tmdbId":603,"runtime":"$undefined","seasons":"$undefined"},{"id":744275,"title":"After: Almas perdidas","originalTitle":"After: Almas perdidas","overview":"Cuando Tessa toma la decisión más importante de su vida, todo cambia. Los secretos que salen a la luz sobre su familia y la de Hardin ponen en peligro su relación y su futuro juntos. La vida de Tessa empieza a romperse en pedazos y ya nada será como antes. Aunque sabe que Hardin la quiere, estas dos almas perdidas están rodeadas de celos, odio... y perdón. Hasta ahora, el amor era suficiente para mantener su relación a flote, pero ¿de verdad sigue mereciendo la pena?","posterPath":"https://image.tmdb.org/t/p/w500/cAvUp7ngPyuhx1nLjmCOTCBNo91.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/mxdiaM2tsx8M6W3zLgiPwAkhQfq.jpg","voteAverage":7,"voteCount":2733,"releaseDate":"2021-09-01","genres":["Drama","Romance"],"type":"movie","platforms":[],"tmdbId":744275,"runtime":"$undefined","seasons":"$undefined"},{"id":27205,"title":"Origen","originalTitle":"Origen","overview":"Dom Cobb es un ladrón hábil, el mejor de todos, especializado en el peligroso arte de extracción: el robo de secretos valiosos desde las profundidades del subconsciente durante el estado de sueño cuando la mente está más vulnerable. Esta habilidad excepcional de Cobb le ha hecho un jugador codiciado en el traicionero nuevo mundo de espionaje corporativo, pero al mismo tiempo, le ha convertido en un fugitivo internacional y ha tenido que sacrificar todo que le importaba. Ahora a Cobb se le ofrece una oportunidad para redimirse. Con un último trabajo podría recuperar su vida anterior, pero solamente si logra lo imposible.","posterPath":"https://image.tmdb.org/t/p/w500/tXQvtRWfkUUnWJAn2tN3jERIUG.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/8ZTVqvKDQ8emSGUEMjsS4yHAwrp.jpg","voteAverage":8.4,"voteCount":39202,"releaseDate":"2010-07-15","genres":["Acción","Ciencia ficción","Aventura"],"type":"movie","platforms":[],"tmdbId":27205,"runtime":"$undefined","seasons":"$undefined"},{"id":361743,"title":"Top Gun: Maverick","originalTitle":"Top Gun: Maverick","overview":"Después de más de 30 años de servicio como uno de los mejores aviadores de la Armada, Pete \"Maverick\" Mitchell se encuentra dónde siempre quiso estar, empujando los límites como un valiente piloto de prueba y esquivando el alcance en su rango, que no le dejaría volar emplazándolo en tierra. Cuando se encuentra entrenando a un destacamento de graduados de Top Gun para una misión especializada, Maverick se encuentra allí con el teniente Bradley Bradshaw, el hijo de su difunto amigo \"Goose\".","posterPath":"https://image.tmdb.org/t/p/w500/AlWpEpQq0RgZIXVHAHZtFhEvRgd.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/AaV1YIdWKnjAIAOe8UUKBFm327v.jpg","voteAverage":8.2,"voteCount":10908,"releaseDate":"2022-05-21","genres":["Acción","Drama"],"type":"movie","platforms":[],"tmdbId":361743,"runtime":"$undefined","seasons":"$undefined"},{"id":155,"title":"El caballero oscuro","originalTitle":"El caballero oscuro","overview":"Batman/Bruce Wayne regresa para continuar su guerra contra el crimen. Con la ayuda del teniente Jim Gordon y del Fiscal del Distrito Harvey Dent, Batman se propone destruir el crimen organizado en la ciudad de Gotham. El triunvirato demuestra su eficacia, pero, de repente, aparece Joker, un nuevo criminal que desencadena el caos y tiene aterrados a los ciudadanos.","posterPath":"https://image.tmdb.org/t/p/w500/8QDQExnfNFOtabLDKqfDQuHDsIg.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/cfT29Im5VDvjE0RpyKOSdCKZal7.jpg","voteAverage":8.5,"voteCount":35725,"releaseDate":"2008-07-16","genres":["Acción","Crimen","Suspense"],"type":"movie","platforms":[],"tmdbId":155,"runtime":"$undefined","seasons":"$undefined"},{"id":122,"title":"El señor de los anillos: El retorno del rey","originalTitle":"El señor de los anillos: El retorno del rey","overview":"Las fuerzas de Saruman han sido destruidas, y su fortaleza sitiada. Ha llegado el momento de que se decida el destino de la Tierra Media, y por primera vez en mucho tiempo, parece que hay una pequeña esperanza. La atención del señor oscuro Sauron se centra ahora en Gondor, el último reducto de los hombres, y del cual Aragorn tendrá que reclamar el trono para ocupar su puesto de rey. Pero las fuerzas de Sauron ya se preparan para lanzar el último y definitivo ataque contra el reino de Gondor, la batalla que decidirá el destino de todos. Mientras tanto, Frodo y Sam continuan su camino hacia Mordor, a la espera de que Sauron no repare en que dos pequeños Hobbits se acercan cada día más al final de su camino, el Monte del Destino.","posterPath":"https://image.tmdb.org/t/p/w500/mWuFbQrXyLk2kMBKF9TUPtDwuPx.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/2u7zbn8EudG6kLlBzUYqP8RyFU4.jpg","voteAverage":8.5,"voteCount":26490,"releaseDate":"2003-12-17","genres":["Aventura","Fantasía","Acción"],"type":"movie","platforms":[],"tmdbId":122,"runtime":"$undefined","seasons":"$undefined"},{"id":496243,"title":"Parásitos","originalTitle":"Parásitos","overview":"Tanto Gi Taek (Song Kang-ho) como su familia están sin trabajo. Cuando su hijo mayor, Gi Woo (Choi Woo-sik), empieza a dar clases particulares en casa de Park (Lee Seon-gyun), las dos familias, que tienen mucho en común pese a pertenecer a dos mundos totalmente distintos, comienzan una interrelación de resultados imprevisibles.","posterPath":"https://image.tmdb.org/t/p/w500/4N55tgxDW0RRATyrZHbx0q9HUKv.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/TU9NIjwzjoKPwQHoHshkFcQUCG.jpg","voteAverage":8.5,"voteCount":20594,"releaseDate":"2019-05-30","genres":["Comedia","Suspense","Drama"],"type":"movie","platforms":[],"tmdbId":496243,"runtime":"$undefined","seasons":"$undefined"},{"id":299534,"title":"Vengadores: Endgame","originalTitle":"Vengadores: Endgame","overview":"Tras el chasquido de Thanos que eliminó a la mitad de la vida en el universo, los Vengadores supervivientes quedan devastados y divididos. Cinco años después, una inesperada oportunidad les permite intentar revertir la catástrofe. Reuniéndose una vez más, los héroes emprenden una misión extrema que los obliga a viajar al pasado, enfrentarse a sus propias pérdidas y hacer sacrificios definitivos para restaurar el equilibrio del universo.","posterPath":"https://image.tmdb.org/t/p/w500/br6krBFpaYmCSglLBWRuhui7tPc.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/7RyHsO4yDXtBv1zUU3mTpHeQ0d5.jpg","voteAverage":8.2,"voteCount":27695,"releaseDate":"2019-04-24","genres":["Aventura","Ciencia ficción","Acción"],"type":"movie","platforms":[],"tmdbId":299534,"runtime":"$undefined","seasons":"$undefined"},{"id":120,"title":"El señor de los anillos: La comunidad del anillo","originalTitle":"El señor de los anillos: La comunidad del anillo","overview":"En la Tierra Media, el Señor Oscuro Saurón creó los Grandes Anillos de Poder, forjados por los herreros Elfos. Tres para los reyes Elfos, siete para los Señores Enanos, y nueve para los Hombres Mortales. Secretamente, Saurón también forjó un anillo maestro, el Anillo Único, que contiene en sí el poder para esclavizar a toda la Tierra Media. Con la ayuda de un grupo de amigos y de valientes aliados, Frodo emprende un peligroso viaje con la misión de destruir el Anillo Único. Pero el Señor Oscuro Sauron, quien creara el Anillo, envía a sus servidores para perseguir al grupo. Si Sauron lograra recuperar el Anillo, sería el final de la Tierra Media.","posterPath":"https://image.tmdb.org/t/p/w500/9xtH1RmAzQ0rrMBNUMXstb2s3er.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/a0lfia8tk8ifkrve0Tn8wkISUvs.jpg","voteAverage":8.4,"voteCount":27497,"releaseDate":"2001-12-18","genres":["Aventura","Fantasía","Acción"],"type":"movie","platforms":[],"tmdbId":120,"runtime":"$undefined","seasons":"$undefined"},{"id":514847,"title":"La caza","originalTitle":"La caza","overview":"Doce extraños se despiertan en el claro de un bosque con muchas preguntas sin respuesta. ¿Dónde están? ¿Cómo llegaron allí? ¿Y por qué o con qué propósito están ahí? La respuesta a todas esas preguntas es: La caza, un juego macabro ideado por miembros de las élites globales, que se reúnen en un punto remoto o una casa para cazar humanos por diversión. Ellos son las presas; el resto, los cazadores. Pero todo está a punto de cambiar cuando Crystal, una de las jóvenes que se encuentra entre los \"cazados\", le da la vuelta al juego y empieza a inclinar la balanza a su favor. Uno a uno, comienza a deshacerse de los miembros de la élite que pretende darles caza, con la intención de llegar hasta la misteriosa mujer (Hilary Swank) que mueve los hilos de todo aquello.","posterPath":"https://image.tmdb.org/t/p/w500/5WCuPRfa0h8jMT4Iu2jIIQXqllM.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/evo3crueRIK9Eutb3lnDLVbD2xD.jpg","voteAverage":6.6,"voteCount":3630,"releaseDate":"2020-03-11","genres":["Acción","Suspense","Terror"],"type":"movie","platforms":[],"tmdbId":514847,"runtime":"$undefined","seasons":"$undefined"},{"id":9823,"title":"Mortal Kombat: Aniquilación","originalTitle":"Mortal Kombat: Aniquilación","overview":"Estamos en el universo del Emperador Shao-Khan, donde las reglas no existen y la vida es una continua batalla. Los esbirros del maquiavélico Khan han sido adiestrados para matar y están dispuestos a cumplir las órdenes de su amo, conseguir el control de la Tierra para iniciar su aniquilación total. Un héroe, llamado Liu Kang, les hará frente.","posterPath":"https://image.tmdb.org/t/p/w500/wImgbIw8knn5WQvvqV5wdnIHdWn.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/19EpgKZDkLIwY1TI1pjBJtQ5qdr.jpg","voteAverage":4.5,"voteCount":1330,"releaseDate":"1997-11-11","genres":["Acción","Fantasía","Ciencia ficción"],"type":"movie","platforms":[],"tmdbId":9823,"runtime":"$undefined","seasons":"$undefined"},{"id":13576,"title":"This Is It","originalTitle":"This Is It","overview":"Película documental realizado con el material grabado durante los últimos ensayos del \"rey del pop\" Michael Jackson, que preparaba su regreso a los escenarios cuando murió por una negligencia de su médico. La mayor parte del montaje del film fue rodado en junio de 2009 en el Staples Center de Los Ángeles y The Forum en Inglewood, en California, cuando Michael preparaba su 'This is it', la serie de 50 conciertos que iba a ofrecer en el O2 Arena de Londres. Dirige el documental Kenny Ortega, responsable de los \"High School Musical\".","posterPath":"https://image.tmdb.org/t/p/w500/a7nyJrfaI4lHyPDh4ptecylfqD7.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/mqAuLsN6oOme6lSKoTb6yyP4U8E.jpg","voteAverage":7.3,"voteCount":1023,"releaseDate":"2009-10-28","genres":["Música","Documental"],"type":"movie","platforms":[],"tmdbId":13576,"runtime":"$undefined","seasons":"$undefined"},{"id":872585,"title":"Oppenheimer","originalTitle":"Oppenheimer","overview":"Película sobre el físico J. Robert Oppenheimer y su papel como desarrollador de la bomba atómica. Basada en el libro 'American Prometheus: The Triumph and Tragedy of J. Robert Oppenheimer' de Kai Bird y Martin J. Sherwin.","posterPath":"https://image.tmdb.org/t/p/w500/ncKCQVXgk4BcQV6XbvesgZ2zLvZ.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/neeNHeXjMF5fXoCJRsOmkNGC7q.jpg","voteAverage":8,"voteCount":11735,"releaseDate":"2023-07-19","genres":["Drama","Historia"],"type":"movie","platforms":[],"tmdbId":872585,"runtime":"$undefined","seasons":"$undefined"},{"id":550,"title":"El club de la lucha","originalTitle":"El club de la lucha","overview":"Un hombre consumido por el insomnio y una vida sin sentido conoce a Tyler Durden, un carismático anarquista que lo arrastra a un club secreto donde el dolor despierta algo dormido. Lo que comienza como liberación pronto se convierte en una guerra contra el sistema…","posterPath":"https://image.tmdb.org/t/p/w500/sgTAWJFaB2kBvdQxRGabYFiQqEK.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/xRyINp9KfMLVjRiO5nCsoRDdvvF.jpg","voteAverage":8.4,"voteCount":31988,"releaseDate":"1999-10-15","genres":["Drama","Suspense"],"type":"movie","platforms":[],"tmdbId":550,"runtime":"$undefined","seasons":"$undefined"},{"id":808,"title":"Shrek","originalTitle":"Shrek","overview":"Hace mucho, mucho tiempo, en una lejanísima ciénaga vivía un intratable ogro llamado Shrek. Pero de repente, un día, su absoluta soledad se ve interrumpida por una invasión de sorprendentes personajes de cuento. Hay ratoncitos ciegos en su comida, un enorme y malísimo lobo en su cama, tres cerditos sin hogar y otros muchos seres increíbles que han sido deportados de su reino por el malvado Lord Farquaad. Para conseguir salvar su terreno, y de paso a sí mismo, Shrek hace un pacto con Farquaad y emprende viaje para conseguir que la preciosa princesa Fiona sea la novia del Lord. En tan importante misión le acompañan un burro chistoso, dispuesto a hacer cualquier cosa por Shrek. Todo, menos estarse calladito. Rescatar a la princesa de una dragona enamoradiza que suelta fuego al respirar va a resultar una tontería comparado con lo que ocurre cuando el oscuro secreto que la joven guardaba es revelado.","posterPath":"https://image.tmdb.org/t/p/w500/jTQONM7jt1yv2lL972TtmWO0UIZ.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/40Wtp7kMG6mZ4d5T1jfrd8qrvD4.jpg","voteAverage":7.8,"voteCount":18715,"releaseDate":"2001-05-18","genres":["Animación","Comedia","Fantasía","Aventura","Familia"],"type":"movie","platforms":[],"tmdbId":808,"runtime":"$undefined","seasons":"$undefined"},{"id":634649,"title":"Spider-Man: No Way Home","originalTitle":"Spider-Man: No Way Home","overview":"Peter Parker es desenmascarado y por tanto no es capaz de separar su vida normal de los enormes riesgos que conlleva ser un súper héroe. Cuando pide ayuda a Doctor Strange, los riesgos pasan a ser aún más peligrosos, obligándole a descubrir lo que realmente significa ser Spider-Man.","posterPath":"https://image.tmdb.org/t/p/w500/miZFgV81xG324rpUknQX8dtXuBl.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/zD5v1E4joAzFvmAEytt7fM3ivyT.jpg","voteAverage":7.9,"voteCount":21945,"releaseDate":"2021-12-15","genres":["Acción","Aventura","Ciencia ficción"],"type":"movie","platforms":[],"tmdbId":634649,"runtime":"$undefined","seasons":"$undefined"},{"id":807,"title":"Seven","originalTitle":"Seven","overview":"El teniente Somerset, del departamento de homicidios, está a punto de jubilarse y ser reemplazado por el ambicioso y brillante detective David Mills. Ambos tendrán que colaborar en la resolución de una serie de asesinatos cometidos por un psicópata que toma como base la relación de los siete pecados capitales: gula, pereza, soberbia, avaricia, envidia, lujuria e ira. Los cuerpos de las víctimas, sobre los que el asesino se ensaña de manera impúdica, se convertirán para los policías en un enigma que les obligará a viajar al horror y la barbarie más absoluta.","posterPath":"https://image.tmdb.org/t/p/w500/uVPcVz4b2hnSGrXYLdIGRXwcivs.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/i5H7zusQGsysGQ8i6P361Vnr0n2.jpg","voteAverage":8.4,"voteCount":23031,"releaseDate":"1995-09-22","genres":["Crimen","Misterio","Suspense"],"type":"movie","platforms":[],"tmdbId":807,"runtime":"$undefined","seasons":"$undefined"},{"id":597,"title":"Titanic","originalTitle":"Titanic","overview":"Jack, un joven artista, gana en una partida de cartas un pasaje para viajar a América en el Titanic, el transatlántico más grande y seguro jamás construido. A bordo conoce a Rose, una joven de una buena familia venida a menos que va a contraer un matrimonio de conveniencia con Cal, un millonario engreído a quien sólo interesa el prestigioso apellido de su prometida. Jack y Rose se enamoran, pero el prometido y la madre de ella ponen todo tipo de trabas a su relación. Mientras, el gigantesco y lujoso transatlántico se aproxima hacia un inmenso iceberg.","posterPath":"https://image.tmdb.org/t/p/w500/VMOt5scbGmBKDvkfHjZN6Ki54i.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/xnHVX37XZEp33hhCbYlQFq7ux1J.jpg","voteAverage":7.9,"voteCount":27113,"releaseDate":"1997-12-18","genres":["Drama","Romance"],"type":"movie","platforms":[],"tmdbId":597,"runtime":"$undefined","seasons":"$undefined"},{"id":671,"title":"Harry Potter y la piedra filosofal","originalTitle":"Harry Potter y la piedra filosofal","overview":"Harry Potter es un huérfano que vive con sus desagradables tíos, los Dursley, y su repelente primo Dudley. Se acerca su undécimo cumpleaños y tiene pocas esperanzas de recibir algún regalo, ya que nunca nadie se acuerda de él. Sin embargo, pocos días antes de su cumpleaños, una serie de misteriosas cartas dirigidas a él y escritas con una estridente tinta verde rompen la monotonía de su vida: Harry es un mago y sus padres también lo eran.","posterPath":"https://image.tmdb.org/t/p/w500/3MKK7vAJLtSkBTABMTjxf6TOCo3.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/1XAC6RPT01UX9EQGy2JVn5c8pgy.jpg","voteAverage":7.9,"voteCount":29519,"releaseDate":"2001-11-16","genres":["Aventura","Fantasía"],"type":"movie","platforms":[],"tmdbId":671,"runtime":"$undefined","seasons":"$undefined"},{"id":13,"title":"Forrest Gump","originalTitle":"Forrest Gump","overview":"Forrest Gump es un chico con deficiencias mentales no muy profundas y con alguna incapacidad motora que, a pesar de todo, llegará a convertirse, entre otras cosas, en un héroe durante la Guerra del Vietnam. Su persistencia y bondad le llevarán a conseguir una gran fortuna, ser objeto del clamor popular y a codearse con las más altas esferas sociales y políticas del país. Siempre sin olvidar a Jenny, su gran amor desde que era niño.","posterPath":"https://image.tmdb.org/t/p/w500/azV6hV99lYkdhydsQbJCI6FqMl4.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/66Kn4XWhkuPkJxOJyPEx4U2CUfN.jpg","voteAverage":8.5,"voteCount":29705,"releaseDate":"1994-06-23","genres":["Comedia","Drama","Romance"],"type":"movie","platforms":[],"tmdbId":13,"runtime":"$undefined","seasons":"$undefined"},{"id":346698,"title":"Barbie","originalTitle":"Barbie","overview":"Barbie vive en Barbieland donde todo es ideal y lleno de música y color. Un buen día decide conocer el mundo real. Cuando el CEO de Mattel se entere, tratará de evitarlo a toda costa y devolver a Barbie a una caja.","posterPath":"https://image.tmdb.org/t/p/w500/fNtqD4BTFj0Bgo9lyoAtmNFzxHN.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/mbYTRO33LJAgpCMrIn9ibiWHbMH.jpg","voteAverage":6.9,"voteCount":11074,"releaseDate":"2023-07-19","genres":["Comedia","Aventura","Fantasía"],"type":"movie","platforms":[],"tmdbId":346698,"runtime":"$undefined","seasons":"$undefined"},{"id":11,"title":"La guerra de las galaxias","originalTitle":"La guerra de las galaxias","overview":"La princesa Leia, líder del movimiento rebelde que desea reinstaurar la República en la galaxia en los tiempos ominosos del Imperio, es capturada por las malévolas Fuerzas Imperiales, capitaneadas por el implacable Darth Vader, el sirviente más fiel del emperador. El intrépido Luke Skywalker, ayudado por Han Solo, capitán de la nave espacial \"El Halcón Milenario\", y los androides, R2D2 y C3PO, serán los encargados de luchar contra el enemigo y rescatar a la princesa para volver a instaurar la justicia en el seno de la Galaxia.","posterPath":"https://image.tmdb.org/t/p/w500/ahT4ObS7XKedQkOSpGr1wQ97aKA.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/yUiXA68FfQeA8cRBhd0Ao0jIRZt.jpg","voteAverage":8.2,"voteCount":22286,"releaseDate":"1977-05-25","genres":["Aventura","Acción","Ciencia ficción"],"type":"movie","platforms":[],"tmdbId":11,"runtime":"$undefined","seasons":"$undefined"},{"id":372058,"title":"Your Name.","originalTitle":"Your Name.","overview":"Taki y Mitsuha descubren un día que durante el sueño sus cuerpos se intercambian, y comienzan a comunicarse por medio de notas. A medida que consiguen superar torpemente un reto tras otro, se va creando entre los dos un vínculo que poco a poco se convierte en algo más romántico.","posterPath":"https://image.tmdb.org/t/p/w500/iaiy3tg9QVkDpObm1IGqmbC9A5C.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/8x9iKH8kWA0zdkgNdpAew7OstYe.jpg","voteAverage":8.5,"voteCount":12530,"releaseDate":"2016-08-26","genres":["Animación","Romance","Drama"],"type":"movie","platforms":[],"tmdbId":372058,"runtime":"$undefined","seasons":"$undefined"},{"id":567609,"title":"Noche de bodas","originalTitle":"Noche de bodas","overview":"Durante la noche de su boda, una mujer recibe la invitación por parte de la rica y excéntrica familia de su marido para participar en una tradición ancestral que se convierte en un juego letal de supervivencia.","posterPath":"https://image.tmdb.org/t/p/w500/47BlTRVQ43NyzgMWPLOkKYYnHez.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/oJ1MIABA0WF0a7MDVQnnMvBdex8.jpg","voteAverage":7.1,"voteCount":5418,"releaseDate":"2019-08-21","genres":["Terror","Comedia"],"type":"movie","platforms":[],"tmdbId":567609,"runtime":"$undefined","seasons":"$undefined"},{"id":497,"title":"La milla verde","originalTitle":"La milla verde","overview":"En el sur de los Estados Unidos, en plena Depresión, Paul Edgecomb es un vigilante penitenciario a cargo de la Milla Verde, un pasillo que separa las celdas de los reclusos condenados a la silla eléctrica. Esperando su ejecución está John Coffey, un gigantesco negro acusado de asesinar brutalmente a dos hermanas de nueve años. Tras una personalidad ingenua, Coffey esconde un don sobrenatural prodigioso. A medida que transcurre la historia, Paul Edgecomb aprende que los milagros ocurren... incluso en los lugares más insospechados.","posterPath":"https://image.tmdb.org/t/p/w500/aBQiJRxGRrX0mXFMjxyzWYFtEnf.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/b6HWTOxn1xevvyHU2K9ICvaRU6g.jpg","voteAverage":8.5,"voteCount":19224,"releaseDate":"1999-12-10","genres":["Fantasía","Drama","Crimen"],"type":"movie","platforms":[],"tmdbId":497,"runtime":"$undefined","seasons":"$undefined"},{"id":240,"title":"El Padrino Parte II","originalTitle":"El Padrino Parte II","overview":"Continuación de la saga de los Corleone con dos historias paralelas: la elección de Michael Corleone como jefe de los negocios familiares y los orígenes del patriarca, el ya fallecido Don Vito, primero en Sicilia y luego en Estados Unidos, donde, empezando desde abajo, llegó a ser un poderosísimo jefe de la mafia de Nueva York.","posterPath":"https://image.tmdb.org/t/p/w500/mbry0W5PRylSUHsYzdiY2FSJwze.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/kGzFbGhp99zva6oZODW5atUtnqi.jpg","voteAverage":8.6,"voteCount":13886,"releaseDate":"1974-12-20","genres":["Drama","Crimen"],"type":"movie","platforms":[],"tmdbId":240,"runtime":"$undefined","seasons":"$undefined"},{"id":693134,"title":"Dune: Parte dos","originalTitle":"Dune: Parte dos","overview":"Sigue el viaje mítico de Paul Atreides mientras se une a Chani y los Fremen en una guerra de venganza contra los conspiradores que destruyeron a su familia. Al enfrentarse a una elección entre el amor de su vida y el destino del universo conocido, Paul se esfuerza por evitar un futuro terrible que solo él puede prever.","posterPath":"https://image.tmdb.org/t/p/w500/xCHmhHeO7aOCMlzcNukGH6Q7EiD.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/xOMo8BRK7PfcJv9JCnx7s5hj0PX.jpg","voteAverage":8.1,"voteCount":7915,"releaseDate":"2024-02-27","genres":["Ciencia ficción","Aventura"],"type":"movie","platforms":[],"tmdbId":693134,"runtime":"$undefined","seasons":"$undefined"},{"id":1184918,"title":"Robot salvaje","originalTitle":"Robot salvaje","overview":"Esta aventura épica cuenta la historia de una robot, Rozzum 7-1-3-4, \"Roz\" para abreviar, que naufraga en una isla inhabitada y debe aprender a adaptarse a los entornos rigurosos construyendo relaciones con los animales de la isla y convirtiéndose en la madre adoptiva de una cría de ganso huérfana.","posterPath":"https://image.tmdb.org/t/p/w500/a0a7RC01aTa7pOnskgJb3mCD2Ba.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/mQZJoIhTEkNhCYAqcHrQqhENLdu.jpg","voteAverage":8.3,"voteCount":6045,"releaseDate":"2024-09-12","genres":["Familia","Animación","Ciencia ficción","Aventura"],"type":"movie","platforms":[],"tmdbId":1184918,"runtime":"$undefined","seasons":"$undefined"},{"id":744,"title":"Top Gun: Ídolos del aire","originalTitle":"Top Gun: Ídolos del aire","overview":"La Marina de los Estados Unidos ha creado una escuela de élite para pilotos con el fin de sacar una promoción de expertos en técnicas de combate. En la academia, más conocida como Top Gun, a los mejores se les entrena para ser intrépidos y fríos al mismo tiempo, capaces de no perder los nervios en situaciones extremas y de no inmutarse al romper la barrera del sonido a los mandos de un F-14. A la escuela llega el joven Maverick, famoso por su temeraria aunque brillante forma de pilotar.","posterPath":"https://image.tmdb.org/t/p/w500/W8QUPhiBOCdj2urJDzc2D9xdQb.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/dBgxEkWe17R0AJDAvAhpeVELQx2.jpg","voteAverage":7.1,"voteCount":9534,"releaseDate":"1986-05-16","genres":["Acción","Drama","Romance"],"type":"movie","platforms":[],"tmdbId":744,"runtime":"$undefined","seasons":"$undefined"},{"id":769,"title":"Uno de los nuestros","originalTitle":"Uno de los nuestros","overview":"Henry, un niño de trece años de Brooklyn, vive fascinado con el mundo de los gángsters. Su sueño se hace realidad cuando entra a formar parte de la familia Pauline, dueña absoluta de la zona, que lo educan como un miembro más de la banda convirtiéndole en un destacado mafioso.","posterPath":"https://image.tmdb.org/t/p/w500/3Yy0zBO9AlyAZH1cTI8Ko2ouCi.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/gILte6Zd7m1YneIr6MVhh30S9pr.jpg","voteAverage":8.5,"voteCount":14306,"releaseDate":"1990-09-12","genres":["Drama","Crimen"],"type":"movie","platforms":[],"tmdbId":769,"runtime":"$undefined","seasons":"$undefined"},{"id":19995,"title":"Avatar","originalTitle":"Avatar","overview":"Año 2154. Jake Sully, un exmarine en silla de ruedas, es enviado al planeta Pandora, donde se ha creado el programa Avatar, gracias al cual los seres humanos pueden controlar de forma remota un cuerpo biológico con apariencia y genética de la especie nativa. Pronto se encontrará con la encrucijada entre seguir las órdenes de sus superiores o defender al mundo que le ha acogido y siente como suyo.","posterPath":"https://image.tmdb.org/t/p/w500/t5T3LPbLLgP2OP6kloM9p2PXpJL.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/vL5LR6WdxWPjLPFRLe133jXWsh5.jpg","voteAverage":7.6,"voteCount":33930,"releaseDate":"2009-12-16","genres":["Ciencia ficción","Acción","Aventura"],"type":"movie","platforms":[],"tmdbId":19995,"runtime":"$undefined","seasons":"$undefined"},{"id":438631,"title":"Dune","originalTitle":"Dune","overview":"En un lejano futuro, la galaxia conocida es gobernada mediante un sistema feudal de casas nobles bajo el mandato del Emperador. Las alianzas y la política giran entorno a un pequeño planeta, Dune,  del que extrae la 'especia melange', la materia prima que permite los viajes espaciales. La Casa Atreides, bajo el mandato del Duque Leto Atreides recibe el encargo de custodiar el planeta, relevando en la encomienda a sus históricos enemigos, los Harkonnen. Paul Atreides, hijo del duque, se verá atrapado en las intrigas políticas mientras descubre el destino que le deparan los desiertos de Dune.","posterPath":"https://image.tmdb.org/t/p/w500/szcew6yyjcDvaL0isaPBk2e3nkF.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/zRKQW58MBEY078AxkHxEJzUskCl.jpg","voteAverage":7.8,"voteCount":14846,"releaseDate":"2021-09-15","genres":["Ciencia ficción","Aventura"],"type":"movie","platforms":[],"tmdbId":438631,"runtime":"$undefined","seasons":"$undefined"},{"id":866398,"title":"Beekeeper: El protector","originalTitle":"Beekeeper: El protector","overview":"La brutal campaña de venganza de Adam Clay adquiere tintes nacionales tras revelarse que es un antiguo agente de una poderosa organización clandestina conocida como \"Beekeeper\".","posterPath":"https://image.tmdb.org/t/p/w500/gBdhYoROX6SHE3vVnBfEHI7Ojma.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/4MCKNAc6AbWjEsM2h9Xc29owo4z.jpg","voteAverage":7.2,"voteCount":4189,"releaseDate":"2024-01-08","genres":["Acción","Crimen","Suspense"],"type":"movie","platforms":[],"tmdbId":866398,"runtime":"$undefined","seasons":"$undefined"},{"id":424,"title":"La lista de Schindler","originalTitle":"La lista de Schindler","overview":"Oskar Schindler, un hombre de enorme astucia y talento para las relaciones públicas, organiza un ambicioso plan para ganarse la simpatía de los nazis. Después de la invasión de Polonia por los alemanes, consigue, gracias a sus relaciones con los nazis, la propiedad de una fábrica de Cracovia. Allí emplea a cientos de operarios judíos, cuya explotación le hace prosperar rápidamente. Su gerente, también judío, es el verdadero director en la sombra, pues Schindler no tiene el menor conocimiento industrial.","posterPath":"https://image.tmdb.org/t/p/w500/3Ho0pXsnMxpGJWqdOi0KDNdaTkT.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/zb6fM1CX41D9rF9hdgclu0peUmy.jpg","voteAverage":8.6,"voteCount":17426,"releaseDate":"1993-12-15","genres":["Drama","Historia","Bélica"],"type":"movie","platforms":[],"tmdbId":424,"runtime":"$undefined","seasons":"$undefined"},{"id":214756,"title":"Ted 2","originalTitle":"Ted 2","overview":"Se trata de una secuela de la exitosa comedia escrita y dirigida por el cómico Seth MacFarlane. Recién casados Ted y Tami-Lynn deciden tener un bebé. John se ofrece en donar su esperma para que su mejor amigo pueda cumplir su sueño de tener un hijo, pero inesperadamente reciben una carta legal que dice que el estado no le permite ser padre ya que no está demostrado que sea una persona. Todos juntos tendrán que unir fuerzas para luchar por sus derechos en un tribunal de justicia.","posterPath":"https://image.tmdb.org/t/p/w500/bO59Vn36fQauTDQpKNlHxvcK9Nw.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/xtHonIIIQXverDQM08TMQXjn9Fe.jpg","voteAverage":6.3,"voteCount":7967,"releaseDate":"2015-06-25","genres":["Comedia","Fantasía"],"type":"movie","platforms":[],"tmdbId":214756,"runtime":"$undefined","seasons":"$undefined"},{"id":121,"title":"El señor de los anillos: Las dos torres","originalTitle":"El señor de los anillos: Las dos torres","overview":"La Compañía del Anillo se ha disuelto. El portador del anillo Frodo y su fiel amigo Sam se dirigen hacia Mordor para destruir el Anillo Único y acabar con el poder de Sauron. Mientras, y tras la dura batalla contra los orcos donde cayó Boromir, el hombre Aragorn, el elfo Legolas y el enano Gimli intentan rescatar a los medianos Merry y Pipin, secuestrados por los ogros de Mordor. Por su parte, Saurón y el traidor Sarumán continúan con sus planes en Mordor, en espera de la guerra contra las razas libres de la Tierra Media.","posterPath":"https://image.tmdb.org/t/p/w500/up6gIHZlfEQZkHIfQwcOOaGOzOt.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/kWYfW2Re0rUDE6IHhy4CRuKWeFr.jpg","voteAverage":8.4,"voteCount":23837,"releaseDate":"2002-12-18","genres":["Aventura","Fantasía","Acción"],"type":"movie","platforms":[],"tmdbId":121,"runtime":"$undefined","seasons":"$undefined"},{"id":652,"title":"Troya","originalTitle":"Troya","overview":"A lo largo de los tiempos, los hombres han hecho la guerra. Unos por poder, otros por gloria o por honor, y algunos por amor. En la antigua Grecia, la pasión de dos de los amantes más legendarios de la historia, Paris, príncipe de Troya y Helena, reina de Esparta, desencadena una guerra que asolará una civilización. El rapto de Helena por Paris, separándola de su esposo, el rey Menelao, es un insulto que El orgullo familiar establece que una afrenta a Menelao es una afrenta a su hermano Agamenón, el poderoso rey de Micenas, que no tarda en reunir a todas las grandes tribus de Grecia para recuperar a Helena de manos de los troyanos y defender el honor de su hermano. La verdad es que la lucha por el honor por parte de Agamenón está corrompida por su incontenible codicia ya que necesita conquistar Troya para asumir el control del mar Egeo.","posterPath":"https://image.tmdb.org/t/p/w500/mBiDQT28DnuYaJSL4nDD43ORE6p.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/d3z8MH9OvTOOSxy5QwAG0cS6GKU.jpg","voteAverage":7.2,"voteCount":11021,"releaseDate":"2004-05-13","genres":["Bélica","Acción","Historia"],"type":"movie","platforms":[],"tmdbId":652,"runtime":"$undefined","seasons":"$undefined"},{"id":1011985,"title":"Kung Fu Panda 4","originalTitle":"Kung Fu Panda 4","overview":"Po se prepara para ser el líder espiritual del Valle de la Paz, buscando un sucesor como Guerrero Dragón. Mientras entrena a un nuevo practicante de kung fu, enfrenta al villano llamado \"el Camaleón\", que evoca villanos del pasado, desafiando todo lo que Po y sus amigos han aprendido.","posterPath":"https://image.tmdb.org/t/p/w500/2xgGWjM3a38E4KTLapvC53RnpN1.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/3ffPx9jqg0yj9y1KWeagT7D20CB.jpg","voteAverage":7,"voteCount":3485,"releaseDate":"2024-03-02","genres":["Acción","Aventura","Animación","Comedia","Familia","Fantasía"],"type":"movie","platforms":[],"tmdbId":1011985,"runtime":"$undefined","seasons":"$undefined"},{"id":269149,"title":"Zootrópolis","originalTitle":"Zootrópolis","overview":"La moderna metrópoli mamífera de Zootrópolis es una ciudad absolutamente única. Está compuesta de barrios con diferentes hábitats como la lujosa Plaza Sahara, el Distrito Selva Tropical y el gélido Distrito Tundra. Es un crisol donde los animales de cada entorno conviven, un lugar donde no importa lo que seas. De hecho puedes ser cualquier cosa, desde un elefante enorme hasta la musaraña más diminuta. Pero cuando llega la optimista agente Judy Hopps, descubre que ser la primera conejita de un cuerpo policial compuesto de animales duros y enormes no es nada fácil. Pero está decidida a demostrar su valía y se mete de cabeza en un caso, a pesar de que eso significa trabajar con Nick Wilde, un zorro parlanchín y estafador, para resolver el misterio.","posterPath":"https://image.tmdb.org/t/p/w500/4zIlT48TgNLuJpUtFOkFITHoCQE.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/9tOkjBEiiGcaClgJFtwocStZvIT.jpg","voteAverage":7.8,"voteCount":18041,"releaseDate":"2016-02-11","genres":["Animación","Aventura","Familia","Comedia"],"type":"movie","platforms":[],"tmdbId":269149,"runtime":"$undefined","seasons":"$undefined"},{"id":569094,"title":"Spider-Man: Cruzando el Multiverso","originalTitle":"Spider-Man: Cruzando el Multiverso","overview":"Tras reencontrarse con Gwen Stacy, el amigable vecindario de Spider-Man de Brooklyn al completo es catapultado a través del Multiverso, donde se encuentra con un equipo de Spidermans encargados de proteger su propia existencia. Pero cuando los héroes se enfrentan sobre cómo manejar una nueva amenaza, Miles se encuentra enfrentado a las otras Arañas y debe redefinir lo que significa ser un héroe para poder salvar a la gente que más quiere.","posterPath":"https://image.tmdb.org/t/p/w500/37WcNMgNOMxdhT87MFl7tq7FM1.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/9xfDWXAUbFXQK585JvByT5pEAhe.jpg","voteAverage":8.3,"voteCount":8573,"releaseDate":"2023-05-31","genres":["Animación","Acción","Aventura","Ciencia ficción"],"type":"movie","platforms":[],"tmdbId":569094,"runtime":"$undefined","seasons":"$undefined"},{"id":389,"title":"12 hombres sin piedad","originalTitle":"12 hombres sin piedad","overview":"Tras escuchar todos los testimonios y valorar las pruebas presentadas, un jurado popular compuesto por doce hombres tiene que decidir, por unanimidad, si absuelve o condena a muerte a un joven acusado de haber matado a su padre. Al principio, once están completamente convencidos de su culpabilidad y se inclinan por la condena, pero el que discrepa empieza a plantear dudas razonables que, poco a poco, van resquebrajando la inicial seguridad de los demás.","posterPath":"https://image.tmdb.org/t/p/w500/qyVoDb3EKO5SnhpSRpztNmZjo70.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/w4bTBXcqXc2TUyS5Fc4h67uWbPn.jpg","voteAverage":8.6,"voteCount":9964,"releaseDate":"1957-04-10","genres":["Drama"],"type":"movie","platforms":[],"tmdbId":389,"runtime":"$undefined","seasons":"$undefined"},{"id":664767,"title":"Mortal Kombat Legends: La venganza de Scorpion","originalTitle":"Mortal Kombat Legends: La venganza de Scorpion","overview":"Basado en el popular videojuego creado por Ed Boon y John Tovias, Mortal Kombat Legends: Scorpion’s Revenge pone el foco en un torneo único que se celebra una vez por generación y en el que se enfrentan los campeones de distintos reinos. El ganador determinará el destino de la Tierra y de sus habitantes.","posterPath":"https://image.tmdb.org/t/p/w500/sqBl12v4AXVoc5PmeGnd8oZ7HHY.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/vw3zNfzvnVNF7nIjpiEgcdznfeC.jpg","voteAverage":8.1,"voteCount":1467,"releaseDate":"2020-04-12","genres":["Animación","Acción","Fantasía"],"type":"movie","platforms":[],"tmdbId":664767,"runtime":"$undefined","seasons":"$undefined"},{"id":335984,"title":"Blade Runner 2049","originalTitle":"Blade Runner 2049","overview":"Han pasado 30 años desde los acontecimientos ocurridos en Blade Runner (1982). El oficial K, un blade runner caza-replicantes del Departamento de Policía de Los Ángeles, descubre un secreto que ha estado enterrado durante mucho tiempo y que tiene el potencial de llevar a la sociedad al caos. Su investigación le conducirá a la búsqueda del legendario Rick Deckard, un antiguo blade runner en paradero desconocido, que lleva desaparecido 30 años.","posterPath":"https://image.tmdb.org/t/p/w500/cOt8SQwrxpoTv9Bc3kyce3etkZX.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/mVr0UiqyltcfqxbAUcLl9zWL8ah.jpg","voteAverage":7.6,"voteCount":15091,"releaseDate":"2017-10-04","genres":["Ciencia ficción","Drama"],"type":"movie","platforms":[],"tmdbId":335984,"runtime":"$undefined","seasons":"$undefined"},{"id":585,"title":"Monstruos, S.A.","originalTitle":"Monstruos, S.A.","overview":"Monsters Inc. es la mayor empresa de miedo del mundo, y James P. Sullivan es uno de sus mejores empleados. Asustar a los niños no es un trabajo fácil, ya que todos creen que los niños son tóxicos y no pueden tener contacto con ellos. Pero un día una niña se cuela sin querer en la empresa, provocando el caos.","posterPath":"https://image.tmdb.org/t/p/w500/g3SgHEb5ej2MioGfYLrZVshF909.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/sDTnMOJ3H5wI38OxObmCtK7wfd5.jpg","voteAverage":7.8,"voteCount":19728,"releaseDate":"2001-11-01","genres":["Animación","Comedia","Familia"],"type":"movie","platforms":[],"tmdbId":585,"runtime":"$undefined","seasons":"$undefined"},{"id":150540,"title":"Del revés (Inside Out)","originalTitle":"Del revés (Inside Out)","overview":"Riley es una chica que disfruta o padece toda clase de sentimientos. Aunque su vida ha estado marcada por la Alegría, también se ve afectada por otro tipo de emociones. Lo que Riley no entiende muy bien es por qué motivo tiene que existir la Tristeza en su vida. Una serie de acontecimientos hacen que Alegría y Tristeza se mezclen en una peligrosa aventura que dará un vuelco al mundo de Riley.","posterPath":"https://image.tmdb.org/t/p/w500/sG3bHZWCMOZwhUq71WbPG9Vrrwc.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/o3i6AfTcWAuNvzAUV3q5lOmi6Gx.jpg","voteAverage":7.9,"voteCount":23420,"releaseDate":"2015-06-17","genres":["Animación","Familia","Aventura","Drama","Comedia"],"type":"movie","platforms":[],"tmdbId":150540,"runtime":"$undefined","seasons":"$undefined"},{"id":862,"title":"Toy Story","originalTitle":"Toy Story","overview":"Los juguetes de Andy, un niño de seis años, temen que haya llegado su hora y que un nuevo regalo de cumpleaños les sustituya en el corazón de su dueño. Woody, un vaquero que ha sido hasta ahora el juguete favorito de Andy, trata de tranquilizarlos hasta que aparece Buzz Lightyear, un héroe espacial dotado de todo tipo de avances tecnológicos. Woody es relegado a un segundo plano, pero su constante rivalidad se transformará en una gran amistad cuando ambos se pierden en la ciudad sin saber cómo volver a casa.","posterPath":"https://image.tmdb.org/t/p/w500/y59d8PjuFSgJJN4VRS7jDoRgSM9.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/3Rfvhy1Nl6sSGJwyjb0QiZzZYlB.jpg","voteAverage":8,"voteCount":19839,"releaseDate":"1995-11-22","genres":["Familia","Comedia","Animación","Aventura"],"type":"movie","platforms":[],"tmdbId":862,"runtime":"$undefined","seasons":"$undefined"},{"id":348,"title":"Alien, el octavo pasajero","originalTitle":"Alien, el octavo pasajero","overview":"De regreso a la Tierra, la nave de carga Nostromo interrumpe su viaje y despierta a sus siete tripulantes. El ordenador central, MADRE, ha detectado la misteriosa transmisión de una forma de vida desconocida, procedente de un planeta cercano aparentemente deshabitado. La nave se dirige entonces al extraño planeta para investigar el origen de la comunicación.","posterPath":"https://image.tmdb.org/t/p/w500/pZ9cAe5FxexJjpCaeiETbXzz3Fs.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/cEobq5QrnOJjO6giDs8q4RxmMKh.jpg","voteAverage":8.2,"voteCount":16323,"releaseDate":"1979-05-25","genres":["Terror","Ciencia ficción"],"type":"movie","platforms":[],"tmdbId":348,"runtime":"$undefined","seasons":"$undefined"},{"id":557,"title":"Spider-Man","originalTitle":"Spider-Man","overview":"Peter Parker es un joven y tímido estudiante que vive con su tía May y su tío Ben desde la muerte de sus padres. Un día es mordido por una araña que ha sido modificada genéticamente, descubriendo al día siguiente que posee unos poderes poco habituales: tiene la fuerza y agilidad de una araña.","posterPath":"https://image.tmdb.org/t/p/w500/bCDaKZLRkrVVtPNyHxUfKvepW1N.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/zQ8AxTPiCiS5nnwXpwTBPBHSaa5.jpg","voteAverage":7.3,"voteCount":20617,"releaseDate":"2002-05-01","genres":["Acción","Ciencia ficción"],"type":"movie","platforms":[],"tmdbId":557,"runtime":"$undefined","seasons":"$undefined"},{"id":673,"title":"Harry Potter y el prisionero de Azkaban","originalTitle":"Harry Potter y el prisionero de Azkaban","overview":"Harry está deseando que termine el verano para comenzar un nuevo curso en Hogwarts, y abandonar lo antes posible la casa de sus despreciables tíos, los Dursley. Lo que desconoce Harry es que va a tener que abandonar Privet Drive antes de tiempo e inesperadamente después de convertir a su tía Marge en un globo gigante. Un autobús noctámbulo, y encantado por supuesto, le llevará a la taberna El Caldero Chorreante, donde le espera nada menos que Cornelius Fudge, el Ministro de Magia.","posterPath":"https://image.tmdb.org/t/p/w500/wF9aoo4YZmpKP4bZPSy4Zwwek6G.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/vbk5CfaAHOjQPSAcYm6AoRRz2Af.jpg","voteAverage":8,"voteCount":23104,"releaseDate":"2004-05-31","genres":["Aventura","Fantasía"],"type":"movie","platforms":[],"tmdbId":673,"runtime":"$undefined","seasons":"$undefined"},{"id":62177,"title":"Indomable","originalTitle":"Indomable","overview":"Mérida, la indómita hija del Rey Fergus y de la Reina Elinor, es una hábil arquera que decide romper con una antigua costumbre, que es sagrada para los señores de la tierra: el gigantesco Lord MacGuffin, el malhumorado Lord Macintosh y el cascarrabias Lord Dingwall. Las acciones de Merida desencadenan el caos y la furia en el reino. Además, pide ayuda a una sabia anciana que le concede un deseo muy desafortunado. La muchacha tendrá que afrontar grandes peligros antes de aprender qué es la auténtica valentía.","posterPath":"https://image.tmdb.org/t/p/w500/cTouCa0ObuGD1P2nKOQ7A21wm9p.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/qx9ts2hBYJrkIQxhryitxnLlm2u.jpg","voteAverage":7,"voteCount":14138,"releaseDate":"2012-06-21","genres":["Animación","Familia","Fantasía","Aventura"],"type":"movie","platforms":[],"tmdbId":62177,"runtime":"$undefined","seasons":"$undefined"},{"id":244786,"title":"Whiplash","originalTitle":"Whiplash","overview":"El objetivo de Andrew Neiman, un joven y ambicioso baterista de jazz, es triunfar en el elitista Conservatorio de Música de la Costa Este en el que estudia. Marcado por el fracaso de la carrera literaria de su padre, Andrew alberga sueños de grandeza. Terence Fletcher, un profesor conocido tanto por su talento como por sus rigurosos métodos de enseñanza, dirige el mejor conjunto de jazz del Conservatorio. Cuando Fletcher elige a Andrew y para formar parte del conjunto musical que dirige, cambia para siempre la vida del joven. La pasión de Andrew por alcanzar la perfección se convierte en obsesión, al tiempo que su despiadado profesor lo lleva al límite de su capacidad y de su salud mental.","posterPath":"https://image.tmdb.org/t/p/w500/uy36CPy5ARuC8qrH8Esg2ndFyJ5.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/wbQa0EnWUyRzQ5d1pHLNRlmsCUP.jpg","voteAverage":8.4,"voteCount":16591,"releaseDate":"2014-10-10","genres":["Drama","Música","Suspense"],"type":"movie","platforms":[],"tmdbId":244786,"runtime":"$undefined","seasons":"$undefined"},{"id":138843,"title":"Expediente Warren: The Conjuring","originalTitle":"Expediente Warren: The Conjuring","overview":"Basada en una historia real documentada por los reputados demonólogos Ed y Lorraine Warren. Narra los encuentros sobrenaturales que vivió la familia Perron en su casa de Rhode Island a principios de los 70. El matrimonio Warren, investigadores de renombre en el mundo de los fenómenos paranormales, acudieron a la llamada de esta familia aterrorizada por la presencia en su granja de un ser maligno.","posterPath":"https://image.tmdb.org/t/p/w500/sKuHxkCogdk6YWzTyXYPoo9qd9n.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/ecKQlAEG95k62SMGhvX83oEqANK.jpg","voteAverage":7.5,"voteCount":12684,"releaseDate":"2013-07-18","genres":["Terror","Suspense"],"type":"movie","platforms":[],"tmdbId":138843,"runtime":"$undefined","seasons":"$undefined"},{"id":429,"title":"El bueno, el feo y el malo","originalTitle":"El bueno, el feo y el malo","overview":"Durante la Guerra de Secesión, tres cazadores de recompensas se lanzan a la búsqueda de un tesoro que ninguno de los tres truhanes puede localizar sin la ayuda de los otros dos. Tuco sabe que el tesoro se encuentra en un cementerio, mientras que Joe conoce el nombre inscrito en la tumba que lo esconde. Mientras tanto, Sentenza no duda en matar a mujeres y niños para conseguir su meta. De esta forma, los tres hombres colaboran en apariencia, pero al final intentarán eliminarse mutuamente.","posterPath":"https://image.tmdb.org/t/p/w500/fSWnIXsxA47smMLwRELSWkxbVJ.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/Adrip2Jqzw56KeuV2nAxucKMNXA.jpg","voteAverage":8.5,"voteCount":9612,"releaseDate":"1966-12-23","genres":["Western"],"type":"movie","platforms":[],"tmdbId":429,"runtime":"$undefined","seasons":"$undefined"},{"id":519182,"title":"Gru 4. Mi villano favorito","originalTitle":"Gru 4. Mi villano favorito","overview":"Gru, Lucy y las niñas -Margo, Edith y Agnes- dan la bienvenida a un nuevo miembro en la familia: Gru Junior, que parece llegar con el propósito de ser un suplicio para su padre. Gru tendrá que enfrentarse en esta ocasión a su nueva némesis Maxime Le Mal y su sofisticada y malévola novia Valentina, lo que obligará a la familia a tener que darse a la fuga. Cuarta entrega de 'Gru, mi villano favorito'.","posterPath":"https://image.tmdb.org/t/p/w500/b6JX0fBne5yPFNBtdp4Imi3CpiE.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/twsxsfao6ZOVvT8LfudH603MMi6.jpg","voteAverage":7,"voteCount":3187,"releaseDate":"2024-06-20","genres":["Acción","Animación","Comedia","Familia","Ciencia ficción"],"type":"movie","platforms":[],"tmdbId":519182,"runtime":"$undefined","seasons":"$undefined"},{"id":315635,"title":"Spider-Man: Homecoming","originalTitle":"Spider-Man: Homecoming","overview":"Peter Parker comienza a experimentar su recién descubierta identidad como el superhéroe Spider-Man. Después de la experiencia vivida con los Vengadores, Peter regresa a casa, donde vive con su tía. Bajo la atenta mirada de su mentor Tony Stark, Peter intenta mantener una vida normal como cualquier joven de su edad, pero interrumpe en su rutina diaria el nuevo villano Vulture y, con él, lo más importante de la vida de Peter comenzará a verse amenazado.","posterPath":"https://image.tmdb.org/t/p/w500/yJfPC6pjSJ5VOsVyXhx5PXBe0mR.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/tPpYGm2mVecue7Bk3gNVoSPA5qn.jpg","voteAverage":7.3,"voteCount":23124,"releaseDate":"2017-07-05","genres":["Acción","Aventura","Ciencia ficción"],"type":"movie","platforms":[],"tmdbId":315635,"runtime":"$undefined","seasons":"$undefined"},{"id":210577,"title":"Perdida","originalTitle":"Perdida","overview":"El día de su quinto aniversario de boda, Nick Dunne informa de que su esposa Amy ha desaparecido misteriosamente. Pronto la presión policial y mediática hace que el retrato de felicidad doméstica que ofrece Nick empiece a tambalearse. Además, su extraña conducta lo convierte en sospechoso, y todo el mundo comienza a preguntase si Nick mató a su esposa...","posterPath":"https://image.tmdb.org/t/p/w500/bkIhygnbv9ydlDo4SEsOcqGgQD4.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/iWak7wT0j6ycCc8lKr4NBz9c7n5.jpg","voteAverage":7.9,"voteCount":19921,"releaseDate":"2014-10-01","genres":["Misterio","Suspense","Drama"],"type":"movie","platforms":[],"tmdbId":210577,"runtime":"$undefined","seasons":"$undefined"},{"id":10138,"title":"Iron Man 2","originalTitle":"Iron Man 2","overview":"El mundo sabe que el multimillonario Tony Stark es Iron Man, el superhéroe enmascarado. Sometido a presiones por parte del gobierno, la prensa y la opinión pública para que comparta su tecnología con el ejército, Tony es reacio a desvelar los secretos de la armadura de Iron Man porque teme que esa información pueda caer en manos indeseables.","posterPath":"https://image.tmdb.org/t/p/w500/ayyJVOV5I4MGjti7nIHC3mVCagR.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/7lmBufEG7P7Y1HClYK3gCxYrkgS.jpg","voteAverage":6.9,"voteCount":22342,"releaseDate":"2010-04-28","genres":["Aventura","Acción","Ciencia ficción"],"type":"movie","platforms":[],"tmdbId":10138,"runtime":"$undefined","seasons":"$undefined"},{"id":414906,"title":"The Batman","originalTitle":"The Batman","overview":"Cuando un asesino se dirige a la élite de Gotham con una serie de maquinaciones sádicas, un rastro de pistas crípticas envía Batman a una investigación en los bajos fondos. A medida que las pruebas comienzan a acercarse a su casa y se hace evidente la magnitud de los planes del autor, Batman debe forjar nuevas relaciones, desenmascarar al culpable y hacer justicia al abuso de poder y la corrupción que durante mucho tiempo han asolado Gotham City.","posterPath":"https://image.tmdb.org/t/p/w500/mo7teil1qH0SxgLijnqeYP1Eb4w.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/rvtdN5XkWAfGX6xDuPL6yYS2seK.jpg","voteAverage":7.7,"voteCount":11895,"releaseDate":"2022-03-01","genres":["Crimen","Misterio","Suspense"],"type":"movie","platforms":[],"tmdbId":414906,"runtime":"$undefined","seasons":"$undefined"},{"id":122917,"title":"El hobbit: La batalla de los cinco ejércitos","originalTitle":"El hobbit: La batalla de los cinco ejércitos","overview":"Después de haber recuperado el reino del Dragón Smaug, la Compañía ha desencadenado, sin querer, una potencia maligna. Un Smaug enfurecido vuela hacia la Ciudad del Lago para acabar con cualquier resto de vida. Obsesionado sobre todo con el reino recuperado, Thorin sacrifica la amistad y el honor para mantenerlo mientras que Bilbo intenta frenéticamente hacerle ver la razón por la que el hobbit toma una decisión desesperada y peligrosa. Pero hay aún mayores peligros por delante. Sin la ayuda aparente del mago Gandalf, su gran enemigo Sauron ha enviado legiones de orcos hacia la Montaña Solitaria en un ataque furtivo. Cuando la oscuridad se cierna sobre ellos, las razas de los Enanos, Elfos y Hombres deben decidir si unirse o ser destruidos. Bilbo se encontrará así en la batalla épica de los Cinco Ejércitos, donde el futuro de la Tierra Media está en juego.","posterPath":"https://image.tmdb.org/t/p/w500/6OiNSLcRKJsBLXwb6DEi6IQ0JFk.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/3UbaCMmqOd7mca4Y5DOzY2ZVTyX.jpg","voteAverage":7.3,"voteCount":15324,"releaseDate":"2014-12-10","genres":["Acción","Aventura","Fantasía"],"type":"movie","platforms":[],"tmdbId":122917,"runtime":"$undefined","seasons":"$undefined"},{"id":354912,"title":"Coco","originalTitle":"Coco","overview":"Un joven aspirante a músico llamado Miguel se embarca en un viaje extraordinario a la mágica tierra de sus ancestros. Allí, el encantador embaucador Héctor se convierte en su inesperado amigo y le ayuda a descubrir los misterios detrás de las historias y tradiciones de su familia.","posterPath":"https://image.tmdb.org/t/p/w500/vwsFGblLYxWBNjg9pdWN1Mm5YfW.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/g7CHF8gTLGooTbP4GznIGwaqAGL.jpg","voteAverage":8.2,"voteCount":20935,"releaseDate":"2017-10-27","genres":["Familia","Animación","Música","Aventura"],"type":"movie","platforms":[],"tmdbId":354912,"runtime":"$undefined","seasons":"$undefined"},{"id":177572,"title":"Big Hero 6","originalTitle":"Big Hero 6","overview":"En la metrópolis de San Fransokio (cruce de San Francisco y Tokio), vive Hiro Hamada, quien aprende a sacar provecho de su capacidad gracias a su brillante hermano Tadashi y sus también brillantes amigos: la buscadora de adrenalina GoGo Tamago, el meticuloso de la limpieza Wasabi-No-Ginger, la genio de la química Honey Lemon y el fanático de los cómics Fred. Cuando tras un devastador giro de los acontecimientos, se ven envueltos en una peligrosa conspiración que tiene lugar en las calles de San Fransokio, Hiro recurre a su amigo más íntimo: un robot llamado Baymax, y transforma al grupo en una banda de héroes de última tecnología decididos a resolver el misterio.","posterPath":"https://image.tmdb.org/t/p/w500/qVU0ag4i5BCmH5h4o04cdvUo0Zf.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/4s2d3xdyqotiVNHTlTlJjrr3q0H.jpg","voteAverage":7.7,"voteCount":16549,"releaseDate":"2014-10-24","genres":["Aventura","Familia","Animación","Acción","Comedia"],"type":"movie","platforms":[],"tmdbId":177572,"runtime":"$undefined","seasons":"$undefined"},{"id":396535,"title":"Train to Busan","originalTitle":"Train to Busan","overview":"Un virus letal se expande por Corea del Sur, provocando violentos altercados. Los pasajeros de un tren KTX que viaja de Seúl a Busan tendrán que luchar por su supervivencia.","posterPath":"https://image.tmdb.org/t/p/w500/anomz7b3GQtHPFH34SODDBBIUad.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/fVpFOcQyHJM2di9upgSIwWD5wac.jpg","voteAverage":7.7,"voteCount":8335,"releaseDate":"2016-07-20","genres":["Terror","Suspense","Acción","Aventura"],"type":"movie","platforms":[],"tmdbId":396535,"runtime":"$undefined","seasons":"$undefined"},{"id":10681,"title":"WALL·E: Batallón de limpieza","originalTitle":"WALL·E: Batallón de limpieza","overview":"En el año 2800, en un planeta Tierra devastado y sin vida, tras cientos de solitarios años haciendo aquello para lo que fue construido -limpiar el planeta de basura- el pequeño robot WALL•E descubre una nueva misión en su vida cuando se encuentra con una moderna y lustrosa robot exploradora llamada EVE. Ambos viajarán a lo largo de la galaxia y vivirán una emocionante e inolvidable aventura.","posterPath":"https://image.tmdb.org/t/p/w500/5CXpoYB2YAZRPBcv9pjkgR6tZ0X.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/nYs4ZwnJBK4AgljhvzwNz7fpr3E.jpg","voteAverage":8.1,"voteCount":20225,"releaseDate":"2008-06-26","genres":["Animación","Familia","Ciencia ficción"],"type":"movie","platforms":[],"tmdbId":10681,"runtime":"$undefined","seasons":"$undefined"},{"id":105,"title":"Regreso al futuro","originalTitle":"Regreso al futuro","overview":"El adolescente Marty McFly es amigo de Doc, un científico al que todos toman por loco. Cuando Doc crea una máquina para viajar en el tiempo, un error fortuito hace que Marty llegue a 1955, año en el que sus futuros padres aún no se habían conocido. Después de impedir su primer encuentro, deberá conseguir que se conozcan y se casen; de lo contrario, su existencia no sería posible.","posterPath":"https://image.tmdb.org/t/p/w500/owk40tn1sFJmC7bhamEpmhdZPKa.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/5bzPWQ2dFUl2aZKkp7ILJVVkRed.jpg","voteAverage":8.3,"voteCount":21758,"releaseDate":"1985-07-03","genres":["Aventura","Comedia","Ciencia ficción"],"type":"movie","platforms":[],"tmdbId":105,"runtime":"$undefined","seasons":"$undefined"},{"id":9312,"title":"Mortal Kombat","originalTitle":"Mortal Kombat","overview":"Durante nueve generaciones, Shang Tsung, un brujo malvado, ha llevado a un poderoso príncipe a la victoria contra sus mortales enemigos. Si vence el décimo torneo Mortal Kombat, la desolación y el mal que han florecido en el mundo exterior reinarán la Tierra por siempre.","posterPath":"https://image.tmdb.org/t/p/w500/yQA2tNUex9usFP4Tp6NEuZNGtxN.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/dfU9xyEEyLxvZ5unTn05Whm9Lce.jpg","voteAverage":5.9,"voteCount":2528,"releaseDate":"1995-08-18","genres":["Acción","Fantasía"],"type":"movie","platforms":[],"tmdbId":9312,"runtime":"$undefined","seasons":"$undefined"},{"id":674,"title":"Harry Potter y el cáliz de fuego","originalTitle":"Harry Potter y el cáliz de fuego","overview":"En el cuarto año en Hogwarts, Harry se enfrenta al mayor de los desafíos y peligros de la saga. Cuando es elegido bajo misteriosas circunstancias como el competidor que representará a Hogwarts en el Torneo Triwizard, Harry deberá competir contra los mejores jóvenes magos de toda Europa. Pero mientras se prepara, aparecen pruebas que manifiestan que Lord Voldemort ha regresado. Antes de darse cuenta, Harry no solo estará luchando por el campeonato sino también por su vida","posterPath":"https://image.tmdb.org/t/p/w500/5hrrncgY7GfRHz6JmnhPlvJUONe.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/1OV7hau4D3rWGS5bu8sqBYeVpe.jpg","voteAverage":7.8,"voteCount":22119,"releaseDate":"2005-11-16","genres":["Aventura","Fantasía"],"type":"movie","platforms":[],"tmdbId":674,"runtime":"$undefined","seasons":"$undefined"},{"id":1726,"title":"Iron Man","originalTitle":"Iron Man","overview":"El multimillonario fabricante de armas Tony Stark debe enfrentarse a su turbio pasado después de sufrir un accidente con una de sus armas. Equipado con una armadura de última generación tecnológica, se convierte en 'El hombre de hierro' para combatir el mal a escala global.","posterPath":"https://image.tmdb.org/t/p/w500/tFCTNx7foAsUQpgu2x1KjAJD1wT.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/cKvDv2LpwVEqbdXWoQl4XgGN6le.jpg","voteAverage":7.7,"voteCount":28089,"releaseDate":"2008-04-30","genres":["Acción","Ciencia ficción","Aventura"],"type":"movie","platforms":[],"tmdbId":1726,"runtime":"$undefined","seasons":"$undefined"},{"id":58,"title":"Piratas del Caribe: El cofre del hombre muerto","originalTitle":"Piratas del Caribe: El cofre del hombre muerto","overview":"Will Turner y Elizabeth Swann se van a casar, pero ambos son hechos prisioneros por Lord Cutler Beckett y acusados de haber liberado al capitán Jack Sparrow. Para salvar su vida, Will tendrá que encontrar a Jack y conseguir su misteriosa brújula. Esta esconde un gran poder, además de la clave de una deuda de sangre del pirata con un temible y siniestro Davy Jones, el legendario capitán del barco fantasma Holandés Errante.","posterPath":"https://image.tmdb.org/t/p/w500/7L7H6sHAt48EfwsqFaa0dw2NJhz.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/vr6n6ZFUZvedvIlhfYcbCWcaKyW.jpg","voteAverage":7.4,"voteCount":17117,"releaseDate":"2006-07-06","genres":["Aventura","Fantasía","Acción"],"type":"movie","platforms":[],"tmdbId":58,"runtime":"$undefined","seasons":"$undefined"},{"id":939243,"title":"Sonic 3: La película","originalTitle":"Sonic 3: La película","overview":"Sonic, Knuckles y Tails se reúnen para enfrentarse a un nuevo y poderoso adversario, Shadow, un misterioso villano cuyos poderes no se parecen a nada de lo que nuestros héroes han conocido hasta ahora. Con sus facultades superadas en todos los sentidos, el Equipo Sonic tendrá que establecer una insólita alianza con la esperanza de detener a Shadow y proteger el planeta.","posterPath":"https://image.tmdb.org/t/p/w500/3aDWCRXLYOCuxjrjiPfLd79tcI6.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/zOpe0eHsq0A2NvNyBbtT6sj53qV.jpg","voteAverage":7.6,"voteCount":3264,"releaseDate":"2024-12-19","genres":["Acción","Ciencia ficción","Comedia","Familia"],"type":"movie","platforms":[],"tmdbId":939243,"runtime":"$undefined","seasons":"$undefined"},{"id":76600,"title":"Avatar: El sentido del agua","originalTitle":"Avatar: El sentido del agua","overview":"Más de una década después de los acontecimientos de 'Avatar', los Na'vi Jake Sully, Neytiri y sus hijos viven en paz en los bosques de Pandora hasta que regresan los hombres del cielo. Entonces comienzan los problemas que persiguen sin descanso a la familia Sully, que decide hacer un gran sacrificio para mantener a su pueblo a salvo y seguir ellos con vida.","posterPath":"https://image.tmdb.org/t/p/w500/ckeTumMS4G31UQ9NNkmtW2QhfMF.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/kJsPVzdyBrYHLomuNv5SJDXUQ2f.jpg","voteAverage":7.6,"voteCount":14090,"releaseDate":"2022-12-14","genres":["Acción","Aventura","Ciencia ficción"],"type":"movie","platforms":[],"tmdbId":76600,"runtime":"$undefined","seasons":"$undefined"},{"id":22,"title":"Piratas del Caribe: La maldición de la Perla Negra","originalTitle":"Piratas del Caribe: La maldición de la Perla Negra","overview":"El aventurero capitán Jack Sparrow recorre las aguas caribeñas. Pero su andanzas terminan cuando su enemigo, el capitán Barbossa le roba su barco, la Perla Negra, y ataca la ciudad de Port Royal, secuestrando a Elizabeth Swann, hija del gobernador. Will Turner, el amigo de la infancia de Elizabeth, se une a Jack para rescatarla y recuperar la Perla Negra. Pero el prometido de Elizabeth, comodoro Norrington, les persigue a bordo del HMS Impávido. Además, Barbossa y su tripulación son víctimas de un conjuro por el que están condenados a vivir eternamente, y a transformarse cada noche en esqueletos vivientes, en fantasmas guerreros.","posterPath":"https://image.tmdb.org/t/p/w500/bVG48kmXuLaZYgPfSCmhs6EYFbX.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/uRNgkJSkNBFbbn9fPsEjDIy8Sh3.jpg","voteAverage":7.8,"voteCount":22182,"releaseDate":"2003-07-09","genres":["Aventura","Fantasía","Acción"],"type":"movie","platforms":[],"tmdbId":22,"runtime":"$undefined","seasons":"$undefined"},{"id":564,"title":"La momia","originalTitle":"La momia","overview":"El legionario Rick O'Connell y su socio descubren durante una batalla en Egipto las ruinas de Hamunaptra, la ciudad de los muertos. Pasado un tiempo, este descubrimiento le permitirá salvar su vida y volver al lugar con una egiptóloga y su hermano, donde coinciden con un grupo de americanos. Todos ellos, seducidos por la aventura, provocarán la resurrección de la momia de un diabólico sacerdote egipcio que intenta desesperadamente recuperar a su amada.","posterPath":"https://image.tmdb.org/t/p/w500/aGRMxB5ve2nSKsq8ww6PyUwhWpP.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/8zLS8p1tRyWFLRFfmgQq0j5WE6z.jpg","voteAverage":7,"voteCount":9964,"releaseDate":"1999-04-16","genres":["Aventura","Acción","Fantasía"],"type":"movie","platforms":[],"tmdbId":564,"runtime":"$undefined","seasons":"$undefined"},{"id":385687,"title":"Fast & Furious X","originalTitle":"Fast & Furious X","overview":"Durante numerosas misiones más que imposibles, Dom Toretto y su familia han sido capaces de ser más listos, de tener más valor y de ir más rápido que cualquier enemigo que se cruzara con ellos. Pero ahora tendrán que enfrentarse al oponente más letal que jamás hayan conocido: Un terrible peligro que resurge del pasado, que se mueve por una sangrienta sed de venganza y que está dispuesto a destrozar a la familia y destruir para siempre todo lo que a Dom le importa.","posterPath":"https://image.tmdb.org/t/p/w500/3P9QvWVN02Etn4kYGC702WVoXEb.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/4XM8DUTQb3lhLemJC51Jx4a2EuA.jpg","voteAverage":7,"voteCount":6302,"releaseDate":"2023-05-17","genres":["Acción","Crimen","Suspense"],"type":"movie","platforms":[],"tmdbId":385687,"runtime":"$undefined","seasons":"$undefined"},{"id":324857,"title":"Spider-Man: un nuevo universo","originalTitle":"Spider-Man: un nuevo universo","overview":"En un universo paralelo donde Peter Parker ha muerto, un joven de secundaria llamado Miles Morales es el nuevo Spider-Man. Sin embargo, cuando el líder mafioso Wilson Fisk construye el 'Super Colisionador' trae a una versión alternativa de Peter Parker que tratará de enseñar a Miles como ser un mejor Spider-Man. Pero no será el único Spider Man en entrar a este universo:  cuatro versiones alternativas buscan regresar a su universo antes de que toda la realidad se colapse.","posterPath":"https://image.tmdb.org/t/p/w500/xRMZikjAHNFebD1FLRqgDZeGV4a.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/8mnXR9rey5uQ08rZAvzojKWbDQS.jpg","voteAverage":8.4,"voteCount":17189,"releaseDate":"2018-12-06","genres":["Animación","Acción","Aventura","Ciencia ficción"],"type":"movie","platforms":[],"tmdbId":324857,"runtime":"$undefined","seasons":"$undefined"},{"id":218,"title":"Terminator","originalTitle":"Terminator","overview":"Un cyborg ha sido enviado desde el futuro en una misión mortal: eliminar a Sarah Connor, una joven cuya vida tendrá una gran importancia en los próximos años. Sarah tiene sólo un protector —Kyle Reese— también enviado desde el futuro. El Terminator utiliza su inteligencia excepcional y fuerza para encontrar a Sarah, pero ¿hay alguna forma de detener al cyborg aparentemente indestructible?","posterPath":"https://image.tmdb.org/t/p/w500/9KI49SBnwAOzGcMw1onIki7vd2.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/ffdqHMWkh1h9MABwIfbfRJhgFW6.jpg","voteAverage":7.7,"voteCount":14567,"releaseDate":"1984-10-26","genres":["Acción","Suspense","Ciencia ficción"],"type":"movie","platforms":[],"tmdbId":218,"runtime":"$undefined","seasons":"$undefined"},{"id":216015,"title":"Cincuenta sombras de Grey","originalTitle":"Cincuenta sombras de Grey","overview":"Cuando la estudiante de Literatura Anastasia Steele recibe el encargo de entrevistar al exitoso y joven empresario Christian Grey, queda impresionada al encontrarse ante un hombre atractivo, seductor y también muy intimidante. La inexperta e inocente Ana intenta olvidarle, pero pronto comprende cuánto le desea. Cuando la pareja por fin inicia una apasionada relación, Ana se sorprende por las peculiares prácticas eróticas de Grey, al tiempo que descubre los límites de sus propios y más oscuros deseos.","posterPath":"https://image.tmdb.org/t/p/w500/mNZcZOIlTwDKd30xLnRR4p0ZELg.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/7IGKrY1f1KfwMipx9wZC4NRgIdF.jpg","voteAverage":5.9,"voteCount":12364,"releaseDate":"2015-02-11","genres":["Drama","Romance","Suspense"],"type":"movie","platforms":[],"tmdbId":216015,"runtime":"$undefined","seasons":"$undefined"},{"id":198663,"title":"El corredor del laberinto","originalTitle":"El corredor del laberinto","overview":"Thomas abre los ojos y se da cuenta que está en un ascensor. Lo extraño es que no recuerda nada, ni dónde está, ni quién es. Lo único que aún permanece intacto en su memoria es su nombre, y ya es mucho. Antes de que le dé tiempo a cuestionarse algo sobre sí mismo las puertas se abrirán y aparecerá ante él un extraño mundo. Todo lo que ve son chicos de su edad que tienen su mismo estado de amnesia. Una aventura fantástica que pronto destapará la dura realidad bajo ese velo de incertidumbre: todos ellos están atrapados en un laberinto. Si quieren tener alguna posibilidad de salir de allí y recuperar su antigua vida y aquello que no son capaces de recordar deberán unir fuerzas para escapar. Un mundo post-apocalíptico que les acorralará e irá un paso por delante será el desafío que tengan que pasar estos jóvenes por la libertad.","posterPath":"https://image.tmdb.org/t/p/w500/egKi4jZKKVZzR8NaaNjEwMpEgHs.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/eTlcNXGv32zkVI7ZDHhfeaKHXKQ.jpg","voteAverage":7.2,"voteCount":18068,"releaseDate":"2014-09-10","genres":["Acción","Misterio","Ciencia ficción","Suspense"],"type":"movie","platforms":[],"tmdbId":198663,"runtime":"$undefined","seasons":"$undefined"},{"id":98,"title":"Gladiator","originalTitle":"Gladiator","overview":"En el año 180, el Imperio Romano domina todo el mundo conocido. Tras una gran victoria sobre los bárbaros del norte, el anciano emperador Marco Aurelio decide transferir el poder a Máximo, bravo general de sus ejércitos y hombre de inquebrantable lealtad al imperio. Pero su hijo Cómodo, que aspiraba al trono, no lo acepta y trata de asesinar a Máximo.","posterPath":"https://image.tmdb.org/t/p/w500/90QFOG5zSN4cbrIVs4DL4ePAuA5.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/jhk6D8pim3yaByu1801kMoxXFaX.jpg","voteAverage":8.2,"voteCount":20839,"releaseDate":"2000-05-04","genres":["Acción","Drama","Aventura"],"type":"movie","platforms":[],"tmdbId":98,"runtime":"$undefined","seasons":"$undefined"},{"id":72190,"title":"Guerra Mundial Z","originalTitle":"Guerra Mundial Z","overview":"Cuando el mundo comienza a ser invadido por una legión de muertos vivientes, Gerry Lane, un experto investigador de las Naciones Unidas, intentará evitar el fin de la civilización en una carrera contra el tiempo y el destino. La destrucción a la que se ve sometida la raza humana lo lleva a recorrer el mundo entero buscando la solución para frenar esa horrible epidemia.","posterPath":"https://image.tmdb.org/t/p/w500/a8ogjWFd0QS6BzBkzfDMWukc26i.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/31VpBgUX5O4Z3dn5ZbX8HLqoXH3.jpg","voteAverage":6.8,"voteCount":16504,"releaseDate":"2013-06-19","genres":["Acción","Terror","Ciencia ficción","Suspense"],"type":"movie","platforms":[],"tmdbId":72190,"runtime":"$undefined","seasons":"$undefined"},{"id":20352,"title":"Gru Mi villano favorito","originalTitle":"Gru Mi villano favorito","overview":"En una alegre urbanización con cuidados jardines rodeados por verjas de madera pintadas de blanco y llenos de rosales, sobresale una casa negra con el césped amarillento. Los vecinos ignoran que debajo de la vivienda hay un enorme escondite secreto. Allí está Gru, rodeado por un pequeño ejército de lacayos, planeando el mayor robo de toda la historia. ¡Va a hacerse con la luna!","posterPath":"https://image.tmdb.org/t/p/w500/AsaaPLSfisdFDeasEd9r0GiZVss.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/2XSeKDmIa2KxaiJy4J9e8FrIZhk.jpg","voteAverage":7.3,"voteCount":16030,"releaseDate":"2010-07-08","genres":["Animación","Comedia","Crimen","Familia","Ciencia ficción"],"type":"movie","platforms":[],"tmdbId":20352,"runtime":"$undefined","seasons":"$undefined"},{"id":18240,"title":"La proposición","originalTitle":"La proposición","overview":"Margaret es una poderosa y estricta editora de gran éxito de Nueva York que, por un problema con su visado, de repente se enfrenta a ser deportada a Canadá, su país de origen. Para evitarlo y poder mantener su visa en Estados Unidos, la astuta ejecutiva declara que está comprometida con su joven asistente Andrew, al que lleva torturando durante años. Andrew acepta participar en la farsa, pero con algunas condiciones. La \"pareja\" se dirige entonces a Alaska a conocer la peculiar familia de él, y la ejecutiva de ciudad, acostumbrada a tener todo bajo control, se encuentra inmersa en situaciones surrealistas que escapan a cualquier lógica conocida. Con planes de boda en camino y un agente de inmigración tras sus pasos, Margaret y Andrew se comprometen a seguir con el plan previsto pese a las consecuencias.","posterPath":"https://image.tmdb.org/t/p/w500/bkbzlLA8HCEHRDxsTKGthII0BpW.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/ojgXOhVi9Yk8irDpRfDkIzdD1LK.jpg","voteAverage":7.1,"voteCount":7458,"releaseDate":"2009-06-02","genres":["Comedia","Romance","Drama"],"type":"movie","platforms":[],"tmdbId":18240,"runtime":"$undefined","seasons":"$undefined"},{"id":603692,"title":"John Wick 4","originalTitle":"John Wick 4","overview":"John Wick descubre un camino para derrotar a la Alta Mesa. Pero para poder ganar su libertad, Wick deberá enfrentarse a un nuevo rival con poderosas alianzas en todo el mundo, capaz de convertir a viejos amigos en enemigos.","posterPath":"https://image.tmdb.org/t/p/w500/mj2Z9HnRSIEk3n7yVPoOY4Uzzfh.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/7I6VUdPj6tQECNHdviJkUHD2u89.jpg","voteAverage":7.7,"voteCount":7890,"releaseDate":"2023-03-21","genres":["Acción","Suspense","Crimen"],"type":"movie","platforms":[],"tmdbId":603692,"runtime":"$undefined","seasons":"$undefined"},{"id":12445,"title":"Harry Potter y las Reliquias de la Muerte - Parte 2","originalTitle":"Harry Potter y las Reliquias de la Muerte - Parte 2","overview":"La segunda parte de la batalla final entre las fuerzas del bien y el mal. El juego nunca ha sido tan peligroso y nadie está a salvo. Se acerca el momento de la confrontación final entre Harry Potter y Lord Voldemort. Todo termina aquí…","posterPath":"https://image.tmdb.org/t/p/w500/aM1TuUiPtV8OAZyu61CTdy9Ymtk.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/cbcpDn6XJaIGoOil1bKuskU8ds4.jpg","voteAverage":8.1,"voteCount":21942,"releaseDate":"2011-07-12","genres":["Aventura","Fantasía"],"type":"movie","platforms":[],"tmdbId":12445,"runtime":"$undefined","seasons":"$undefined"},{"id":337167,"title":"Cincuenta sombras liberadas","originalTitle":"Cincuenta sombras liberadas","overview":"Creyendo que han dejado atrás las sombras del pasado, Christian y Anastasia disfrutan de su relación y de su vida llena de lujos. Pero justo cuando Ana empieza a relajarse, aparecen nuevas amenazas que ponen en riesgo su felicidad.","posterPath":"https://image.tmdb.org/t/p/w500/sM8hwgWZlmZf0h4aOkNopb3HBIo.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/9ywA15OAiwjSTvg3cBs9B7kOCBF.jpg","voteAverage":6.7,"voteCount":8338,"releaseDate":"2018-01-17","genres":["Drama","Romance"],"type":"movie","platforms":[],"tmdbId":337167,"runtime":"$undefined","seasons":"$undefined"},{"id":12,"title":"Buscando a Nemo","originalTitle":"Buscando a Nemo","overview":"Nemo, un pececillo, hijo único muy querido y protegido por su padre, ha sido capturado en un arrecife australiano y ahora vive en una pecera en la oficina de un dentista de Sidney. El tímido padre de Nemo se embarcará en una peligrosa aventura para rescatar a su hijo. Pero Nemo y sus nuevos amigos tienen también un astuto plan para escapar de la pecera y volver al mar.","posterPath":"https://image.tmdb.org/t/p/w500/jPhak722pNGxQIXSEfeWIUqBrO5.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/eCynaAOgYYiw5yN5lBwz3IxqvaW.jpg","voteAverage":7.8,"voteCount":20515,"releaseDate":"2003-05-30","genres":["Animación","Familia","Aventura"],"type":"movie","platforms":[],"tmdbId":12,"runtime":"$undefined","seasons":"$undefined"},{"id":675,"title":"Harry Potter y la Orden del Fénix","originalTitle":"Harry Potter y la Orden del Fénix","overview":"Harry Potter regresa por quinto año a Hogwarts aún sacudido por la tragedia ocurrida en el Torneo de los Tres Magos. Debido a que el Ministro de la Magia niega el regreso de Lord Voldemort, Harry se convierte en el centro de atención de la comunidad mágica. Mientras lucha con sus problemas en el colegio, incluyendo a la nueva profesora Dolores Umbridge, intentará aprender más sobre la misteriosa Orden del Fénix.","posterPath":"https://image.tmdb.org/t/p/w500/xxXiM2Ij7plbzibKWW9BfDk23aI.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/pkxPkHOPJjOvzfQOclANEBT8OfK.jpg","voteAverage":7.7,"voteCount":20763,"releaseDate":"2007-07-08","genres":["Aventura","Fantasía"],"type":"movie","platforms":[],"tmdbId":675,"runtime":"$undefined","seasons":"$undefined"},{"id":106646,"title":"El lobo de Wall Street","originalTitle":"El lobo de Wall Street","overview":"Película basada en hechos reales del corredor de bolsa neoyorquino Jordan Belfort. A mediados de los años 80, Belfort era un joven honrado que perseguía el sueño americano, pero pronto en la agencia de valores aprendió que lo más importante no era hacer ganar a sus clientes, sino ser ambicioso y ganar una buena comisión. Su enorme éxito y fortuna le valió el mote de \"El lobo de Wall Street\". Dinero. Poder. Mujeres. Drogas. Las tentaciones abundaban y el temor a la ley era irrelevante. Jordan y su manada de lobos consideraban que la discreción era una cualidad anticuada; nunca se conformaban con lo que tenían.","posterPath":"https://image.tmdb.org/t/p/w500/uthRoUeTtiep5HCoySlOjQSPCbJ.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/7Nwnmyzrtd0FkcRyPqmdzTPppQa.jpg","voteAverage":8,"voteCount":25873,"releaseDate":"2013-12-25","genres":["Crimen","Drama","Comedia"],"type":"movie","platforms":[],"tmdbId":106646,"runtime":"$undefined","seasons":"$undefined"},{"id":1495,"title":"El reino de los cielos","originalTitle":"El reino de los cielos","overview":"Balián de Ibelín viaja a Jerusalén durante las cruzadas del siglo XII, donde será el defensor de su pueblo.","posterPath":"https://image.tmdb.org/t/p/w500/pIrjgBmZYnwKvx4WoTkhyhKSHTp.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/kP8rK9dGS1pr0HrnmXfIi2heWjo.jpg","voteAverage":7,"voteCount":4925,"releaseDate":"2005-05-03","genres":["Drama","Acción","Aventura","Historia","Bélica"],"type":"movie","platforms":[],"tmdbId":1495,"runtime":"$undefined","seasons":"$undefined"},{"id":18785,"title":"Resacón en Las Vegas","originalTitle":"Resacón en Las Vegas","overview":"\"The Hangover\" es la historia de una desmadrada despedida de soltero en la que el futuro novio y sus tres amigos, dos días antes de la boda, se montan la juerga padre en Las Vegas. Doug viaja a la ciudad del juego con sus mejores amigos Phil y Stu, así como su futuro cuñado Alan. La juerga es de campeonato y, como era de esperar, a la mañana siguiente tienen una resaca monumental. El problema es que, siendo incapaces de recordar nada de lo ocurrido durante la noche anterior, se encuentran con que el prometido ha desaparecido, topándose en su lugar con otras dos sorpresas en la suite del hotel: un tigre y un bebé.","posterPath":"https://image.tmdb.org/t/p/w500/rqeim09TdaflSvPNVnCTBjUHlKu.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/iuRVt8tFiXDPGgzavhuSa3QHRxD.jpg","voteAverage":7.3,"voteCount":18067,"releaseDate":"2009-06-02","genres":["Comedia"],"type":"movie","platforms":[],"tmdbId":18785,"runtime":"$undefined","seasons":"$undefined"},{"id":863,"title":"Toy Story 2","originalTitle":"Toy Story 2","overview":"Cuando Andy se va de campamento dejando solos a los juguetes, Al McWhiggin, un compulsivo coleccionista de juguetes valiosos, secuestra a Woody. Buzz Lightyear y el resto de los juguetes de Andy deberán actuar con rapidez para rescatarlo, poniéndose al frente de una operación de rescate durante la cual se enfrentarán a múltiples peligros y divertidas situaciones.","posterPath":"https://image.tmdb.org/t/p/w500/8OTDKkJv2jXg5ZHKazFxBAttKkR.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/7iUDfakacY1HpajP1DtHrCuDB95.jpg","voteAverage":7.6,"voteCount":14850,"releaseDate":"1999-10-30","genres":["Animación","Comedia","Familia"],"type":"movie","platforms":[],"tmdbId":863,"runtime":"$undefined","seasons":"$undefined"},{"id":11324,"title":"Shutter Island","originalTitle":"Shutter Island","overview":"Verano de 1954. Los agentes judiciales Teddy Daniels y Chuck Aule son destinados a una remota isla del puerto de Boston para investigar la desaparición de una peligrosa asesina recluida en el hospital psiquiátrico Ashecliffe, un centro penitenciario para criminales perturbados dirigido por el siniestro doctor John Cawley. Pronto descubrirán que el centro guarda muchos secretos, y que la isla esconde algo más peligroso que los pacientes.","posterPath":"https://image.tmdb.org/t/p/w500/56utveUWJwmG12YU7c2zKw6pbRZ.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/rbZvGN1A1QyZuoKzhCw8QPmf2q0.jpg","voteAverage":8.2,"voteCount":25787,"releaseDate":"2010-02-14","genres":["Drama","Suspense","Misterio"],"type":"movie","platforms":[],"tmdbId":11324,"runtime":"$undefined","seasons":"$undefined"},{"id":11036,"title":"El diario de Noa","originalTitle":"El diario de Noa","overview":"En una residencia de ancianos, un hombre mayor lee a una mujer una historia de amor escrita en su viejo libro de notas. El libro cuenta la vida en los años 40 de Noah Calhoun y Allie Nelson, dos jóvenes adolescentes de Carolina del Norte que, a pesar de vivir en dos ambientes sociales muy diferentes, pasaron un verano idílico juntos y profundamente enamorados, antes de ser separados, primero por sus padres, y más tarde por la Segunda Guerra Mundial.","posterPath":"https://image.tmdb.org/t/p/w500/gFCnDKfsZWzyv9sweizVC4EWn06.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/zdXnJqBaGFVtLoPNuMeKfEYUViZ.jpg","voteAverage":7.9,"voteCount":12520,"releaseDate":"2004-06-25","genres":["Romance","Drama"],"type":"movie","platforms":[],"tmdbId":11036,"runtime":"$undefined","seasons":"$undefined"},{"id":672,"title":"Harry Potter y la cámara secreta","originalTitle":"Harry Potter y la cámara secreta","overview":"Harry regresa a su segundo año a Hogwarts, pero descubre que cosas malas ocurren debido a que un sitio llamado la Cámara de los Secretos ha sido abierto por el heredero de Slytherin y hará que los hijos de muggles, los impuros, aparezcan petrificados misteriosamente por un animal monstruoso.","posterPath":"https://image.tmdb.org/t/p/w500/bhCfAzeMMg7GyLDT11yVM2i1NPh.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/1stUIsjawROZxjiCMtqqXqgfZWC.jpg","voteAverage":7.7,"voteCount":23531,"releaseDate":"2002-11-13","genres":["Aventura","Fantasía"],"type":"movie","platforms":[],"tmdbId":672,"runtime":"$undefined","seasons":"$undefined"},{"id":12444,"title":"Harry Potter y las Reliquias de la Muerte - Parte 1","originalTitle":"Harry Potter y las Reliquias de la Muerte - Parte 1","overview":"Una tarea casi imposible cae sobre los hombros de Harry: deberá encontrar y destruir los horrocruxes restantes para dar fin al reinado de Lord Voldemort. En el episodio final de la saga, el hechicero de 17 años parte junto con sus amigos Hermione Granger y Ron Weasley en un peligroso viaje por Inglaterra para encontrar los objetos que contienen los fragmentos del alma del Señor Tenebroso, los cuales garantizan su longevidad. Pero el camino no será fácil pues el lado oscuro adquiere más poder con cada minuto que pasa y las lealtades serán puestas a prueba. Harry deberá usar todos los conocimientos que gracias a Dumbledore ha adquirido sobre su enemigo para poder encontrar la forma de sobrevivir a esta última aventura.","posterPath":"https://image.tmdb.org/t/p/w500/w6wsYKdXERaXRdByPsI2O9rn20b.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/vcrgU0KaNj5mKUCIQSUdiQwTE9y.jpg","voteAverage":7.7,"voteCount":20337,"releaseDate":"2010-11-17","genres":["Aventura","Fantasía"],"type":"movie","platforms":[],"tmdbId":12444,"runtime":"$undefined","seasons":"$undefined"},{"id":1643,"title":"El último tango en París","originalTitle":"El último tango en París","overview":"Una mañana de invierno un hombre y una muchacha se encuentran casualmente mientras visitan un piso de alquiler en París. La pasión se apodera de ellos y hacen el amor violentamente en el piso vacío. Cuando abandonan el edificio, se ponen de acuerdo para volver a encontrarse allí, en soledad, sin preguntarse ni siquiera sus nombres.","posterPath":"https://image.tmdb.org/t/p/w500/2G1j1RWBvmWc8f0HXjRZnn0ZlgD.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/hExTiLbfB93HwEwkeQxb3q4nHtQ.jpg","voteAverage":6.9,"voteCount":1340,"releaseDate":"1972-12-15","genres":["Drama","Romance"],"type":"movie","platforms":[],"tmdbId":1643,"runtime":"$undefined","seasons":"$undefined"},{"id":181808,"title":"Star Wars: Los últimos Jedi","originalTitle":"Star Wars: Los últimos Jedi","overview":"La malvada Primera Orden se ha vuelto más poderosa y tiene contra las cuerdas a la Resistencia, liderada por la General Leia Organa. El piloto Poe Dameron encabeza una misión para intentar destruir un acorazado de la Primera Orden. Mientras tanto, la joven Rey tendrá que definir su futuro y su vocación, y el viejo jedi Luke Skywalker revaluar el significado de su vida.","posterPath":"https://image.tmdb.org/t/p/w500/7SNzh1fY3YJ8Y8MX93pZF5cJHaH.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/bIUaCtWaRgd78SnoHJDI8TNf7Sd.jpg","voteAverage":6.8,"voteCount":16306,"releaseDate":"2017-12-13","genres":["Aventura","Acción","Ciencia ficción"],"type":"movie","platforms":[],"tmdbId":181808,"runtime":"$undefined","seasons":"$undefined"},{"id":109445,"title":"Frozen: El reino del hielo","originalTitle":"Frozen: El reino del hielo","overview":"Cuando una profecía condena a un reino a un invierno eterno, Anna, una joven optimista se une a un temerario montañero llamado Kristoff y a su compinche el reno Sven. Juntos emprenden un viaje épico en busca de Elsa, hermana de Anna y reina de Las Nieves para poner fin al gélido hechizo.","posterPath":"https://image.tmdb.org/t/p/w500/sGNuWC4BwqOB4l0tkbKwLy70tXC.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/rj58WQ9ImI0mYDptXdM7euX1Wjt.jpg","voteAverage":7.2,"voteCount":17548,"releaseDate":"2013-11-20","genres":["Animación","Familia","Aventura","Fantasía"],"type":"movie","platforms":[],"tmdbId":109445,"runtime":"$undefined","seasons":"$undefined"},{"id":561,"title":"Constantine","originalTitle":"Constantine","overview":"John Constantine ha estado en el infierno y ha vuelto. Nació con un don que no deseaba, la capacidad de reconocer claramente a los ángeles y a los demonios que andan por la tierra bajo un aspecto humano, Constantine se vio empujado al suicido para escapar de la atormentadora claridad de su visión. Pero fracasó. Ahora, marcado por su intento de suicidio, patrulla la frontera terrenal entre el cielo y el infierno, esperando en vano ganarse el camino a la salvación enviando a los esbirros de Luciffer de vuelta al averno. Cuando una desesperada pero escéptica detective de policía consigue su ayuda para resolver la misteriosa muerte de su querida hermana gemela, su investigación les lleva a través del mundo de demonios y ángeles que subyace justo bajo el paisaje de la actual ciudad de Los Angeles. Atrapados en una catastrófica serie de acontecimientos sobrenaturales, los dos se encuentran inextricablemente involucrados y tratan de encontrar su propia paz a cualquier precio.","posterPath":"https://image.tmdb.org/t/p/w500/oj0s9jvCyMSCMvw7pNWt7nELykW.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/z9qFZHT8K7tG2PlpKBSAqlmGST8.jpg","voteAverage":7.1,"voteCount":8050,"releaseDate":"2005-02-08","genres":["Fantasía","Acción","Terror"],"type":"movie","platforms":[],"tmdbId":561,"runtime":"$undefined","seasons":"$undefined"},{"id":7131,"title":"Van Helsing","originalTitle":"Van Helsing","overview":"Siglo XIX. En medio de los montes de los Cárpatos está la misteriosa y mítica Transilvania, donde el mal siempre está presente, el peligro aparece cuando el sol se pone... y donde toman forma los monstruos que habitan las pesadillas de los hombres.","posterPath":"https://image.tmdb.org/t/p/w500/fqorDWIwBBwMvLTZXxUWgrEyGWy.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/d72ROyJqXQtw2OupW0l15eicRAF.jpg","voteAverage":6.4,"voteCount":6631,"releaseDate":"2004-05-03","genres":["Terror","Aventura","Acción"],"type":"movie","platforms":[],"tmdbId":7131,"runtime":"$undefined","seasons":"$undefined"},{"id":429617,"title":"Spider-Man: Lejos de casa","originalTitle":"Spider-Man: Lejos de casa","overview":"Peter Parker decide irse junto a MJ, Ned y el resto de sus amigos a pasar unas vacaciones a Europa. Sin embargo, el plan de Parker por dejar de lado sus superpoderes durante unas semanas se ven truncados cuando Nick Fury contacta con él para solicitarle ayuda para frenar el ataque de unas criaturas elementales que están causando el caos en el continente. En ese momento, Parker vuelve a ponerse el traje de Spider-Man para cumplir con su labor.","posterPath":"https://image.tmdb.org/t/p/w500/o59zDVJDIehGcWZsMUGU5SN0V0D.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/34jW8LvjRplM8Pv06cBFDpLlenR.jpg","voteAverage":7.4,"voteCount":16919,"releaseDate":"2019-06-28","genres":["Acción","Aventura","Ciencia ficción"],"type":"movie","platforms":[],"tmdbId":429617,"runtime":"$undefined","seasons":"$undefined"},{"id":425,"title":"Ice Age: La edad de hielo","originalTitle":"Ice Age: La edad de hielo","overview":"Hace muchos, muchos años, tantos como 20.000, una pequeña ardirata de nombre Scrat quería esconder una bellota en el hielo. Pero lo que hace es provocar una semicatástrofe que provoca que todos los animales migren hacia el sur, hacia tierras más cálidas. Bueno, lo que se dice todos, todos, no. Porque hay uno que lleva la contraria: se trata del mamut Manfred, un auténtico lobo solitario vagabundo y soberbio que va hacia el norte sólo porque los demás están yendo hacia el sur.","posterPath":"https://image.tmdb.org/t/p/w500/9rpdhn7p7mDZW2rUXsINf9c6sR5.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/8pwIhymsxfAVjrAE7syDjQULn37.jpg","voteAverage":7.4,"voteCount":14256,"releaseDate":"2002-03-14","genres":["Animación","Comedia","Familia","Aventura"],"type":"movie","platforms":[],"tmdbId":425,"runtime":"$undefined","seasons":"$undefined"},{"id":16869,"title":"Malditos bastardos","originalTitle":"Malditos bastardos","overview":"Segunda Guerra Mundial. Durante la ocupación de Francia por los alemanes, Shosanna Dreyfus presencia la ejecución de su familia por orden del coronel nazi Hans Landa. Ella consigue huir a París, donde adopta una nueva identidad como propietaria de un cine. En otro lugar de Europa, el teniente Aldo Raine adiestra a un grupo de soldados judíos \"Los bastardos\" para atacar objetivos concretos. Los hombres de Raine y una actriz alemana, que trabaja para los aliados, deben llevar a cabo una misión que hará caer a los jefes del Tercer Reich. El destino quiere que todos se encuentren bajo la marquesina de un cine donde Shosanna espera para vengarse.","posterPath":"https://image.tmdb.org/t/p/w500/dqu7nUtKTLdpM7DaJvD4zcSXhn1.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/hwNtEmmugU5Yd7hpfprNWI0DGIn.jpg","voteAverage":8.2,"voteCount":24128,"releaseDate":"2009-08-02","genres":["Drama","Suspense","Bélica"],"type":"movie","platforms":[],"tmdbId":16869,"runtime":"$undefined","seasons":"$undefined"},{"id":76341,"title":"Mad Max: Furia en la carretera","originalTitle":"Mad Max: Furia en la carretera","overview":"Perseguido por su turbulento pasado, Mad Max cree que la mejor forma de sobrevivir es ir solo por el mundo. Sin embargo, se ve arrastrado a formar parte de un grupo que huye a través del desierto en un War Rig conducido por una Emperatriz de élite: Furiosa. Escapan de una Ciudadela tiranizada por Immortan Joe, a quien han arrebatado algo irreemplazable. Enfurecido, el Señor de la Guerra moviliza a todas sus bandas y persigue implacablemente a los rebeldes en una 'guerra de la carretera' de altas revoluciones.","posterPath":"https://image.tmdb.org/t/p/w500/fnY0VRsb31A5RLVCBjuR6EFUlo2.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/uT895WNwm0aIJRtGizcQhrejWUo.jpg","voteAverage":7.6,"voteCount":24030,"releaseDate":"2015-05-13","genres":["Acción","Aventura","Ciencia ficción"],"type":"movie","platforms":[],"tmdbId":76341,"runtime":"$undefined","seasons":"$undefined"},{"id":402431,"title":"Wicked","originalTitle":"Wicked","overview":"Ambientada en la Tierra de Oz, mucho antes de la llegada de Dorothy Gale desde Kansas. Elphaba es una joven incomprendida por su inusual color verde que aún no ha descubierto su verdadero poder. Glinda es una popular joven marcada por sus privilegios y su ambición que aún no ha descubierto su verdadera pasión. Las dos se conocen como estudiantes de la Universidad Shiz, en la fantástica Tierra de Oz, y forjan una insólita pero profunda amistad. La trama abarca los acontecimientos del primer acto del musical de Broadway.","posterPath":"https://image.tmdb.org/t/p/w500/hDQXqvmmikekQ15uxhisBDwEA63.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/uVlUu174iiKhsUGqnOSy46eIIMU.jpg","voteAverage":6.9,"voteCount":3012,"releaseDate":"2024-10-16","genres":["Drama","Romance","Fantasía"],"type":"movie","platforms":[],"tmdbId":402431,"runtime":"$undefined","seasons":"$undefined"},{"id":315162,"title":"El Gato con Botas: El último deseo","originalTitle":"El Gato con Botas: El último deseo","overview":"El Gato con Botas se embarca en un viaje épico para encontrar al mítico Último Deseo y recuperar sus nueve vidas.","posterPath":"https://image.tmdb.org/t/p/w500/b5Jb7GoQaqIXy4VEdnQa0UrQZI.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/jr8tSoJGj33XLgFBy6lmZhpGQNu.jpg","voteAverage":8.2,"voteCount":8802,"releaseDate":"2022-12-07","genres":["Animación","Aventura","Fantasía","Comedia","Familia"],"type":"movie","platforms":[],"tmdbId":315162,"runtime":"$undefined","seasons":"$undefined"},{"id":857,"title":"Salvar al soldado Ryan","originalTitle":"Salvar al soldado Ryan","overview":"Segunda Guerra Mundial, 1944. Tras el desembarco de los Aliados en Normandía, a un grupo de soldados americanos se le encomienda una peligrosa misión: poner a salvo al soldado James Ryan. Los hombres de la patrulla del capitán John Miller deben arriesgar sus vidas para encontrar a este soldado, cuyos tres hermanos han muerto en la guerra. Lo único que se sabe del soldado Ryan es que se lanzó con su escuadrón de paracaidistas detrás de las líneas enemigas.","posterPath":"https://image.tmdb.org/t/p/w500/dcKfD8xWf8XnS3tHVp7v331wdNT.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/bdD39MpSVhKjxarTxLSfX6baoMP.jpg","voteAverage":8.2,"voteCount":17173,"releaseDate":"1998-07-24","genres":["Bélica","Drama","Historia"],"type":"movie","platforms":[],"tmdbId":857,"runtime":"$undefined","seasons":"$undefined"},{"id":37165,"title":"El show de Truman","originalTitle":"El show de Truman","overview":"Truman Burbank es un hombre corriente y algo ingenuo que ha vivido toda su vida en uno de esos pueblos donde nunca pasa nada. Sin embargo, de repente, unos extraños sucesos le hacen sospechar que algo anormal está ocurriendo. Todos sus amigos son actores, toda su ciudad es un plató, toda su vida está siendo filmada y emitida como el reality más ambicioso de la historia.","posterPath":"https://image.tmdb.org/t/p/w500/4BGVZSwv5n0hMIAWwiSjMFDQ63K.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/aCHn2TXYJfzPXQKA6r9mKPbMlUB.jpg","voteAverage":8.2,"voteCount":20167,"releaseDate":"1998-06-04","genres":["Comedia","Drama"],"type":"movie","platforms":[],"tmdbId":37165,"runtime":"$undefined","seasons":"$undefined"},{"id":843527,"title":"La idea de tenerte","originalTitle":"La idea de tenerte","overview":"Solène, madre soltera de 40 años, comienza un romance inesperado con Hayes Campbell, de 24 años, el cantante principal de August Moon, la banda de chicos más popular del planeta.","posterPath":"https://image.tmdb.org/t/p/w500/y1WpsgfBA5GywXIuqLm9D4aQHNd.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/sI6uCeF8mUlZx22mFfHSi9W3XQ9.jpg","voteAverage":7.3,"voteCount":1940,"releaseDate":"2024-05-02","genres":["Música","Comedia","Romance","Drama"],"type":"movie","platforms":[],"tmdbId":843527,"runtime":"$undefined","seasons":"$undefined"},{"id":767,"title":"Harry Potter y el misterio del príncipe","originalTitle":"Harry Potter y el misterio del príncipe","overview":"En medio de los desastres que azotan a Inglaterra, Harry y sus compañeros vuelven a Hogwarts para cursar su sexto año de estudios; y aunque las medidas de seguridad han convertido al colegio en una fortaleza, algunos estudiantes son víctimas de ataques inexplicables. Harry sospecha que Draco Malfoy es el responsable de los mismos y decide averiguar la razón. Mientras tanto, Albus Dumbledore y el protagonista exploran el pasado de Lord Voldemort mediante recuerdos que el director ha recolectado. Con esto, Dumbledore planea preparar al muchacho para el día de la batalla final.","posterPath":"https://image.tmdb.org/t/p/w500/tO0UGkNuQoxyXve0mvwtXP49NAO.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/ze6Mx4QE5mQVXRYmG2flncqqle4.jpg","voteAverage":7.7,"voteCount":20740,"releaseDate":"2009-07-15","genres":["Aventura","Fantasía"],"type":"movie","platforms":[],"tmdbId":767,"runtime":"$undefined","seasons":"$undefined"},{"id":4951,"title":"10 razones para odiarte","originalTitle":"10 razones para odiarte","overview":"Las hermanas Stratford son muy distintas. La guapa y popular Bianca nunca ha salido con un chico, y Kat, su hermana mayor, es una bruja con muy mal genio, y algo arisca, que se ha propuesto rechazar a cualquier chico que demuestre el más mínimo interés por ella. Desgraciadamente, el estricto reglamento que rige el hogar de los Stratford prohibe a Blanca tener novio hasta que su insoportable hermana tenga uno; situación que parece más que improbable teniendo en cuenta que Kat lleva una vida social desastrosa. Blanca está desesperada por ir al baile de fin de curso. Pero su pretendiente, Cameron, guarda una sorpresa...","posterPath":"https://image.tmdb.org/t/p/w500/ugSquUOt4U0a6xsgWUiOZcr5plz.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/yvPbncYhMu9FfTjDhq0N5lgnVkO.jpg","voteAverage":7.6,"voteCount":8890,"releaseDate":"1999-03-30","genres":["Comedia","Romance","Drama"],"type":"movie","platforms":[],"tmdbId":4951,"runtime":"$undefined","seasons":"$undefined"},{"id":49051,"title":"El hobbit: Un viaje inesperado","originalTitle":"El hobbit: Un viaje inesperado","overview":"Precuela de la trilogía \"El Señor de los Anillos\", obra de J.R.R. Tolkien. En compañía del mago Gandalf y de trece enanos, el hobbit Bilbo Bolsón emprende un viaje a través del país de los elfos y los bosques de los trolls, desde las mazmorras de los orcos hasta la Montaña Solitaria, donde el dragón Smaug esconde el tesoro de los Enanos. Finalmente, en las profundidades de la Tierra, encuentra el Anillo Único, hipnótico objeto que será posteriormente causa de tantas sangrientas batallas en la Tierra Media.","posterPath":"https://image.tmdb.org/t/p/w500/3dJELUqdpGEkXVrMj7V3BiOjrtf.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/xyXmtuvsoM5J3yNad0nvcetpBdY.jpg","voteAverage":7.4,"voteCount":19596,"releaseDate":"2012-12-12","genres":["Aventura","Fantasía","Acción"],"type":"movie","platforms":[],"tmdbId":49051,"runtime":"$undefined","seasons":"$undefined"},{"id":9502,"title":"Kung Fu Panda","originalTitle":"Kung Fu Panda","overview":"El protagonista es un oso panda llamado Po, el más vago de todas las criaturas del Valle de la Paz. Con poderosos enemigos acercándose, la esperanza es depositada en una antigua profecía que dice que un héroe se alzará para salvarles. Voces originales de Jack Black, Angelina Jolie, Dustin Hoffman, Lucy Liu & Jackie Chan.","posterPath":"https://image.tmdb.org/t/p/w500/zcORJ8s9zsBjvKxP0k4FASQSjpf.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/qdthf9WrRDSaIkGVQGhhJ9pz1hn.jpg","voteAverage":7.3,"voteCount":12596,"releaseDate":"2008-06-04","genres":["Acción","Animación","Comedia","Familia"],"type":"movie","platforms":[],"tmdbId":9502,"runtime":"$undefined","seasons":"$undefined"},{"id":99861,"title":"Vengadores: La era de Ultrón","originalTitle":"Vengadores: La era de Ultrón","overview":"Cuando Tony Stark intenta reactivar un programa caído en desuso cuyo objetivo es mantener la paz, las cosas empiezan a torcerse y los héroes más poderosos de la Tierra, incluyendo a Iron Man, Capitán América, Thor, El Increíble Hulk, Viuda Negra y Ojo de Halcón, tendrán que afrontar la prueba definitiva cuando el destino del planeta se ponga en juego. Cuando el villano Ultron emerge, le corresponderá a Los Vengadores detener sus terribles planes, que junto a incómodas alianzas llevarán a una inesperada acción que allanará el camino para una épica y única aventura.","posterPath":"https://image.tmdb.org/t/p/w500/3Lz6h5rlCFNNyCZRaRJ2ZjtBnAE.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/kIBK5SKwgqIIuRKhhWrJn3XkbPq.jpg","voteAverage":7.3,"voteCount":24384,"releaseDate":"2015-04-22","genres":["Acción","Aventura","Ciencia ficción"],"type":"movie","platforms":[],"tmdbId":99861,"runtime":"$undefined","seasons":"$undefined"},{"id":2062,"title":"Ratatouille","originalTitle":"Ratatouille","overview":"Remy es una simpática rata que sueña con convertirse en un gran chef francés a pesar de la oposición de su familia y del problema evidente que supone ser una rata en una profesión que detesta a los roedores. El destino lleva entonces a Remy a las alcantarillas de París, pero su situación no podría ser mejor, ya que se encuentra justo debajo de un restaurante que se ha hecho famoso gracias a Auguste Gusteau, una estrella de la cuisine. A pesar del peligro que representa ser un visitante poco común (y desde luego nada deseado) en los fogones de un exquisito restaurante francés, la pasión de Remy por la cocina pone patas arriba el mundo culinario parisino en una trepidante y emocionante aventura.","posterPath":"https://image.tmdb.org/t/p/w500/nGUelOVetiRpY2wTBMHTbrTIGYC.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/xgDj56UWyeWQcxQ44f5A3RTWuSs.jpg","voteAverage":7.8,"voteCount":18436,"releaseDate":"2007-06-28","genres":["Animación","Comedia","Familia","Fantasía"],"type":"movie","platforms":[],"tmdbId":2062,"runtime":"$undefined","seasons":"$undefined"},{"id":111,"title":"El precio del poder","originalTitle":"El precio del poder","overview":"Un emigrante cubano frío y sanguinario, Tony Montana, llega de Cuba para instalarse en Miami, donde se propone hacerse con un nombre dentro del crimen organizado de Florida. Junto a su amigo, Manny Rivera, inicia una ascendente carrera delictiva.","posterPath":"https://image.tmdb.org/t/p/w500/iDABT5GD9OQmFiXM3wR0DJIxtkY.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/1qM2BYNE11Viby8ImC9LC00DgDr.jpg","voteAverage":8.2,"voteCount":12991,"releaseDate":"1983-12-09","genres":["Acción","Crimen","Drama"],"type":"movie","platforms":[],"tmdbId":111,"runtime":"$undefined","seasons":"$undefined"},{"id":953,"title":"Madagascar","originalTitle":"Madagascar","overview":"Cuenta la historia de cuatro divertidos animales del zoo de Central Park, Nueva York, (Alex el león, Marty la cebra, Gloria la hipopótamo y Melman la jirafa). Llevan toda su vida encerrados en cautividad sin poder experiemtnar el sabor de la libertad y se han propuesto idear un plan para salir de allí juntos. Un día, una serie de casualidades les llevan a lograr lo que tanto ansiaban y huyen de aquel lugar. Terminan en plena naturaleza, concretamente en la idílica isla de Madagascar. Allí descubrirán, a base de apasionantes aventuras, que la vida salvaje es muy diferente a lo que ellos pensaban y que vivir en libertad no es tan fácil como imaginaban.","posterPath":"https://image.tmdb.org/t/p/w500/zrV5GnfCcLWzyjrFgYTpjQPRMfl.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/tPaurpIUskVji5vwV0dhy9pq4Vs.jpg","voteAverage":6.9,"voteCount":11702,"releaseDate":"2005-05-25","genres":["Aventura","Animación","Comedia","Familia"],"type":"movie","platforms":[],"tmdbId":953,"runtime":"$undefined","seasons":"$undefined"},{"id":49026,"title":"El caballero oscuro: La leyenda renace","originalTitle":"El caballero oscuro: La leyenda renace","overview":"Hace ocho años que Batman desapareció, dejando de ser un héroe para convertirse en un fugitivo. Al asumir la culpa por la muerte del fiscal del distrito Harvey Dent, el Caballero Oscuro decidió sacrificarlo todo por lo que consideraba, al igual que el Comisario Gordon, un bien mayor. La mentira funciona durante un tiempo, ya que la actividad criminal de la ciudad de Gotham se ve aplacada gracias a la dura Ley Dent. Pero todo cambia con la llegada de una astuta gata ladrona que pretende llevar a cabo un misterioso plan. Sin embargo, mucho más peligrosa es la aparición en escena de Bane, un terrorista enmascarado cuyos despiadados planes obligan a Bruce a regresar de su voluntario exilio.","posterPath":"https://image.tmdb.org/t/p/w500/rrS7K8tXVFUBliIKWaRuSq65nWr.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/c3OHQncTAnKFhdOTX7D3LTW6son.jpg","voteAverage":7.8,"voteCount":24314,"releaseDate":"2012-07-17","genres":["Acción","Crimen","Drama","Suspense"],"type":"movie","platforms":[],"tmdbId":49026,"runtime":"$undefined","seasons":"$undefined"},{"id":10193,"title":"Toy Story 3","originalTitle":"Toy Story 3","overview":"Sabiendo que su dueño Andy, que ya no es un niño, se prepara para ir a la universidad, el vaquero Woody, el astronauta Buzz y el resto de sus amigos juguetes comienzan a preocuparse ante su incierto futuro. Efectivamente todos acaban en una guardería, donde por ejemplo la muñeca Barbie conocerá al guapo Ken. Esta reunión de nuestros amigos con otros nuevos juguetes no será sino el inicio de un montón de trepidantes y divertidas aventuras.","posterPath":"https://image.tmdb.org/t/p/w500/yBSISwqix2z0JiwIrM3r6fiI6Cm.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/uAfhsySkr1UzQg1zdg3dZQRz9Fd.jpg","voteAverage":7.8,"voteCount":15690,"releaseDate":"2010-06-16","genres":["Animación","Familia","Comedia"],"type":"movie","platforms":[],"tmdbId":10193,"runtime":"$undefined","seasons":"$undefined"},{"id":38365,"title":"Niños grandes","originalTitle":"Niños grandes","overview":"Después de muchos años, su antiguo entrenador de basquet muere y cincos amigos deciden pasar un fin de semanas -ahora con sus respectivas familias- en la casa donde celebraron, antaño, el campeonato.","posterPath":"https://image.tmdb.org/t/p/w500/r1mDA1SLjw2yiYhhLiAjrd2Pt1l.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/kARonxQpuSZdFraTKlCThWOBCtu.jpg","voteAverage":6.4,"voteCount":6643,"releaseDate":"2010-06-24","genres":["Comedia"],"type":"movie","platforms":[],"tmdbId":38365,"runtime":"$undefined","seasons":"$undefined"},{"id":285,"title":"Piratas del Caribe: En el fin del mundo","originalTitle":"Piratas del Caribe: En el fin del mundo","overview":"Siguiendo la estela de lo sucedido en “Piratas del caribe: el cofre del hombre muerto”, encontramos a nuestros héroes Will Turner y Elizabeth Swann aliados con el capitán Barbossa, en una búsqueda desesperada para liberar al capitán Jack Sparrow de las manos de Davy Jones. Mientras, el terrorífico barco fantasma, el Holandés Errante, bajo el control de la Compañía de las Indias Orientales, causa estragos a lo largo de los Siete Mares. Will y Elizabeth, navegando en medio de la traición, la felonía y mares salvajes, deben seguir adelante rumbo a Singapur y enfrentarse al astuto pirata chino Sao Feng. Ahora, en los mismísimos confines de la tierra, todos ellos deben elegir un bando en la batalla final, ya que no sólo sus vidas y fortunas, sino también el futuro de la piratería clásica, pende de un hilo...","posterPath":"https://image.tmdb.org/t/p/w500/xHcUMez2b1QiMGQYCuQTAlqwDEe.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/1jHxkVXMI5s3vRiyiZooUy1shB5.jpg","voteAverage":7.3,"voteCount":15420,"releaseDate":"2007-05-19","genres":["Aventura","Fantasía","Acción"],"type":"movie","platforms":[],"tmdbId":285,"runtime":"$undefined","seasons":"$undefined"},{"id":637649,"title":"Despierta la furia","originalTitle":"Despierta la furia","overview":"H (Jason Statham) es el misterioso tipo que acaba de incorporarse como guardia de seguridad en una compañía de furgones blindados. Durante un intento de atraco a su camión, sorprende a sus compañeros mostrando habilidades propias de un soldado profesional, dejando al resto del equipo preguntándose quién es realmente y de dónde viene.","posterPath":"https://image.tmdb.org/t/p/w500/emM894kjspdQsHyTAF7sjRNlbTr.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/70AV2Xx5FQYj20labp0EGdbjI6E.jpg","voteAverage":7.6,"voteCount":6071,"releaseDate":"2021-04-22","genres":["Suspense","Crimen","Drama"],"type":"movie","platforms":[],"tmdbId":637649,"runtime":"$undefined","seasons":"$undefined"},{"id":232672,"title":"Juntos y revueltos","originalTitle":"Juntos y revueltos","overview":"Un hombre y una mujer va un resort con sus respectivas familias y no pueden ocultar su sorpresa al verse el uno al otro. Ya se conocían, había tenido una cita a ciegas hace algún tiempo, una cita cuyo resultado no había sido para nada satisfactorio. No obstante, contra todo pronóstico, la tracción que entonces no sintieron hace ahora su aparición. Pero ellos no son los únicos que se ven beneficiados por esto, sus hijos también saben sacar partido a la situación, convirtiendo la creciente relación en algo de lo que pueden sacar provecho.","posterPath":"https://image.tmdb.org/t/p/w500/aVLm7uud6Oh1wmhiR4vOrngQKo8.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/g5haoqEqt5VwVwQKEkoXY9zqSxb.jpg","voteAverage":6.9,"voteCount":3794,"releaseDate":"2014-05-21","genres":["Comedia","Romance"],"type":"movie","platforms":[],"tmdbId":232672,"runtime":"$undefined","seasons":"$undefined"},{"id":39254,"title":"Acero puro","originalTitle":"Acero puro","overview":"En un futuro no muy lejano, el boxeo es robótico: en los combates ya no se enfrentan seres humanos, sino robots humanoides, sofisticadas máquinas diseñadas para luchar. Charlie Kenton, un antiguo púgil que casi llegó a alcanzar la gloria, está pasando una mala racha como promotor de combates. Un día, encuentra un viejo robot desechado y, al comprobar que es un gran boxeador, decide entrenarlo.","posterPath":"https://image.tmdb.org/t/p/w500/gqjKG4Z24pjYxcOfCd9p6WAnYlG.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/pjlxrd646cBYznHoPBWTzz6FujX.jpg","voteAverage":7.1,"voteCount":9092,"releaseDate":"2011-09-28","genres":["Acción","Ciencia ficción","Drama"],"type":"movie","platforms":[],"tmdbId":39254,"runtime":"$undefined","seasons":"$undefined"},{"id":823464,"title":"Godzilla y Kong: El nuevo imperio","originalTitle":"Godzilla y Kong: El nuevo imperio","overview":"Una aventura cinematográfica completamente nueva, que enfrentará al todopoderoso Kong y al temible Godzilla contra una colosal amenaza desconocida escondida dentro de nuestro mundo. La nueva y épica película profundizará en las historias de estos titanes, sus orígenes y los misterios de Isla Calavera y más allá, mientras descubre la batalla mítica que ayudó a forjar a estos seres extraordinarios y los unió a la humanidad para siempre.","posterPath":"https://image.tmdb.org/t/p/w500/2YqZ6IyFk7menirwziJvfoVvSOh.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/gvLG3Fnznkxl4SmYfcK8gUuqxM8.jpg","voteAverage":7.1,"voteCount":4651,"releaseDate":"2024-03-27","genres":["Acción","Aventura","Ciencia ficción"],"type":"movie","platforms":[],"tmdbId":823464,"runtime":"$undefined","seasons":"$undefined"},{"id":228150,"title":"Corazones de acero","originalTitle":"Corazones de acero","overview":"Abril de 1945. Al mando del veterano sargento Wardaddy, un pelotón de cinco soldados americanos a bordo de un carro de combate -el Fury- ha de luchar contra un ejército nazi al borde de la desesperación, pues los alemanes saben que su derrota estaba ya cantada por aquel entonces.","posterPath":"https://image.tmdb.org/t/p/w500/kbtH5G8L8REzy72LkLmKYoBVaGv.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/95ckrV6wQgbffurAVmETQ5YKASL.jpg","voteAverage":7.5,"voteCount":12897,"releaseDate":"2014-10-15","genres":["Bélica","Drama","Acción"],"type":"movie","platforms":[],"tmdbId":228150,"runtime":"$undefined","seasons":"$undefined"},{"id":284054,"title":"Black Panther","originalTitle":"Black Panther","overview":"Después de los acontecimientos de \"Capitán América: Civil War\", T'Challa vuelve a casa, la nación aislada y muy avanzada tecnológicamente de Wakanda, para ser proclamado Rey. Pero la reaparición de un viejo enemigo pone a prueba el temple de T'Challa como Rey y Black Panther ya que se ve arrastrado a un conflicto que pone en peligro todo el destino de Wakanda y del mundo.","posterPath":"https://image.tmdb.org/t/p/w500/lAPzezdc5E6DFnttJwCWXZ9A9C6.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/19Ed4XgjahPm4U8JT7SnntERIlt.jpg","voteAverage":7.4,"voteCount":23454,"releaseDate":"2018-02-13","genres":["Acción","Aventura","Ciencia ficción"],"type":"movie","platforms":[],"tmdbId":284054,"runtime":"$undefined","seasons":"$undefined"},{"id":68721,"title":"Iron Man 3","originalTitle":"Iron Man 3","overview":"El descarado y brillante empresario Tony Stark/Iron Man se enfrentará a un enemigo cuyo poder no conoce límites. Cuando Stark comprende que su enemigo ha destruido su universo personal, se embarca en una angustiosa búsqueda para encontrar a los responsables. Este viaje pondrá a prueba su entereza una y otra vez. Acorralado, Stark tendrá que sobrevivir por sus propios medios, confiando en su ingenio y su instinto para proteger a las personas que quiere.","posterPath":"https://image.tmdb.org/t/p/w500/cW0fOIZONkgeiMJDYzqUcgl4MUn.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/iVped1djsF0tvGkvnHbzsE3ZPTF.jpg","voteAverage":6.9,"voteCount":23387,"releaseDate":"2013-04-18","genres":["Acción","Aventura","Ciencia ficción"],"type":"movie","platforms":[],"tmdbId":68721,"runtime":"$undefined","seasons":"$undefined"},{"id":475557,"title":"Joker","originalTitle":"Joker","overview":"Arthur Fleck es un hombre ignorado por la sociedad, cuya motivación en la vida es hacer reír. Pero una serie de trágicos acontecimientos le llevarán a ver el mundo de otra forma. Película basada en Joker, el popular personaje de DC Comics y archivillano de Batman, pero que en este film toma un cariz más realista y oscuro.","posterPath":"https://image.tmdb.org/t/p/w500/g9l7iLYusH82bbEbwGCJzhVkOe2.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/hO7KbdvGOtDdeg0W4Y5nKEHeDDh.jpg","voteAverage":8.1,"voteCount":27676,"releaseDate":"2019-10-01","genres":["Crimen","Suspense","Drama"],"type":"movie","platforms":[],"tmdbId":475557,"runtime":"$undefined","seasons":"$undefined"},{"id":49013,"title":"Cars 2","originalTitle":"Cars 2","overview":"Rayo McQueen y su amigo, la grúa Mate, viajan al extranjero para participar en el primer Campeonato Mundial en el que se decidirá cuál es el coche más rápido del planeta. La primera etapa es Tokio (Japón), donde Mate tendrá que convertirse en un espía secreto al verse envuelto inesperadamente en un caso de espionaje internacional, que lo llevará a París y a Londres. También vivirán una aventura de proporciones épicas al viajar a Porto Corsa (Italia), para disputar el Campeonato. Sin embargo, los dos tendrán que renunciar a los placeres de la Riviera italiana -yates, playas y pasta al pesto- ya que Mate está muy ocupado con su labor de espía, mientras que McQueen compite contra los mejores coches del mundo.","posterPath":"https://image.tmdb.org/t/p/w500/eQo1LQs5Vo9RHVHYUhNSfMZa3VB.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/4BS8tgBNWg2jPiDlBwM2iJe1xB7.jpg","voteAverage":6.2,"voteCount":8455,"releaseDate":"2011-06-11","genres":["Animación","Familia","Aventura","Comedia"],"type":"movie","platforms":[],"tmdbId":49013,"runtime":"$undefined","seasons":"$undefined"},{"id":920,"title":"Cars","originalTitle":"Cars","overview":"El aspirante a campeón de carreras Rayo McQueen parece que está a punto de conseguir el éxito, la fama y todo lo que había soñado, hasta que por error toma un desvío inesperado en la polvorienta y solitaria Ruta 66. Su actitud arrogante se desvanece cuando llega a una pequeña comunidad olvidada que le enseña las cosas importantes de la vida que había olvidado.","posterPath":"https://image.tmdb.org/t/p/w500/lgBe9KD6DoLyQP28JZ6fSUGK8j0.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/sd4xN5xi8tKRPrJOWwNiZEile7f.jpg","voteAverage":7,"voteCount":15081,"releaseDate":"2006-06-08","genres":["Animación","Aventura","Comedia","Familia"],"type":"movie","platforms":[],"tmdbId":920,"runtime":"$undefined","seasons":"$undefined"},{"id":539,"title":"Psicosis","originalTitle":"Psicosis","overview":"Una joven secretaria, tras cometer un robo, se marcha de la ciudad y conduce durante horas, parando para descansar en un pequeño motel de carretera regentado por un joven llamado Norman. Todo parece normal y tranquilo en el apartado motel y en la casa de al lado en la que viven Norman y su madre pero, mientras está en la ducha, la joven es asesinada salvajemente a cuchilladas.","posterPath":"https://image.tmdb.org/t/p/w500/xFbnc2QPG5H5gYWsGbZT4q8Akya.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/mufF1aYvwdpKerhq5R1YrVcbJLY.jpg","voteAverage":8.4,"voteCount":10971,"releaseDate":"1960-06-22","genres":["Terror","Suspense","Misterio"],"type":"movie","platforms":[],"tmdbId":539,"runtime":"$undefined","seasons":"$undefined"},{"id":1865,"title":"Piratas del Caribe: En mareas misteriosas","originalTitle":"Piratas del Caribe: En mareas misteriosas","overview":"Cuando Jack Sparrow vuelve a encontrarse con una mujer a la que había conocido años atrás, no está seguro de si se trata de amor o si ella es una estafadora sin escrúpulos que lo está utilizando para encontrar la legendaria Fuente de la Juventud. A todo esto, Jack es capturado por el Venganza de la Reina Ana, el barco del temible pirata Barbanegra, que lo obliga a unirse a su tripulación, lo que le hará vivir una inesperada aventura en la que no sabe quién le inspira más miedo si Barbanegra o esa mujer que regresa del pasado.","posterPath":"https://image.tmdb.org/t/p/w500/2oOARbiV871kCC27FyKBmYwOM3G.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/uzIGtyS6bbnJzGsPL93WCF1FWm8.jpg","voteAverage":6.6,"voteCount":14922,"releaseDate":"2011-05-15","genres":["Aventura","Acción","Fantasía"],"type":"movie","platforms":[],"tmdbId":1865,"runtime":"$undefined","seasons":"$undefined"},{"id":324786,"title":"Hasta el último hombre","originalTitle":"Hasta el último hombre","overview":"La historia de Desmond T. Doss, quien, debido a que se lo prohibía su fe, combatió en la Segunda Guerra Mundial sin portar un arma. No disparó ni una bala, pero salvó a 75 personas de la muerte en la batalla de la isla de Okinawa.","posterPath":"https://image.tmdb.org/t/p/w500/m3jj8IJ7uP5p4MqMzgtGW5l4ECd.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/vDKRMZGFTKP9nQolzeSB1rB1w6p.jpg","voteAverage":8.2,"voteCount":14816,"releaseDate":"2016-10-07","genres":["Drama","Historia","Bélica"],"type":"movie","platforms":[],"tmdbId":324786,"runtime":"$undefined","seasons":"$undefined"},{"id":293660,"title":"Deadpool","originalTitle":"Deadpool","overview":"Basado en el anti-héroe menos convencional de Marvel, Deadpool narra el origen de un ex agente de las fuerzas especiales llamado Wade Wilson, reconvertido a mercenario, y que tras ser sometido a un cruel experimento para curar su cáncer adquiere poderes de curación rápida, adoptando entonces el alter ego de Deadpool. Armado con sus nuevas habilidades y un oscuro y retorcido sentido del humor, Deadpool intentará dar caza al hombre que casi destruye su vida.","posterPath":"https://image.tmdb.org/t/p/w500/3TUYy0XvhPQBhrXJwRIaOoYFOBO.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/en971MEXui9diirXlogOrPKmsEn.jpg","voteAverage":7.6,"voteCount":32693,"releaseDate":"2016-02-09","genres":["Acción","Aventura","Comedia"],"type":"movie","platforms":[],"tmdbId":293660,"runtime":"$undefined","seasons":"$undefined"},{"id":359410,"title":"Road House (De profesión: duro)","originalTitle":"Road House (De profesión: duro)","overview":"Dalton es un exluchador de la UFC en horas bajas que acepta un trabajo como portero en un conflictivo bar de carretera de los Cayos de Florida, sólo para descubrir que este paraíso no es todo lo que parece... Remake de la película de 1989 con Patrick Swayze.","posterPath":"https://image.tmdb.org/t/p/w500/n5af068Xoa2feazpY5MP3xcW5Mj.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/clFFCapyGpE7KD4Jsu5pUbFBZF4.jpg","voteAverage":6.9,"voteCount":3018,"releaseDate":"2024-03-08","genres":["Acción","Suspense","Drama"],"type":"movie","platforms":[],"tmdbId":359410,"runtime":"$undefined","seasons":"$undefined"},{"id":106,"title":"Depredador","originalTitle":"Depredador","overview":"Un comando de mercenarios es contratados por la CIA para rescatar a unos pilotos apresados por las guerrillas en la selva Centroamericana. La misión resulta satisfactoria, pero durante su viaje de regreso se dan cuenta de que algo está dándoles caza uno a uno, ese algo resulta ser un cazador alienígena que se queda con las calaveras de sus víctimas como trofeos","posterPath":"https://image.tmdb.org/t/p/w500/spgPmu5bTk8N6KZXrIOBwfd3cNb.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/otkJlfjB7zJ5h34FEIfemenMbCy.jpg","voteAverage":7.5,"voteCount":9077,"releaseDate":"1987-06-12","genres":["Ciencia ficción","Acción","Aventura","Suspense"],"type":"movie","platforms":[],"tmdbId":106,"runtime":"$undefined","seasons":"$undefined"},{"id":8961,"title":"Dos policías rebeldes II","originalTitle":"Dos policías rebeldes II","overview":"Los detectives de narcóticos Mike Lowrey y Marcus Burnett han sido asignados a un nuevo caso en Miami, donde un astuto narcotraficante ha iniciado una sangrienta guerra. Además la amistad de los dos agentes se complica cuando Mike empieza a sentir algo por la hermana de Marcus...","posterPath":"https://image.tmdb.org/t/p/w500/qyHDZB87UQF9cu6uuQzhhaKGvuo.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/gxSVZCUlDd8upT1G2wdrUdz2hxG.jpg","voteAverage":6.7,"voteCount":5924,"releaseDate":"2003-07-18","genres":["Acción","Crimen","Comedia"],"type":"movie","platforms":[],"tmdbId":8961,"runtime":"$undefined","seasons":"$undefined"},{"id":823219,"title":"Flow, un mundo que salvar","originalTitle":"Flow, un mundo que salvar","overview":"En un mundo al borde del colapso, un gato solitario pierde su hogar por una inundación y encuentra refugio en un barco con otras especies. Juntos, deberán superar diferencias y desafíos mientras navegan por un misterioso paisaje sumergido.","posterPath":"https://image.tmdb.org/t/p/w500/337MqZW7xii2evUDVeaWXAtopff.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/4XPNNt0zfZKBqxxVWaQALd57UHl.jpg","voteAverage":8.1,"voteCount":2799,"releaseDate":"2024-08-29","genres":["Aventura","Animación","Familia","Fantasía"],"type":"movie","platforms":[],"tmdbId":823219,"runtime":"$undefined","seasons":"$undefined"},{"id":559,"title":"Spider-Man 3","originalTitle":"Spider-Man 3","overview":"Parece que Parker ha conseguido por fin el equilibrio entre su devoción por Mary Jane y sus deberes como superhéroe. Pero, de repente, su traje se vuelve negro y adquiere nuevos poderes; también él se transforma, mostrando el lado más oscuro y vengativo de su personalidad. Bajo la influencia del nuevo traje, Peter se convierte en un ser egoísta que sólo se preocupa por sí mismo. Tiene, pues, que afrontar un dilema: disfrutar de sus nuevos poderes o seguir siendo un héroe compasivo. Mientras tanto, sobre él se cierne la amenaza de dos temibles enemigos: Venom y el Hombre de Arena.","posterPath":"https://image.tmdb.org/t/p/w500/589rUff9Ai272uMudb9Dn7k88Oa.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/w1oD1MzHjnBJc5snKupIQaSBLIh.jpg","voteAverage":6.5,"voteCount":15177,"releaseDate":"2007-05-01","genres":["Acción","Aventura","Ciencia ficción"],"type":"movie","platforms":[],"tmdbId":559,"runtime":"$undefined","seasons":"$undefined"},{"id":68726,"title":"Pacific Rim","originalTitle":"Pacific Rim","overview":"Cuando legiones de monstruosas criaturas, denominadas Kaiju, comienzan a salir del mar, se inicia una guerra que acabará con millones de vidas y que consumirá los recursos de la humanidad durante interminables años. Para combatir a los Kaiju gigantes diseñan un tipo especial de arma: enormes robots, llamados Jaegers, que son controlados simultáneamente por dos pilotos cuyas mentes están bloqueadas en un puente neural. Pero incluso los Jaegers proporcionan poca defensa ante los incansables Kaiju. A punto de la derrota, las fuerzas que defienden a la humanidad no tienen otra elección que recurrir a dos insólitos héroes: un ex piloto acabado (Charlie Hunnam) y un aprendiz que todavía no se ha puesto a prueba (Rinko Kikuchi). Ambos se unen para traer a un legendario pero al parecer obsoleto Jaeger del pasado. Juntos, son la última esperanza de la humanidad frente al Apocalipsis que se avecina.","posterPath":"https://image.tmdb.org/t/p/w500/9ZqJwngRoM8DOjl0Yyemmvt0qis.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/9X7Im1YuBhyHYVD8r7CAONPJR5k.jpg","voteAverage":6.9,"voteCount":13335,"releaseDate":"2013-07-11","genres":["Acción","Ciencia ficción","Aventura"],"type":"movie","platforms":[],"tmdbId":68726,"runtime":"$undefined","seasons":"$undefined"},{"id":205596,"title":"The Imitation Game (Descifrando Enigma)","originalTitle":"The Imitation Game (Descifrando Enigma)","overview":"Durante el invierno de 1952, las autoridades británicas entraron en el hogar del matemático, analista y héroe de guerra Alan Turing, con la intención de investigar la denuncia de un robo. Al final acabaron arrestando a Turing acusándole de indecencia grave, un cargo que le supondría una devastadora condena por una ofensa criminal: ser homosexual. Los oficiales no tenían ni idea de que en realidad estaban incriminando al pionero de la informática actual. Liderando a un heterogéneo grupo de académicos, lingüistas, campeones de ajedrez y oficiales de inteligencia, se le conoce por haber descifrado el código de la inquebrantable máquina Enigma de los alemanes durante la Segunda Guerra Mundial.","posterPath":"https://image.tmdb.org/t/p/w500/pdd20KgHJec4BM4sfHS8oefaDUI.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/4vf5Fv6OVXXrNqEXqiJnWxnNSyV.jpg","voteAverage":8,"voteCount":18055,"releaseDate":"2014-11-14","genres":["Historia","Drama","Suspense","Bélica"],"type":"movie","platforms":[],"tmdbId":205596,"runtime":"$undefined","seasons":"$undefined"},{"id":204082,"title":"El protector (Homefront)","originalTitle":"El protector (Homefront)","overview":"Un exagente de la DEA (Agencia Antidroga) que está viudo se retira a un pequeño pueblo para empezar una nueva vida con su hija de diez años. El único problema es que ha elegido el pueblo equivocado.","posterPath":"https://image.tmdb.org/t/p/w500/3epke5oOH7WRWvaFJeH9SsibBW4.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/259QYLcZEkTqwAZAWSC5GeSthaF.jpg","voteAverage":6.9,"voteCount":3827,"releaseDate":"2013-11-12","genres":["Acción","Suspense"],"type":"movie","platforms":[],"tmdbId":204082,"runtime":"$undefined","seasons":"$undefined"},{"id":6479,"title":"Soy leyenda","originalTitle":"Soy leyenda","overview":"Año 2012. Robert Neville es el último hombre vivo que hay sobre la Tierra, pero no está solo. Los demás seres humanos se han convertido en unos mutantes nocturnos llamados \"Darkseekers\" y todos ansían beber su sangre. Durante el día vive en estado de alerta, como un cazador, y busca a los muertos vivientes mientras duermen; pero durante la noche debe esconderse de ellos y esperar el amanecer. Esta pesadilla empezó hace tres años: Neville era un brillante científico, pero no pudo impedir la expansión de un terrible virus creado por el hombre. Él ha sobrevivido porque es inmune al virus; todos los días envía mensajes por radio con la esperanza de que haya otros supervivientes, pero es inútil. Lo único que puede hacer es buscar una fórmula que le permita utilizar su sangre inmune para devolverles a los hombres su naturaleza. Pero está en inferioridad de condiciones y el tiempo se acaba.","posterPath":"https://image.tmdb.org/t/p/w500/pO1SrJgf5BumqcIRkYviSGIFdmX.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/aTLq0TMKdsmIy1ZyFM1LfPs326d.jpg","voteAverage":7.2,"voteCount":16803,"releaseDate":"2007-12-12","genres":["Drama","Ciencia ficción","Suspense"],"type":"movie","platforms":[],"tmdbId":6479,"runtime":"$undefined","seasons":"$undefined"},{"id":1621,"title":"Entre pillos anda el juego","originalTitle":"Entre pillos anda el juego","overview":"Dos hombres de negocios sostienen distintas tesis sobre las condiciones de la naturaleza humana. Para uno es cuestión de genética, para el otro es cuestión de educación. Para corroborar sus teorías hacen una apuesta para lo cual cambian los destinos de dos personas socialmente antagónicas.","posterPath":"https://image.tmdb.org/t/p/w500/bwmqcucVleqUTKUKw7K3hlvUGKC.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/3FO1kbQmRlU1H6Kmn7sTfmd7mw9.jpg","voteAverage":7.2,"voteCount":3650,"releaseDate":"1983-06-07","genres":["Comedia"],"type":"movie","platforms":[],"tmdbId":1621,"runtime":"$undefined","seasons":"$undefined"},{"id":578,"title":"Tiburón","originalTitle":"Tiburón","overview":"En la costa de un pequeño pueblo del Este de Estados Unidos, un enorme tiburón ataca a varias personas. Temiendo las fatales consecuencias que esto puede provocar en el negocio turístico, el alcalde se niega a cerrar las playas y a difundir la noticia. Pero un nuevo ataque del tiburón, en la propia playa, termina con la vida de otro bañista. El terror se ha hecho público, así que un veterano cazador de tiburones, un científico y el jefe de la policía local se unen para dar caza al temible escualo...","posterPath":"https://image.tmdb.org/t/p/w500/aCqHb3eFQV8raX30OfGurqPlpjh.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/i1yf91svRHX45l9BXL8rVFzLoPH.jpg","voteAverage":7.7,"voteCount":11503,"releaseDate":"1975-06-20","genres":["Terror","Suspense","Aventura"],"type":"movie","platforms":[],"tmdbId":578,"runtime":"$undefined","seasons":"$undefined"},{"id":615457,"title":"Nadie","originalTitle":"Nadie","overview":"Hutch Mansell, un padre de familia que aguanta con resignación y sin defenderse los golpes de la vida. Un don nadie.  Una noche, cuando dos ladrones entran en su casa, Hutch decide no actuar y no trata de defenderse ni al él mismo ni a su familia, convencido de que solo así evitará una escalada de violencia. Tras el ataque, su hija adolescente Blake no oculta su decepción, y su esposa Becca se aleja todavía más.","posterPath":"https://image.tmdb.org/t/p/w500/ddO5a3tMPpQutSDQO1bESgLWadB.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/61MrK5U4w4MVL1vfwoG12zYPJ8B.jpg","voteAverage":7.9,"voteCount":8310,"releaseDate":"2021-03-18","genres":["Acción","Suspense"],"type":"movie","platforms":[],"tmdbId":615457,"runtime":"$undefined","seasons":"$undefined"},{"id":28,"title":"Apocalypse Now","originalTitle":"Apocalypse Now","overview":"Durante la guerra de Vietnam, al joven Capitán Willard, un oficial de los servicios de inteligencia del ejército estadounidense, se le ha encomendado entrar en Camboya con la peligrosa misión de eliminar a Kurtz, un coronel renegado que se ha vuelto loco. El capitán deberá ir navegar por el río hasta el corazón de la selva, donde parece ser que Kurtz reina como un buda despótico sobre los miembros de la tribu Montagnard, que le adoran como a un dios.","posterPath":"https://image.tmdb.org/t/p/w500/zJXRrkJTlcb5x87v4VWN1zZX0Xk.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/49fzLedFVKgGgFChLMuulDJBY1c.jpg","voteAverage":8.3,"voteCount":9068,"releaseDate":"1979-05-19","genres":["Drama","Bélica"],"type":"movie","platforms":[],"tmdbId":28,"runtime":"$undefined","seasons":"$undefined"},{"id":985939,"title":"Fall","originalTitle":"Fall","overview":"Para las mejores amigas Becky y Hunter, la vida trata de superar tus miedos y empujar tus límites. Sin embargo, después de subir hasta la cima de una torre de comunicaciones abandonada, se encuentran atrapadas y sin forma de bajar. A 600 metros del suelo y totalmente alejadas de la civilización, las chicas pondrán a prueba sus habilidades de escaladoras expertas y lucharán desesperadamente por sobrevivir aunque lo tengan todo en contra. ¿Lo conseguirán?","posterPath":"https://image.tmdb.org/t/p/w500/tsjVxiuGyvMC4IbI2gjmDYpcYjU.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/hT3OqvzMqCQuJsUjZnQwA5NuxgK.jpg","voteAverage":7.1,"voteCount":4562,"releaseDate":"2022-08-11","genres":["Suspense"],"type":"movie","platforms":[],"tmdbId":985939,"runtime":"$undefined","seasons":"$undefined"},{"id":436969,"title":"El escuadrón suicida","originalTitle":"El escuadrón suicida","overview":"Un grupo de super villanos se encuentran encerrados en Belle Reve, una prisión de alta seguridad con la tasa de mortalidad más alta de Estados Unidos. Para salir de allí harán cualquier cosa, incluso unirse al grupo Task Force X, dedicado a llevar a cabo misiones suicidas bajo las órdenes de Amanda Waller. Fuertemente armados son enviados a la isla Corto Maltese, una jungla repleta de enemigos.","posterPath":"https://image.tmdb.org/t/p/w500/fPJWlhXA2VXf4MlQ3JenVsz1iba.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/jlGmlFOcfo8n5tURmhC7YVd4Iyy.jpg","voteAverage":7.5,"voteCount":9560,"releaseDate":"2021-07-28","genres":["Acción","Comedia","Aventura"],"type":"movie","platforms":[],"tmdbId":436969,"runtime":"$undefined","seasons":"$undefined"},{"id":1124,"title":"El truco final (El prestigio)","originalTitle":"El truco final (El prestigio)","overview":"Robert Angier es un ilusionista respetado que se obsesiona con uno de los trucos de su rival Alfred Borden. Para conseguir el truco hará todo lo posible, sin saber hasta qué punto cambiará su vida...","posterPath":"https://image.tmdb.org/t/p/w500/lIl2CrnWohGrZSO9eyKRptxZ7Hs.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/z3br1ub7spqGMkxgjgJSdM4DC21.jpg","voteAverage":8.2,"voteCount":17546,"releaseDate":"2006-10-19","genres":["Drama","Misterio","Ciencia ficción"],"type":"movie","platforms":[],"tmdbId":1124,"runtime":"$undefined","seasons":"$undefined"},{"id":772,"title":"Solo en casa 2: Perdido en Nueva York","originalTitle":"Solo en casa 2: Perdido en Nueva York","overview":"En plenas fiestas navideñas, el pequeño Kevin y su familia están a punto de coger un avión para disfrutar de unas pequeñas vacaciones, pero Kevin se equivoca y embarca en un avión que lo lleva a Nueva York, donde vuelve a encontrarse solo y desprotegido.","posterPath":"https://image.tmdb.org/t/p/w500/7sdiRUyc0ANHJptPhsgb1KL6hoq.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/8fnYJPoXxwAN4valDLgz2whMGTH.jpg","voteAverage":6.8,"voteCount":10596,"releaseDate":"1992-11-15","genres":["Comedia","Familia","Aventura"],"type":"movie","platforms":[],"tmdbId":772,"runtime":"$undefined","seasons":"$undefined"},{"id":301528,"title":"Toy Story 4","originalTitle":"Toy Story 4","overview":"Woody siempre ha tenido claro cuál es su labor en el mundo y cuál es su prioridad: cuidar a su dueño, ya sea Andy o Bonnie. Sin embargo, Woody descubrirá lo grande que puede ser el mundo para un juguete cuando Forky se convierta en su nuevo compañero de habitación. Los juguetes se embarcarán en una aventura de la que no se olvidarán jamás.","posterPath":"https://image.tmdb.org/t/p/w500/yF1vPDuHVrAUMX5dy1tVMbAjkEL.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/q62bpQ67qaXY0u6b2wFEnQYIbPd.jpg","voteAverage":7.5,"voteCount":10492,"releaseDate":"2019-06-19","genres":["Familia","Comedia","Animación","Aventura"],"type":"movie","platforms":[],"tmdbId":301528,"runtime":"$undefined","seasons":"$undefined"},{"id":524047,"title":"Greenland: El último refugio","originalTitle":"Greenland: El último refugio","overview":"Cuando el mundo es consciente de que el asteroide más grande de la historia va a impactar en la Tierra y aniquilar todo rastro de vida, los gobiernos de todo el mundo realizan un sorteo en el cual los afortunados podrán sobrevivir en refugios secretos. Esta decisión desata un caos a nivel mundial. Muchos tendrán que emprender un peligroso viaje donde se enfrentarán a los más imponentes peligros de la naturaleza, lo que les obligará a encontrar la manera de mantenerse unidos mientras encuentran la forma de sobrevivir.","posterPath":"https://image.tmdb.org/t/p/w500/9iFkwShRf5M29yLABAdsEZyr9w6.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/uorMP2U1F0AfogYMz4lYu2EbgYo.jpg","voteAverage":7.1,"voteCount":5276,"releaseDate":"2020-07-29","genres":["Suspense","Aventura","Acción","Ciencia ficción"],"type":"movie","platforms":[],"tmdbId":524047,"runtime":"$undefined","seasons":"$undefined"},{"id":679,"title":"Aliens: El regreso","originalTitle":"Aliens: El regreso","overview":"Alien es un organismo perfecto, una máquina de matar cuya superioridad física sólo puede competir con su agresividad. La oficial Ripley y la tripulación de la nave «Nostromo» se habían enfrentado, en el pasado, a esa monstruosa criatura. Y sólo Ripley sobrevivió a la masacre. Después de vagar por el espacio durante varios años, Ripley fue rescatada. Durante ese tiempo, el planeta de Alien ha sido colonizado. Pero, de repente, se pierde la comunicación con la colonia y, para investigar los motivos, se envía una expedición de marines espaciales, capitaneados por Ripley. Allí les esperan miles de espeluznantes criaturas. Alien se ha reproducido y esta vez la lucha es por la supervivencia de la Humanidad.","posterPath":"https://image.tmdb.org/t/p/w500/3QU9EP8BFLnTh6w9ycDSCvhqbRU.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/4kix6fAblJIH6eMs0Ku2loyZJXK.jpg","voteAverage":8,"voteCount":10821,"releaseDate":"1986-07-18","genres":["Acción","Suspense","Ciencia ficción"],"type":"movie","platforms":[],"tmdbId":679,"runtime":"$undefined","seasons":"$undefined"},{"id":912649,"title":"Venom: El último baile","originalTitle":"Venom: El último baile","overview":"Eddie y Venom están a la fuga. Perseguidos por sus sendos mundos y cada vez más cercados, el dúo se ve abocado a tomar una decisión devastadora que hará que caiga el telón sobre el último baile de Venom y Eddie.","posterPath":"https://image.tmdb.org/t/p/w500/toZiAd0n0NKhiuHTiGk7kBMmhtG.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/3V4kLQg0kSqPLctI5ziYWabAZYF.jpg","voteAverage":6.7,"voteCount":4196,"releaseDate":"2024-10-22","genres":["Ciencia ficción","Acción","Aventura"],"type":"movie","platforms":[],"tmdbId":912649,"runtime":"$undefined","seasons":"$undefined"},{"id":573435,"title":"Bad Boys: Ride or Die","originalTitle":"Bad Boys: Ride or Die","overview":"Los policías más famosos del mundo regresan con su icónica mezcla de acción al límite y comedia escandalosa, pero esta vez con un giro inesperado: ¡Los mejores de Miami se dan a la fuga! Cuarta entrega de la saga 'Dos policías rebeldes'.","posterPath":"https://image.tmdb.org/t/p/w500/53y0ETa1TGdVrMEVx7oLW86ay8r.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/3q01ACG0MWm0DekhvkPFCXyPZSu.jpg","voteAverage":7.3,"voteCount":3318,"releaseDate":"2024-06-05","genres":["Acción","Comedia","Crimen"],"type":"movie","platforms":[],"tmdbId":573435,"runtime":"$undefined","seasons":"$undefined"},{"id":9806,"title":"Los Increíbles","originalTitle":"Los Increíbles","overview":"Como Mr. Increíble y Elastigirl, Bob y su esposa Helen estaban entre los mejores luchadores contra el crimen. Por fin pueden volver a la acción cuando una misteriosa llamada cita a Bob en una isla remota.","posterPath":"https://image.tmdb.org/t/p/w500/al1jusd4T7JPatZlj4BuYkDDOzr.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/lxwzY9vNwjDgxWKt3zZ6zcU6rEJ.jpg","voteAverage":7.7,"voteCount":18849,"releaseDate":"2004-10-27","genres":["Acción","Aventura","Animación","Familia"],"type":"movie","platforms":[],"tmdbId":9806,"runtime":"$undefined","seasons":"$undefined"},{"id":694,"title":"El resplandor","originalTitle":"El resplandor","overview":"Jack Torrance se traslada, junto a su mujer y a su hijo, al impresionante hotel Overlook, en Colorado, para encargarse del mantenimiento del mismo durante la temporada invernal, en la que permanece cerrado y aislado por la nieve. Su idea es escribir su novela al tiempo que cuida de las instalaciones durante esos largos y solitarios meses de invierno, pero desde su llegada al hotel, Jack comienza a padecer inquietantes transtornos de personalidad, al mismo tiempo que en el lugar comienzan a suceder diversos fenómenos paranormales.","posterPath":"https://image.tmdb.org/t/p/w500/mm003Mj2e9kJRsrxiVdPn2BSBPh.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/mmd1HnuvAzFc4iuVJcnBrhDNEKr.jpg","voteAverage":8.2,"voteCount":18886,"releaseDate":"1980-05-23","genres":["Terror","Suspense"],"type":"movie","platforms":[],"tmdbId":694,"runtime":"$undefined","seasons":"$undefined"},{"id":62,"title":"2001: Una odisea del espacio","originalTitle":"2001: Una odisea del espacio","overview":"Mientras investigan la aparición de misteriosos monolitos en el universo, dos astronautas luchan contra la inteligencia artificial de su nave.","posterPath":"https://image.tmdb.org/t/p/w500/sln50uQYigvu5AvN72JfYfu1ckq.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/w5IDXtifKntw0ajv2co7jFlTQDM.jpg","voteAverage":8.1,"voteCount":12561,"releaseDate":"1968-04-02","genres":["Ciencia ficción","Misterio","Aventura"],"type":"movie","platforms":[],"tmdbId":62,"runtime":"$undefined","seasons":"$undefined"},{"id":10625,"title":"Chicas malas","originalTitle":"Chicas malas","overview":"Una joven adolescente, Cady, acostumbrada a vivir en África con sus padres, zoólogos, se encuentra una nueva jungla cuando se muda a Illinois. Allí acude a la escuela pública, donde se enamorará del ex-novio de la chica más popular del colegio. Las chicas comenzarán a hacer la vida imposible a Cady, y ésta no tendrá otro remedio que usar sus mismas tácticas para mantenerse a flote.","posterPath":"https://image.tmdb.org/t/p/w500/fVHCoj809sonJJDvOF9hqCVZPRx.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/nP3y0TkR6XniFs9J53qQkg4Bnnk.jpg","voteAverage":7.2,"voteCount":9433,"releaseDate":"2004-04-30","genres":["Drama","Comedia"],"type":"movie","platforms":[],"tmdbId":10625,"runtime":"$undefined","seasons":"$undefined"},{"id":10674,"title":"Mulán","originalTitle":"Mulán","overview":"Mulán, una joven china hija única de la familia Fa, en lugar de buscar novio, como sus amigas, trata por todos los medios de alistarse en el ejército imperial para evitar que su anciano padre sea llamado a filas para defender al Emperador del acoso de los Hunos. Cuando el emisario imperial lleva a cabo la orden de reclutar a los varones de todas las familias, Mulán se hará pasar por soldado y se someterá a un duro entrenamiento hasta hacerse merecedora de la estima y de la confianza del resto de su escuadrón.","posterPath":"https://image.tmdb.org/t/p/w500/towmTJ0k29quKI9IDnOZKAAtQx.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/mUYV0ZdsDEliGaQahcQH1F3grsP.jpg","voteAverage":7.9,"voteCount":10394,"releaseDate":"1998-06-18","genres":["Animación","Familia","Aventura"],"type":"movie","platforms":[],"tmdbId":10674,"runtime":"$undefined","seasons":"$undefined"},{"id":242,"title":"El Padrino Parte III","originalTitle":"El Padrino Parte III","overview":"Michael Corleone, heredero del imperio de don Vito Corleone, intenta rehabilitarse socialmente y legitimar todas las posesiones de la familia negociando con el Vaticano. Después de luchar toda su vida se encuentra cansado y centra todas sus esperanzas en encontrar un sucesor que se haga cargo de los negocios. Vincent, el hijo ilegítimo de su hermano Sonny, parece ser el elegido.","posterPath":"https://image.tmdb.org/t/p/w500/l2D8Gzuzw8hN41UthdqM9Osu9I3.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/8zhviPFJx25k8PbUOUL5sLOy9XE.jpg","voteAverage":7.4,"voteCount":6838,"releaseDate":"1990-12-25","genres":["Crimen","Drama","Suspense"],"type":"movie","platforms":[],"tmdbId":242,"runtime":"$undefined","seasons":"$undefined"},{"id":812,"title":"Aladdin","originalTitle":"Aladdin","overview":"Aladdín es un ingenioso joven que vive en una extrema pobreza, y que sueña con casarse con la bella hija del sultán, la princesa Jasmine. El destino interviene cuando el astuto visir del Sultán, Jafar, recluta a Aladdín para que le ayude a recuperar una lámpara mágica de las profundidades de la Cueva de las Maravillas. Aladdín encuentra una lámpara maravillosa con un genio dentro, y sus deseos comienzan a hacerse realidad.","posterPath":"https://image.tmdb.org/t/p/w500/5ALwczKzFxbsiMDlHuy7aREDCzr.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/nenJjvfe2Eq8uBMXFJnWj5mw4bi.jpg","voteAverage":7.7,"voteCount":11993,"releaseDate":"1992-11-25","genres":["Animación","Familia","Aventura","Fantasía","Romance"],"type":"movie","platforms":[],"tmdbId":812,"runtime":"$undefined","seasons":"$undefined"},{"id":713704,"title":"Posesión infernal: El despertar","originalTitle":"Posesión infernal: El despertar","overview":"Historia de dos hermanas separadas cuyo reencuentro se ve interrumpido por el surgimiento de demonios poseedores de carne, empujándolos a una batalla por la supervivencia mientras se enfrentan a la versión de familia más aterradora que se pueda imaginar. Secuela de la trilogía original de 'Evil Dead'.","posterPath":"https://image.tmdb.org/t/p/w500/ioMtng0qHbwNjR1fuxYZsRf1kjm.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/7bWxAsNPv9CXHOhZbJVlj2KxgfP.jpg","voteAverage":6.9,"voteCount":3652,"releaseDate":"2023-04-12","genres":["Terror","Suspense"],"type":"movie","platforms":[],"tmdbId":713704,"runtime":"$undefined","seasons":"$undefined"},{"id":12155,"title":"Alicia en el País de las Maravillas","originalTitle":"Alicia en el País de las Maravillas","overview":"Alicia, una joven de 19 años, asiste a una fiesta en una mansión victoriana, donde descubre que está a punto de recibir una propuesta de matrimonio frente a un montón de gente estirada de la alta sociedad. Alicia entonces se escapa, corriendo tras un conejo blanco, entra a un agujero tras él... y acaba en el país de las Maravillas, un lugar que visitó hace 10 años, pero el cual no recuerda. El país de las Maravillas era un reino pacífico hasta que la Reina Roja derrocó a su hermana, la Reina Blanca. Las criaturas del país de las maravillas, listos para la revuelta, esperan que Alicia les ayude, y éstas a su vez le ayudarán a recordar su primera visita al mágico reino.","posterPath":"https://image.tmdb.org/t/p/w500/sqOyCSgzLglxcR2y1boewr5Qufn.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/ocOWbTzHcJVTw9Tz173KPeskDOP.jpg","voteAverage":6.6,"voteCount":14772,"releaseDate":"2010-03-03","genres":["Familia","Fantasía","Aventura"],"type":"movie","platforms":[],"tmdbId":12155,"runtime":"$undefined","seasons":"$undefined"},{"id":43347,"title":"Amor y otras drogas","originalTitle":"Amor y otras drogas","overview":"Maggie es una mujer independiente que ha decidido vivir sin ataduras. Pero conoce a Jamie, un joven cuyo irresistible encanto funciona no sólo con las mujeres, sino también dentro del despiadado mundo de las ventas farmacéuticas. La relación entre Maggie y Jamie, para sorpresa de ambos, desemboca en amor. La película se basa en una historia real: la de Jamie Reidy, un vendedor de Pfizer (laboratorio que desarrolló la Viagra), quien sacó a la luz algunas prácticas dudosas empleadas por estas compañías farmacéuticas.","posterPath":"https://image.tmdb.org/t/p/w500/b8gw9s7hWbcA0kuezuV10DKgjRP.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/fGBJEfGjHmhg7nLAT0Jkcv9qV5e.jpg","voteAverage":7,"voteCount":5592,"releaseDate":"2010-11-22","genres":["Drama","Comedia","Romance"],"type":"movie","platforms":[],"tmdbId":43347,"runtime":"$undefined","seasons":"$undefined"},{"id":272,"title":"Batman Begins","originalTitle":"Batman Begins","overview":"¿Cómo cambia un hombre el mundo? Es una pregunta que obsesiona a Bruce Wayne al igual que el fantasma de sus padres, muertos a tiros ante sus ojos en las calles de Gotham una noche que cambió su vida para siempre. Atormentado por la culpa y la ira, el desilusionado heredero industrial desaparece de Gotham y viaja en secreto por el mundo, buscando los medios de luchar contra la injusticia y utilizar el miedo contra los que se aprovechan de los que tienen miedo. Con la ayuda de su leal mayordomo Alfred, el detective Jim Gordon - uno de los pocos buenos policías de las fuerzas del orden público de Gotham - y Lucius Fox, su aliado en la división de Ciencias Aplicadas de Wayne Enterprises, Bruce Wayne libera a su imponente alter ego: Batman, un justiciero enmascarado que utiliza la fuerza, la inteligencia y un despliegue de artefactos de alta tecnología para combatir las fuerzas siniestras que amenazan con destruir la ciudad.","posterPath":"https://image.tmdb.org/t/p/w500/6yMWU1vWkOBbNRIwOxhetd2aHhO.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/9IIBboV7MCT0bTxzXHmWK1Hq558.jpg","voteAverage":7.7,"voteCount":22557,"releaseDate":"2005-06-10","genres":["Drama","Crimen","Acción"],"type":"movie","platforms":[],"tmdbId":272,"runtime":"$undefined","seasons":"$undefined"},{"id":168259,"title":"Fast & Furious 7","originalTitle":"Fast & Furious 7","overview":"Ha pasado un año desde que el equipo de Dominic Torreto y Brian pudiera regresar finalmente a Estados Unidos, tras ser indultados. Desean adaptarse a una vida en la legalidad, pero el entorno ya no es el mismo. Dom intenta acercarse a Letty, y Brian lucha para acostumbrarse a la vida en una urbanización con Mia y su hijo. Ninguno de ellos imagina que un frío asesino británico, entrenado para realizar operaciones secretas, se cruzará en sus vidas para convertirse en su mayor enemigo.","posterPath":"https://image.tmdb.org/t/p/w500/yWG5W4tKCQweHEdnKV4YEvqOBGx.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/ehzI1mVcnHqB58NqPyQwpMqcVoz.jpg","voteAverage":7.2,"voteCount":11262,"releaseDate":"2015-04-01","genres":["Acción","Crimen","Suspense"],"type":"movie","platforms":[],"tmdbId":168259,"runtime":"$undefined","seasons":"$undefined"},{"id":14161,"title":"2012","originalTitle":"2012","overview":"El geólogo Adrian Helmsley, descubre de que el núcleo de la Tierra se está calentando. Teme que la corteza se vuelva inestable, coincidiendo con las predicciones mayas del fin del mundo. Entre tanto, los líderes del mundo \"venden\" plazas para escapar del cataclismo. El escritor Curtis Jackson tropieza con esa información... y luchará por salvar a su familia mientras el suelo se hunde bajo sus pies, y los terremotos y las erupciones volcánicas destruyen el mundo tal y como lo conocemos.","posterPath":"https://image.tmdb.org/t/p/w500/gWE2GIrIqqf1OLV2Talxph11MC.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/4P71rDf6roxVskbvdcbNayVMpXd.jpg","voteAverage":5.9,"voteCount":12718,"releaseDate":"2009-10-10","genres":["Acción","Aventura","Ciencia ficción"],"type":"movie","platforms":[],"tmdbId":14161,"runtime":"$undefined","seasons":"$undefined"},{"id":9470,"title":"Kung Fu Sion","originalTitle":"Kung Fu Sion","overview":"Ambientada en el caos de la China prerrevolucionaria, un ladrón de poca monta, Sing (Ste-phen Chow), aspira a ser uno de los crueles y sofisticados miembros de la Banda del Hacha cuyas actividades ilegales ensombrecen la ciudad. Sing intenta extorsionar a uno de los habitantes de un complejo de apartamentos llamado 'Pig Sty Alley', pero los vecinos no son lo que parecen. Sin pretenderlo, los cómicos intentos de intimidación de Sing atraen a la Banda del Hacha, desencadenando una serie de sucesos que enfrentan cara a cara los dos mundos tan diferentes. Mientras los habitantes de Pig Sty luchan por sus vidas, el choque de titanes de kung fu que sigue desentierra algunos maestros legendarios de artes marciales.","posterPath":"https://image.tmdb.org/t/p/w500/cMVfbypyu34ckTBgMsoRT92j2pN.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/9XhZhoSnFJ3AjpfzdIiZVHLQIS4.jpg","voteAverage":7.5,"voteCount":3167,"releaseDate":"2004-02-10","genres":["Acción","Comedia","Crimen","Fantasía"],"type":"movie","platforms":[],"tmdbId":9470,"runtime":"$undefined","seasons":"$undefined"},{"id":209112,"title":"Batman vs Superman: El amanecer de la justicia","originalTitle":"Batman vs Superman: El amanecer de la justicia","overview":"Ante el temor de las acciones que pueda llevar a cabo Superman, el vigilante de Gotham City aparece para poner a raya al superhéroe de Metrópolis, mientras que la opinión pública debate cuál es realmente el héroe que necesitan. El hombre de acero y Batman se sumergen en una contienda territorial, pero las cosas se complican cuando una nueva y peligrosa amenaza surge rápidamente, poniendo en jaque la existencia de la humanidad.","posterPath":"https://image.tmdb.org/t/p/w500/mS3t9puIjLKgoex82cu9d6G0835.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/5fX1oSGuYdKgwWmUTAN5MNSQGzr.jpg","voteAverage":6,"voteCount":18952,"releaseDate":"2016-03-23","genres":["Acción","Aventura","Fantasía"],"type":"movie","platforms":[],"tmdbId":209112,"runtime":"$undefined","seasons":"$undefined"},{"id":102382,"title":"The Amazing Spider-Man 2: El poder de Electro","originalTitle":"The Amazing Spider-Man 2: El poder de Electro","overview":"Peter Parker lleva una vida muy ocupada, compaginando su tiempo entre su papel como Spider-Man, acabando con los malos, y en el instituto con la persona a la que quiere, Gwen. Peter no ve el momento de graduarse. No ha olvidado la promesa que le hizo al padre de Gwen de protegerla, manteniéndose lejos de ella, pero es una promesa que simplemente no puede cumplir. Las cosas cambiarán para Peter cuando aparece un nuevo villano, Electro, y un viejo amigo, Harry Osborn, regresa, al tiempo que descubre nuevas pistas sobre su pasado.","posterPath":"https://image.tmdb.org/t/p/w500/8W0mMrmaVdSoLz5LnX61gJOXfEb.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/u7SeO6Y42P7VCTWLhpnL96cyOqd.jpg","voteAverage":6.5,"voteCount":14195,"releaseDate":"2014-04-16","genres":["Acción","Aventura","Ciencia ficción"],"type":"movie","platforms":[],"tmdbId":102382,"runtime":"$undefined","seasons":"$undefined"},{"id":1072790,"title":"Cualquiera menos tú","originalTitle":"Cualquiera menos tú","overview":"Bea y Ben se conocen y parecen la pareja perfecta, pero tras una increíble primera cita sucede algo que enfría su fuerte atracción, hasta que meses después ambos se encuentran inesperadamente en una boda en Australia. Obligados a verse, y a pesar de su rechazo mutuo, por conveniencia para ambos deciden fingir que son una pareja.","posterPath":"https://image.tmdb.org/t/p/w500/6dkuwwLJJmpzb6n5pbok1DMN7WV.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/j9eOeLlTGoHoM8BNUJVNyWmIvCi.jpg","voteAverage":6.8,"voteCount":3055,"releaseDate":"2023-12-21","genres":["Romance","Comedia"],"type":"movie","platforms":[],"tmdbId":1072790,"runtime":"$undefined","seasons":"$undefined"},{"id":637,"title":"La vida es bella","originalTitle":"La vida es bella","overview":"En 1939, a punto de estallar la Segunda Guerra Mundial (1939-1945), el extravagante Guido llega a Arezzo, en la Toscana, con la intención de abrir una librería. Allí conoce a la encantadora Dora y, a pesar de que es la prometida del fascista Rodolfo, se casa con ella y tiene un hijo. Al estallar la guerra, los tres son internados en un campo de exterminio, donde Guido hará lo imposible para hacer creer a su hijo que la terrible situación que están padeciendo es tan sólo un juego.","posterPath":"https://image.tmdb.org/t/p/w500/aZ7MFlKPfB02Lr9NwZQ4vsYRgcy.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/6aNKD81RHR1DqUUa8kOZ1TBY1Lp.jpg","voteAverage":8.4,"voteCount":13967,"releaseDate":"1997-12-20","genres":["Comedia","Drama"],"type":"movie","platforms":[],"tmdbId":637,"runtime":"$undefined","seasons":"$undefined"},{"id":137113,"title":"Al filo del mañana","originalTitle":"Al filo del mañana","overview":"En un futuro no muy lejano, invade la Tierra una raza de extraterrestres invencibles. Al comandante William Cage, un oficial que nunca ha entrado en combate, le encargan una misión casi suicida y resulta muerto. Entra entonces en un bucle temporal, en el que se ve obligado a luchar y morir una y otra vez. Pero las múltiples batallas que libra lo hacen cada vez más hábil y eficaz en su lucha contra los alienígenas. Su compañera de combate es Rita Vrataski, una guerrera de las Fuerzas Especiales. Adaptación del manga de Hiroshi Sakurazaka.","posterPath":"https://image.tmdb.org/t/p/w500/vNjwi0STOwzmwE9laZSMYYh2JPE.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/4V1yIoAKPMRQwGBaSses8Bp2nsi.jpg","voteAverage":7.6,"voteCount":15025,"releaseDate":"2014-05-27","genres":["Acción","Ciencia ficción"],"type":"movie","platforms":[],"tmdbId":137113,"runtime":"$undefined","seasons":"$undefined"},{"id":271110,"title":"Capitán América: Civil War","originalTitle":"Capitán América: Civil War","overview":"Continúa la historia de “Avengers: Age of Ultron”, con Steve Rogers liderando un nuevo equipo de Vengadores en su esfuerzo por proteger a la humanidad. Tras otro incidente internacional relacionado con los Vengadores que ocasiona daños colaterales, la presión política fuerza a crear un sistema de registro y un cuerpo gubernamental para determinar cuándo se requiere los servicios del equipo. El nuevo status quo divide a los Vengadores mientras intentan salvar al mundo de un nuevo y perverso villano.","posterPath":"https://image.tmdb.org/t/p/w500/jPPy7tCfglppQo6J9nGwU6UmJ8X.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/7FWlcZq3r6525LWOcvO9kNWurN1.jpg","voteAverage":7.4,"voteCount":23994,"releaseDate":"2016-04-27","genres":["Aventura","Acción","Ciencia ficción"],"type":"movie","platforms":[],"tmdbId":271110,"runtime":"$undefined","seasons":"$undefined"},{"id":493922,"title":"Hereditary","originalTitle":"Hereditary","overview":"Cosas extrañas comienzan a suceder en casa de los Graham tras la muerte de la abuela y matriarca, que deja en herencia su casa a su hija Annie. Annie Graham, una galerista casada y con dos hijos, no tuvo una infancia demasiado feliz junto a su madre, y cree que la muerte de ésta puede hacer que pase página. Pero todo se complica cuando su hija menor comienza a ver figuras fantasmales, que también empiezan a aparecer ante su hermano.","posterPath":"https://image.tmdb.org/t/p/w500/oE5TS72U6tNdXKK42HpF2NULv4u.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/gJbTXKNTL6O7r7PzF6ZRkJGBlPp.jpg","voteAverage":7.3,"voteCount":8547,"releaseDate":"2018-06-07","genres":["Terror","Misterio","Suspense"],"type":"movie","platforms":[],"tmdbId":493922,"runtime":"$undefined","seasons":"$undefined"},{"id":841755,"title":"Mortal Kombat Leyendas: La Batalla de los Reinos","originalTitle":"Mortal Kombat Leyendas: La Batalla de los Reinos","overview":"Tras ganar el primer torneo de Mortal Kombat: Liu Kang, Sonya Blade y Johnny Cage, deberán entrar al reino de Outworld, para decidir el destino de la humanidad.","posterPath":"https://image.tmdb.org/t/p/w500/ikSqxoxcIMq6tG3cCpO0KFt5PQ5.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/dssCw0mUmD4EriUmkwB3PnsGu4q.jpg","voteAverage":7.6,"voteCount":495,"releaseDate":"2021-08-30","genres":["Animación","Acción","Fantasía"],"type":"movie","platforms":[],"tmdbId":841755,"runtime":"$undefined","seasons":"$undefined"},{"id":2288,"title":"Closer","originalTitle":"Closer","overview":"Una historia de pasiones, sexo, amor y abandono que involucra a dos parejas, con una situación que se complica cuando el hombre de la primera pareja conoce a la mujer de la segunda pareja.","posterPath":"https://image.tmdb.org/t/p/w500/4Sqs6uA6nitoMDTQs9lZE22ln2v.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/s7oDV92ltdecJ7BTfGSOgsDi900.jpg","voteAverage":6.8,"voteCount":3737,"releaseDate":"2004-12-03","genres":["Drama","Romance"],"type":"movie","platforms":[],"tmdbId":2288,"runtime":"$undefined","seasons":"$undefined"},{"id":82702,"title":"Cómo entrenar a tu dragón 2","originalTitle":"Cómo entrenar a tu dragón 2","overview":"Han pasado cinco años desde que Hipo empezó a entrenar a su dragón, rompiendo la tradición vikinga de cazarlos. Astrid y el resto de la pandilla han conseguido difundir en la isla un nuevo deporte: las carreras de dragones. Mientras realizan una carrera, atraviesan los cielos llegando a territorios inhóspitos, donde nadie antes ha estado. Durante un viaje descubren una cueva cubierta de hielo que resulta ser el refugio de cientos de dragones salvajes, a los que cuida un misterioso guardián. Hipo y los suyos se unen al guardián para proteger a los dragones de las fuerzas malignas que quieren acabar con ellos.","posterPath":"https://image.tmdb.org/t/p/w500/bXcRw7FL8QzUZOvY2fZdwDv5ymQ.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/8AAuJtCzaibYkbE0QVHc8EBsELB.jpg","voteAverage":7.7,"voteCount":10416,"releaseDate":"2014-06-05","genres":["Fantasía","Acción","Aventura","Animación","Familia"],"type":"movie","platforms":[],"tmdbId":82702,"runtime":"$undefined","seasons":"$undefined"},{"id":2251,"title":"Infiel","originalTitle":"Infiel","overview":"El matrimonio de Edward (Richard Gere) y Connie Sumner (Diane Lane) parece ir bien: tienen dinero, posición, un niño y una bonita casa en un barrio residencial de las afueras de Nueva York. Pero un día, en Manhattan, Connie conoce a Paul (Olivier Martinez), un joven y atractivo coleccionista de libros de origen francés. Ambos comienzan una relación adúltera de insospechadas consecuencias.","posterPath":"https://image.tmdb.org/t/p/w500/9UeN5JUCvJU3SuA4a9CrCVzgTr2.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/egVj5Y9f79xPnyAQJmeDR0Uwow3.jpg","voteAverage":6.7,"voteCount":1708,"releaseDate":"2002-05-10","genres":["Suspense","Drama","Romance"],"type":"movie","platforms":[],"tmdbId":2251,"runtime":"$undefined","seasons":"$undefined"},{"id":1422,"title":"Infiltrados","originalTitle":"Infiltrados","overview":"El Departamento de Policía de Massachussets se enfrenta a la mayor banda de crimen organizado de la ciudad de Boston. La estrategia consiste en acabar desde dentro con Frank Costello, el poderoso jefe de la mafia irlandesa. El encargado de infiltrarse en la banda es un joven novato, Billy Costigan. Mientras Billy intenta ganarse la confianza de Costello, otro joven policía, Colin Sullivan, sube rápidamente de categoría y ocupa un puesto en la unidad de Investigaciones Especiales, grupo de élite cuya misión también es acabar con Costello. Lo que nadie sabe es que Colin es un topo infiltrado en la policía por el propio Costello.","posterPath":"https://image.tmdb.org/t/p/w500/hf0Hgw1snmBwinkHYLCxGIs6DgO.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/6WRrGYalXXveItfpnipYdayFkQB.jpg","voteAverage":8.2,"voteCount":16156,"releaseDate":"2006-10-04","genres":["Drama","Suspense","Crimen"],"type":"movie","platforms":[],"tmdbId":1422,"runtime":"$undefined","seasons":"$undefined"},{"id":6977,"title":"No es país para viejos","originalTitle":"No es país para viejos","overview":"El veterano de la Guerra de Vietnam ahora cazador Llewellyn Moss descubre por casualidad una sangrienta escena en algún lugar de la frontera entre Texas y México, mientras estaba cazando algunos animales en el árido paisaje. Se trata de un negocio que se cerró mal entre contrabandistas de drogas y algunos hombres locales de la zona, provocando la muerte de varios de ellos. Además de los cuerpos y paquetes de heroína, Llewellyn descubre en una maleta algo más de dos millones de dólares. Cuando Llewellyn toma la maleta con el dinero, provoca una reacción en cadena de catastrófica violencia y una carrera sangrienta de los que quieren darle caza.","posterPath":"https://image.tmdb.org/t/p/w500/x9sQnOXhvec93L6cfWMGIx7BS4h.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/gddUsvfyySrM5k8B8wwJy2VRlBx.jpg","voteAverage":8,"voteCount":13275,"releaseDate":"2007-11-09","genres":["Crimen","Suspense","Western"],"type":"movie","platforms":[],"tmdbId":6977,"runtime":"$undefined","seasons":"$undefined"},{"id":519465,"title":"Reina de corazones","originalTitle":"Reina de corazones","overview":"Annie es una exitosa abogada que vive en una casa de estilo modernista con sus dos hijas y su marido Peter, un reputado físico. La aparición de Gustav, un hijo que pertenece a una relación previa de Peter, pone patas arriba la armonía que reina en la vida de Annie. Lo que en un principio parece ser un movimiento liberador para ella, pronto se convierte en una historia de poder y traición que tendrá consecuencias devastadoras en su vida.","posterPath":"https://image.tmdb.org/t/p/w500/dnbZXUwp7ZGNZnPeBxXA1HHxsab.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/e5lxpaVyazQX723A3svR17WxckP.jpg","voteAverage":6.9,"voteCount":376,"releaseDate":"2019-03-27","genres":["Drama"],"type":"movie","platforms":[],"tmdbId":519465,"runtime":"$undefined","seasons":"$undefined"},{"id":786892,"title":"Furiosa: De la saga Mad Max","originalTitle":"Furiosa: De la saga Mad Max","overview":"En un mundo postapocalíptico donde todo ha perdido su valor, los pocos supervivientes se guían por la ley del más fuerte. Sin aprecio por la vida, lo único que despierta un brutal interés es la gasolina, sinónimo de poder y objetivo de bandas armadas hasta los dientes y sin escrúpulos. En este contexto conoceremos la  historia de la arrebatadoramente despiadada, salvaje y joven Furiosa, quien cae en manos de una horda de motoristas y debe sobrevivir a muchas pruebas mientras reúne los medios para encontrar el camino de vuelta a casa. Precuela de 'Mad Max: Furia en la carretera' (2015).","posterPath":"https://image.tmdb.org/t/p/w500/tGHUlykWn9V2IIQ4ZaATIAq9VLB.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/raph7qjAGTMXaIjVxt6ZDSXRzUr.jpg","voteAverage":7.5,"voteCount":4850,"releaseDate":"2024-05-22","genres":["Acción","Ciencia ficción","Aventura"],"type":"movie","platforms":[],"tmdbId":786892,"runtime":"$undefined","seasons":"$undefined"},{"id":78,"title":"Blade Runner","originalTitle":"Blade Runner","overview":"A principios del siglo XXI, la Tyrell Corporation desarrolló un nuevo tipo de robot llamado Nexus, un ser virtualmente idéntico al hombre y conocido como Replicante.  Los Replicantes Nexus-6 eran superiores en fuerza y agilidad, y al menos iguales en inteligencia, a los ingenieros de genética que los crearon.  En el espacio exterior, los Replicantes fueron usados como trabajadores esclavos en la arriesgada exploración y colonización de otros planetas.  Después de la sangrienta rebelión de un equipo de combate de Nexus-6 en una colonia sideral, los Replicantes fueron declarados proscritos en la Tierra bajo pena de muerte.  Brigadas de policías especiales, con el nombre de Unidades de Blade Runners, tenían órdenes de tirar a matar al ver a cualquier Replicante invasor.  A esto no se le llamó ejecución, se le llamó retiro.","posterPath":"https://image.tmdb.org/t/p/w500/pBA2J6iQMiP5Zd4ewMKdOWfq1HV.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/hJ5R9d6QuH3tzr8L8neZZTuzNXm.jpg","voteAverage":7.9,"voteCount":14950,"releaseDate":"1982-06-25","genres":["Ciencia ficción","Drama","Suspense"],"type":"movie","platforms":[],"tmdbId":78,"runtime":"$undefined","seasons":"$undefined"},{"id":50014,"title":"Criadas y Señoras","originalTitle":"Criadas y Señoras","overview":"Mississippi, años 60. Skeeter es una joven sureña que regresa de la universidad decidida a convertirse en escritora. Su llegada altera la vida de la ciudad e incluso la de sus amigos porque se ha propuesto entrevistar a las mujeres negras que se han pasado la vida al servicio de las grandes familias sufriendo todas las formas de discriminación racial.","posterPath":"https://image.tmdb.org/t/p/w500/jki2RrXEE4x6RT2qyQzOVIXYlsn.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/wyvUmyzqGOBDyqLHRSukGDjI7bH.jpg","voteAverage":8.2,"voteCount":9014,"releaseDate":"2011-08-09","genres":["Drama"],"type":"movie","platforms":[],"tmdbId":50014,"runtime":"$undefined","seasons":"$undefined"},{"id":4348,"title":"Orgullo y prejuicio","originalTitle":"Orgullo y prejuicio","overview":"Las cinco hermanas Bennet han sido criadas por una madre obsesionada por encontrarles marido. Pero una de ellas, Lizzie, inteligente y con carácter, desea una vida con perspectivas más abiertas, un anhelo respaldado por su padre. Cuando el señor Bingley, un soltero rico, y su círculo de sofisticados amigos se instalan en una mansión vecina para pasar el verano, las Bennett se entusiasman con la posibilidad de encontrar pretendientes. En el baile de bienvenida, Lizzie conoce al apuesto y elegante señor Darcy, pero, a primera vista, le parece demasiado orgulloso y arrogante.","posterPath":"https://image.tmdb.org/t/p/w500/oixzLjpyaLagLa8UREts1NiHr6F.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/1Onam6oWyFAUCcoxtdWkACtEiNr.jpg","voteAverage":8.1,"voteCount":8750,"releaseDate":"2005-09-16","genres":["Drama","Romance"],"type":"movie","platforms":[],"tmdbId":4348,"runtime":"$undefined","seasons":"$undefined"},{"id":335,"title":"Hasta que llegó su hora","originalTitle":"Hasta que llegó su hora","overview":"Mientras los constructores del ferrocarril avanzan imparables por el desierto de Arizona en su camino hacia el mar, Jill llega al pequeño pueblo de Flagstone con la intención de empezar una nueva vida.","posterPath":"https://image.tmdb.org/t/p/w500/upiek8u4rHTrOJW9B0woXe4A4h7.jpg","backdropPath":"https://image.tmdb.org/t/p/w1280/h31SOVlekuHXsMWVGxI8nPPfY82.jpg","voteAverage":8.3,"voteCount":4884,"releaseDate":"1968-12-21","genres":["Drama","Western"],"type":"movie","platforms":[],"tmdbId":335,"runtime":"$undefined","seasons":"$undefined"}],"series":[]}]
