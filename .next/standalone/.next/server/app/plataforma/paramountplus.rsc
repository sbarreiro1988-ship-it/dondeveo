6:T538,{"@context":"https://schema.org","@graph":[{"@type":"WebSite","@id":"https://www.uru2.com/#website","url":"https://www.uru2.com","name":"DondeVeo Uruguay","description":"Guía de streaming en Uruguay. Encontrá dónde ver películas y series en Netflix, Disney+, Max, Prime Video y más.","inLanguage":"es-UY","potentialAction":{"@type":"SearchAction","target":{"@type":"EntryPoint","urlTemplate":"https://www.uru2.com/?q={search_term_string}"},"query-input":"required name=search_term_string"}},{"@type":"NewsMediaOrganization","@id":"https://www.uru2.com/#organization","name":"DondeVeo Uruguay","alternateName":"DondeVeo","url":"https://www.uru2.com","description":"Guía independiente de streaming y cine para Uruguay. Noticias, reseñas y dónde ver cada película y serie.","foundingDate":"2024","knowsAbout":["streaming","cine","series de televisión","plataformas digitales","Netflix Uruguay","Disney Plus Uruguay"],"areaServed":{"@type":"Country","name":"Uruguay","@id":"https://www.wikidata.org/wiki/Q77"},"logo":{"@type":"ImageObject","url":"https://www.uru2.com/favicon.svg","width":512,"height":512},"sameAs":["https://www.uru2.com"],"publishingPrinciples":"https://www.uru2.com/acerca","diversityPolicy":"https://www.uru2.com/acerca","ethicsPolicy":"https://www.uru2.com/acerca","masthead":"https://www.uru2.com/acerca"}]}0:["5NKp0EthyFALPJ3XyiZE6",[[["",{"children":["plataforma",{"children":[["id","paramountplus","d"],{"children":["__PAGE__?{\"id\":\"paramountplus\"}",{}]}]}]},"$undefined","$undefined",true],["",{"children":["plataforma",{"children":[["id","paramountplus","d"],{"children":["__PAGE__",{},[["$L1","$L2"],null],null]},["$","$L3",null,{"parallelRouterKey":"children","segmentPath":["children","plataforma","children","$4","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L5",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined","styles":null}