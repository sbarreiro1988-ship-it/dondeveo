b:T4a2,{"@context":"https://schema.org","@type":"NewsArticle","headline":"Max (HBO): las series que no podés perderte este mes","description":"Max, la plataforma que fusionó HBO y Warner, consolida su posición como la casa de las series más aclamadas por la crítica. The Last of Us, House of the Dragon y una larga lista de producciones premium están disponibles en Uruguay.","image":[{"@type":"ImageObject","url":"https://www.uru2.com/favicon.svg","width":48,"height":48}],"datePublished":"2026-05-16T12:52:44.899Z","dateModified":"2026-05-16T12:52:44.899Z","author":[{"@type":"Organization","name":"DondeVeo","url":"https://www.uru2.com"}],"publisher":{"@type":"Organization","name":"DondeVeo Uruguay","url":"https://www.uru2.com","logo":{"@type":"ImageObject","url":"https://www.uru2.com/favicon.svg"}},"mainEntityOfPage":{"@type":"WebPage","@id":"https://www.uru2.com/noticias/max-hbo-series-temporadas-nuevas"},"keywords":"Max, HBO, The Last of Us, House of the Dragon, Series","articleSection":"Series","inLanguage":"es-UY","url":"https://www.uru2.com/noticias/max-hbo-series-temporadas-nuevas","speakable":{"@type":"SpeakableSpecification","cssSelector":["h1","p:first-of-type"]}}2:["$","div",null,{"className":"min-h-screen bg-dv-bg","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$b"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Inicio\",\"item\":\"https://www.uru2.com\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Noticias\",\"item\":\"https://www.uru2.com/noticias\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Max (HBO): las series que no podés perderte este mes\",\"item\":\"https://www.uru2.com/noticias/max-hbo-series-temporadas-nuevas\"}]}"}}],["$","div",null,{"className":"max-w-3xl mx-auto px-4 pt-6 pb-2","children":["$","$L9",null,{"